<!-- google dynamic remarketing tag for theme.liquid -->
{% if template contains 'product' %}
<script type="text/javascript">
  var json_product = {{ product | json }};
</script>
<script>
  var ecomm_prodid=[];
  for(var i=0;i<json_product.variants.length;i++)
    ecomm_prodid.push('shopify_IN_{{product.id}}_'+json_product.variants[i].id);
</script>
<script type="text/javascript">
  var google_tag_params = {
    ecomm_prodid: ecomm_prodid,
    ecomm_pagetype: 'product',
    ecomm_totalvalue: parseFloat('{{ product.price | money_without_currency | remove: ","}}')
  };
</script>
{% elsif template contains 'collection' %}
<script type="text/javascript">
  var google_tag_params = {
    ecomm_pagetype: 'category'
  };
</script>
{% elsif template contains 'cart' %}
<script type="text/javascript">
  var id = new Array();
  {% for item in cart.items %}
  id.push('shopify_IN_{{item.product.id}}_{{item.variant.id}}');
   {% endfor %}

   var google_tag_params = {
     ecomm_prodid: id,
     ecomm_pagetype: 'cart',
     ecomm_totalvalue: parseFloat('{{ cart.total_price | money_without_currency | remove: ","}}')
   };
</script>
{% elsif template contains 'search' %}
<script type="text/javascript">
  var google_tag_params = {
    ecomm_pagetype: 'searchresults'
  };
</script>
{% elsif template contains 'index' %}
<script type="text/javascript">
  var google_tag_params = {
    ecomm_pagetype: 'home'
  };
</script>
{% else %}
<script type="text/javascript">
  var google_tag_params = {
    ecomm_pagetype: 'other'
  };
</script>
{% endif %}
<script>
  gtag('event', 'page_view', {'send_to': 'AW-16646732061',
                              'ecomm_prodid':window.google_tag_params.ecomm_prodid,
                              'ecomm_pagetype': window.google_tag_params.ecomm_pagetype,
                              'ecomm_totalvalue':window.google_tag_params.ecomm_totalvalue
                             });
</script>

<script>
  $(document).ready(function() {
    // Function to update the button text
    function updateButtonText() {
      $('.m-add-to-cart--text').text('Add to Cart');
    }

    // Initial update when the page loads
    updateButtonText();

    // Update button text when variant changes
    $(document).on('change', '.m-product-option--content', function() {
      updateButtonText();
    });
  });
</script>   

<script>
  $(document).ready(function() {
    // Function to update the "Buy it now" button text
    function updateBuyNowButtonText() {
      $('.shopify-payment-button__button').each(function() {
        if ($(this).text().trim() === 'Buy it now') {
          $(this).text('Buy Now');
        }
      });
    }

    // Initial update when the page loads
    updateBuyNowButtonText();

    // Use a MutationObserver to handle dynamic content changes
    const observer = new MutationObserver(updateBuyNowButtonText);
    observer.observe(document.body, { childList: true, subtree: true });

    // Additionally, update button text on variant change
    $(document).on('change', '.m-product-option--content', function() {
      updateBuyNowButtonText();
    });
  });
</script>


    <script>
  $(document).ready(function() {
    // Function to remove trailing .00 from the price
    function updatePriceText() {
      $('.m-price-item').each(function() {
        let priceText = $(this).text().trim();

        // Use a regular expression to remove .00 if it exists
        priceText = priceText.replace(/(\.00)(\s*\/-)?$/, '$2');

        // Update the text content of the element
        $(this).text(priceText);
      });
    }

    // Initial update when the page loads
    updatePriceText();


     // Update price text on variant change
    $(document).on('change', '.m-product-option--content', function() {
      updatePriceText();
    });
    
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
  // Function to hide the specific list item
  function hideShopByProduct() {
    // Check if the viewport is for mobile devices
    if (window.innerWidth <= 1023) { // You can adjust the breakpoint as needed
      // Select all list items with the class 'm-menu-mobile__item'
      const menuItems = document.querySelectorAll('.m-menu-mobile__item');

      menuItems.forEach(item => {
        // Find the span element containing "Shop By Product"
        const linkText = item.querySelector('.m-menu-mobile__link span');
        
        if (linkText && linkText.textContent.trim() === "Shop By Product") {
          // Hide the list item
          item.style.display = 'none';
        }
      });
    }
  }

  // Initial call to hide the list item
  hideShopByProduct();

  // Optionally, add an event listener to handle window resize events
  window.addEventListener('resize', hideShopByProduct);
});

</script>


    <script>
      document.addEventListener("DOMContentLoaded", function () {
  // Function to hide the specific list item
  function hideAllProductsMenu() {
    // Check if the viewport is for desktop devices
    if (window.innerWidth > 1024) { // Adjust the breakpoint as needed
      // Select all list items with the class 'm-sub-menu__item--level-1'
      const menuItems = document.querySelectorAll('.m-sub-menu__item--level-1');

      menuItems.forEach(item => {
        // Find the anchor element containing "All Products"
        const linkText = item.querySelector('.m-menu__link');

        if (linkText && linkText.textContent.trim() === "Shop By Products") {
          // Hide the list item
          item.style.display = 'none';
        }
      });
    }
  }

  // Call the function to hide the menu
  hideAllProductsMenu();
});

