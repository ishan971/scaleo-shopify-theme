<script>
  $(document).ready(function() {
    // Function to update the 'Save' text to ensure it's correctly capitalized
    function updateSaveText() {
      $('.m-price__badge-sale .m-product-tag').each(function() {
        let tagText = $(this).contents().filter(function() {
          return this.nodeType === 3; // Get only the text nodes
        }).text().trim();

        if (tagText === 'SAVE') {
          $(this).contents().filter(function() {
            return this.nodeType === 3; // Get only the text nodes
          })[0].nodeValue = 'Save ';
        }
      });
    }

    // Initial update when the page loads
    updateSaveText();

    // Use a MutationObserver to handle dynamic content changes
    const observer = new MutationObserver(updateSaveText);
    observer.observe(document.body, { childList: true, subtree: true });

    // Update on variant change
    $(document).on('change', '.m-product-option--content', function() {
      updateSaveText();
    });
  });
</script>


