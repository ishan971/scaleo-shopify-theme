{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'article.css' | asset_url | stylesheet_tag }}
{{ 'scale-o-article.css' | asset_url | stylesheet_tag }}
<script src="{{ 'scale-o-article.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign show_sidebar = false
  if section.settings.sidebar_show and section.blocks != blank
    assign show_sidebar = true
  endif

  assign design = section.settings.design

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
  endif

  assign article_class = 'm-article so-article'
  assign article_class = article_class | append: ' m-article--' | append: design

  if show_sidebar
    if section.settings.sidebar_position == 'left_column'
      assign sidebar_class = 'sidebar-left'
    else
      assign sidebar_class = 'sidebar-right'
    endif
    assign article_class = article_class | append: ' m-article--' | append: sidebar_class
  else
    assign article_class = article_class | append: ' m-article--no-sidebar'
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif
%}

<section data-section-type="article-template" data-section-id="{{ section.id }}" class="{{ article_class }}">
  <div class="{{ container }}">
    <div class="m-row{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
      <div class="m-article__wrapper">
        {%- if design == 'layout2' and article.image -%}
          <div class="m-article__feature-image">
            {% render 'responsive-image', image: article.image, image_class: 'w-full' %}
          </div>
        {%- endif -%}
        <div role="article" class="m-article__inner">
          <article>
            <div class="m-article__header so-article-header">
              {% if section.settings.blog_show_breadcrumb %}
                {% render 'breadcrumb', justify: 'start', container: 'so-article-crumbs', class: 'so-article-breadcrumb' %}
              {% endif %}
              <a class="so-article-kicker" href="{{ blog.url }}">{{ blog.title }}</a>
              <h1 class="m-article__title so-article-title">{{ article.title }}</h1>
              {% if section.settings.blog_show_author or section.settings.blog_show_date %}
                <div class="so-article-meta">
                  <span class="so-article-avatar" aria-hidden="true">{{ article.author | slice: 0 | upcase }}</span>
                  <div class="so-article-meta__copy">
                    {% if section.settings.blog_show_author %}
                      <span class="so-article-author">{{ article.author }}</span>
                    {% endif %}
                    {% if section.settings.blog_show_date %}
                      <span>{{ article.published_at | date: '%b %d, %Y' }}</span>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            </div>

            {%- if design == 'layout1' and article.image -%}
              <div class="m-article__feature-image">
                {% render 'responsive-image', image: article.image, image_class: 'w-full' %}
              </div>
            {%- endif -%}

            {% if article.content != blank %}
              <div class="m-article__content rte">
                {{ article.content }}
              </div>
            {% endif %}

            {%- if section.settings.blog_show_social or section.settings.blog_show_tags -%}
              <div class="m-article__footer">
                {% if article.tags.size > 0 and section.settings.blog_show_tags %}
                  <div class="m-article-tags">
                    <span class="m-article-tags__heading">{{ 'blogs.article.tags' | t }}</span>
                    {% for tag in article.tags %}
                      <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
                    {% endfor %}
                  </div>
                {% endif %}
                {% if section.settings.blog_show_social %}
                  {% assign url = shop.url | append: article.url %}
                  {% render 'scale-o-article-share', url: url %}
                {% endif %}
              </div>
            {% endif %}

            {%- comment -%}Comment{%- endcomment -%}
            {%- if blog.comments_enabled? and section.settings.blog_show_comment -%}
              {% liquid
                assign new_comment = false
                if comment and comment.created_at
                  assign new_comment = true
                  assign new_comment_id = comment.id
                endif

                if new_comment
                  assign duplicate_comment = false
                  for comment in article.comments
                    if comment.id == new_comment_id
                      assign duplicate_comment = true
                      break
                    endif
                  endfor

                  if duplicate_comment
                    assign number_of_comments = article.comments_count
                  else
                    assign number_of_comments = article.comments_count | plus: 1
                  endif
                else
                  assign number_of_comments = article.comments_count
                endif
              %}

              {% if number_of_comments > 0 %}
                <div class="m-comment-section">
                  <h3 class="m-comment-section__heading">
                    {{ 'blogs.comments.comments_with_count' | t: count: number_of_comments }}
                  </h3>
                  {% paginate article.comments by 5 %}
                    <div id="m-comments" class="m-comment-section__wrapper">
                      {% if comment and comment.status and comment.id != blank and paginate.current_page == 1 %}
                        <p class="m-comment-section__form-message">
                          {% if blog.moderated? and comment.status != 'published' %}
                            {{ 'blogs.comments.success_moderated' | t }}
                          {% else %}
                            {{ 'blogs.comments.success' | t }}
                          {% endif %}
                        </p>
                      {% endif %}

                      {% if article.comments_count > 0 %}
                        <ul class="m-comment-list">
                          {% if comment and comment.status != 'published' and comment.id != blank %}
                            <li id="{{ comment.id }}" class="m-comment m-comment--unpublished">
                              <div class="m-comment__author">
                                {{ comment.author }}
                              </div>
                              <div class="m-comment__content">
                                {{ comment.content }}
                              </div>
                            </li>
                          {% endif %}

                          {% for comment in article.comments %}
                            <li id="{{ comment.id }}" class="m-comment">
                              <div class="m-comment__meta">
                                <div class="m-comment__author">{{ comment.author }}</div>
                                <div class="m-comment__date">
                                  {{ comment.created_at | date: '%b %d, %Y' }}
                                  {{ 'blogs.comments.at_time' | t }}
                                  {{ comment.created_at | date: '%H:%M' }}
                                </div>
                              </div>
                              <div class="m-comment__content">
                                {{ comment.content }}
                              </div>
                              <a href="#m-leave-comment" class="m-comment__reply m-button m-button--link">
                                {{- 'blogs.comments.reply' | t -}}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>

                        {% if paginate.pages > 1 %}
                          {% render 'pagination', paginate: paginate %}
                        {% endif %}
                      {% endif %}
                    </div>
                  {% endpaginate %}
                </div>
              {% endif %}

              <div class="m-comment-form so-comment" id="m-leave-comment">
                {% form 'new_comment', article, class: 'so-comment__form' %}
                  {%- liquid
                    assign body_invalid = false
                    assign author_invalid = false
                    assign email_invalid = false
                    if form.errors contains 'body'
                      assign body_invalid = true
                    endif
                    if form.errors contains 'author'
                      assign author_invalid = true
                    endif
                    if form.errors contains 'email'
                      assign email_invalid = true
                    endif
                  -%}
                  <div class="so-comment__head">
                    <h3 class="so-comment__title">{{ 'blogs.comments.title' | t }}</h3>
                    <p class="so-comment__hint">{{ 'blogs.comments.sub_title' | t }}</p>
                  </div>

                  {% if form.errors %}
                    <div class="so-comment__errors" role="alert">
                      <ul>
                        {% for error in form.errors %}
                          <li>
                            {% if error == 'form' %}
                              {{ form.errors.messages[error] }}
                            {% else %}
                              {{ form.errors.translated_fields[error] }}: {{ form.errors.messages[error] }}
                            {% endif %}
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  <div class="so-comment__grid">
                    <div class="so-comment__field so-comment__field--full">
                      <label for="CommentBody">
                        {{ 'blogs.comments.message' | t }}
                        <span class="so-comment__req" aria-hidden="true">*</span>
                      </label>
                      <textarea
                        name="comment[body]"
                        id="CommentBody"
                        class="so-comment__input{% if body_invalid %} so-comment__input--error{% endif %}"
                        rows="3"
                        required
                        aria-required="true"
                        aria-invalid="{{ body_invalid }}"
                      >{{- form.body -}}</textarea>
                    </div>
                    <div class="so-comment__field">
                      <label for="CommentAuthor">
                        {{ 'blogs.comments.name' | t }}
                        <span class="so-comment__req" aria-hidden="true">*</span>
                      </label>
                      <input
                        type="text"
                        name="comment[author]"
                        id="CommentAuthor"
                        class="so-comment__input{% if author_invalid %} so-comment__input--error{% endif %}"
                        value="{{ form.author }}"
                        autocomplete="name"
                        autocapitalize="words"
                        required
                        aria-required="true"
                        aria-invalid="{{ author_invalid }}"
                      >
                    </div>
                    <div class="so-comment__field">
                      <label for="CommentEmail">
                        {{ 'blogs.comments.email' | t }}
                        <span class="so-comment__req" aria-hidden="true">*</span>
                      </label>
                      <input
                        type="email"
                        name="comment[email]"
                        id="CommentEmail"
                        class="so-comment__input{% if email_invalid %} so-comment__input--error{% endif %}"
                        value="{{ form.email }}"
                        autocomplete="email"
                        spellcheck="false"
                        autocapitalize="off"
                        required
                        aria-required="true"
                        aria-invalid="{{ email_invalid }}"
                      >
                    </div>
                  </div>
                  <div class="so-comment__actions">
                    <button type="submit" class="so-comment__submit">
                      {{ 'blogs.comments.post' | t }}
                    </button>
                  </div>
                {% endform %}
              </div>
            {%- endif -%}
          </article>
        </div>
      </div>

      {% if show_sidebar %}
        <div class="m-blog-sidebar">
          {% render 'blog-sidebar' %}
        </div>
      {% endif %}
    </div>

    {% if section.settings.show_related_articles %}
      <div class="so-related">
        <div class="so-related__head">
          <span class="so-related__tag">{{ 'blogs.article.related_kicker' | t }}</span>
          <h2 class="so-related__heading">{{ 'blogs.article.related_title' | t }}</h2>
          <p class="so-related__sub">{{ 'blogs.article.related_subtitle' | t }}</p>
        </div>
        <div class="so-related__grid">
          {% liquid
            assign current_id = article.id
            assign related_count = 0
          %}
          {% for related_post in blog.articles %}
            {% if related_post.id == current_id %}
              {% continue %}
            {% endif %}
            {% if related_count >= 3 %}
              {% break %}
            {% endif %}
            {% render 'scale-o-related-card', article: related_post %}
            {% assign related_count = related_count | plus: 1 %}
          {% endfor %}
        </div>
        {%- if blog.url != blank -%}
          <div class="so-related__more">
            <a class="so-related__more-btn" href="{{ blog.url }}">
              <span>{{ 'blogs.article.view_more' | t }}</span>
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3.5 8h9M9 4.5 12.5 8 9 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        {%- endif -%}
      </div>
    {% endif %}
  </div>
</section>
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ shop.url | append: page.url | json }}
    },
    "headline": {{ article.title | json }},
    {% if article.excerpt != blank %}
      "description": {{ article.excerpt | strip_html | json }},
    {% endif %}
    {% if article.image %}
  {% assign image_size = article.image.width %}
      "image": [
        {{ article | image_url: width: image_size | prepend: "https:" | json }}
      ],
    {% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      {% if page_image %}
  {% assign image_size = page_image.width %}
        "logo": {
          "@type": "ImageObject",
          "height": {{ page_image.height | json }},
          "url": {{ page_image | image_url: width: image_size | prepend: "https:" | json }},
          "width": {{ page_image.width | json }}
        },
      {% endif %}
      "name": {{ shop.name | json }}
    }
  }
</script>
