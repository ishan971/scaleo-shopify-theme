{%- comment -%}
  Scale-O Before & After Results — visual comparison
{%- endcomment -%}

{{ 'scale-o-before-after.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign point_blocks = section.blocks | where: 'type', 'point'
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign pair_blocks = section.blocks | where: 'type', 'compare_pair'
  assign header_align = section.settings.header_alignment
  assign layout_style = section.settings.layout_style | default: 'pairs'
  assign is_pairs = false
  if layout_style == 'pairs'
    assign is_pairs = true
  endif

  assign show_header = false
  if section.settings.heading != blank
    assign show_header = true
  endif
  if section.settings.show_eyebrow and section.settings.eyebrow != blank
    assign show_header = true
  endif
  if section.settings.show_description and section.settings.description != blank
    assign show_header = true
  endif
  if section.settings.show_description and section.settings.description_highlight != blank
    assign show_header = true
  endif

  assign before_main = section.settings.before_image
  assign before_mobile = section.settings.before_image_mobile | default: before_main
  assign after_main = section.settings.after_image
  assign after_mobile = section.settings.after_image_mobile | default: after_main
  assign before_alt = section.settings.before_image_alt | default: section.settings.before_heading | default: 'Before Scale-O'
  assign after_alt = section.settings.after_image_alt | default: section.settings.after_heading | default: 'After Scale-O'
  assign transition_label = section.settings.transition_text | default: 'Before to after'

  assign before_point_count = 0
  assign after_point_count = 0
  for block in point_blocks
    if block.settings.title != blank
      if block.settings.side == 'before'
        assign before_point_count = before_point_count | plus: 1
      elsif block.settings.side == 'after'
        assign after_point_count = after_point_count | plus: 1
      endif
    endif
  endfor
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-before-after {
    --sba-bg: {{ section.settings.background_color }};
    --sba-heading: {{ section.settings.heading_color }};
    --sba-text: {{ section.settings.text_color }};
    --sba-accent: {{ section.settings.accent_color }};
    --sba-accent-hover: {{ section.settings.accent_hover_color }};
    --sba-before-bg: {{ section.settings.before_card_background }};
    --sba-after-bg: {{ section.settings.after_card_background }};
    --sba-radius: {{ section.settings.card_radius }}px;
    --sba-ratio: {{ section.settings.image_aspect_ratio }};
    --sba-image-height: {{ section.settings.image_height }}px;
    --sba-image-height-mobile: {{ section.settings.image_height_mobile }}px;
    --sba-arrow-size: {{ section.settings.arrow_size }}px;
    --sba-shadow: 0 10px 28px rgba(26, 43, 74, 0.06);
    --sba-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --sba-heading-size: {{ section.settings.heading_size_mobile }}px;
    --sba-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --sba-desc-size: {{ section.settings.description_size }}px;
    --sba-pad-x: {{ section.settings.padding_x }}px;
    --sba-header-gap: {{ section.settings.header_gap }}px;
    --sba-header-align: {{ header_align }};
    --sba-max-width: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: var(--sba-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-before-after {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }

  /* Pair cards: keep images inside + gap between Before/After */
  #shopify-section-{{ section.id }} .scale-o-before-after--pairs .scale-o-before-after__pair {
    padding: 16px !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
    border: 1.5px solid #c5d0e0 !important;
    box-shadow: 0 10px 28px rgba(18, 40, 72, 0.14) !important;
  }
  #shopify-section-{{ section.id }} .scale-o-before-after--pairs .scale-o-before-after__pair-media {
    display: flex !important;
    flex-direction: row !important;
    align-items: stretch !important;
    gap: 14px !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} .scale-o-before-after--pairs .scale-o-before-after__pair-shot {
    position: relative !important;
    flex: 1 1 0 !important;
    width: auto !important;
    max-width: calc(50% - 7px) !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    border-radius: 14px !important;
    aspect-ratio: 1 / 1 !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} .scale-o-before-after--pairs .scale-o-before-after__pair-shot img {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    object-fit: cover !important;
  }
</style>

<div
  class="scale-o-before-after{% if is_pairs %} scale-o-before-after--pairs{% else %} scale-o-before-after--classic{% endif %}"
  data-section-id="{{ section.id }}"
  data-animate="{% if section.settings.enable_animations %}true{% else %}false{% endif %}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Before and after results' | escape }}"
>
  <div class="scale-o-before-after__container">
    {%- if show_header -%}
      <header class="scale-o-before-after__header scale-o-before-after__header--{{ header_align }}" data-sba-animate>
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
          <p class="scale-o-before-after__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="scale-o-before-after__heading{% if section.settings.heading_one_line %} scale-o-before-after__heading--one-line{% endif %}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.show_description -%}
          {%- if section.settings.description != blank -%}
            <p class="scale-o-before-after__description">{{ section.settings.description | escape }}</p>
          {%- endif -%}
          {%- if section.settings.description_highlight != blank -%}
            <p class="scale-o-before-after__description-accent">{{ section.settings.description_highlight | escape }}</p>
          {%- endif -%}
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if is_pairs -%}
      <div class="scale-o-before-after__pairs" role="list">
        {%- if pair_blocks.size > 0 -%}
          {%- for block in pair_blocks -%}
            {%- liquid
              assign pair_before = block.settings.before_image
              assign pair_after = block.settings.after_image
              assign pair_label = block.settings.category_label
              assign pair_before_tag = block.settings.before_label | default: 'Before'
              assign pair_after_tag = block.settings.after_label | default: 'After'
            -%}
            <article class="scale-o-before-after__pair" role="listitem" data-sba-animate {{ block.shopify_attributes }}>
              {%- if pair_label != blank -%}
                <p class="scale-o-before-after__pair-label">{{ pair_label | escape }}</p>
              {%- endif -%}
              <div class="scale-o-before-after__pair-media">
                <div class="scale-o-before-after__pair-shot">
                  {%- if pair_before != blank -%}
                    {{ pair_before | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280,420,700', sizes: '(max-width: 767px) 45vw, 12vw', alt: pair_before_tag }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'scale-o-before-after__pair-placeholder' }}
                  {%- endif -%}
                  <span class="scale-o-before-after__pair-tag">{{ pair_before_tag | escape }}</span>
                </div>
                <div class="scale-o-before-after__pair-shot">
                  {%- if pair_after != blank -%}
                    {{ pair_after | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280,420,700', sizes: '(max-width: 767px) 45vw, 12vw', alt: pair_after_tag }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'scale-o-before-after__pair-placeholder' }}
                  {%- endif -%}
                  <span class="scale-o-before-after__pair-tag">{{ pair_after_tag | escape }}</span>
                </div>
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Fallback: build 4 static pairs from section images {%- endcomment -%}
          {%- for i in (1..4) -%}
            {%- liquid
              assign pair_label = ''
              assign pair_before = blank
              assign pair_after = blank
              if i == 1
                assign pair_label = section.settings.pair_label_1 | default: 'For Property'
                assign pair_before = before_main
                assign pair_after = after_main
                assign before_fallback = 'scale-o-ba-before-main.jpg'
                assign after_fallback = 'scale-o-ba-after-main.jpg'
              elsif i == 2
                assign pair_label = section.settings.pair_label_2 | default: 'For People'
                assign pair_before = section.settings.before_detail_1
                assign pair_after = section.settings.after_detail_1
                assign before_fallback = 'scale-o-ba-before-1.jpg'
                assign after_fallback = 'scale-o-ba-after-1.jpg'
              elsif i == 3
                assign pair_label = section.settings.pair_label_3 | default: 'For Property'
                assign pair_before = section.settings.before_detail_2
                assign pair_after = section.settings.after_detail_2
                assign before_fallback = 'scale-o-ba-before-2.jpg'
                assign after_fallback = 'scale-o-ba-after-2.jpg'
              else
                assign pair_label = section.settings.pair_label_4 | default: 'For People'
                assign pair_before = section.settings.before_detail_3
                assign pair_after = section.settings.after_detail_3
                assign before_fallback = 'scale-o-ba-before-3.jpg'
                assign after_fallback = 'scale-o-ba-after-3.jpg'
              endif
            -%}
            <article class="scale-o-before-after__pair" role="listitem" data-sba-animate>
              {%- if pair_label != blank -%}
                <p class="scale-o-before-after__pair-label">{{ pair_label | escape }}</p>
              {%- endif -%}
              <div class="scale-o-before-after__pair-media">
                <div class="scale-o-before-after__pair-shot">
                  {%- if pair_before != blank -%}
                    {{ pair_before | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280,420,700', sizes: '(max-width: 767px) 45vw, 12vw', alt: 'Before' }}
                  {%- else -%}
                    <img src="{{ before_fallback | asset_url }}" alt="Before" width="700" height="700" loading="lazy">
                  {%- endif -%}
                  <span class="scale-o-before-after__pair-tag">Before</span>
                </div>
                <div class="scale-o-before-after__pair-shot">
                  {%- if pair_after != blank -%}
                    {{ pair_after | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280,420,700', sizes: '(max-width: 767px) 45vw, 12vw', alt: 'After' }}
                  {%- else -%}
                    <img src="{{ after_fallback | asset_url }}" alt="After" width="700" height="700" loading="lazy">
                  {%- endif -%}
                  <span class="scale-o-before-after__pair-tag">After</span>
                </div>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- else -%}
    <div class="scale-o-before-after__compare">
      <article class="scale-o-before-after__card scale-o-before-after__card--before" data-sba-animate>
        <div class="scale-o-before-after__main">
          {%- if before_main != blank -%}
            <picture>
              {%- if section.settings.before_image_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ before_mobile | image_url: width: 900 }}">
              {%- endif -%}
              {{
                before_main
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '480,800,1200',
                  sizes: '(max-width: 767px) 100vw, 50vw',
                  alt: before_alt
              }}
            </picture>
          {%- else -%}
            <img src="{{ 'scale-o-ba-before-main.jpg' | asset_url }}" alt="{{ before_alt | escape }}" width="1200" height="900" loading="lazy">
          {%- endif -%}
          {%- if section.settings.before_label != blank or section.settings.before_heading != blank -%}
            <div class="scale-o-before-after__overlay">
              {%- if section.settings.before_label != blank -%}
                <p class="scale-o-before-after__label">{{ section.settings.before_label | escape }}</p>
              {%- endif -%}
              {%- if section.settings.before_heading != blank -%}
                <h3 class="scale-o-before-after__card-title">{{ section.settings.before_heading | escape }}</h3>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
        {%- if section.settings.show_detail_images -%}
        <ul class="scale-o-before-after__thumbs" role="list">
          <li class="scale-o-before-after__thumb">
            {%- if section.settings.before_detail_1 != blank -%}
              {{ section.settings.before_detail_1 | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,400', alt: '' }}
            {%- else -%}
              <img src="{{ 'scale-o-ba-before-1.jpg' | asset_url }}" alt="" width="400" height="400" loading="lazy">
            {%- endif -%}
          </li>
          <li class="scale-o-before-after__thumb">
            {%- if section.settings.before_detail_2 != blank -%}
              {{ section.settings.before_detail_2 | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,400', alt: '' }}
            {%- else -%}
              <img src="{{ 'scale-o-ba-before-2.jpg' | asset_url }}" alt="" width="400" height="400" loading="lazy">
            {%- endif -%}
          </li>
          <li class="scale-o-before-after__thumb">
            {%- if section.settings.before_detail_3 != blank -%}
              {{ section.settings.before_detail_3 | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,400', alt: '' }}
            {%- else -%}
              <img src="{{ 'scale-o-ba-before-3.jpg' | asset_url }}" alt="" width="400" height="400" loading="lazy">
            {%- endif -%}
          </li>
        </ul>
        {%- endif -%}
        {%- if section.settings.before_description != blank -%}
          <p class="scale-o-before-after__card-copy">{{ section.settings.before_description | escape }}</p>
        {%- endif -%}
        {%- if before_point_count > 0 -%}
        {%- assign shown_before_points = 0 -%}
        <ul class="scale-o-before-after__points" role="list">
          {%- for block in point_blocks -%}
            {%- if block.settings.side == 'before' and shown_before_points < 4 and block.settings.title != blank -%}
              {%- assign shown_before_points = shown_before_points | plus: 1 -%}
              <li class="scale-o-before-after__point" {{ block.shopify_attributes }}>
                <svg class="scale-o-before-after__mark" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 4l8 8M12 4 4 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                <span>{{ block.settings.title | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- endif -%}
      </article>

      {%- if section.settings.show_transition -%}
        <span class="scale-o-before-after__divider" aria-hidden="true"></span>
        <span class="scale-o-before-after__mobile-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 4v16M6 14l6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="scale-o-before-after__arrow" aria-label="{{ transition_label | escape }}">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 12h16M14 6l6 6-6 6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      {%- endif -%}

      <article class="scale-o-before-after__card scale-o-before-after__card--after" data-sba-animate>
        <div class="scale-o-before-after__main">
          {%- if after_main != blank -%}
            <picture>
              {%- if section.settings.after_image_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ after_mobile | image_url: width: 900 }}">
              {%- endif -%}
              {{
                after_main
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '480,800,1200',
                  sizes: '(max-width: 767px) 100vw, 50vw',
                  alt: after_alt
              }}
            </picture>
          {%- else -%}
            <img src="{{ 'scale-o-ba-after-main.jpg' | asset_url }}" alt="{{ after_alt | escape }}" width="1200" height="900" loading="lazy">
          {%- endif -%}
          {%- if section.settings.after_label != blank or section.settings.after_heading != blank -%}
            <div class="scale-o-before-after__overlay">
              {%- if section.settings.after_label != blank -%}
                <p class="scale-o-before-after__label">{{ section.settings.after_label | escape }}</p>
              {%- endif -%}
              {%- if section.settings.after_heading != blank -%}
                <h3 class="scale-o-before-after__card-title">{{ section.settings.after_heading | escape }}</h3>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
        {%- if section.settings.show_detail_images -%}
        <ul class="scale-o-before-after__thumbs" role="list">
          <li class="scale-o-before-after__thumb">
            {%- if section.settings.after_detail_1 != blank -%}
              {{ section.settings.after_detail_1 | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,400', alt: '' }}
            {%- else -%}
              <img src="{{ 'scale-o-ba-after-1.jpg' | asset_url }}" alt="" width="400" height="400" loading="lazy">
            {%- endif -%}
          </li>
          <li class="scale-o-before-after__thumb">
            {%- if section.settings.after_detail_2 != blank -%}
              {{ section.settings.after_detail_2 | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,400', alt: '' }}
            {%- else -%}
              <img src="{{ 'scale-o-ba-after-2.jpg' | asset_url }}" alt="" width="400" height="400" loading="lazy">
            {%- endif -%}
          </li>
          <li class="scale-o-before-after__thumb">
            {%- if section.settings.after_detail_3 != blank -%}
              {{ section.settings.after_detail_3 | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,400', alt: '' }}
            {%- else -%}
              <img src="{{ 'scale-o-ba-after-3.jpg' | asset_url }}" alt="" width="400" height="400" loading="lazy">
            {%- endif -%}
          </li>
        </ul>
        {%- endif -%}
        {%- if section.settings.after_description != blank -%}
          <p class="scale-o-before-after__card-copy">{{ section.settings.after_description | escape }}</p>
        {%- endif -%}
        {%- if after_point_count > 0 -%}
        {%- assign shown_after_points = 0 -%}
        <ul class="scale-o-before-after__points" role="list">
          {%- for block in point_blocks -%}
            {%- if block.settings.side == 'after' and shown_after_points < 4 and block.settings.title != blank -%}
              {%- assign shown_after_points = shown_after_points | plus: 1 -%}
              <li class="scale-o-before-after__point" {{ block.shopify_attributes }}>
                <svg class="scale-o-before-after__mark" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{{ block.settings.title | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- endif -%}
      </article>
    </div>
    {%- endif -%}

    {%- if benefit_blocks.size > 0 -%}
      <ul class="scale-o-before-after__benefits" role="list">
        {%- for block in benefit_blocks limit: 4 -%}
          <li class="scale-o-before-after__benefit" data-sba-animate {{ block.shopify_attributes }}>
            <span class="scale-o-before-after__benefit-icon" aria-hidden="true">
              {%- if block.settings.icon_image != blank -%}
                {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
              {%- else -%}
                {% render 'scale-o-solution-icon', icon: block.settings.theme_icon, class: 'scale-o-before-after__benefit-svg' %}
              {%- endif -%}
            </span>
            {%- if block.settings.title != blank -%}
              <h3 class="scale-o-before-after__benefit-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="scale-o-before-after__benefit-text">{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_cta and section.settings.cta_text != blank -%}
      <div class="scale-o-before-after__cta-wrap" data-sba-animate>
        <a class="scale-o-before-after__cta" href="{{ section.settings.cta_url | default: '#' }}">
          <span>{{ section.settings.cta_text | escape }}</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.enable_animations -%}
  <script src="{{ 'scale-o-before-after.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Before & After Results",
  "tag": "section",
  "class": "scale-o-before-after-section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BEFORE & AFTER RESULTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Checkout Before vs After Results with Scale-O" },
    { "type": "checkbox", "id": "heading_one_line", "label": "Keep heading on one line (desktop)", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Genuine differences and impact after installing our water softeners across houses." },
    { "type": "text", "id": "description_highlight", "label": "Description line 2" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },

    { "type": "header", "content": "Before panel" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "BEFORE" },
    { "type": "text", "id": "before_heading", "label": "Before heading", "default": "Without Scale-O" },
    { "type": "textarea", "id": "before_description", "label": "Before description", "default": "Hard-water scale can build up on everyday fixtures and surfaces." },
