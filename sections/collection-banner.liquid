<div class="collection-slider">  
  <div class="collection-banner-wrapper">
    {% for block in section.blocks %}
    <div class="slider-banner">
      <a href="{{ block.settings.btn_link }}">
        
        {% if block.settings.desktop_banner != blank %}
        <img class="slider-desktop-image" src="{{ block.settings.desktop_banner | img_url:'master' }}">
            {% if block.settings.mobile_banner != blank %}
            <img class="slider-mobile-image" src="{{ block.settings.mobile_banner | img_url:'master' }}">
            {% else %}
            <img class="slider-mobile-image" src="{{ block.settings.desktop_banner | img_url:'master' }}">
            {% endif %}
        {% endif %}
        <div class="slider-content">
          <div class="container-fluid">
            <div class="top-slider-content">
          {% if block.settings.heading != blank %}
            <h2>{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.subtext != blank %}
            <h3>{{ block.settings.subtext }}</h3>
            <h4>{{ block.settings.subtext_2 }}</h4>
          {% endif %}
            {{ block.settings.info }}

              {% if block.settings.btn_label != blank %}
          <button class="slider-button">{{ block.settings.btn_label }}</button>
              {% endif %}
          </div>
          <div class="product-specification">
            {% if block.settings.specification_image_1 != blank or block.settings.specification_heading_1 != blank or block.settings.specification_content_1 != blank %}
            <div class="specification-inner">
              {% if block.settings.specification_image_1 != blank %}
              <img src="{{ block.settings.specification_image_1 | img_url : '300x'}}">
              {% endif %}
              <div class="specification-data">
                {% if block.settings.specification_heading_1 != blank %}
                  <h4>{{ block.settings.specification_heading_1 }}</h4>
                {% endif %}
                {{ block.settings.specification_content_1 }}   
                </div>
            </div>
              {% endif %}

             {% if block.settings.specification_image_2 != blank or block.settings.specification_heading_2 != blank or block.settings.specification_content_2 != blank %}
            <div class="specification-inner">
              {% if block.settings.specification_image_2 != blank %}
              <img src="{{ block.settings.specification_image_2 | img_url : '300x'}}">
              {% endif %}
              <div class="specification-data">
                {% if block.settings.specification_heading_2 != blank %}
                  <h4>{{ block.settings.specification_heading_2 }}</h4>
                {% endif %}
                {{ block.settings.specification_content_2 }} 
              </div>
            </div>
              {% endif %}

             {% if block.settings.specification_image_3 != blank or block.settings.specification_heading_3 != blank or block.settings.specification_content_3 != blank %}
            <div class="specification-inner">
              {% if block.settings.specification_image_3 != blank %}
              <img src="{{ block.settings.specification_image_3 | img_url : '300x'}}">
              {% endif %}
              <div class="specification-data">
                {% if block.settings.specification_heading_3 != blank %}
                  <h4>{{ block.settings.specification_heading_3 }}</h4>
                {% endif %}
                {{ block.settings.specification_content_3 }}  
              </div>
            </div>
              {% endif %}
          </div>
          </div>
        </div>
        
      </a>
    </div>
    {% endfor %}
  </div>
</div>
  
{% schema %}
  {
    "name": "Collection Banner Slider",
    "settings": [],
    "blocks":[
      {
        "type": "slide",
        "name":"Slide",
        "settings":[
          {
            "type":"image_picker",
            "id":"desktop_banner",
            "label":"Desktop Banner"
          },
          {
            "type":"image_picker",
            "id":"mobile_banner",
            "label":"Mobile Banner"
          },
          {
            "type":"richtext",
            "id":"heading",
            "label":"Heading"
          },
          {
            "type":"text",
            "id":"subtext",
            "label":"Subtext_1"
          },
          {
            "type":"text",
            "id":"subtext_2",
            "label":"Subtext 2"
          },
          {
            "type":"richtext",
            "id":"info",
            "label":"Information"
          },
          {
            "type":"text",
            "id":"btn_label",
            "label":"Button Label"
          },
          {
            "type":"url",
            "id":"btn_link",
            "label":"Button Link"
          },
          {
            "type":"header",
            "content": "Product Specification 1"
          },
          {
            "type":"image_picker",
            "id":"specification_image_1",
            "label":"Specification Image"
          },
          {
            "type":"text",
            "id":"specification_heading_1",
            "label":"Specficication Heading"
          },
          {
            "type":"richtext",
            "id":"specification_content_1",
            "label":"Specficication Content"
          },
          {
            "type":"header",
            "content": "Product Specification 2"
          },
          {
            "type":"image_picker",
            "id":"specification_image_2",
            "label":"Specification Image"
          },
          {
            "type":"text",
            "id":"specification_heading_2",
            "label":"Specficication Heading"
          },
          {
            "type":"richtext",
            "id":"specification_content_2",
            "label":"Specficication Content"
          },
          {
            "type":"header",
            "content": "Product Specification 1"
          },
          {
            "type":"image_picker",
            "id":"specification_image_3",
            "label":"Specification Image"
          },
          {
            "type":"text",
            "id":"specification_heading_3",
            "label":"Specficication Heading"
          },
          {
            "type":"richtext",
            "id":"specification_content_3",
            "label":"Specficication Content"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Collection Banner Slider"
      }
    ]
  }
{% endschema %}