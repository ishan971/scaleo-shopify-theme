{% comment %}
  Scale-O footer — compact premium layout.
 {% endcomment %} 
 
{{ 'scale-o-footer.css' | asset_url | stylesheet_tag }}

<footer
  class="so-footer"
  id="so-footer"
  role="contentinfo"
>
  {% render 'scale-o-footer-waves' %}
  <div class="so-footer__inner">
    <div class="so-footer__main">
      <div class="so-footer__brand">
        <a class="so-footer__logo" href="{{ routes.root_url }}">
          <img
            src="https://cdn.shopify.com/s/files/1/0592/6508/9638/files/scale-o_1_cb790b16-7565-4370-acfe-238cda3b1f14.png?v=1722322631"
            alt="Scale-O"
            width="92"
            height="92"
            loading="lazy"
          >
        </a>
        <span class="so-footer__tagline">
          <img
            src="https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Clean_H2O_7ddc14d1-a3c1-4855-99f5-85095b4acec5.svg?v=1723626773"
            alt="Clean H₂O"
            width="88"
            height="18"
            loading="lazy"
          >
        </span>
        <p class="so-footer__desc">Protecting your health and homes with our innovative, affordable and sustainable water softening solutions!</p>
        <div class="so-footer__social--desktop">
          {% render 'scale-o-footer-social' %}
        </div>
      </div>

      <nav class="so-footer__col so-footer__col--nav" aria-labelledby="so-footer-locations">
        <h3 class="so-footer__col-title" id="so-footer-locations">Locations</h3>
        {% render 'scale-o-footer-menu', handle: 'locations' %}
      </nav>

      <nav class="so-footer__col so-footer__col--nav" aria-labelledby="so-footer-quick-links">
        <h3 class="so-footer__col-title" id="so-footer-quick-links">Quick Links</h3>
        {% render 'scale-o-footer-menu', handle: 'quick-links' %}
      </nav>

      <div class="so-footer__end">
        <nav class="so-footer__col so-footer__col--policy" aria-labelledby="so-footer-policy">
          <h3 class="so-footer__col-title" id="so-footer-policy">Policy</h3>
          {% render 'scale-o-footer-menu', handle: 'policy' %}
        </nav>

        <div class="so-footer__col so-footer__contact">
          <div class="so-footer__contact-group">
            <h3 class="so-footer__contact-title">For Support</h3>
            <ul class="so-footer__contact-list" role="list">
              <li>
                <a href="tel:+919909963300">
                  <img src="https://cdn.shopify.com/s/files/1/0592/6508/9638/files/call_2c979c87-c541-498e-b9ef-127dc8251f38.png?v=1723095226" alt="" width="16" height="16" loading="lazy">
                  <span>+91 9909963300</span>
 </a>
 </li>
              <li>
                <a href="mailto:support@scale-o.com">
                  <img src="https://cdn.shopify.com/s/files/1/0592/6508/9638/files/email.png?v=1723095314" alt="" width="16" height="16" loading="lazy">
                  <span>support@scale-o.com</span>
                </a>
 </li>
 </ul>
 </div>

          <div class="so-footer__contact-group">
            <h3 class="so-footer__contact-title">For Sales</h3>
            <ul class="so-footer__contact-list" role="list">
              <li>
                <a href="tel:+919909963304">
                  <img src="https://cdn.shopify.com/s/files/1/0592/6508/9638/files/call_2c979c87-c541-498e-b9ef-127dc8251f38.png?v=1723095226" alt="" width="16" height="16" loading="lazy">
                  <span>+91 9909963304</span>
 </a>
 </li>
              <li>
                <a href="mailto:sales@scale-o.com">
                  <img src="https://cdn.shopify.com/s/files/1/0592/6508/9638/files/email.png?v=1723095314" alt="" width="16" height="16" loading="lazy">
                  <span>sales@scale-o.com</span>
                </a>
 </li>
 </ul>
 </div>

 </div>

        <div class="so-footer__payments">
          <h3 class="so-footer__contact-title">Secure Payments</h3>
          <div class="so-footer__pay-row">
            <img
              src="{{ 'payment-icons-secure.svg' | asset_url }}"
              alt="Visa, Mastercard, RuPay, UPI"
              width="240"
              height="26"
              loading="lazy"
            >
            <img
              class="so-footer__pay-cod"
              src="{{ 'payment-icon-cod.svg' | asset_url }}"
              alt="Cash on Delivery"
              width="92"
              height="26"
              loading="lazy"
            >
          </div>
        </div>
 </div>
 </div>

    <div class="so-footer__maker">
      <p class="so-footer__maker-label">Manufactured &amp; marketed by</p>
      <div class="so-footer__maker-brand">
        <img
          class="so-footer__maker-logo"
          src="https://cdn.shopify.com/s/files/1/0592/6508/9638/files/panthera-logo_40f11a0f-5a68-4228-afef-9155acfed08f.png?v=1722324453"
          alt="Panthera Cleantech Pvt Ltd"
          width="180"
          height="36"
          loading="lazy"
        >
        <span class="so-footer__maker-rule" aria-hidden="true"></span>
        <p class="so-footer__maker-address">C-101, Titanium Business Park, Nr Corporate Road, Makarba, Ahmedabad, Gujarat, India - 380051</p>
 </div>
 </div>

    <div class="so-footer__social-bar so-footer__social--mobile">
      {% render 'scale-o-footer-social' %}
    </div>

    <div class="so-footer__copy">
      <p>© 2026 Scale-O. All Rights Reserved.</p>
 </div>
 </div>
</footer>

{% schema %}
{
  "name": "Scale-O footer",
  "settings": []
}
{% endschema %}
