    .slick-track {
        display: flex;
        gap: 20px;
    }
    .slick-list {
        display: flex!important;
    }
    .st-slide {
        background: white;
        padding: 20px;
        border-radius: 20px;
        display: flex!important;
        flex-direction: column;
        justify-content: space-between;
        gap: 30px;
    }
    .slick-slide{
        height: auto!important;
    }
    .st-content {
        display: grid;
        gap: 15px;
    }
    .st-content img{
        width: 100%;
        height: 270px;
        object-fit: cover;
        background-position-x: center;
        background-position-y: center;
        border-radius: 20px;
    }
    .st-content span{
        background: #2A6AB2;
        padding: 6px 15px;
        border-radius: 50px;
        color: white;
        width: fit-content;
    }
    /* Texts */
    .st-content h3{
        margin: 0!important;
        font-size: 24px;
        line-height: 28.8px;
    }
    .st-content p{
        margin: 0!important;
        margin-top: -5px;
        font-size: 18px;
        line-height: 21.6px;
    }
    /* Navigations */
    .slick-next{
        right: -60px!important;
        padding: 23px;
        border-radius: 50%;
        background: white;
        transition: .4s all ease;
    }
    .slick-prev{
        left: -60px!important;
        padding: 23px;
        border-radius: 50%;
        background: white;
        transition: .4s all ease;
    }
    .slick-prev:hover,.slick-next:hover{
        transition: .4s all ease;
        background: black;
    }
    .slick-prev:hover::before,
    .slick-next:hover::before{
        filter: brightness(0) invert(1);
        transition: .4s all ease;
    }
    .slick-prev::before{
        content: url('https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Group_1.svg?v=1722327196')!important;
        display: flex;
        width: 24px;
        height: 24px;
        transform: translate(-11px,-11px);
        transition: .4s all ease;
    }
    .slick-next::before{
        content: url('https://cdn.shopify.com/s/files/1/0592/6508/9638/files/cfsafa.svg?v=1722327196')!important;
        display: flex;
        width: 24px;
        height: 24px;
        transform: translate(-11px,-11px);
        transition: .4s all ease;
    }
    
