{%- comment -%}
  Scale-O Hard Water Problems — bento grid section
{%- endcomment -%}

{{ 'scale-o-problems.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign problem_blocks = section.blocks | where: 'type', 'problem'
  assign visible_count = section.settings.visible_cards | plus: 0
  unless section.settings.show_view_all
    assign visible_count = problem_blocks.size
  endunless
  assign extra_count = 0
  assign shown_count = 0
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-problems {
    --sop-bg: {{ section.settings.background_color }};
    --sop-heading: {{ section.settings.heading_color }};
    --sop-text: {{ section.settings.text_color }};
    --sop-accent: {{ section.settings.accent_color }};
    --sop-accent-hover: {{ section.settings.accent_hover_color }};
    --sop-card-border: {{ section.settings.card_border_color }};
    --sop-overlay: {{ section.settings.overlay_color }};
    --sop-radius: {{ section.settings.card_radius }}px;
    --sop-shadow: 0 4px {{ section.settings.shadow_strength | divided_by: 4 | plus: 10 }}px rgba(26, 43, 74, {{ section.settings.shadow_strength | times: 0.0012 }});
    --sop-shadow-hover: 0 12px {{ section.settings.shadow_strength | divided_by: 3 | plus: 16 }}px rgba(26, 43, 74, {{ section.settings.shadow_strength | times: 0.0018 }});
    --sop-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --sop-heading-size: {{ section.settings.heading_size_mobile }}px;
    --sop-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --sop-desc-size: {{ section.settings.description_size }}px;
    --sop-title-size: {{ section.settings.problem_title_size }}px;
    --sop-card-desc-size: {{ section.settings.card_description_size }}px;
    --sop-gap: {{ section.settings.card_gap }}px;
    --sop-pad-x: {{ section.settings.padding_x }}px;
    --sop-header-gap: {{ section.settings.header_gap }}px;
    --sop-header-align: {{ section.settings.header_alignment }};
    --sop-max-width: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --sop-bento-row-height: {{ section.settings.bento_row_height }}px;
    --sop-bento-min-height: {{ section.settings.bento_min_height_mobile }}px;
    --sop-overlay-transition: {{ section.settings.overlay_transition_ms }}ms;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--sop-bg);
  }
</style>

<div
  class="scale-o-problems"
  data-section-id="{{ section.id }}"
  aria-label="{{ section.settings.accessibility_label | default: 'Hard water problems' | escape }}"
>
  <div class="scale-o-problems__container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <header class="scale-o-problems__header scale-o-problems__header--{{ section.settings.header_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="scale-o-problems__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="scale-o-problems__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="scale-o-problems__desc">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if problem_blocks.size > 0 -%}
      <div class="scale-o-problems__bento-grid" data-bento-count="{{ visible_count }}">
        {%- for block in problem_blocks -%}
          {%- assign shown_count = shown_count | plus: 1 -%}
          {%- if shown_count > visible_count -%}
            {%- assign extra_count = extra_count | plus: 1 -%}
            {%- continue -%}
          {%- endif -%}
          {%- render 'scale-o-problem-card', block: block, section: section, loading: 'lazy', grid_style: '' -%}
        {%- endfor -%}
      </div>

      {%- if extra_count > 0 -%}
        <div class="scale-o-problems__bento-grid" data-problems-extra hidden>
          {%- assign shown_count = 0 -%}
          {%- for block in problem_blocks -%}
            {%- assign shown_count = shown_count | plus: 1 -%}
            {%- if shown_count <= visible_count -%}
              {%- continue -%}
            {%- endif -%}
            {%- render 'scale-o-problem-card', block: block, section: section, loading: 'lazy', grid_style: '' -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.show_view_all -%}
          <div class="scale-o-problems__toggle-wrap">
            <button
              type="button"
              class="scale-o-problems__toggle"
              data-problems-toggle
              aria-expanded="false"
              data-label-show="{{ section.settings.view_all_text | default: 'View all problems' | escape }}"
              data-label-hide="{{ section.settings.view_all_hide_text | default: 'Show fewer problems' | escape }}"
            >
              <span data-problems-toggle-label>{{ section.settings.view_all_text | default: 'View all problems' | escape }}</span>
            </button>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.show_solution -%}
      <div class="scale-o-problems__solution">
        {%- if section.settings.solution_eyebrow != blank -%}
          <p class="scale-o-problems__eyebrow">{{ section.settings.solution_eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.solution_heading != blank -%}
          <h3 class="scale-o-problems__solution-heading">{{ section.settings.solution_heading | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.solution_description != blank -%}
          <p class="scale-o-problems__solution-desc">{{ section.settings.solution_description | escape }}</p>
        {%- endif -%}
        {%- if section.settings.solution_button_text != blank -%}
          {%- assign solution_url = section.settings.solution_button_url | default: '#shopify-section-how_it_works_home' -%}
          <a class="scale-o-problems__solution-btn" href="{{ solution_url }}">
            {{ section.settings.solution_button_text | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if extra_count > 0 and section.settings.show_view_all -%}
  <script src="{{ 'scale-o-problems.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Hard Water Problems",
  "tag": "section",
  "class": "scale-o-problems-section",
  "max_blocks": 9,
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE PROBLEM" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hard Water Doesn't Just Affect Your Water" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Hard water can leave visible scale, affect everyday cleaning, and contribute to buildup across the fixtures and appliances in your home." },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "header", "content": "Bento grid" },
    { "type": "range", "id": "visible_cards", "label": "Cards to show initially", "min": 2, "max": 9, "step": 1, "default": 9 },
    { "type": "range", "id": "bento_row_height", "label": "Desktop row height", "min": 160, "max": 280, "step": 10, "unit": "px", "default": 210 },
    { "type": "range", "id": "bento_min_height_mobile", "label": "Mobile card height", "min": 220, "max": 360, "step": 10, "unit": "px", "default": 260 },
    { "type": "range", "id": "overlay_transition_ms", "label": "Hover transition", "min": 200, "max": 800, "step": 50, "unit": "ms", "default": 450 },
    { "type": "checkbox", "id": "show_card_description", "label": "Show card description on overlay", "default": false, "info": "Title always shows. Enable to also show the description text on hover/mobile." },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 0, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_x", "label": "Horizontal padding", "min": 12, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "margin_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "header_gap", "label": "Header bottom gap", "min": 16, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "header", "content": "View all" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View all problems", "default": false },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "View all problems" },
    { "type": "text", "id": "view_all_hide_text", "label": "Show fewer text", "default": "Show fewer problems" },
    { "type": "header", "content": "Solution transition" },
    { "type": "checkbox", "id": "show_solution", "label": "Show solution block", "default": true },
    { "type": "text", "id": "solution_eyebrow", "label": "Solution eyebrow", "default": "THE SOLUTION" },
    { "type": "text", "id": "solution_heading", "label": "Solution heading", "default": "There's a Better Way to Manage Hard Water" },
    { "type": "textarea", "id": "solution_description", "label": "Solution description", "default": "Scale-O is designed to help reduce scale-forming impact throughout your home's water system." },
    { "type": "text", "id": "solution_button_text", "label": "Solution button text", "default": "See How Scale-O Works" },
    { "type": "url", "id": "solution_button_url", "label": "Solution button link" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 10, "max": 16, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 24, "max": 48, "step": 1, "unit": "px", "default": 45 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 36, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "problem_title_size", "label": "Card title size", "min": 16, "max": 28, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_description_size", "label": "Card description size", "min": 12, "max": 18, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7FBFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1A2B4A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5A6B85" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "accent_hover_color", "label": "Accent hover", "default": "#0A6BC4" },
    { "type": "color", "id": "overlay_color", "label": "Card overlay color", "default": "#0C7FDF" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#E8EEF8" },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 8, "max": 28, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "shadow_strength", "label": "Shadow intensity", "min": 0, "max": 100, "step": 5, "default": 50 },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Hard water problems" }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem",
      "settings": [
        {
          "type": "select",
          "id": "bento_size",
          "label": "Bento size",
          "default": "auto",
          "info": "Auto uses a balanced layout based on total cards.",
          "options": [
            { "value": "auto", "label": "Auto" },
            { "value": "standard", "label": "Standard" },
            { "value": "wide", "label": "Wide" },
            { "value": "tall", "label": "Tall" },
            { "value": "large", "label": "Large" }
          ]
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "faucet",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "faucet", "label": "Faucet" },
            { "value": "shower", "label": "Shower" },
            { "value": "heater", "label": "Water heater" },
            { "value": "pipe", "label": "Pipe" },
            { "value": "floor", "label": "Floor / tiles" },
            { "value": "hair", "label": "Hair" },
            { "value": "skin", "label": "Skin" },
            { "value": "appliance", "label": "Appliance" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "glass", "label": "Glass" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. Uses the main image if empty." },
        { "type": "text", "id": "title", "label": "Title", "default": "Scale on Taps & Showers" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Mineral buildup can leave bathroom fixtures looking dull and make them harder to clean." },
        { "type": "text", "id": "cta_text", "label": "Optional link text" },
        { "type": "url", "id": "cta_url", "label": "Optional link URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hard Water Problems",
      "category": "Custom",
      "blocks": [
        { "type": "problem", "settings": { "icon": "hair", "title": "Hair Fall & Balding", "description": "Hard water can weaken hair and increase breakage over time." } },
        { "type": "problem", "settings": { "icon": "skin", "title": "Dry & Itchy Skin", "description": "Mineral residue can leave skin feeling dry and irritated." } },
        { "type": "problem", "settings": { "icon": "faucet", "title": "Scaling on Taps & Showers", "description": "White scale buildup makes fixtures harder to clean." } },
        { "type": "problem", "settings": { "icon": "droplet", "title": "Impure Water", "description": "Hard water can look cloudy and affect everyday use." } },
        { "type": "problem", "settings": { "icon": "floor", "title": "White Stains on Floors & Utensils", "description": "Minerals leave visible marks on tiles, glass and surfaces." } },
        { "type": "problem", "settings": { "icon": "pipe", "title": "Pipe Blockage & Reduced Waterflow", "description": "Scale buildup can restrict water flow inside plumbing." } },
        { "type": "problem", "settings": { "icon": "heater", "title": "Damage inside Water Heaters", "description": "Scale can reduce heater efficiency and lifespan." } },
        { "type": "problem", "settings": { "icon": "appliance", "title": "Damage in Washing Machines", "description": "Hard water can affect appliances and everyday cleaning." } }
      ]
    }
  ]
}
{% endschema %}
