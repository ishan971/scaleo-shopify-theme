        },
        {
          "type": "install_step",
          "settings": { "step_number": "2", "title": "Open the Overhead Tank", "description": "Access your overhead water tank safely before placing the unit." }
        },
        {
          "type": "install_step",
          "settings": { "step_number": "3", "title": "Place Scale-O Inside the Tank", "description": "Drop the compact Scale-O unit into the tank. No plumber or wiring needed." }
        },
        {
          "type": "install_step",
          "settings": { "step_number": "4", "title": "Close and Secure the Tank", "description": "Seal the tank properly so water flows normally through your home." }
        },
        {
