      "limit": 6,
      "settings": [
        { "type": "text", "id": "step_number", "label": "Step number", "default": "1" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "exchange",
          "options": [
            { "value": "exchange", "label": "Exchange" },
            { "value": "install", "label": "Install" },
            { "value": "tank", "label": "Tank" },
            { "value": "check", "label": "Check" },
            { "value": "power", "label": "Power off/on" },
            { "value": "none", "label": "None" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "Step image", "info": "If empty, uses theme file how-it-works-exchange-N.jpg" },
        { "type": "text", "id": "title", "label": "Title", "default": "Identify Your Scale-O Unit" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "category": "Custom",
      "blocks": [
        { "type": "usp_point", "settings": { "title": "Zero Electricity", "description": "Operates without electricity." } },
        { "type": "usp_point", "settings": { "title": "Zero Operating Cost", "description": "No ongoing electricity or operating expenses." } },
        { "type": "usp_point", "settings": { "title": "Zero Maintenance", "description": "Minimal to no maintenance required." } },
        { "type": "usp_point", "settings": { "title": "Zero Manpower", "description": "No dedicated manpower needed for operation." } },
        { "type": "usp_point", "settings": { "title": "Zero Plumbing", "description": "No plumbing connection required." } },
        { "type": "usp_point", "settings": { "title": "Zero Water Wastage", "description": "No water is wasted during the process." } },
        { "type": "usp_point", "settings": { "title": "Zero Salt", "description": "No salt or salt-based treatment required." } },
        {
          "type": "install_step",
          "settings": { "step_number": "1", "title": "Choose the Right Model", "description": "Pick Mini, Semi or Centi to match your overhead tank size and the water your household uses each day." }
