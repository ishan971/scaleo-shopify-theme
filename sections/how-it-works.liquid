        {
          "type": "install_step",
          "settings": { "step_number": "2", "title": "Open the Overhead Tank", "description": "Open the tank lid safely on the terrace and keep the opening clear before you place the Scale-O unit inside." }
        },
        {
          "type": "install_step",
          "settings": { "step_number": "3", "title": "Place Scale-O Inside the Tank", "description": "Lower the compact Scale-O unit into the tank. No plumber, wiring or plumbing changes are needed at all." }
        },
        {
          "type": "install_step",
          "settings": { "step_number": "4", "title": "Close and Secure the Tank", "description": "Close the lid firmly so the tank stays sealed and water can flow normally through every tap in the home." }
        },
        {
          "type": "install_step",
          "settings": { "step_number": "5", "title": "Start Using Scale-O", "description": "Use water as usual in the bathroom, kitchen and laundry while Scale-O helps reduce hard-water scale buildup." }
        },
        {
          "type": "exchange_step",
          "settings": { "step_number": "1", "title": "Identify Your Scale-O Unit", "description": "Check your current unit against its product life so you know when it is time for a simple Scale-O exchange." }
        },
        {
          "type": "exchange_step",
          "settings": { "step_number": "2", "title": "Turn Off the Water Supply", "description": "Stop the water supply to the overhead tank first, then wait until the flow settles before you open the lid." }
        },
