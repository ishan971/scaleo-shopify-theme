      "info": "One option per line. Used when a storefront filter is not set up. Match product tags exactly."
    },
    {
      "type": "checkbox",
      "id": "show_people_family_filter",
      "label": "Show People in Family filter",
      "default": true
    },
    {
      "type": "text",
      "id": "people_family_label",
      "label": "People in Family heading",
