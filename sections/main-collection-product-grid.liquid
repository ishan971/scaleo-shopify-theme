{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-product-inventory.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}
{%- if section.settings.enable_horizontal_filter_bar -%}
  {{ 'scale-o-collection-filters.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'scale-o-collection-filters.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if section.settings.use_scale_o_cards -%}
  {{ 'scale-o-product-grid.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
{%- if template.suffix == 'flash-sale' -%}
  <script src="{{ 'foxkit-flashsale-countdown.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'foxkit-flash-sale.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- liquid
  assign initial_column = section.settings.grid_columns
  if section.settings.grid_layout == 'list'
    assign initial_column = 1
  endif

  assign show_filter = section.settings.show_filter
  if section.settings.filters_type == 'storefront_filters' and collection.filters.size == 0
    if section.settings.show_daily_usage_filter != true and section.settings.show_people_family_filter != true
      assign show_filter = false
    endif
  endif
  if section.settings.filters_type == 'tags_filter' and section.blocks.size == 0
    assign show_filter = false
  endif

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign product_col_class = 'm:w-6/12 md:m:w-4/12'
  case section.settings.grid_columns
    when '2'
      assign product_col_class = 'm:w-6/12 lg:m:w-6/12'
    when '3'
      assign product_col_class = 'm:w-6/12 lg:m:w-4/12'
    when '4'
      assign product_col_class = 'm:w-6/12 lg:m:w-3/12'
    when '5'
      assign product_col_class = 'm:w-6/12 lg:m:w-1/5'
  endcase

  assign cols_desktop = section.settings.grid_columns | default: '3'
  assign cols_tablet = cols_desktop
  assign cols_mobile = cols_desktop
  if section.settings.use_scale_o_cards
    assign cols_mobile = '1'
    case cols_desktop
      when '5', '4'
        assign cols_tablet = '3'
      when '3'
        assign cols_tablet = '3'
      when '2'
        assign cols_tablet = '2'
    endcase
    assign product_col_class = ''
  endif

  assign collection_products_class = 'm-collection-products m:flex m:flex-wrap m-cols-' | append: initial_column
  if section.settings.use_scale_o_cards and section.settings.grid_layout != 'list'
    assign collection_products_class = 'm-collection-products m-cols-' | append: initial_column | append: ' scale-o-collection-products'
  endif
-%}

<section
  class="facest-filters-section{% if section.settings.enable_horizontal_filter_bar %} scale-o-filters{% endif %}"
  data-section-type="collection-template"
  data-section-id="{{ section.id }}"
  data-filters-type="{{ section.settings.filters_type }}"
  data-filters-position="{{ section.settings.sidebar }}"
  data-enable-filters="{{ section.settings.show_filter }}"
  data-enable-sorting="{{ section.settings.show_sorting }}"
  data-show-col-switchers="{{ section.settings.show_columns_switcher }}"
  data-pagination-type="{{ section.settings.paginate_type }}"
  data-product-count="{{ collection.products.size }}"
  data-initial-column="{{ initial_column }}"
  data-view="{{ template.name }}"
  {% if section.settings.use_scale_o_cards %}data-scale-o-grid="true"{% endif %}
  style="
    --sof-bg: {{ section.settings.filter_bar_background | default: '#ffffff' }};
    --sof-text: {{ section.settings.filter_bar_text | default: '#0b1b2e' }};
    --sof-accent: {{ section.settings.filter_bar_accent | default: '#0C7FDF' }};
    --sof-border: {{ section.settings.filter_bar_border | default: '#e6edf4' }};
    --sof-radius: {{ section.settings.filter_bar_radius | default: 12 }}px;
    --spg-cols-desktop: {{ cols_desktop }};
    --spg-cols-tablet: {{ cols_tablet }};
    --spg-cols-mobile: {{ cols_mobile }};
    --spg-gap: {{ section.settings.card_gap | default: 20 }}px;
    --spg-gap-mobile: {{ section.settings.card_gap_mobile | default: 12 }}px;
    --spg-accent: #0C7FDF;
    --spg-title-color: #1A2B4A;
    --spg-title-size: 15px;
    --spg-price-color: #0C7FDF;
    --spg-price-size: 20px;
    --spg-compare-color: #8A97AB;
    --spg-discount-color: #22A06B;
    --spg-spec-background: #EEF6FF;
    --spg-spec-text-color: #1A2B4A;
    --spg-spec-border-color: #C5DFFA;
    --spg-spec-icon-color: #0C7FDF;
    --spg-spec-size: 12px;
    --spg-card-bg: #ffffff;
    --spg-card-border: #E8EEF8;
    --spg-image-bg: #F5F7FF;
    --spg-button-bg: #0C7FDF;
    --spg-button-bg-hover: #0A6BC4;
    --spg-button-text: #ffffff;
    --spg-button-size: 15px;
    --spg-image-ratio: 4 / 3;
    --spg-image-padding: 10px;
    --spg-card-radius: 16px;
    --spg-card-shadow: 0 4px 16px rgba(26, 43, 74, 0.06);
    --spg-card-shadow-hover: 0 8px 24px rgba(26, 43, 74, 0.1);
    --spg-badge-sale-bg: #1A2B4A;
    --spg-badge-sale-text: #ffffff;
    --spg-badge-best-bg: #22A06B;
    --spg-badge-best-text: #ffffff;
    --spg-badge-affordable-bg: #F5B800;
    --spg-badge-affordable-text: #1A2B4A;
    --spg-badge-popular-bg: #0C7FDF;
    --spg-badge-popular-text: #ffffff;
    --spg-badge-new-bg: #0C7FDF;
    --spg-badge-new-text: #ffffff;
  "
>
  <div class="{{ container }}">
    <div class="m-collection--wrapper {% if section.settings.show_filter %}m-sidebar--{{ section.settings.sidebar }}{% endif %}">
      {%- if section.settings.enable_horizontal_filter_bar -%}
        <div class="scale-o-filter-bar">
          {%- if section.settings.show_collection_count -%}
            <p class="scale-o-filter-bar__results">
              <span class="scale-o-filter-bar__results-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.5"/>
                  <rect x="9" y="1.5" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.5"/>
                  <rect x="1.5" y="9" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.5"/>
                  <rect x="9" y="9" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.5"/>
                </svg>
              </span>
              <span class="scale-o-filter-bar__results-text">
                {{ 'collections.general.items_count' | t: count: collection.products_count }}
              </span>
            </p>
          {%- endif -%}
          {%- if section.settings.show_filter -%}
            <button
              class="m-sidebar--open scale-o-filter-bar__open"
              type="button"
            >
              {%- if section.settings.show_filter_icon -%}
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M2 4h12M4 8h8M6 12h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              {%- endif -%}
              <span>Filter</span>
              {%- assign so_filter_count = 0 -%}
              {%- for filter in collection.filters -%}
                {%- assign so_filter_count = so_filter_count | plus: filter.active_values.size -%}
                {%- if filter.type == 'price_range' and section.settings.show_price_filter -%}
                  {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                    {%- assign so_filter_count = so_filter_count | plus: 1 -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if section.settings.show_active_filter_count and so_filter_count > 0 -%}
                <span class="scale-o-filter-bar__count">{{ so_filter_count }}</span>
              {%- endif -%}
            </button>
          {%- endif -%}
          {%- render 'collection-sidebar',
            show_filter: show_filter,
            animated: animated,
            animation_effect: animation_effect
          -%}
          {%- if section.settings.show_filter and section.settings.show_clear_all -%}
            {%- assign so_has_filter = false -%}
            {%- for filter in collection.filters -%}
              {%- if filter.active_values.size > 0 -%}
                {%- assign so_has_filter = true -%}
              {%- endif -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                  {%- assign so_has_filter = true -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if so_has_filter -%}
              <a class="scale-o-filter-bar__clear" href="{{ collection.url }}">{{ 'collections.sidebar.clear_all' | t }}</a>
            {%- endif -%}
          {%- endif -%}
          {%- render 'collection-page-toolbar',
            section: section,
            results: collection,
            animated: animated,
            animation_effect: animation_effect
          -%}
        </div>
      {%- else -%}
        {%- render 'collection-sidebar',
          show_filter: show_filter,
          animated: animated,
          animation_effect: animation_effect
        -%}
      {%- endif -%}
      <div id="CollectionProductGrid" class="m:flex-1" data-collection-id="{{ collection.id }}">
        {%- if section.settings.use_scale_o_cards and section.settings.show_grid_heading -%}
          <header class="scale-o-collection-header">
            {%- if section.settings.grid_eyebrow != blank -%}
              <p class="scale-o-product-grid__eyebrow">{{ section.settings.grid_eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.grid_heading != blank -%}
              <h2 class="scale-o-product-grid__heading">{{ section.settings.grid_heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.grid_description != blank -%}
              <p class="scale-o-product-grid__description">{{ section.settings.grid_description | escape }}</p>
            {%- endif -%}
          </header>
        {%- endif -%}
        {%- unless section.settings.enable_horizontal_filter_bar -%}
          {%- render 'collection-page-toolbar',
            section: section,
            results: collection,
            animated: animated,
            animation_effect: animation_effect
          -%}
        {%- endunless -%}
        {%- liquid
          if section.settings.show_filter
            if section.settings.filters_type == 'storefront_filters'
              render 'collection-filters-facets', results: collection, animated: animated, animation_effect: animation_effect
            else
              render 'selected-tags-filter', animated: animated, animation_effect: animation_effect
            endif
          endif
        -%}
        {%- paginate collection.products by section.settings.pagination_limit -%}
          {%- if collection.products.size == 0 -%}
            <div class="m-collection--empty m:flex m:flex-col m:w-full m:items-center">
              <span>{%- render 'icon', name: 'empty-collection', fill: '#9a9a9a' -%}</span>
              <p class="m-collection--empty-text">{{ 'collections.general.no_matches' | t }}</p>
            </div>
          {%- else -%}
            <div
              class="{{ collection_products_class }}"
              data-total-pages="{{ paginate.pages }}"
              data-product-container
            >
              {%- for product in collection.products -%}
                <div class="m-product-item {{ product_col_class }}">
                  {% liquid
                    if section.settings.use_scale_o_cards and section.settings.grid_layout != 'list'
                      render 'scale-o-product-card', product: product, section: section, card_index: forloop.index
                    else
                      case settings.pcard_layout
                        when '1'
                          render 'product-card-1', product: product, section: section, index: forloop.index, animated: animated, animation_effect: animation_effect
                        when '2'
                          render 'product-card-2', product: product, section: section, index: forloop.index, animated: animated, animation_effect: animation_effect
                        when '3'
                          render 'product-card-3', product: product, section: section, index: forloop.index, animated: animated, animation_effect: animation_effect
                        when '4'
                          render 'product-card-4', product: product, section: section, index: forloop.index, animated: animated, animation_effect: animation_effect
                        when '5'
                          render 'product-card-5', product: product, section: section, index: forloop.index, animated: animated, animation_effect: animation_effect
                      endcase
                    endif
                  %}
                </div>
              {%- endfor -%}
            </div>
            {% if paginate.pages > 1 %}
              <div class="m-collection--pagination m:text-center{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
                {%- if section.settings.paginate_type == 'paginate' -%}
                  {%- render 'pagination', paginate: paginate, anchor: '' -%}
                {%- else -%}
                  <button class="m-button m-button--primary m-spinner-button" data-load-more>
                    <span>
                      {%- render 'new-locale', key: 'collections.paginate.load_more' -%}
                    </span>
                    <span class="m-spinner-icon">
                      <svg
                        class="animate-spin m-svg-icon--medium"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                      >
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                      </svg>
                    </span>
                  </button>
                {%- endif -%}
              </div>
            {% endif %}
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
  {% if section.settings.show_sorting %}
    {%- render 'sort-by-mobile', results: collection -%}
  {% endif %}
</section>
<script>
  window.addEventListener('load', () => {
    if (typeof Collection !== 'undefined') {
      MinimogTheme.Collection = new Collection();
      MinimogTheme.Collection.init();
    }
  });
  if (Shopify.designMode) {
    document.addEventListener('shopify:section:load', function (event) {
      MinimogTheme.Collection.init();
    });
  }
</script>
{% schema %}
{
  "name": "Product listing",
  "settings": [
    {
      "type": "paragraph",
      "content": "[Watch tutorial](https://foxecom.link/zHcHV5) or [read How-to](https://foxecom.link/CDVgnM)"
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default"
        },
        {
          "value": "container-full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Use container box"
        }
      ]
    },
    {
      "type": "header",
      "content": "layout"
    },
    {
      "type": "radio",
      "id": "grid_layout",
      "label": "Default layout",
      "options": [
        {
          "label": "List",
          "value": "list"
        },
        {
          "label": "Grid",
          "value": "grid"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "grid_columns",
      "label": "Products per row in Grid layout",
      "info": "For devices with screen width greater than 1024px",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Scale-O product cards"
    },
    {
      "type": "checkbox",
      "id": "use_scale_o_cards",
      "label": "Use homepage Shop by Products cards",
      "default": true,
      "info": "Makes every card the same size with specs, price, and Shop Now."
    },
    {
      "type": "checkbox",
      "id": "show_grid_heading",
      "label": "Show products heading",
      "default": false
    },
    {
      "type": "text",
      "id": "grid_eyebrow",
      "label": "Eyebrow",
      "default": "PRODUCTS"
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Heading",
      "default": "Shop by Products"
    },
    {
      "type": "textarea",
      "id": "grid_description",
      "label": "Description",
      "default": "Choose the perfect Scale-O Water Softener for your home."
    },
    {
      "type": "checkbox",
      "id": "show_shop_now_button",
      "label": "Show Shop Now button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Shop Now button text",
      "default": "Shop Now"
    },
    {
      "type": "checkbox",
      "id": "show_specifications",
      "label": "Show specification pills",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_spec_icons",
      "label": "Show specification icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show sale and product badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare_at_price",
      "label": "Show compare-at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discount",
