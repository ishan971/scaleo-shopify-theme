<style>
  /* Marquee Container */
  .marquee {
    width: 100%; /* Full width */
    overflow: hidden;
    white-space: nowrap;
    box-sizing: border-box;
    padding: 10px 0;
  }

  .marquee-inner {
    display: flex;
    gap: 30px;
    width: fit-content; /* Makes the content width dynamic */
    animation: marquee {{ section.settings.marquee_speed }}s linear infinite;
  }

  .marquee-inner:hover {
    animation-play-state: paused;
  }

  /* Marquee Content */
  .marquee-content {
    display: flex;
    gap: 30px; /* Spacing between logos */
  }

  .marquee-slide {
    padding: 0 20px;
    display: block;
  }

  .marquee-content a{
    display: flex;
  }
  
  /* Marquee Animation */
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%); /* Moves halfway since content is duplicated */
    }
  }
</style>  
<div class="section--padding" style="background:{{ section.settings.background_color }};color:{{ section.settings.color }}">
  <div class="marquee">
    <div class="marquee-inner">
      {% for i in (1..2) %}
        <div class="marquee-content">
          {% for block in section.blocks %}
            {% if block.settings.link != blank %}<a class="marquee-slide" href="{{ block.settings.link }}">{% else %}<div class="marquee-slide">{% endif %}
              {{ block.settings.text }}
            {% if block.settings.link != blank %}</a>{% else %}</div>{% endif %} 
          {% endfor %}  
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Marquee Slider",
    "settings": [
      {
        "type": "range",
        "id": "marquee_speed",
        "label": "Marquee Speed",
        "max": 50,
        "min": 5,
        "step": 5,
        "unit": "s",
        "default": 20
      },
      {
        "type": "range",
        "id": "image_width",
        "label": "Image Width",
        "max": 500,
        "min": 200,
        "step": 10,
        "unit": "px",
        "default": 300
      },
      {
        "type": "color",
        "id": "color",
        "label": "Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#000000"
      }
    ],
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "settings": [
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Text"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Marquee Slider"
      }
    ]
  }
{% endschema %}