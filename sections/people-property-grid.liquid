{%- comment -%}
  Scale-O People & Property — no tabs, no hero, 8-card grid (4 + 4)
{%- endcomment -%}

{{ 'scale-o-advantages-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign header_align = section.settings.header_alignment
  assign show_header = false
  if section.settings.heading != blank
    assign show_header = true
  endif
  if section.settings.show_eyebrow and section.settings.eyebrow != blank
    assign show_header = true
  endif
  if section.settings.show_description and section.settings.description != blank
    assign show_header = true
  endif

  assign people_label = section.settings.people_label | default: 'For People'
  assign property_label = section.settings.property_label | default: 'For Property'
  assign card_count = 0
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-adv-grid {
    --sag-bg: {{ section.settings.background_color }};
    --sag-heading: {{ section.settings.heading_color }};
    --sag-text: {{ section.settings.text_color }};
    --sag-accent: {{ section.settings.accent_color }};
    --sag-card-bg: {{ section.settings.card_background }};
    --sag-border: {{ section.settings.card_border_color }};
    --sag-radius: {{ section.settings.card_radius }}px;
    --sag-gap: {{ section.settings.card_gap }}px;
    --sag-ratio: {{ section.settings.card_aspect_ratio }};
    --sag-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --sag-heading-size: {{ section.settings.heading_size_mobile }}px;
    --sag-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --sag-desc-size: {{ section.settings.description_size }}px;
    --sag-card-title: {{ section.settings.card_title_size }}px;
    --sag-card-desc: {{ section.settings.card_description_size }}px;
    --sag-pad-x: {{ section.settings.padding_x }}px;
    --sag-header-gap: {{ section.settings.header_gap }}px;
    --sag-header-align: {{ header_align }};
    --sag-max-width: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --sag-shadow: {% if section.settings.show_card_shadow %}0 8px 22px rgba(20, 43, 74, 0.07){% else %}none{% endif %};
    --sag-shadow-hover: {% if section.settings.show_card_shadow %}0 12px 28px rgba(20, 43, 74, 0.11){% else %}none{% endif %};
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: var(--sag-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-adv-grid {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<div
  class="scale-o-adv-grid"
  data-section-id="{{ section.id }}"
  data-animate="{% if section.settings.enable_animations %}true{% else %}false{% endif %}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Why Scale-O people and property benefits' | escape }}"
>
  <div class="scale-o-adv-grid__container">
    {%- if show_header -%}
      <header class="scale-o-adv-grid__header scale-o-adv-grid__header--{{ header_align }}" data-sag-animate>
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
          <p class="scale-o-adv-grid__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="scale-o-adv-grid__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.show_description and section.settings.description != blank -%}
          <p class="scale-o-adv-grid__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
        {%- if section.settings.show_legend -%}
          <p class="scale-o-adv-grid__legend" aria-hidden="true">
            <span class="scale-o-adv-grid__pill scale-o-adv-grid__pill--people">
              <span class="scale-o-adv-grid__pill-dot"></span>
              {{ people_label | escape }}
            </span>
            <span class="scale-o-adv-grid__pill scale-o-adv-grid__pill--property">
              <span class="scale-o-adv-grid__pill-dot"></span>
              {{ property_label | escape }}
            </span>
          </p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if benefit_blocks.size > 0 -%}
      <ul class="scale-o-adv-grid__grid" role="list">
        {%- comment -%} People first (max 4), then Property (max 4) {%- endcomment -%}
        {%- assign people_shown = 0 -%}
        {%- assign property_shown = 0 -%}

        {%- for block in benefit_blocks -%}
          {%- if block.settings.category == 'people' and people_shown < 4 -%}
            {%- assign people_shown = people_shown | plus: 1 -%}
            {%- assign card_count = card_count | plus: 1 -%}
            {%- render 'people-property-grid-card',
              block: block,
              category_label: people_label,
              fallback_index: people_shown,
              show_tag: section.settings.show_card_category
            -%}
          {%- endif -%}
        {%- endfor -%}

        {%- for block in benefit_blocks -%}
          {%- if block.settings.category == 'property' and property_shown < 4 -%}
            {%- assign property_shown = property_shown | plus: 1 -%}
            {%- assign card_count = card_count | plus: 1 -%}
            {%- render 'people-property-grid-card',
              block: block,
              category_label: property_label,
              fallback_index: property_shown,
              show_tag: section.settings.show_card_category
            -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="scale-o-adv-grid__empty">Add up to 4 People and 4 Property benefits in the theme editor.</p>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.enable_animations -%}
  <script src="{{ 'scale-o-advantages-grid.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "People & Property Grid",
  "tag": "section",
  "class": "scale-o-adv-grid-section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY SCALE-O" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "People & Property" },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Discover how Scale-O helps protect your everyday water experience and your home." },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "checkbox", "id": "show_legend", "label": "Show For People / For Property legend", "default": true },
    { "type": "text", "id": "people_label", "label": "People label", "default": "For People" },
    { "type": "text", "id": "property_label", "label": "Property label", "default": "For Property" },
    { "type": "checkbox", "id": "show_card_category", "label": "Show category tag on cards", "default": true },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 960, "max": 1400, "step": 20, "unit": "px", "default": 1200 },
    {
      "type": "select",
      "id": "card_aspect_ratio",
      "label": "Image ratio",
      "default": "16 / 10",
      "options": [
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "16 / 10", "label": "Wide (16:10)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ]
    },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 28, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "card_radius", "label": "Corner radius", "min": 8, "max": 24, "step": 2, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_card_shadow", "label": "Show card shadow", "default": true },
    { "type": "checkbox", "id": "enable_animations", "label": "Enable reveal animations", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 72, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 72, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_x", "label": "Horizontal padding", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "margin_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "header_gap", "label": "Header bottom gap", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 28 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 28, "max": 52, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 22, "max": 36, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 13, "max": 18, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_title_size", "label": "Card title size", "min": 14, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_description_size", "label": "Card description size", "min": 12, "max": 16, "step": 1, "unit": "px", "default": 13 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1A2B4A" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#465568" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#E8EEF8" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Why Scale-O people and property benefits" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "default": "people",
          "options": [
            { "value": "people", "label": "For People" },
            { "value": "property", "label": "For Property" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "short_label", "label": "Optional short label" },
        { "type": "text", "id": "title", "label": "Title", "default": "Better Shower Experience" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Help reduce visible hard-water scale around everyday bathroom fixtures." },
        { "type": "text", "id": "cta_text", "label": "Optional CTA text" },
        { "type": "url", "id": "link", "label": "Optional link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "People & Property Grid",
      "category": "Custom",
      "blocks": [
        { "type": "benefit", "settings": { "category": "people", "title": "Better Shower Experience", "description": "Help reduce visible hard-water scale around everyday bathroom fixtures." } },
        { "type": "benefit", "settings": { "category": "people", "title": "Softer-Feeling Laundry", "description": "Better water for everyday washing and household laundry." } },
        { "type": "benefit", "settings": { "category": "people", "title": "Cleaner-Looking Fixtures", "description": "Help reduce visible mineral deposits around taps and showers." } },
        { "type": "benefit", "settings": { "category": "people", "title": "Better Everyday Water Experience", "description": "A simple salt-free approach to managing hard-water scale throughout the home." } },
        { "type": "benefit", "settings": { "category": "property", "title": "Helps Reduce Scale Buildup", "description": "Helps manage mineral scale buildup on water-contact surfaces." } },
        { "type": "benefit", "settings": { "category": "property", "title": "Protect Water-Using Appliances", "description": "Helps reduce the impact of scale buildup in appliances that use water." } },
        { "type": "benefit", "settings": { "category": "property", "title": "Lower Maintenance Burden", "description": "Less visible buildup can mean less frequent cleaning and maintenance." } },
        { "type": "benefit", "settings": { "category": "property", "title": "Protect Everyday Fixtures", "description": "Help keep taps, shower fittings and other water-contact fixtures looking cleaner." } }
      ]
    }
  ]
}
{% endschema %}
