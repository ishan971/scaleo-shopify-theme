{%- comment -%}
  Scale-O about values — mission image + editable value cards.
{%- endcomment -%}

{{ 'scale-o-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign header_align = section.settings.header_alignment | default: 'left'
  assign media_alt = section.settings.image_alt | default: section.settings.heading
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-about {
    --soa-bg: {{ section.settings.background_color }};
    --soa-heading: {{ section.settings.heading_color }};
    --soa-text: {{ section.settings.text_color }};
    --soa-accent: {{ section.settings.accent_color }};
    --soa-card-bg: {{ section.settings.card_background }};
    --soa-border: {{ section.settings.border_color }};
    --soa-radius: {{ section.settings.card_radius }}px;
    --soa-pad-x: {{ section.settings.padding_x }}px;
    --soa-header-gap: {{ section.settings.header_gap }}px;
    --soa-header-align: {{ header_align }};
    --soa-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --soa-heading-size: {{ section.settings.heading_size_mobile }}px;
    --soa-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --soa-desc-size: {{ section.settings.description_size }}px;
    --soa-max: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --soa-shadow: {% if section.settings.show_card_shadow %}0 10px 28px rgba(16, 42, 67, 0.06){% else %}none{% endif %};
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: var(--soa-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-about {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<section
  class="scale-o-about"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Our mission' | escape }}"
>
  <div class="scale-o-about__container">
    <div class="scale-o-about__values">
      {%- if section.settings.image != blank -%}
        <div class="scale-o-about__media">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200',
              sizes: '(max-width: 767px) 100vw, 45vw',
              alt: media_alt
          }}
        </div>
      {%- endif -%}

      <div>
        <header class="scale-o-about__header{% if header_align == 'left' %} scale-o-about__header--left{% endif %}">
          {%- if section.settings.eyebrow != blank -%}
            <p class="scale-o-about__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="scale-o-about__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <p class="scale-o-about__lede">{{ section.settings.description | escape }}</p>
          {%- endif -%}
        </header>

        <ul class="scale-o-about__value-list">
          {%- for block in section.blocks -%}
            {%- if block.type != 'value' or block.settings.enabled == false -%}
              {%- continue -%}
            {%- endif -%}
            <li class="scale-o-about__value" {{ block.shopify_attributes }}>
              <span class="scale-o-about__value-icon" aria-hidden="true">
                {%- if block.settings.icon != blank -%}
                  {{
                    block.settings.icon
                    | image_url: width: 96
                    | image_tag: loading: 'lazy', widths: '48, 72, 96', alt: ''
                  }}
                {%- else -%}
                  <svg viewBox="0 0 16 16" width="18" height="18" fill="none">
                    <path d="M3.5 8.2 6.4 11.2 12.5 4.8" stroke="#0C7FDF" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              </span>
              <div>
                {%- if block.settings.title != blank -%}
                  <h3 class="scale-o-about__value-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="scale-o-about__value-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Scale-O about values",
  "tag": "section",
  "class": "scale-o-about-section",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Tag", "default": "Our mission" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Salt-free water softeners for Indian homes" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Scale-O is built around simple overhead-tank installation, no salt refill, and no electricity."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Side image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 900, "max": 1400, "step": 20, "unit": "px", "default": 1180 },
    { "type": "range", "id": "padding_x", "label": "Side padding", "min": 12, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "header_gap", "label": "Header bottom gap", "min": 16, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 24, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 24, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "eyebrow_size", "label": "Tag size", "min": 11, "max": 16, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 24, "max": 48, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 22, "max": 36, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "description_size", "label": "Text size", "min": 14, "max": 18, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "Image radius", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_card_shadow", "label": "Show card shadow", "default": true },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7FBFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#102A43" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#465568" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Card border", "default": "#DCEAF5" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Our mission" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Show this value", "default": true },
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Creativity" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Scale-O uses salt-free chelation in the overhead tank, so homes get softer water without salt bags or a plumber."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scale-O about values",
      "blocks": [
        { "type": "value" },
        { "type": "value", "settings": { "title": "Sustainability" } },
        { "type": "value", "settings": { "title": "Affordability" } }
      ]
    }
  ]
}
{% endschema %}
