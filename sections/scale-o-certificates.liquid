{%- comment -%}
  Scale-O Certifications & Quality — certificate gallery with lightbox
{%- endcomment -%}

{{ 'scale-o-certificates.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cert_blocks = section.blocks | where: 'type', 'certificate'
  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign header_align = section.settings.header_alignment

  assign show_header = false
  if section.settings.heading != blank
    assign show_header = true
  endif
  if section.settings.show_eyebrow and section.settings.eyebrow != blank
    assign show_header = true
  endif
  if section.settings.show_description and section.settings.description != blank
    assign show_header = true
  endif

  assign show_banner = false
  if section.settings.show_banner
    if section.settings.banner_heading != blank or section.settings.banner_text != blank
      assign show_banner = true
    endif
    if section.settings.show_cta and section.settings.cta_text != blank
      assign show_banner = true
    endif
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-cert {
    --soc-bg: {{ section.settings.background_color }};
    --soc-heading: {{ section.settings.heading_color }};
    --soc-text: {{ section.settings.text_color }};
    --soc-accent: {{ section.settings.accent_color }};
    --soc-accent-hover: {{ section.settings.accent_hover_color }};
    --soc-card-bg: {{ section.settings.card_background }};
    --soc-card-border: {{ section.settings.card_border_color }};
    --soc-banner-bg: {{ section.settings.banner_background }};
    --soc-radius: {{ section.settings.card_radius }}px;
    --soc-gap: {{ section.settings.card_spacing }}px;
    --soc-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --soc-heading-size: {{ section.settings.heading_size_mobile }}px;
    --soc-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --soc-desc-size: {{ section.settings.description_size }}px;
    --soc-pad-x: {{ section.settings.padding_x }}px;
    --soc-header-gap: {{ section.settings.header_gap }}px;
    --soc-header-align: {{ header_align }};
    --soc-max-width: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --soc-desktop-cards: {{ section.settings.desktop_cards }};
    --soc-tablet-cards: {{ section.settings.tablet_cards }};
    --soc-ratio: {{ section.settings.image_ratio }};
    --soc-shadow: {% if section.settings.show_card_shadow %}0 12px 30px rgba(20, 43, 74, 0.12){% else %}none{% endif %};
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: var(--soc-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-cert {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<div
  class="scale-o-cert{% unless section.settings.enable_carousel %} is-grid{% endunless %}"
  data-section-id="{{ section.id }}"
  data-carousel="{% if section.settings.enable_carousel %}true{% else %}false{% endif %}"
  data-lightbox="{% if section.settings.enable_lightbox %}true{% else %}false{% endif %}"
  data-desktop-cards="{{ section.settings.desktop_cards }}"
  data-tablet-cards="{{ section.settings.tablet_cards }}"
  data-animate="{% if section.settings.enable_animations %}true{% else %}false{% endif %}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Certifications and quality' | escape }}"
>
  <div class="scale-o-cert__container">
    {%- if show_header -%}
      <header class="scale-o-cert__header scale-o-cert__header--{{ header_align }}" data-soc-animate>
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
          <p class="scale-o-cert__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="scale-o-cert__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.show_description and section.settings.description != blank -%}
          <p class="scale-o-cert__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if cert_blocks.size > 0 -%}
      <div class="scale-o-cert__stage" data-soc-animate>
        {%- if section.settings.enable_carousel and section.settings.show_arrows -%}
          <button class="scale-o-cert__nav scale-o-cert__nav--prev" type="button" data-soc-prev aria-label="Previous certificates">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}

        <div class="scale-o-cert__viewport" data-soc-viewport>
          <div class="scale-o-cert__track" data-soc-track>
            {%- for block in cert_blocks -%}
              {%- if block.settings.enabled == false -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign cert_image = block.settings.image
                assign cert_link = block.settings.image_url
                assign cert_alt = block.settings.image_alt | default: block.settings.title | default: 'Certificate'
                assign preview_src = ''
                assign full_src = ''
                if cert_link != blank
                  assign preview_src = cert_link
                  assign full_src = cert_link
                elsif cert_image != blank
                  assign preview_src = cert_image | image_url: width: 900
                  assign full_src = cert_image | image_url: width: 2000
                endif
                assign has_preview = false
                if preview_src != blank
                  assign has_preview = true
                endif
                assign button_label = block.settings.button_text
              -%}
              <article
                class="scale-o-cert__card"
                data-soc-card
                data-full-src="{{ full_src | escape }}"
                data-full-alt="{{ cert_alt | escape }}"
                data-full-title="{{ block.settings.title | escape }}"
                {{ block.shopify_attributes }}
              >
                <button
                  class="scale-o-cert__preview"
                  type="button"
                  data-soc-open
                  {% if has_preview == false or section.settings.enable_lightbox == false %}disabled{% endif %}
                  aria-label="{% if block.settings.title != blank %}View {{ block.settings.title | escape }}{% else %}View certificate{% endif %}"
                >
                  {%- if preview_src != blank -%}
                    <img
                      src="{{ preview_src | escape }}"
                      alt="{{ cert_alt | escape }}"
                      width="800"
                      height="600"
                      loading="lazy"
                    >
                  {%- else -%}
                    <span class="scale-o-cert__preview-fallback" aria-hidden="true"></span>
                  {%- endif -%}
                </button>

                <div class="scale-o-cert__body">
                  {%- if block.settings.title != blank -%}
                    <h3 class="scale-o-cert__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}

                  {%- if button_label != blank -%}
                    {%- if block.settings.button_url != blank -%}
                      <a class="scale-o-cert__view" href="{{ block.settings.button_url }}">
                        <span>{{ button_label | escape }}</span>
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </a>
                    {%- else -%}
                      <button class="scale-o-cert__view" type="button" data-soc-open {% if has_preview == false or section.settings.enable_lightbox == false %}disabled{% endif %}>
                        <span>{{ button_label | escape }}</span>
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </button>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.settings.enable_carousel and section.settings.show_arrows -%}
          <button class="scale-o-cert__nav scale-o-cert__nav--next" type="button" data-soc-next aria-label="Next certificates">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}
      </div>

      {%- if section.settings.enable_carousel and section.settings.show_dots -%}
        <div class="scale-o-cert__dots" data-soc-dots role="tablist" aria-label="Certificate pagination"></div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.show_trust and trust_blocks.size > 0 -%}
      <ul class="scale-o-cert__trust" data-soc-animate>
        {%- for block in trust_blocks -%}
          <li class="scale-o-cert__trust-item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
              <span class="scale-o-cert__trust-icon" aria-hidden="true">
                {% render 'scale-o-cert-icon', icon: block.settings.icon %}
              </span>
            {%- endif -%}
            <div>
              {%- if block.settings.title != blank -%}
                <p class="scale-o-cert__trust-title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="scale-o-cert__trust-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if show_banner -%}
      <div class="scale-o-cert__banner" data-soc-animate>
        <div class="scale-o-cert__banner-main">
          <span class="scale-o-cert__banner-icon" aria-hidden="true">
            {% render 'scale-o-cert-icon', icon: section.settings.banner_icon %}
          </span>
          <div>
            {%- if section.settings.banner_heading != blank -%}
              <p class="scale-o-cert__banner-heading">{{ section.settings.banner_heading | escape }}</p>
            {%- endif -%}
            {%- if section.settings.banner_text != blank -%}
              <p class="scale-o-cert__banner-text">{{ section.settings.banner_text | escape }}</p>
            {%- endif -%}
          </div>
        </div>
        {%- if section.settings.show_cta and section.settings.cta_text != blank -%}
          <a class="scale-o-cert__cta" href="{{ section.settings.cta_url | default: '#' }}">
            <span>{{ section.settings.cta_text | escape }}</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.enable_lightbox -%}
    <div class="scale-o-cert__lightbox" data-soc-lightbox hidden>
      <div class="scale-o-cert__lightbox-dialog" role="dialog" aria-modal="true" aria-label="Certificate preview">
        <button class="scale-o-cert__lightbox-close" type="button" data-soc-lightbox-close aria-label="Close certificate preview">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 4l8 8M12 4 4 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
        <button class="scale-o-cert__lightbox-nav scale-o-cert__lightbox-nav--prev" type="button" data-soc-lightbox-prev aria-label="Previous certificate">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="scale-o-cert__lightbox-frame">
          <img data-soc-lightbox-img alt="">
        </div>
        <button class="scale-o-cert__lightbox-nav scale-o-cert__lightbox-nav--next" type="button" data-soc-lightbox-next aria-label="Next certificate">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <p class="scale-o-cert__lightbox-caption" data-soc-lightbox-caption></p>
      </div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'scale-o-certificates.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Certifications & Quality",
  "tag": "section",
  "class": "scale-o-cert-section",
  "max_blocks": 20,
  "settings": [
    { "type": "header", "content": "How to edit" },
    { "type": "paragraph", "content": "Add Certificate blocks for each document. Upload the image, then set the title and optional description. Clicking a card opens a larger preview. Add Trust item blocks for the row under the gallery." },

    { "type": "header", "content": "Heading" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CERTIFICATIONS & QUALITY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built on Tested Quality & Innovation" },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Every Scale-O product is backed by documented testing, intellectual property and quality standards designed to deliver reliable hard-water scale protection." },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },

    { "type": "header", "content": "Gallery" },
    { "type": "range", "id": "desktop_cards", "label": "Cards on desktop", "min": 2, "max": 5, "step": 1, "default": 5 },
    { "type": "range", "id": "tablet_cards", "label": "Cards on tablet", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "checkbox", "id": "enable_carousel", "label": "Enable carousel", "default": true, "info": "Turn off to wrap cards in a grid." },
    { "type": "checkbox", "id": "show_arrows", "label": "Show navigation arrows", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show pagination dots", "default": true },
    { "type": "checkbox", "id": "enable_lightbox", "label": "Open certificates in a preview", "default": true },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Certificate preview ratio",
      "default": "4 / 3",
      "options": [
        { "value": "4 / 3", "label": "Landscape 4:3" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "4 / 5", "label": "Portrait 4:5" }
      ]
    },

    { "type": "header", "content": "Trust row & banner" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust items", "default": false },
    { "type": "checkbox", "id": "show_banner", "label": "Show trust banner", "default": false },
    {
      "type": "select",
      "id": "banner_icon",
      "label": "Banner icon",
      "default": "check-shield",
      "options": [
        { "value": "check-shield", "label": "Shield with check" },
        { "value": "shield", "label": "Shield" },
        { "value": "document", "label": "Document" },
        { "value": "ribbon", "label": "Ribbon" }
      ]
    },
    { "type": "text", "id": "banner_heading", "label": "Banner heading", "default": "Certified technology you can trust." },
    { "type": "textarea", "id": "banner_text", "label": "Banner text", "default": "Scale-O is supported by patents, lab tests and quality certifications." },
    { "type": "checkbox", "id": "show_cta", "label": "Show CTA button", "default": false },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Explore Scale-O Technology" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 0, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 8, "max": 28, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_spacing", "label": "Card spacing", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_card_shadow", "label": "Show card shadow", "default": true },
    { "type": "checkbox", "id": "enable_animations", "label": "Enable reveal animations", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_x", "label": "Horizontal padding", "min": 12, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "margin_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "header_gap", "label": "Header bottom gap", "min": 16, "max": 64, "step": 4, "unit": "px", "default": 36 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 11, "max": 16, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 24, "max": 56, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 40, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 16 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7FBFF" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#C5D3E4" },
    { "type": "color", "id": "banner_background", "label": "Banner background", "default": "#E8F3FC" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#142B4A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5A6B85" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "accent_hover_color", "label": "Accent hover", "default": "#0A6BC4" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Certifications and quality" }
  ],
  "blocks": [
    {
      "type": "certificate",
      "name": "Certificate",
      "limit": 12,
      "settings": [
        { "type": "paragraph", "content": "Upload the certificate image. Title and description are optional and editable." },
        { "type": "checkbox", "id": "enabled", "label": "Show this certificate", "default": true },
        { "type": "image_picker", "id": "image", "label": "Certificate image" },
        { "type": "text", "id": "image_url", "label": "Image URL fallback", "info": "Optional. Used if the uploaded file does not load." },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "title", "label": "Certificate title", "default": "Certificate" },
        { "type": "textarea", "id": "description", "label": "Short description" },
        {
          "type": "select",
          "id": "icon",
          "label": "Card icon",
          "default": "document",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shield", "label": "Shield" },
            { "value": "check-shield", "label": "Shield with check" },
            { "value": "document", "label": "Document" },
            { "value": "beaker", "label": "Lab beaker" },
            { "value": "ribbon", "label": "Ribbon" }
          ]
        },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "View Certificate" },
        { "type": "url", "id": "button_url", "label": "Button URL", "info": "Leave empty to open the certificate preview instead." }
      ]
    },
    {
      "type": "trust",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Tested" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Rigorous testing for performance" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check-shield",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shield", "label": "Shield" },
            { "value": "check-shield", "label": "Shield with check" },
            { "value": "document", "label": "Document" },
            { "value": "beaker", "label": "Lab beaker" },
            { "value": "ribbon", "label": "Ribbon" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Certifications & Quality",
      "category": "Custom",
      "blocks": [
        {
          "type": "certificate",
          "settings": {
            "title": "Intellectual Property Certificate",
            "description": "Certified trademark for Scale-O technology and brand.",
            "icon": "shield"
          }
        },
        {
          "type": "certificate",
          "settings": {
            "title": "Trademark Registration Certificate",
            "description": "Registered trademark for Scale-O brand.",
            "icon": "shield"
          }
        },
        {
          "type": "certificate",
          "settings": {
            "title": "Patent Certificate",
            "description": "Granted patent for anti-scale technology.",
            "icon": "document"
          }
        },
        {
          "type": "certificate",
          "settings": {
            "title": "Water Quality Test Report",
            "description": "Lab-tested for performance and water compatibility.",
            "icon": "beaker"
          }
        },
        {
          "type": "certificate",
          "settings": {
            "title": "Quality Assurance Certificate",
            "description": "Certified for quality management and manufacturing standards.",
            "icon": "ribbon"
          }
        }
      ]
    }
  ]
}
{% endschema %}
