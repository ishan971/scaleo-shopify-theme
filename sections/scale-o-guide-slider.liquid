{%- comment -%}
  Full-width Scale-O guide slider — install, how it works, test, care.
{%- endcomment -%}

{{ 'scale-o-guide-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'scale-o-guide-slider.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section.id }} .scale-o-guide-slider {
    --sogs-bg: {{ section.settings.background_color }};
    --sogs-heading: {{ section.settings.heading_color }};
    --sogs-accent: {{ section.settings.accent_color }};
    --sogs-max: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --sogs-heading-size: {{ section.settings.heading_size_mobile }}px;
    --sogs-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --sogs-slide-h: {{ section.settings.slide_height }}vh;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
</style>

<section
  class="scale-o-guide-slider"
  data-sogs-root
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
  aria-label="{{ section.settings.heading | default: 'Scale-O guide' | escape }}"
>
  <div class="scale-o-guide-slider__inner">
    {%- if section.settings.show_header -%}
      <header class="scale-o-guide-slider__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="scale-o-guide-slider__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="scale-o-guide-slider__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.settings.show_tabs -%}
      <nav class="scale-o-guide-slider__tabs" aria-label="Guide slides">
        {%- assign tab_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' and block.settings.enabled != false -%}
            <button
              type="button"
              class="scale-o-guide-slider__tab{% if tab_index == 0 %} is-active{% endif %}"
              data-sogs-tab
              aria-current="{% if tab_index == 0 %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | escape }}
            </button>
            {%- assign tab_index = tab_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="scale-o-guide-slider__stage">
      <div class="swiper-container swiper" data-sogs-swiper>
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- if block.type == 'slide' and block.settings.enabled != false -%}
              {%- liquid
                assign slide_image = block.settings.image
                assign fallback_file = block.settings.fallback_image | append: '.png'
                assign slide_alt = block.settings.alt
                if slide_alt == blank
                  assign slide_alt = block.settings.label
                endif
              -%}
              <div class="swiper-slide scale-o-guide-slider__slide{% if forloop.first %} swiper-slide-active is-active{% endif %}" {{ block.shopify_attributes }}>
                {%- if slide_image != blank -%}
                  {{ slide_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', alt: slide_alt }}
                {%- else -%}
                  <img
                    src="{{ fallback_file | asset_url }}"
                    alt="{{ slide_alt | escape }}"
                    loading="lazy"
                    width="1600"
                    height="900"
                  >
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.show_arrows -%}
        <button type="button" class="scale-o-guide-slider__nav scale-o-guide-slider__nav--prev" data-sogs-prev aria-label="Previous slide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button type="button" class="scale-o-guide-slider__nav scale-o-guide-slider__nav--next" data-sogs-next aria-label="Next slide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      {%- endif -%}
    </div>

    {%- if section.settings.show_dots -%}
      <div class="scale-o-guide-slider__dots" data-sogs-pagination></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Scale-O guide slider",
  "tag": "section",
  "class": "scale-o-guide-slider-section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_header", "label": "Show heading", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GUIDE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Scale-O works in your home" },
    { "type": "checkbox", "id": "show_tabs", "label": "Show slide tabs", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show progress bar", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 5 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 0, "max": 1600, "step": 20, "unit": "px", "default": 0, "info": "0 = full screen width" },
    { "type": "range", "id": "slide_height", "label": "Slide height", "min": 48, "max": 78, "step": 1, "unit": "vh", "default": 62, "info": "Keeps the full infographic visible in one screen." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 28, "max": 48, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 22, "max": 36, "step": 1, "unit": "px", "default": 28 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#EEF6FF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1A2B4A" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Enable slide", "default": true },
        { "type": "text", "id": "label", "label": "Tab label", "default": "How to Install?" },
        { "type": "image_picker", "id": "image", "label": "Slide image", "info": "Leave empty to use the default Scale-O guide image." },
        { "type": "select", "id": "fallback_image", "label": "Default image", "default": "scale-o-guide-install", "options": [
          { "value": "scale-o-guide-install", "label": "How to Install" },
          { "value": "scale-o-guide-works", "label": "How It Works" },
          { "value": "scale-o-guide-factor", "label": "Scale-O 0 Factor" },
          { "value": "scale-o-guide-test", "label": "How to Test" },
          { "value": "scale-o-guide-care", "label": "Clean & Replace" }
        ]},
        { "type": "text", "id": "alt", "label": "Image alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scale-O guide slider",
      "blocks": [
        { "type": "slide", "settings": { "label": "How to Install?", "fallback_image": "scale-o-guide-install" } },
        { "type": "slide", "settings": { "label": "How It Works?", "fallback_image": "scale-o-guide-works" } },
        { "type": "slide", "settings": { "label": "0 Factor", "fallback_image": "scale-o-guide-factor" } },
        { "type": "slide", "settings": { "label": "How to Test?", "fallback_image": "scale-o-guide-test" } },
        { "type": "slide", "settings": { "label": "Clean & Replace", "fallback_image": "scale-o-guide-care" } }
      ]
    }
  ]
}
{% endschema %}
