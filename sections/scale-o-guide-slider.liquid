{%- comment -%}
  Scale-O guide — vertical, non-clickable stack of infographics.
{%- endcomment -%}

{{ 'scale-o-guide-slider.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .scale-o-guide-slider {
    --sogs-bg: {{ section.settings.background_color }};
    --sogs-heading: {{ section.settings.heading_color }};
    --sogs-accent: {{ section.settings.accent_color }};
    --sogs-max: {% if section.settings.max_width == 0 %}1280px{% else %}{{ section.settings.max_width }}px{% endif %};
    --sogs-heading-size: {{ section.settings.heading_size_mobile }}px;
    --sogs-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
</style>

<section
  class="scale-o-guide-slider"
  aria-label="{{ section.settings.heading | default: 'Scale-O guide' | escape }}"
>
  <div class="scale-o-guide-slider__inner">
    {%- if section.settings.show_header -%}
      <header class="scale-o-guide-slider__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="scale-o-guide-slider__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="scale-o-guide-slider__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ol class="scale-o-guide-slider__list">
      {%- assign step_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' and block.settings.enabled != false -%}
          {%- liquid
            assign step_index = step_index | plus: 1
            assign slide_image = block.settings.image
            assign fallback_file = block.settings.fallback_image | append: '.png'
            assign slide_alt = block.settings.alt
            if slide_alt == blank
              assign slide_alt = block.settings.label
            endif
          -%}
          <li class="scale-o-guide-slider__item" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <p class="scale-o-guide-slider__label">
                <span class="scale-o-guide-slider__num">{{ step_index | prepend: '0' | slice: -2, 2 }}</span>
                <span>{{ block.settings.label | escape }}</span>
              </p>
            {%- endif -%}
            <figure class="scale-o-guide-slider__figure">
              {%- if slide_image != blank -%}
                {{ slide_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1100, 1600', sizes: '(min-width: 768px) 50vw, 100vw', alt: slide_alt }}
              {%- else -%}
                <img
                  src="{{ fallback_file | asset_url }}"
                  alt="{{ slide_alt | escape }}"
                  loading="lazy"
                  width="1600"
                  height="900"
                >
              {%- endif -%}
            </figure>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Scale-O guide slider",
  "tag": "section",
  "class": "scale-o-guide-slider-section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_header", "label": "Show heading", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GUIDE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Scale-O Installation, Working, Replacement & Technology Guide" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 0, "max": 1600, "step": 20, "unit": "px", "default": 1120, "info": "0 uses 1120px." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 28, "max": 48, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 22, "max": 36, "step": 1, "unit": "px", "default": 28 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#EEF6FF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1A2B4A" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Guide panel",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Enable panel", "default": true },
        { "type": "text", "id": "label", "label": "Label", "default": "How to Install?" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the default Scale-O guide image." },
        { "type": "select", "id": "fallback_image", "label": "Default image", "default": "scale-o-guide-install", "options": [
          { "value": "scale-o-guide-install", "label": "How to Install" },
          { "value": "scale-o-guide-works", "label": "How It Works" },
          { "value": "scale-o-guide-factor", "label": "Scale-O 0 Factor" },
          { "value": "scale-o-guide-test", "label": "How to Test" },
          { "value": "scale-o-guide-replace", "label": "How to Replace" },
          { "value": "scale-o-guide-clean", "label": "How to Clean" },
          { "value": "scale-o-guide-when-replace", "label": "When to Replace" },
          { "value": "scale-o-guide-care", "label": "Clean & Replace" }
        ]},
        { "type": "text", "id": "alt", "label": "Image alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scale-O guide slider",
      "blocks": [
        { "type": "slide", "settings": { "label": "How to Install?", "fallback_image": "scale-o-guide-install" } },
        { "type": "slide", "settings": { "label": "How It Works?", "fallback_image": "scale-o-guide-works" } },
        { "type": "slide", "settings": { "label": "How to Test?", "fallback_image": "scale-o-guide-test" } },
        { "type": "slide", "settings": { "label": "How To Replace?", "fallback_image": "scale-o-guide-replace" } },
        { "type": "slide", "settings": { "label": "How To Clean?", "fallback_image": "scale-o-guide-clean" } },
        { "type": "slide", "settings": { "label": "When To Replace?", "fallback_image": "scale-o-guide-when-replace" } }
      ]
    }
  ]
}
{% endschema %}
