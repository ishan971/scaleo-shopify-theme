{%- comment -%}
  Scale-O page hero — editable background image with left-aligned tag, title, description, and CTA.
{%- endcomment -%}

{{ 'scale-o-page-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign hero_image = section.settings.image
  assign mobile_image = section.settings.image_mobile
  assign hero_alt = section.settings.image_alt | default: section.settings.heading | default: 'Scale-O'
  assign fallback_asset = section.settings.fallback_asset
  if fallback_asset == blank
    assign fallback_asset = 'scale-o-plans-hero.png'
  endif

  assign cta_url = section.settings.button_url
  if cta_url == blank
    capture cta_url
      render 'scale-o-shop-url'
    endcapture
    assign cta_url = cta_url | strip
  endif

  assign show_cta = false
  if section.settings.show_button and section.settings.button_label != blank and cta_url != blank
    assign show_cta = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-page-hero {
    --soph-bg: {{ section.settings.background_color }};
    --soph-heading: {{ section.settings.heading_color }};
    --soph-text: {{ section.settings.text_color }};
    --soph-accent: {{ section.settings.accent_color }};
    --soph-accent-hover: {{ section.settings.accent_hover_color }};
    --soph-radius: {{ section.settings.border_radius }}px;
    --soph-max: {% if section.settings.content_width == 0 %}100%{% else %}{{ section.settings.content_width }}px{% endif %};
    --soph-height: {{ section.settings.desktop_height }}px;
    --soph-height-mobile: {{ section.settings.mobile_height }}px;
    --soph-image-position: {{ section.settings.image_position }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background: var(--soph-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-page-hero {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #shopify-section-{{ section.id }} .scale-o-page-hero__inner {
    padding-left: {{ section.settings.padding_x }}px;
    padding-right: {{ section.settings.padding_x }}px;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .scale-o-page-hero__inner {
      padding-left: 16px;
      padding-right: 16px;
    }
  }
</style>

<section
  class="scale-o-page-hero"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Page banner' | escape }}"
>
  <div class="scale-o-page-hero__inner">
    <div class="scale-o-page-hero__panel">
      <div class="scale-o-page-hero__bg">
        {%- if hero_image != blank -%}
          {%- if mobile_image != blank -%}
            <picture>
              <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 1000 }}">
              {{
                hero_image
                | image_url: width: 1800
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '800, 1200, 1600, 1800',
                  alt: hero_alt
              }}
            </picture>
          {%- else -%}
            {{
              hero_image
              | image_url: width: 1800
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '800, 1200, 1600, 1800',
                alt: hero_alt
            }}
          {%- endif -%}
        {%- else -%}
          <img
            class="scale-o-page-hero__placeholder"
            src="{{ fallback_asset | asset_url }}"
            alt="{{ hero_alt | escape }}"
            width="1920"
            height="1080"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </div>

      {%- if section.settings.show_overlay -%}
        <div class="scale-o-page-hero__veil" aria-hidden="true"></div>
      {%- endif -%}

      <div class="scale-o-page-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="scale-o-page-hero__tag">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="scale-o-page-hero__heading">
            {%- if section.settings.show_heading_underline -%}
              <span class="scale-o-page-hero__heading-accent">{{ section.settings.heading | escape }}</span>
            {%- else -%}
              {{ section.settings.heading | escape }}
            {%- endif -%}
          </{{ heading_tag }}>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="scale-o-page-hero__text">{{ section.settings.description | escape }}</p>
        {%- endif -%}

        {%- if show_cta -%}
          <a class="scale-o-page-hero__cta" href="{{ cta_url }}">
            <span>{{ section.settings.button_label | escape }}</span>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
              <path d="M3.5 8h9M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Scale-O page hero",
  "tag": "section",
  "class": "scale-o-page-hero-section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Leave empty to use the theme fallback image below." },
    { "type": "image_picker", "id": "image_mobile", "label": "Background image (mobile)" },
    { "type": "text", "id": "fallback_asset", "label": "Theme fallback image filename", "default": "scale-o-plans-hero.png", "info": "Used when Background image is empty. File must be in theme assets." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Scale-O water softener for overhead tanks" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focus",
      "default": "center right",
      "options": [
        { "value": "center left", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "center right", "label": "Right" }
      ]
    },
    { "type": "checkbox", "id": "show_overlay", "label": "Show left fade so text stays readable", "default": true },

    { "type": "header", "content": "Left-side text" },
    { "type": "text", "id": "eyebrow", "label": "Tag", "default": "Water softener price" },
    { "type": "text", "id": "heading", "label": "Title", "default": "Water Softener Price and Plans" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Title tag",
      "default": "h1",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ]
    },
    { "type": "checkbox", "id": "show_heading_underline", "label": "Show line under title", "default": false },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Compare Scale-O water softener price in India by plan. Salt-free units sit in the overhead tank of independent houses, villas and bungalows. No salt, no plumber, no electricity."
    },

    { "type": "header", "content": "Button" },
    { "type": "checkbox", "id": "show_button", "label": "Show button", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop water softeners" },
    { "type": "url", "id": "button_url", "label": "Button link", "info": "Leave blank to use the water-softeners collection." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 0, "max": 1600, "step": 20, "unit": "px", "default": 0, "info": "0 is full width" },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 320, "max": 640, "step": 10, "unit": "px", "default": 480 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 320, "max": 560, "step": 10, "unit": "px", "default": 420 },
    { "type": "range", "id": "padding_x", "label": "Side padding", "min": 12, "max": 48, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 8 },
    { "type": "range", "id": "border_radius", "label": "Corner radius", "min": 0, "max": 28, "step": 2, "unit": "px", "default": 12 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Title", "default": "#0B1B2E" },
    { "type": "color", "id": "text_color", "label": "Description", "default": "#465568" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "accent_hover_color", "label": "Accent hover", "default": "#0A6BC4" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Water softener plans" }
  ],
  "presets": [
    {
      "name": "Scale-O page hero"
    }
  ]
}
{% endschema %}
