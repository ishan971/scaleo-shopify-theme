{%- comment -%}
  Scale-O PDP size links — Mini / Semi / Centi plus Plans and collection.
  The current product is marked in place and not linked to itself.
{%- endcomment -%}

{{ 'scale-o-pdp-sizes.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_handle = product.handle | default: ''

  assign collection_url = section.settings.collection_url
  if collection_url == blank
    capture collection_url
      render 'scale-o-shop-url'
    endcapture
    assign collection_url = collection_url | strip
  endif

  assign plans_url = section.settings.plans_url | default: '/pages/water-softener-plans'
  if plans_url == blank
    assign plans_url = '/pages/water-softener-plans'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-pdp-sizes {
    --sps-bg: {{ section.settings.background_color }};
    --sps-heading: {{ section.settings.heading_color }};
    --sps-text: {{ section.settings.text_color }};
    --sps-accent: {{ section.settings.accent_color }};
    --sps-accent-hover: {{ section.settings.accent_hover_color }};
    --sps-card: {{ section.settings.card_background }};
    --sps-border: {{ section.settings.border_color }};
    --sps-radius: {{ section.settings.card_radius }}px;
    --sps-pad-x: {{ section.settings.padding_x }}px;
    --sps-max: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --sps-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --sps-heading-size: {{ section.settings.heading_size_mobile }}px;
    --sps-desc-size: {{ section.settings.description_size }}px;
    --sps-shadow: {% if section.settings.show_card_shadow %}0 10px 28px rgba(16, 42, 67, 0.06){% else %}none{% endif %};
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: var(--sps-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-pdp-sizes {
      --sps-heading-size: {{ section.settings.heading_size_desktop }}px;
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<section
  class="scale-o-pdp-sizes"
  role="navigation"
  aria-label="{{ section.settings.accessibility_label | default: 'Other Scale-O tank sizes' | escape }}"
>
  <div class="scale-o-pdp-sizes__container">
    <header class="scale-o-pdp-sizes__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="scale-o-pdp-sizes__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="scale-o-pdp-sizes__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="scale-o-pdp-sizes__desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </header>

    <ul class="scale-o-pdp-sizes__grid">
      {%- for block in section.blocks -%}
        {%- if block.type != 'size' or block.settings.enabled == false -%}
          {%- continue -%}
        {%- endif -%}
        {%- liquid
          assign size_product = block.settings.product
          if size_product == blank and block.settings.fallback_handle != blank
            assign size_product = all_products[block.settings.fallback_handle]
          endif

          assign size_url = block.settings.url
          if size_url == blank and size_product != blank
            assign size_url = size_product.url
          endif
          if size_url == blank and block.settings.fallback_handle != blank
            assign size_url = '/products/' | append: block.settings.fallback_handle
          endif

          assign size_title = block.settings.heading
          if size_title == blank and size_product != blank
            assign size_title = size_product.title
          endif

          assign is_current = false
          if current_handle != blank
            if size_product != blank and size_product.handle == current_handle
              assign is_current = true
            elsif block.settings.fallback_handle != blank and block.settings.fallback_handle == current_handle
              assign is_current = true
            endif
          endif
        -%}
        {%- if size_title == blank or size_url == blank -%}
          {%- continue -%}
        {%- endif -%}
        <li class="scale-o-pdp-sizes__item{% if is_current %} scale-o-pdp-sizes__item--current{% endif %}" {{ block.shopify_attributes }}>
          {%- if is_current -%}
            <div class="scale-o-pdp-sizes__card scale-o-pdp-sizes__card--current">
              <span class="scale-o-pdp-sizes__badge">{{ section.settings.current_badge | default: 'This size' | escape }}</span>
              <p class="scale-o-pdp-sizes__name">{{ size_title | escape }}</p>
              {%- if block.settings.tank != blank -%}
                <p class="scale-o-pdp-sizes__tank">{{ block.settings.tank | escape }}</p>
              {%- endif -%}
            </div>
          {%- else -%}
            <a class="scale-o-pdp-sizes__card" href="{{ size_url }}">
              <p class="scale-o-pdp-sizes__name">{{ size_title | escape }}</p>
              {%- if block.settings.tank != blank -%}
                <p class="scale-o-pdp-sizes__tank">{{ block.settings.tank | escape }}</p>
              {%- endif -%}
              <span class="scale-o-pdp-sizes__go">{{ block.settings.link_label | default: 'View size' | escape }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_cta_row -%}
      <div class="scale-o-pdp-sizes__actions">
        {%- if section.settings.plans_label != blank and plans_url != blank -%}
          <a class="scale-o-pdp-sizes__btn scale-o-pdp-sizes__btn--primary" href="{{ plans_url }}">
            {{ section.settings.plans_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.collection_label != blank and collection_url != blank -%}
          <a class="scale-o-pdp-sizes__btn scale-o-pdp-sizes__btn--ghost" href="{{ collection_url }}">
            {{ section.settings.collection_label | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Scale-O PDP sizes",
  "tag": "section",
  "class": "scale-o-pdp-sizes-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Other sizes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Need a different tank size?" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Mini, Semi and Centi are sized for your overhead tank. Compare water softener price, or shop all models for home." },
    { "type": "text", "id": "current_badge", "label": "Current size badge", "default": "This size" },
    { "type": "header", "content": "Plans and collection" },
    { "type": "checkbox", "id": "show_cta_row", "label": "Show Plans and collection buttons", "default": true },
    { "type": "text", "id": "plans_label", "label": "Plans button", "default": "Water softener price and plans" },
    { "type": "url", "id": "plans_url", "label": "Plans URL" },
    { "type": "text", "id": "collection_label", "label": "Collection button", "default": "Shop water softeners for home" },
    { "type": "url", "id": "collection_url", "label": "Collection URL", "info": "Leave blank to use the water-softeners collection." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 900, "max": 1400, "step": 20, "unit": "px", "default": 1180 },
    { "type": "range", "id": "padding_x", "label": "Side padding", "min": 12, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 24, "max": 80, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 16, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 11, "max": 16, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 24, "max": 44, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 22, "max": 34, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 14, "max": 18, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7FBFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#102A43" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5A6B85" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "accent_hover_color", "label": "Accent hover", "default": "#0A6BC4" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Card border", "default": "#DCEAF5" },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_card_shadow", "label": "Show card shadow", "default": true },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Other Scale-O tank sizes" }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size link",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Show this size", "default": true },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "fallback_handle", "label": "Fallback product handle", "info": "Used if no product is selected." },
        { "type": "url", "id": "url", "label": "Override URL" },
        { "type": "text", "id": "heading", "label": "Title", "default": "Scale-O Mini" },
        { "type": "text", "id": "tank", "label": "Tank size", "default": "500L-750L overhead tanks" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "View Mini" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scale-O PDP sizes",
      "blocks": [
        {
          "type": "size",
          "settings": {
            "heading": "Scale-O Mini",
            "tank": "500L-750L overhead tanks",
            "fallback_handle": "mini-water-softener-500l-750l-tanks",
            "link_label": "View Mini"
          }
        },
        {
          "type": "size",
          "settings": {
            "heading": "Scale-O Semi",
            "tank": "1000L-1500L overhead tanks",
            "fallback_handle": "semi-water-softener-1000l-1500l-tanks",
            "link_label": "View Semi"
          }
        },
        {
          "type": "size",
          "settings": {
            "heading": "Scale-O Centi",
            "tank": "2000L-2500L overhead tanks",
            "fallback_handle": "centi-water-softener-2000l-2500l-tanks",
            "link_label": "View Centi"
          }
        }
      ]
    }
  ]
}
{% endschema %}
