{%- comment -%}
  Scale-O combo packs for dual-tank homes.
{%- endcomment -%}

{{ 'scale-o-plans.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign header_align = section.settings.header_alignment | default: 'center'
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-plans {
    --sop-bg: {{ section.settings.background_color }};
    --sop-heading: {{ section.settings.heading_color }};
    --sop-text: {{ section.settings.text_color }};
    --sop-accent: {{ section.settings.accent_color }};
    --sop-accent-hover: {{ section.settings.accent_hover_color }};
    --sop-card-bg: {{ section.settings.card_background }};
    --sop-border: {{ section.settings.border_color }};
    --sop-radius: {{ section.settings.card_radius }}px;
    --sop-gap: {{ section.settings.card_gap }}px;
    --sop-cols: {{ section.settings.columns }};
    --sop-pad-x: {{ section.settings.padding_x }}px;
    --sop-header-gap: {{ section.settings.header_gap }}px;
    --sop-header-align: {{ header_align }};
    --sop-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --sop-heading-size: {{ section.settings.heading_size_mobile }}px;
    --sop-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --sop-desc-size: {{ section.settings.description_size }}px;
    --sop-max: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --sop-shadow: {% if section.settings.show_card_shadow %}0 10px 28px rgba(16, 42, 67, 0.06){% else %}none{% endif %};
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: var(--sop-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-plans {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<section
  class="scale-o-plans"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Combo water softeners' | escape }}"
>
  <div class="scale-o-plans__container">
    <header class="scale-o-plans__header{% if header_align == 'left' %} scale-o-plans__header--left{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="scale-o-plans__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="scale-o-plans__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="scale-o-plans__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </header>

    <ul class="scale-o-plans__grid">
      {%- for block in section.blocks -%}
        {%- if block.type != 'combo' or block.settings.enabled == false -%}
          {%- continue -%}
        {%- endif -%}
        {%- liquid
          assign combo_product = block.settings.product
          assign combo_image = block.settings.image
          if combo_image == blank and combo_product != blank
            assign combo_image = combo_product.featured_image
          endif
          assign combo_alt = block.settings.image_alt | default: block.settings.heading | default: combo_product.title
          assign combo_url = block.settings.cta_url
          if combo_url == blank and combo_product != blank
            assign combo_url = combo_product.url
          endif
          assign fit_lines = block.settings.fit_list | strip | newline_to_br | split: '<br />'
          assign card_tag = 'article'
          if combo_url != blank
            assign card_tag = 'a'
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <{{ card_tag }}
            class="scale-o-plans__combo"
            {% if combo_url != blank %}href="{{ combo_url }}"{% endif %}
          >
            <div class="scale-o-plans__combo-media">
              {%- if combo_image != blank -%}
                {{
                  combo_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 640, 900',
                    sizes: '(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw',
                    alt: combo_alt
                }}
              {%- endif -%}
            </div>
            <div class="scale-o-plans__combo-body">
              {%- if block.settings.eyebrow != blank -%}
                <p class="scale-o-plans__card-tag">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="scale-o-plans__card-title">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.fit_list != blank -%}
                <ul class="scale-o-plans__fit">
                  {%- for line in fit_lines -%}
                    {%- assign fit_text = line | strip -%}
                    {%- if fit_text != blank -%}
                      <li>{{ fit_text | escape }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.cta_label != blank -%}
                <span class="scale-o-plans__combo-cta">{{ block.settings.cta_label | escape }}</span>
              {%- endif -%}
            </div>
          </{{ card_tag }}>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Scale-O combo packs",
  "tag": "section",
  "class": "scale-o-plans-combos-section",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Combo packs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Combo packs for larger homes and dual tanks" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "For villas, duplex homes, bungalows and farmhouses with larger overhead tanks or two storage systems. Same salt-free, low-maintenance approach as the single units."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 900, "max": 1400, "step": 20, "unit": "px", "default": 1180 },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_x", "label": "Side padding", "min": 12, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "header_gap", "label": "Header bottom gap", "min": 20, "max": 64, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 24, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 24, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 11, "max": 16, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 24, "max": 48, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 22, "max": 36, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 14, "max": 18, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#102A43" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5A6B85" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "accent_hover_color", "label": "Accent hover", "default": "#0A6BC4" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Card border", "default": "#DCEAF5" },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_card_shadow", "label": "Show card shadow", "default": true },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Combo water softeners" }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo card",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Show this combo", "default": true },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "eyebrow", "label": "Tag", "default": "Mini x2" },
        { "type": "text", "id": "heading", "label": "Title", "default": "Mini combo for two tanks" },
        {
          "type": "textarea",
          "id": "fit_list",
          "label": "Ideal for",
          "info": "One point per line",
          "default": "3 to 5 family members\nDuplex homes, villas and bungalows\nDaily use up to 1000 L/day\nTanks up to 1500 litres"
        },
        { "type": "text", "id": "cta_label", "label": "Link label", "default": "View product" },
        { "type": "url", "id": "cta_url", "label": "Link", "info": "Leave blank to use the selected product." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scale-O combo packs",
      "blocks": [
        { "type": "combo" },
        { "type": "combo", "settings": { "eyebrow": "Semi x2", "heading": "Semi combo for larger homes" } },
        { "type": "combo", "settings": { "eyebrow": "Centi x2", "heading": "Centi combo for high capacity" } }
      ]
    }
  ]
}
{% endschema %}
