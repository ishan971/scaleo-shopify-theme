{%- comment -%}
  Product benefits — Scale-O Benefits for Soft Water Living
{%- endcomment -%}

{{ 'scale-o-pdp-story.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .scale-o-pdp-benefits {
    --spb-bg: {{ section.settings.background_color }};
    --spb-heading: {{ section.settings.heading_color }};
    --spb-text: {{ section.settings.text_color }};
    --spb-accent: {{ section.settings.accent_color }};
    --spb-card: {{ section.settings.card_background }};
    --spb-border: {{ section.settings.card_border }};
    --spb-icon: {{ section.settings.icon_background }};
    --spb-max: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --spb-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --spb-heading-size: {{ section.settings.heading_size_mobile }}px;
    --spb-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --spb-desc-size: {{ section.settings.description_size }}px;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--spb-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-pdp-benefits {
      --spb-heading-size: {{ section.settings.heading_size_desktop }}px;
    }
  }
</style>

<section class="scale-o-pdp-benefits" aria-label="{{ section.settings.heading | escape }}">
  <div class="scale-o-pdp-benefits__inner">
    <header class="scale-o-pdp-benefits__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="scale-o-pdp-benefits__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="scale-o-pdp-benefits__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank or section.settings.description_highlight != blank -%}
        <p class="scale-o-pdp-benefits__desc">
          {{ section.settings.description | escape -}}
          {%- if section.settings.description_highlight != blank -%}
            {{- ' ' -}}{{ section.settings.description_highlight | escape }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </header>

    <ul class="scale-o-pdp-benefits__grid" role="list">
      {%- assign benefit_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          {%- assign benefit_index = benefit_index | plus: 1 -%}
          {%- if benefit_index < 10 -%}
            {%- assign index_label = benefit_index | prepend: '0' -%}
          {%- else -%}
            {%- assign index_label = benefit_index -%}
          {%- endif -%}
          {%- liquid
            assign benefit_image = block.settings.image
            assign fallback_asset = ''
            case benefit_index
              when 1
                assign fallback_asset = 'scale-o-benefit-appliances.png'
              when 2
                assign fallback_asset = 'scale-o-benefit-bathroom.png'
              when 3
                assign fallback_asset = 'scale-o-benefit-water-flow.png'
              when 4
                assign fallback_asset = 'scale-o-benefit-salt-free.png'
              when 5
                assign fallback_asset = 'scale-o-benefit-diy.png'
              when 6
                assign fallback_asset = 'scale-o-benefit-whole-house.png'
              when 7
                assign fallback_asset = 'scale-o-benefit-maintenance.png'
            endcase
          -%}
          <li class="scale-o-pdp-benefits__card" {{ block.shopify_attributes }}>
            <span class="scale-o-pdp-benefits__index" aria-hidden="true">{{ index_label }}</span>
            <div class="scale-o-pdp-benefits__media">
              {%- if benefit_image != blank -%}
                {{
                  benefit_image
                  | image_url: width: 320
                  | image_tag:
                    loading: 'lazy',
                    widths: '160,240,320',
                    sizes: '80px',
                    alt: block.settings.title
                }}
              {%- elsif fallback_asset != blank -%}
                <img
                  src="{{ fallback_asset | asset_url }}"
                  alt="{{ block.settings.title | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              {%- else -%}
                <span class="scale-o-pdp-benefits__icon" aria-hidden="true">
                  {% render 'scale-o-benefit-icon', icon: block.settings.icon %}
                </span>
              {%- endif -%}
            </div>
            <div class="scale-o-pdp-benefits__copy">
              <h3 class="scale-o-pdp-benefits__title">{{ block.settings.title | escape }}</h3>
              <p class="scale-o-pdp-benefits__text">{{ block.settings.text | escape }}</p>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Scale-O product benefits",
  "tag": "section",
  "class": "scale-o-product-benefits-section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BENEFITS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Scale-O Benefits for Soft Water Living" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Scale-O helps improve your everyday water experience by reducing hard water scaling across your entire home." },
    { "type": "text", "id": "description_highlight", "label": "Extra phrase (optional)", "info": "Appended after the description in the same text color. Leave empty if the description is already complete." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 0, "max": 1400, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 11, "max": 16, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 28, "max": 48, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 22, "max": 36, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 13, "max": 18, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7FBFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1A2B4A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5A6B85" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#C5D0E0" },
    { "type": "color", "id": "icon_background", "label": "Image / icon background", "default": "#EEF6FF" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Card image", "info": "Square image works best. If empty, a default benefit image is used." },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "default": "shield",
          "info": "Used only if no image is set and no default asset exists.",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "bathroom", "label": "Bathroom" },
            { "value": "droplet", "label": "Water" },
            { "value": "molecule", "label": "Salt-free / molecule" },
            { "value": "wrench", "label": "Installation" },
            { "value": "home", "label": "Home" },
            { "value": "gear", "label": "Maintenance" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Protects Appliances" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Helps reduce scale buildup in geysers, washing machines, dishwashers, and pipelines." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scale-O product benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "shield", "title": "Protects Appliances", "text": "Helps reduce scale buildup in geysers, washing machines, dishwashers, and pipelines." } },
        { "type": "benefit", "settings": { "icon": "bathroom", "title": "Cleaner Bathrooms", "text": "Reduces white stains and scaling on taps, showers, and tiles." } },
        { "type": "benefit", "settings": { "icon": "droplet", "title": "Better Water Flow", "text": "Helps reduce mineral buildup inside plumbing systems for better water flow." } },
        { "type": "benefit", "settings": { "icon": "molecule", "title": "Salt-Free Technology", "text": "No salt refilling, chemicals, or regeneration required." } },
        { "type": "benefit", "settings": { "icon": "wrench", "title": "DIY Installation", "text": "Simply placed inside the overhead tank without plumbing modifications." } },
        { "type": "benefit", "settings": { "icon": "home", "title": "Whole House Protection", "text": "Supports hard water treatment for the entire house through the overhead tank system." } },
        { "type": "benefit", "settings": { "icon": "gear", "title": "Zero Maintenance", "text": "No complicated servicing or recurring maintenance needs." } }
      ]
    }
  ]
}
{% endschema %}
