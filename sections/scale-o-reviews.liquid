{%- comment -%}
  Scale-O Customer Reviews — visual wrapper around Judge.me app block.
  Do not replace or rebuild the widget. App block HTML/JS stays intact.
{%- endcomment -%}

{{ 'scale-o-reviews.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign header_align = section.settings.header_alignment
  assign show_header = false
  if section.settings.heading != blank
    assign show_header = true
  endif
  if section.settings.show_eyebrow and section.settings.eyebrow != blank
    assign show_header = true
  endif
  if section.settings.show_description and section.settings.description != blank
    assign show_header = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-reviews {
    --sor-bg: {{ section.settings.background_color }};
    --sor-heading: {{ section.settings.heading_color }};
    --sor-text: {{ section.settings.text_color }};
    --sor-accent: {{ section.settings.accent_color }};
    --sor-accent-hover: {{ section.settings.accent_hover_color }};
    --sor-card-bg: {{ section.settings.card_background }};
    --sor-border: {{ section.settings.card_border_color }};
    --sor-star: {{ section.settings.star_color }};
    --sor-radius: {{ section.settings.card_radius }}px;
    --sor-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --sor-heading-size: {{ section.settings.heading_size_mobile }}px;
    --sor-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --sor-desc-size: {{ section.settings.description_size }}px;
    --sor-pad-x: {{ section.settings.padding_x }}px;
    --sor-header-gap: {{ section.settings.header_gap }}px;
    --sor-header-align: {{ header_align }};
    --sor-max-width: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --sor-shadow: {% if section.settings.show_card_shadow %}0 10px 28px rgba(20, 43, 74, 0.08){% else %}none{% endif %};
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: var(--sor-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-reviews {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<div
  class="scale-o-reviews{% if section.settings.hide_native_heading %} scale-o-reviews--hide-native-title{% endif %}"
  data-section-id="{{ section.id }}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Customer reviews' | escape }}"
>
  <div class="scale-o-reviews__container">
    {%- if show_header -%}
      <header class="scale-o-reviews__header scale-o-reviews__header--{{ header_align }}">
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
          <p class="scale-o-reviews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="scale-o-reviews__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.show_description and section.settings.description != blank -%}
          <p class="scale-o-reviews__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="scale-o-reviews__widget">
      {% for block in section.blocks %}
        {% render block %}
      {% else %}
        {%- if request.design_mode -%}
          <p class="scale-o-reviews__empty">Add the Judge.me Review Widget app block in Theme Editor to show reviews here.</p>
        {%- endif -%}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Reviews",
  "tag": "section",
  "class": "scale-o-reviews-section",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "REVIEWS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews" },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": false },
    { "type": "textarea", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "checkbox", "id": "hide_native_heading", "label": "Hide Judge.me widget title (keeps our heading)", "default": true, "info": "Does not hide ratings, write-a-review, sorting, or pagination." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 960, "max": 1400, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 8, "max": 24, "step": 2, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_card_shadow", "label": "Show card shadow", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_x", "label": "Side padding", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "header_gap", "label": "Header gap", "min": 12, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 28, "max": 52, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 22, "max": 36, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 13, "max": 18, "step": 1, "unit": "px", "default": 15 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7FBFF" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Border", "default": "#D7E4F2" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1A2B4A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5A6B85" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "accent_hover_color", "label": "Accent hover", "default": "#0A6BC4" },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#F5B301" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Customer reviews" }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews"
    }
  ]
}
{% endschema %}
