{%- comment -%}
  Scale-O Premium Customer Reviews — custom UI, Judge.me live data.
{%- endcomment -%}

{{ 'scale-o-reviews.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign jm = shop.metafields.judgeme
  assign review_count = jm.all_reviews_count | default: 0
  assign review_score = jm.all_reviews_rating | default: 5
  assign review_score_display = review_score | plus: 0 | round: 1

  if product != blank
    if product.metafields.reviews.rating.value.rating != blank
      assign review_score = product.metafields.reviews.rating.value.rating
    elsif product.metafields.reviews.rating.value != blank
      assign review_score = product.metafields.reviews.rating.value
    elsif product.metafields.ddreviews.content.average_star != blank
      assign review_score = product.metafields.ddreviews.content.average_star
    endif

    if product.metafields.reviews.rating_count.value != blank
      assign review_count = product.metafields.reviews.rating_count.value | plus: 0
    elsif product.metafields.ddreviews.content.total != blank
      assign review_count = product.metafields.ddreviews.content.total | plus: 0
    endif
  endif

  assign review_score_display = review_score | plus: 0 | round: 1
  assign per_page = section.settings.cards_per_page | default: 3

  assign happy_homes_count = 0
  assign happy_homes_formatted = ''
  if product != blank
    assign product_handle = product.handle | downcase
    if product_handle contains 'mini-combo'
      assign happy_homes_count = 1000
      assign happy_homes_formatted = '1,000'
    elsif product_handle contains 'semi-combo'
      assign happy_homes_count = 2000
      assign happy_homes_formatted = '2,000'
    elsif product_handle contains 'centi-combo'
      assign happy_homes_count = 2000
      assign happy_homes_formatted = '2,000'
    elsif product_handle contains 'mini'
      assign happy_homes_count = 8000
      assign happy_homes_formatted = '8,000'
    elsif product_handle contains 'semi'
      assign happy_homes_count = 13000
      assign happy_homes_formatted = '13,000'
    elsif product_handle contains 'centi'
      assign happy_homes_count = 18000
      assign happy_homes_formatted = '18,000'
    endif
  endif

  assign heading_text = section.settings.heading
  if happy_homes_formatted != blank
    assign heading_text = 'Loved by ' | append: happy_homes_formatted | append: ' Happy Homes'
  elsif section.settings.auto_heading_count and review_count > 0
    assign heading_text = 'Loved by ' | append: review_count | append: ' Happy Homes'
  endif

  assign count_label = section.settings.reviews_count_label
  if count_label contains '[count]'
    assign count_label = count_label | replace: '[count]', review_count
  elsif count_label == blank
    assign count_label = 'from ' | append: review_count | append: ' reviews'
  endif

  assign default_thumb = section.settings.default_product_image
  if default_thumb == blank and product != blank and product.featured_media != blank
    assign default_thumb = product.featured_media
  endif
  assign default_thumb_url = ''
  if default_thumb != blank
    assign default_thumb_url = default_thumb | image_url: width: 160
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-reviews {
    --sor-bg: {{ section.settings.background_color }};
    --sor-bg-end: {{ section.settings.background_color_end }};
    --sor-heading: {{ section.settings.heading_color }};
    --sor-text: {{ section.settings.text_color }};
    --sor-accent: {{ section.settings.accent_color }};
    --sor-accent-hover: {{ section.settings.accent_hover_color }};
    --sor-card-bg: {{ section.settings.card_background }};
    --sor-border: {{ section.settings.card_border_color }};
    --sor-star: {{ section.settings.star_color }};
    --sor-radius: {{ section.settings.card_radius }}px;
    --sor-max-width: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --sor-pad-x: {{ section.settings.padding_x }}px;
    --sor-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-reviews {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<section
  class="scale-o-reviews"
  data-scale-o-reviews
  data-per-page="{{ per_page }}"
  {% if default_thumb_url != blank %}data-default-thumb="{{ default_thumb_url }}"{% endif %}
  aria-label="{{ section.settings.accessibility_label | default: 'Customer reviews' | escape }}"
>
  <div class="scale-o-reviews__container">
    <header class="scale-o-reviews__header">
      {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
        <p class="scale-o-reviews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if heading_text != blank -%}
        <h2 class="scale-o-reviews__heading">{{ heading_text | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="scale-o-reviews__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      {%- if section.settings.show_rating_summary -%}
        <div class="scale-o-reviews__rating">
          {%- if review_score_display > 0 -%}
            <p class="scale-o-reviews__avg">
              <strong>{{ review_score_display }}</strong>/5 Avg rating
            </p>
          {%- endif -%}
          <p class="scale-o-reviews__count">
            <span>{{ count_label | escape }}</span>
            {%- if section.settings.show_verified_badge -%}
              <span class="scale-o-reviews__count-verified">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" fill="#14b8a6"/>
                  <path d="M8 12.2 10.6 14.8 16.2 9.2" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Verified
              </span>
            {%- endif -%}
          </p>
        </div>
      {%- endif -%}
    </header>

    <div class="scale-o-reviews__slider">
      <div class="scale-o-reviews__track" data-sor-track role="list"></div>

      <div class="scale-o-reviews__controls">
        <button type="button" class="scale-o-reviews__nav" data-sor-prev aria-label="Previous reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M14.5 6.5 9 12l5.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="scale-o-reviews__dots" data-sor-dots role="tablist" aria-label="Review pages"></div>
        <button type="button" class="scale-o-reviews__nav" data-sor-next aria-label="Next reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9.5 6.5 15 12l-5.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    {%- comment -%} Fallback reviews from blocks {%- endcomment -%}
    <div class="scale-o-reviews__fallback" hidden>
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <span
            data-sor-fallback-review
            data-title="{{ block.settings.title | escape }}"
            data-body="{{ block.settings.body | escape }}"
            data-author="{{ block.settings.author | escape }}"
            {% if block.settings.image != blank %}
              data-image="{{ block.settings.image | image_url: width: 160 }}"
            {% elsif default_thumb_url != blank %}
              data-image="{{ default_thumb_url }}"
            {% endif %}
            {{ block.shopify_attributes }}
          ></span>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Hidden Judge.me source for live review data {%- endcomment -%}
    <div class="scale-o-reviews__jm-source" data-sor-jm-source aria-hidden="true">
      {% render 'scale-o-judgeme-carousel' %}
    </div>
  </div>
</section>

<script src="{{ 'scale-o-reviews.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Customer Reviews",
  "tag": "section",
  "class": "scale-o-reviews-section",
  "max_blocks": 15,
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "REVIEWS" },
    { "type": "checkbox", "id": "auto_heading_count", "label": "Auto heading with review count", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 100+ Happy Homes", "info": "Used when auto heading is off." },
    { "type": "textarea", "id": "description", "label": "Supporting text", "default": "Real experiences from real customers who trust Scale-O." },
    { "type": "checkbox", "id": "show_rating_summary", "label": "Show star rating row", "default": true },
    { "type": "text", "id": "reviews_count_label", "label": "Review count label", "default": "from [count] reviews", "info": "Use [count] for live review total." },
    { "type": "checkbox", "id": "show_verified_badge", "label": "Show verified badge", "default": true },

    { "type": "header", "content": "Carousel" },
    { "type": "range", "id": "cards_per_page", "label": "Cards per page (desktop)", "min": 1, "max": 3, "step": 1, "default": 3 },
    { "type": "image_picker", "id": "default_product_image", "label": "Default product thumbnail", "info": "Used when a review has no product image. On product pages, the current product image is used automatically." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 960, "max": 1280, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 12, "max": 28, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "padding_x", "label": "Side padding", "min": 16, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 24, "max": 72, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 24, "max": 72, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 11, "max": 16, "step": 1, "unit": "px", "default": 13 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background start", "default": "#F8FCFF" },
    { "type": "color", "id": "background_color_end", "label": "Background end", "default": "#EEF6FF" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#D7E8F8" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#142B4A" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#5A6B80" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "accent_hover_color", "label": "Accent hover", "default": "#0A6BC4" },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#F5B301" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Customer reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Fallback review",
      "settings": [
        { "type": "text", "id": "title", "label": "Review title", "default": "Nice result" },
        { "type": "textarea", "id": "body", "label": "Review text", "default": "Water quality is visibly better. No more white deposits in bathroom and utensils. Totally worth it!" },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Dr Sagar Ghanghav" },
        { "type": "image_picker", "id": "image", "label": "Product thumbnail" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Nice result",
            "body": "Water quality is visibly better. No more white deposits in bathroom and utensils. Totally worth it!",
            "author": "Dr Sagar Ghanghav"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "So convenient to use",
            "body": "Found the concept really innovative and super easy to install and maintain. Need of the hour!!",
            "author": "Jayraj Soni"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Recommended",
            "body": "I'd suggest this product for smaller tanks only. We installed at our house few weeks back, results are okay but improving slowly...",
            "author": "John D'souza"
          }
        }
      ]
    }
  ]
}
{% endschema %}
