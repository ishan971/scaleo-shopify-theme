{%- comment -%}
  Scale-O Technology Comparison — visual product cards + feature rows
{%- endcomment -%}

{{ 'scale-o-tech-compare.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tech_blocks = section.blocks | where: 'type', 'technology'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign header_align = section.settings.header_alignment
  assign tech_count = tech_blocks.size
  if tech_count > 4
    assign tech_count = 4
  endif

  assign show_header = false
  if section.settings.heading != blank
    assign show_header = true
  endif
  if section.settings.show_eyebrow and section.settings.eyebrow != blank
    assign show_header = true
  endif
  if section.settings.show_description and section.settings.description != blank
    assign show_header = true
  endif

  assign show_banner = false
  if section.settings.show_cta_banner
    if section.settings.banner_heading != blank or section.settings.banner_text != blank or section.settings.cta_text != blank
      assign show_banner = true
    endif
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-compare {
    --stc-bg: {{ section.settings.background_color }};
    --stc-heading: {{ section.settings.heading_color }};
    --stc-text: {{ section.settings.text_color }};
    --stc-accent: {{ section.settings.accent_color }};
    --stc-accent-hover: {{ section.settings.accent_hover_color }};
    --stc-card-bg: {{ section.settings.card_background }};
    --stc-card-border: {{ section.settings.card_border_color }};
    --stc-matrix-bg: {{ section.settings.matrix_background }};
    --stc-radius: {{ section.settings.card_radius }}px;
    --stc-cols: {{ tech_count }};
    --stc-shadow: 0 10px 28px rgba(26, 43, 74, 0.06);
    --stc-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --stc-heading-size: {{ section.settings.heading_size_mobile }}px;
    --stc-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --stc-desc-size: {{ section.settings.description_size }}px;
    --stc-pad-x: {{ section.settings.padding_x }}px;
    --stc-header-gap: {{ section.settings.header_gap }}px;
    --stc-header-align: {{ header_align }};
    --stc-max-width: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --stc-image-ratio: {{ section.settings.image_aspect_ratio }};
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: var(--stc-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-compare {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<div
  class="scale-o-compare"
  data-section-id="{{ section.id }}"
  data-mobile-layout="{{ section.settings.mobile_layout }}"
  data-animate="{% if section.settings.enable_animations %}true{% else %}false{% endif %}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Technology comparison' | escape }}"
>
  <div class="scale-o-compare__container">
    {%- if show_header -%}
      <header class="scale-o-compare__header scale-o-compare__header--{{ header_align }}" data-stc-animate>
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
          <p class="scale-o-compare__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="scale-o-compare__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.show_description and section.settings.description != blank -%}
          <p class="scale-o-compare__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if tech_count > 0 -%}
      <div class="scale-o-compare__cards-row">
        <div class="scale-o-compare__cards-spacer" aria-hidden="true"></div>
        <div class="scale-o-compare__cards" data-stc-cards>
          {%- for block in tech_blocks limit: 4 -%}
            {%- liquid
              assign card_image = block.settings.image
              if card_image == blank and block.settings.product != blank
                assign card_image = block.settings.product.featured_image
              endif
              assign card_mobile = block.settings.image_mobile | default: card_image
              assign card_alt = block.settings.image_alt | default: block.settings.title | default: 'Technology'
              assign is_highlight = block.settings.highlight
              assign use_fallback = false
              if card_image == blank and is_highlight
                assign use_fallback = true
              endif
            -%}
            <article
              class="scale-o-compare__card{% if is_highlight %} scale-o-compare__card--highlight{% endif %}"
              data-stc-animate
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
                <p class="scale-o-compare__badge">
                  <span aria-hidden="true">★</span>
                  {{ block.settings.badge_text | escape }}
                </p>
              {%- endif -%}
              <div class="scale-o-compare__media">
                {%- if card_image != blank -%}
                  <picture>
                    {%- if block.settings.image_mobile != blank -%}
                      <source media="(max-width: 767px)" srcset="{{ card_mobile | image_url: width: 800 }}">
                    {%- endif -%}
                    {{
                      card_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '400,700,900',
                        sizes: '(max-width: 767px) 80vw, 25vw',
                        alt: card_alt
                    }}
                  </picture>
                {%- elsif use_fallback -%}
                  <img src="{{ 'scale-o-solution-product.png' | asset_url }}" alt="{{ card_alt | escape }}" width="900" height="675" loading="lazy">
                {%- else -%}
                  <div class="scale-o-compare__placeholder" aria-hidden="true">
                    {% render 'scale-o-compare-icon', icon: block.settings.theme_icon, class: 'scale-o-compare__placeholder-svg' %}
                  </div>
                {%- endif -%}

                {%- if section.settings.show_card_icons and block.settings.show_icon -%}
                  <span class="scale-o-compare__card-icon" aria-hidden="true">
                    {%- if block.settings.icon_image != blank -%}
                      {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
                    {%- else -%}
                      {% render 'scale-o-compare-icon', icon: block.settings.theme_icon, class: 'scale-o-compare__icon-svg' %}
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </div>

              <div class="scale-o-compare__body">
                {%- if block.settings.category_label != blank -%}
                  <p class="scale-o-compare__category">{{ block.settings.category_label | escape }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="scale-o-compare__name">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="scale-o-compare__card-text">{{ block.settings.description | escape }}</p>
                {%- endif -%}
                {%- if block.settings.cta_text != blank -%}
                  <a class="scale-o-compare__card-link" href="{{ block.settings.cta_url | default: '#' }}">{{ block.settings.cta_text | escape }}</a>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_features and feature_blocks.size > 0 and tech_count > 0 -%}
      <div class="scale-o-compare__matrix" data-stc-animate>
        {%- for block in feature_blocks -%}
          <div class="scale-o-compare__row" {{ block.shopify_attributes }}>
            <div class="scale-o-compare__feature">
              <span class="scale-o-compare__feature-icon" aria-hidden="true">
                {%- if block.settings.icon_image != blank -%}
                  {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  {% render 'scale-o-compare-icon', icon: block.settings.theme_icon, class: 'scale-o-compare__icon-svg' %}
                {%- endif -%}
              </span>
              {%- if block.settings.title != blank -%}
                <p class="scale-o-compare__feature-title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
            </div>
            {%- assign col_index = 0 -%}
            {%- for tech in tech_blocks limit: 4 -%}
              {%- assign col_index = col_index | plus: 1 -%}
              {%- if col_index == 1 -%}
                {% render 'scale-o-compare-cell', value: block.settings.value_1, status: block.settings.status_1, featured: tech.settings.highlight, short_label: tech.settings.title %}
              {%- elsif col_index == 2 -%}
                {% render 'scale-o-compare-cell', value: block.settings.value_2, status: block.settings.status_2, featured: tech.settings.highlight, short_label: tech.settings.title %}
              {%- elsif col_index == 3 -%}
                {% render 'scale-o-compare-cell', value: block.settings.value_3, status: block.settings.status_3, featured: tech.settings.highlight, short_label: tech.settings.title %}
              {%- elsif col_index == 4 -%}
                {% render 'scale-o-compare-cell', value: block.settings.value_4, status: block.settings.status_4, featured: tech.settings.highlight, short_label: tech.settings.title %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if show_banner -%}
      <div class="scale-o-compare__banner" data-stc-animate>
        <span class="scale-o-compare__banner-icon" aria-hidden="true">
          {% render 'scale-o-compare-icon', icon: section.settings.banner_icon, class: 'scale-o-compare__icon-svg' %}
        </span>
        <div class="scale-o-compare__banner-copy">
          {%- if section.settings.banner_heading != blank -%}
            <p class="scale-o-compare__banner-heading">{{ section.settings.banner_heading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.banner_text != blank -%}
            <p class="scale-o-compare__banner-text">{{ section.settings.banner_text | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.cta_text != blank -%}
          <a class="scale-o-compare__cta" href="{{ section.settings.cta_url | default: '#' }}">
            <span>{{ section.settings.cta_text | escape }}</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.enable_animations or section.settings.mobile_layout == 'carousel' -%}
  <script src="{{ 'scale-o-tech-compare.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Technology Comparison",
  "tag": "section",
  "class": "scale-o-compare-section",
  "max_blocks": 16,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMPARE THE TECHNOLOGIES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Scale-O Stands Apart" },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Compare the technologies that protect your home from hard-water scale and see why Scale-O is designed for simple, salt-free protection." },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "checkbox", "id": "show_features", "label": "Show feature comparison", "default": true },
    { "type": "checkbox", "id": "show_card_icons", "label": "Show card icons", "default": true, "info": "Turns all four technology card icons on or off." },

    { "type": "header", "content": "Conclusion banner" },
    { "type": "checkbox", "id": "show_cta_banner", "label": "Show conclusion banner", "default": true },
    {
      "type": "select",
      "id": "banner_icon",
      "label": "Banner icon",
      "default": "shield",
      "options": [
        { "value": "shield", "label": "Shield" },
        { "value": "droplet", "label": "Water" },
        { "value": "wrench", "label": "Install" },
        { "value": "none", "label": "None" }
      ]
    },
    { "type": "text", "id": "banner_heading", "label": "Banner heading", "default": "Simple. Salt-Free. Designed for Modern Homes." },
    { "type": "textarea", "id": "banner_text", "label": "Banner text", "default": "Scale-O helps protect your home from hard-water scale without the hassle of salt, electricity or regular maintenance." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Explore Scale-O Products" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 0, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Card image ratio",
      "default": "4 / 3",
      "options": [
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "16 / 10", "label": "16:10" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile card layout",
      "default": "carousel",
      "options": [
        { "value": "carousel", "label": "Swipe carousel" },
        { "value": "stack", "label": "Stacked cards" }
      ]
    },
    { "type": "range", "id": "card_radius", "label": "Corner radius", "min": 8, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "checkbox", "id": "enable_animations", "label": "Enable reveal animations", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_x", "label": "Horizontal padding", "min": 12, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "margin_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "header_gap", "label": "Header bottom gap", "min": 16, "max": 64, "step": 4, "unit": "px", "default": 28 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 24, "max": 56, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 40, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 16 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "matrix_background", "label": "Comparison background", "default": "#F7FBFF" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#E8EEF8" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#12345B" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5A6B85" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "accent_hover_color", "label": "Accent hover", "default": "#0A6BC4" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Technology comparison" }
  ],
  "blocks": [
    {
      "type": "technology",
      "name": "Technology",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Technology name", "default": "Scale-O Water Softener" },
        { "type": "text", "id": "category_label", "label": "Category label" },
        { "type": "textarea", "id": "description", "label": "Short description", "default": "Salt-free scale protection designed for simple installation and zero operating requirements." },
        { "type": "product", "id": "product", "label": "Shopify product", "info": "Uses the product image if no custom image is uploaded." },
        { "type": "image_picker", "id": "image", "label": "Product image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Product image (mobile)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        {
          "type": "select",
          "id": "theme_icon",
          "label": "Icon",
          "default": "droplet",
          "options": [
            { "value": "bucket", "label": "Salt / bucket" },
            { "value": "pipe", "label": "Pipe" },
            { "value": "gear", "label": "Media / gears" },
            { "value": "droplet", "label": "Water" },
            { "value": "shield", "label": "Shield" },
            { "value": "none", "label": "None" }
          ]
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" },
        { "type": "checkbox", "id": "show_icon", "label": "Show icon on this card", "default": true },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this technology", "default": false },
        { "type": "checkbox", "id": "show_badge", "label": "Show badge", "default": false },
        { "type": "text", "id": "badge_text", "label": "Badge text", "default": "RECOMMENDED" },
        { "type": "text", "id": "cta_text", "label": "Card CTA text" },
        { "type": "url", "id": "cta_url", "label": "Card CTA URL" }
      ]
    },
    {
      "type": "feature",
      "name": "Comparison feature",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "title", "label": "Feature name", "default": "Installation" },
        {
          "type": "select",
          "id": "theme_icon",
          "label": "Icon",
          "default": "wrench",
          "options": [
            { "value": "wrench", "label": "Installation" },
            { "value": "screen", "label": "Plumbing / screen" },
            { "value": "shield", "label": "Shield" },
            { "value": "bolt", "label": "Electricity" },
            { "value": "gear", "label": "Regeneration" },
            { "value": "droplet", "label": "Water" },
            { "value": "settings", "label": "Maintenance" },
            { "value": "dollar", "label": "Cost" },
            { "value": "none", "label": "None" }
          ]
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" },
        { "type": "header", "content": "Column 1 (first technology)" },
        { "type": "text", "id": "value_1", "label": "Value" },
        {
          "type": "select",
          "id": "status_1",
          "label": "Status",
          "default": "neutral",
          "options": [
            { "value": "positive", "label": "Positive" },
            { "value": "negative", "label": "Negative" },
            { "value": "neutral", "label": "Neutral" },
            { "value": "required", "label": "Required" },
            { "value": "not_required", "label": "Not required" },
            { "value": "low", "label": "Low" },
            { "value": "medium", "label": "Medium" },
            { "value": "high", "label": "High" }
          ]
        },
        { "type": "header", "content": "Column 2" },
        { "type": "text", "id": "value_2", "label": "Value" },
        {
          "type": "select",
          "id": "status_2",
          "label": "Status",
          "default": "neutral",
          "options": [
            { "value": "positive", "label": "Positive" },
            { "value": "negative", "label": "Negative" },
            { "value": "neutral", "label": "Neutral" },
            { "value": "required", "label": "Required" },
            { "value": "not_required", "label": "Not required" },
            { "value": "low", "label": "Low" },
            { "value": "medium", "label": "Medium" },
            { "value": "high", "label": "High" }
          ]
        },
        { "type": "header", "content": "Column 3" },
        { "type": "text", "id": "value_3", "label": "Value" },
        {
          "type": "select",
          "id": "status_3",
          "label": "Status",
          "default": "neutral",
          "options": [
            { "value": "positive", "label": "Positive" },
            { "value": "negative", "label": "Negative" },
            { "value": "neutral", "label": "Neutral" },
            { "value": "required", "label": "Required" },
            { "value": "not_required", "label": "Not required" },
            { "value": "low", "label": "Low" },
            { "value": "medium", "label": "Medium" },
            { "value": "high", "label": "High" }
          ]
        },
        { "type": "header", "content": "Column 4 (usually Scale-O)" },
        { "type": "text", "id": "value_4", "label": "Value" },
        {
          "type": "select",
          "id": "status_4",
          "label": "Status",
          "default": "positive",
          "options": [
            { "value": "positive", "label": "Positive" },
            { "value": "negative", "label": "Negative" },
            { "value": "neutral", "label": "Neutral" },
            { "value": "required", "label": "Required" },
            { "value": "not_required", "label": "Not required" },
            { "value": "low", "label": "Low" },
            { "value": "medium", "label": "Medium" },
            { "value": "high", "label": "High" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Technology Comparison",
      "category": "Custom",
      "blocks": [
        { "type": "technology", "settings": { "title": "Salt-Based Water Softener", "description": "Traditional ion-exchange softening using salt and regeneration.", "theme_icon": "bucket", "highlight": false } },
        { "type": "technology", "settings": { "title": "Electro-Magnetic Water Softener", "description": "Electronic or electromagnetic technology designed to reduce scale formation.", "theme_icon": "pipe", "highlight": false } },
