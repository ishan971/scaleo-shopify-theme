{%- comment -%}
  Scale-O Core Competitor Comparison — compact 5-column decision matrix
{%- endcomment -%}

{{ 'scale-o-tech-compare.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tech_blocks = section.blocks | where: 'type', 'technology'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign header_align = section.settings.header_alignment
  assign tech_count = 0
  for block in tech_blocks
    if block.settings.enabled == false
      continue
    endif
    assign tech_count = tech_count | plus: 1
    if tech_count >= 4
      break
    endif
  endfor

  assign show_header = false
  if section.settings.heading != blank
    assign show_header = true
  endif
  if section.settings.show_eyebrow and section.settings.eyebrow != blank
    assign show_header = true
  endif
  if section.settings.show_description and section.settings.description != blank
    assign show_header = true
  endif

  assign show_banner = false
  if section.settings.show_cta_banner
    if section.settings.banner_heading != blank or section.settings.banner_text != blank or section.settings.cta_text != blank
      assign show_banner = true
    endif
  endif

  assign highlight_color = section.settings.highlight_color | default: section.settings.accent_color
  assign highlight_bg = section.settings.highlight_background | default: '#E8F3FC'
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-compare {
    --stc-bg: {{ section.settings.background_color }};
    --stc-heading: {{ section.settings.heading_color }};
    --stc-text: {{ section.settings.text_color }};
    --stc-accent: {{ section.settings.accent_color }};
    --stc-accent-hover: {{ section.settings.accent_hover_color }};
    --stc-card-bg: {{ section.settings.card_background }};
    --stc-card-border: {{ section.settings.card_border_color }};
    --stc-matrix-bg: {{ section.settings.matrix_background }};
    --stc-highlight: {{ highlight_color }};
    --stc-highlight-bg: {{ highlight_bg }};
    --stc-radius: {{ section.settings.card_radius }}px;
    --stc-cols: {{ tech_count }};
    --stc-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --stc-heading-size: {{ section.settings.heading_size_mobile }}px;
    --stc-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --stc-desc-size: {{ section.settings.description_size }}px;
    --stc-pad-x: {{ section.settings.padding_x }}px;
    --stc-header-gap: {{ section.settings.header_gap }}px;
    --stc-header-align: {{ header_align }};
    --stc-max-width: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --stc-image-ratio: {{ section.settings.image_aspect_ratio }};
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: var(--stc-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-compare {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<div
  class="scale-o-compare"
  data-section-id="{{ section.id }}"
  data-mobile-layout="{{ section.settings.mobile_layout }}"
  data-animate="{% if section.settings.enable_animations %}true{% else %}false{% endif %}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Competitor comparison' | escape }}"
>
  <div class="scale-o-compare__container">
    {%- if show_header -%}
      <header class="scale-o-compare__header scale-o-compare__header--{{ header_align }}" data-stc-animate>
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
          <p class="scale-o-compare__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="scale-o-compare__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.show_description and section.settings.description != blank -%}
          <p class="scale-o-compare__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if tech_count > 0 -%}
      <div class="scale-o-compare__board" data-stc-animate>
        <div class="scale-o-compare__scroll" tabindex="0" role="region" aria-label="{{ section.settings.heading | default: 'Competitor comparison' | escape }} table">
          <table class="scale-o-compare__table">
            <caption class="scale-o-compare__sr-only">{{ section.settings.heading | default: 'Competitor comparison' | escape }}</caption>
            <colgroup>
              {%- if section.settings.show_features -%}
                <col class="scale-o-compare__col scale-o-compare__col--criteria">
              {%- endif -%}
              {%- assign visible = 0 -%}
              {%- for block in tech_blocks -%}
                {%- if block.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                {%- assign visible = visible | plus: 1 -%}
                {%- if visible > 4 -%}{%- break -%}{%- endif -%}
                <col class="scale-o-compare__col{% if block.settings.highlight %} scale-o-compare__col--featured{% endif %}">
              {%- endfor -%}
            </colgroup>
            <thead>
              <tr>
                {%- if section.settings.show_features -%}
                  <th class="scale-o-compare__th scale-o-compare__th--criteria" scope="col">
                    <span class="scale-o-compare__criteria-label">{{ section.settings.criteria_heading | default: 'Comparison Criteria' | escape }}</span>
                  </th>
                {%- endif -%}
                {%- assign visible = 0 -%}
                {%- for block in tech_blocks -%}
                  {%- if block.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                  {%- assign visible = visible | plus: 1 -%}
                  {%- if visible > 4 -%}{%- break -%}{%- endif -%}
                  {%- liquid
                    assign card_image = block.settings.image
                    if card_image == blank and block.settings.product != blank
                      assign card_image = block.settings.product.featured_image
                    endif
                    assign card_mobile = block.settings.image_mobile | default: card_image
                    assign card_alt = block.settings.image_alt | default: block.settings.title | default: 'Competitor'
                    assign is_highlight = block.settings.highlight
                    assign use_fallback = false
                    if card_image == blank and is_highlight
                      assign use_fallback = true
                    endif
                  -%}
                  <th
                    class="scale-o-compare__th scale-o-compare__th--product{% if is_highlight %} scale-o-compare__th--featured{% endif %}"
                    scope="col"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
                      <span class="scale-o-compare__badge">
                        <span aria-hidden="true">★</span>
                        {{ block.settings.badge_text | escape }}
                      </span>
                    {%- endif -%}
                    {%- if section.settings.show_column_images -%}
                      <div class="scale-o-compare__media{% if is_highlight %} scale-o-compare__media--featured{% endif %}">
                        {%- if card_image != blank -%}
                          <picture>
                            {%- if block.settings.image_mobile != blank -%}
                              <source media="(max-width: 767px)" srcset="{{ card_mobile | image_url: width: 480 }}">
                            {%- endif -%}
                            {{
                              card_image
                              | image_url: width: 480
                              | image_tag:
                                loading: 'lazy',
                                widths: '240,360,480',
                                sizes: '(max-width: 767px) 42vw, 180px',
                                alt: card_alt
                            }}
                          </picture>
                        {%- elsif use_fallback -%}
                          <img src="{{ 'scale-o-solution-product.png' | asset_url }}" alt="{{ card_alt | escape }}" width="480" height="360" loading="lazy">
                        {%- else -%}
                          <div class="scale-o-compare__placeholder" aria-hidden="true">
                            {% render 'scale-o-compare-icon', icon: block.settings.theme_icon, class: 'scale-o-compare__placeholder-svg' %}
                          </div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.title != blank -%}
                      <span class="scale-o-compare__name">{{ block.settings.title | escape }}</span>
                    {%- endif -%}
                    {%- if section.settings.show_column_descriptions and block.settings.description != blank -%}
                      <span class="scale-o-compare__col-text">{{ block.settings.description | escape }}</span>
                    {%- endif -%}
                  </th>
                {%- endfor -%}
              </tr>
            </thead>
            {%- if section.settings.show_features and feature_blocks.size > 0 -%}
              <tbody>
                {%- for block in feature_blocks -%}
                  {%- if block.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                  <tr class="scale-o-compare__row" {{ block.shopify_attributes }}>
                    <th class="scale-o-compare__feature" scope="row">
                      <span class="scale-o-compare__feature-icon" aria-hidden="true">
                        {%- if block.settings.icon_image != blank -%}
                          {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy', alt: '' }}
                        {%- else -%}
                          {% render 'scale-o-compare-icon', icon: block.settings.theme_icon, class: 'scale-o-compare__icon-svg' %}
                        {%- endif -%}
                      </span>
                      {%- if block.settings.title != blank -%}
                        <span class="scale-o-compare__feature-title">{{ block.settings.title | escape }}</span>
                      {%- endif -%}
                    </th>
                    {%- assign visible = 0 -%}
                    {%- for tech in tech_blocks -%}
                      {%- if tech.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                      {%- assign visible = visible | plus: 1 -%}
                      {%- if visible > 4 -%}{%- break -%}{%- endif -%}
                      {%- assign col_index = forloop.index -%}
                      <td class="scale-o-compare__td{% if tech.settings.highlight %} scale-o-compare__td--featured{% endif %}">
                        {%- case col_index -%}
                          {%- when 1 -%}
                            {% render 'scale-o-compare-cell', value: block.settings.value_1, status: block.settings.status_1, featured: tech.settings.highlight, short_label: tech.settings.title %}
                          {%- when 2 -%}
                            {% render 'scale-o-compare-cell', value: block.settings.value_2, status: block.settings.status_2, featured: tech.settings.highlight, short_label: tech.settings.title %}
                          {%- when 3 -%}
                            {% render 'scale-o-compare-cell', value: block.settings.value_3, status: block.settings.status_3, featured: tech.settings.highlight, short_label: tech.settings.title %}
                          {%- when 4 -%}
                            {% render 'scale-o-compare-cell', value: block.settings.value_4, status: block.settings.status_4, featured: tech.settings.highlight, short_label: tech.settings.title %}
                        {%- endcase -%}
                      </td>
                    {%- endfor -%}
                  </tr>
                {%- endfor -%}
              </tbody>
            {%- endif -%}
          </table>
        </div>
      </div>

      {%- if section.settings.mobile_layout == 'stack' -%}
        <div class="scale-o-compare__stack" data-stc-animate>
          {%- assign visible = 0 -%}
          {%- for tech in tech_blocks -%}
            {%- if tech.settings.enabled == false -%}{%- continue -%}{%- endif -%}
            {%- assign visible = visible | plus: 1 -%}
            {%- if visible > 4 -%}{%- break -%}{%- endif -%}
            {%- liquid
              assign col_index = forloop.index
              assign card_image = tech.settings.image
              if card_image == blank and tech.settings.product != blank
                assign card_image = tech.settings.product.featured_image
              endif
              assign card_alt = tech.settings.image_alt | default: tech.settings.title | default: 'Competitor'
              assign is_highlight = tech.settings.highlight
            -%}
            <article class="scale-o-compare__stack-card{% if is_highlight %} scale-o-compare__stack-card--featured{% endif %}" {{ tech.shopify_attributes }}>
              {%- if tech.settings.show_badge and tech.settings.badge_text != blank -%}
                <p class="scale-o-compare__badge">
                  <span aria-hidden="true">★</span>
                  {{ tech.settings.badge_text | escape }}
                </p>
              {%- endif -%}
              {%- if section.settings.show_column_images -%}
                <div class="scale-o-compare__media{% if is_highlight %} scale-o-compare__media--featured{% endif %}">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 640
                      | image_tag:
                        loading: 'lazy',
                        widths: '320,480,640',
                        sizes: '86vw',
                        alt: card_alt
                    }}
                  {%- elsif is_highlight -%}
                    <img src="{{ 'scale-o-solution-product.png' | asset_url }}" alt="{{ card_alt | escape }}" width="640" height="480" loading="lazy">
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if tech.settings.title != blank -%}
                <h3 class="scale-o-compare__name">{{ tech.settings.title | escape }}</h3>
              {%- endif -%}
              {%- for feature in feature_blocks -%}
                {%- if feature.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                <div class="scale-o-compare__stack-row">
                  <span class="scale-o-compare__stack-label">{{ feature.settings.title | escape }}</span>
                  {%- case col_index -%}
                    {%- when 1 -%}
                      {% render 'scale-o-compare-cell', value: feature.settings.value_1, status: feature.settings.status_1, featured: is_highlight %}
                    {%- when 2 -%}
                      {% render 'scale-o-compare-cell', value: feature.settings.value_2, status: feature.settings.status_2, featured: is_highlight %}
                    {%- when 3 -%}
                      {% render 'scale-o-compare-cell', value: feature.settings.value_3, status: feature.settings.status_3, featured: is_highlight %}
                    {%- when 4 -%}
                      {% render 'scale-o-compare-cell', value: feature.settings.value_4, status: feature.settings.status_4, featured: is_highlight %}
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if show_banner -%}
      <div class="scale-o-compare__banner" data-stc-animate>
        <span class="scale-o-compare__banner-icon" aria-hidden="true">
          {% render 'scale-o-compare-icon', icon: section.settings.banner_icon, class: 'scale-o-compare__icon-svg' %}
        </span>
        <div class="scale-o-compare__banner-copy">
          {%- if section.settings.banner_heading != blank -%}
            <p class="scale-o-compare__banner-heading">{{ section.settings.banner_heading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.banner_text != blank -%}
            <p class="scale-o-compare__banner-text">{{ section.settings.banner_text | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.cta_text != blank -%}
          <a class="scale-o-compare__cta" href="{{ section.settings.cta_url | default: '#' }}">
            <span>{{ section.settings.cta_text | escape }}</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.enable_animations -%}
  <script src="{{ 'scale-o-tech-compare.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Competitor Comparison",
  "tag": "section",
  "class": "scale-o-compare-section",
  "max_blocks": 24,
  "settings": [
    { "type": "header", "content": "How to edit" },
    { "type": "paragraph", "content": "Use Competitor column blocks for the 4 product columns (name, image, badge). Use Comparison row blocks for each criterion. Add, remove, or drag blocks to reorder. Column 1–4 values in each row follow the Competitor block order." },
    { "type": "header", "content": "Heading" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMPETITOR COMPARISON", "info": "Small label above the heading." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Scale-O vs Similar Solutions" },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "textarea", "id": "description", "label": "Description", "default": "See how Scale-O compares with other solutions designed to tackle hard-water scaling." },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "text", "id": "criteria_heading", "label": "First column heading", "default": "COMPARISON CRITERIA" },
    { "type": "checkbox", "id": "show_features", "label": "Show comparison rows", "default": true },
    { "type": "checkbox", "id": "show_column_images", "label": "Show column images", "default": true },
    { "type": "checkbox", "id": "show_column_descriptions", "label": "Show column descriptions", "default": false },
    { "type": "checkbox", "id": "show_card_icons", "label": "Show card icons", "default": false },

    { "type": "header", "content": "Scale-O column" },
    { "type": "color", "id": "highlight_color", "label": "Highlight color", "default": "#0C7FDF" },
    { "type": "color", "id": "highlight_background", "label": "Highlight background", "default": "#E8F3FC" },

    { "type": "header", "content": "Conclusion banner" },
    { "type": "checkbox", "id": "show_cta_banner", "label": "Show conclusion banner", "default": true },
    {
      "type": "select",
      "id": "banner_icon",
      "label": "Banner icon",
      "default": "shield",
      "options": [
        { "value": "shield", "label": "Shield" },
        { "value": "droplet", "label": "Water" },
        { "value": "wrench", "label": "Install" },
        { "value": "none", "label": "None" }
      ]
    },
    { "type": "text", "id": "banner_heading", "label": "Banner heading" },
    { "type": "textarea", "id": "banner_text", "label": "Banner text", "default": "Scale-O delivers salt-free, maintenance-free protection that’s simple, efficient and built for modern homes." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Explore Scale-O Products" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 0, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Column image ratio",
      "default": "4 / 3",
      "options": [
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "16 / 10", "label": "16:10" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "scroll",
      "options": [
        { "value": "scroll", "label": "Horizontal scroll" },
        { "value": "stack", "label": "Stacked cards" }
      ]
    },
    { "type": "range", "id": "card_radius", "label": "Corner radius", "min": 8, "max": 28, "step": 1, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "enable_animations", "label": "Enable reveal animations", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_x", "label": "Horizontal padding", "min": 12, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "margin_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "header_gap", "label": "Header bottom gap", "min": 16, "max": 64, "step": 4, "unit": "px", "default": 32 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Label size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 24, "max": 56, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 40, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 16 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "matrix_background", "label": "Banner background", "default": "#EEF6FF" },
    { "type": "color", "id": "card_background", "label": "Board background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Board border", "default": "#E4ECF6" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#12345B" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5A6B85" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "accent_hover_color", "label": "Accent hover", "default": "#0A6BC4" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Competitor comparison" }
  ],
  "blocks": [
    {
      "type": "technology",
      "name": "Competitor column",
      "limit": 4,
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Show this column", "default": true },
        { "type": "text", "id": "title", "label": "Column title", "default": "Scale-O Water Softener" },
        { "type": "text", "id": "category_label", "label": "Category label" },
        { "type": "textarea", "id": "description", "label": "Short description", "default": "Salt-free scale protection designed for simple installation and zero operating requirements." },
        { "type": "product", "id": "product", "label": "Shopify product", "info": "Uses the product image if no custom image is uploaded." },
        { "type": "image_picker", "id": "image", "label": "Column image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Column image (mobile)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        {
          "type": "select",
          "id": "theme_icon",
          "label": "Placeholder icon",
          "default": "droplet",
          "options": [
            { "value": "bucket", "label": "Salt / bucket" },
            { "value": "pipe", "label": "Pipe" },
            { "value": "gear", "label": "Media / gears" },
            { "value": "droplet", "label": "Water" },
            { "value": "shield", "label": "Shield" },
            { "value": "none", "label": "None" }
          ]
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" },
        { "type": "checkbox", "id": "show_icon", "label": "Show icon on this card", "default": false },
        { "type": "checkbox", "id": "highlight", "label": "Highlight as Scale-O column", "default": false },
