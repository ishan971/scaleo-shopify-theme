{%- comment -%}
  Scale-O comparison: technology photo table + premium competitor comparison cards
{%- endcomment -%}

{{ 'scale-o-tech-compare.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tech_blocks = section.blocks | where: 'type', 'technology'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign competitor_blocks = section.blocks | where: 'type', 'competitor'
  assign competitor_rows = section.blocks | where: 'type', 'competitor_row'
  assign header_align = section.settings.header_alignment
  assign highlight_color = section.settings.highlight_color | default: section.settings.accent_color
  assign highlight_bg = section.settings.highlight_background | default: '#E8F3FC'

  assign tech_count = 0
  for block in tech_blocks
    if block.settings.enabled == false
      continue
    endif
    assign tech_count = tech_count | plus: 1
    if tech_count >= 4
      break
    endif
  endfor

  assign competitor_count = 0
  for block in competitor_blocks
    if block.settings.enabled == false
      continue
    endif
    assign competitor_count = competitor_count | plus: 1
    if competitor_count >= 4
      break
    endif
  endfor

  assign show_tech_header = false
  if section.settings.show_tech
    if section.settings.tech_heading != blank or section.settings.show_tech_eyebrow and section.settings.tech_eyebrow != blank or section.settings.show_tech_description and section.settings.tech_description != blank
      assign show_tech_header = true
    endif
  endif

  assign show_comp_header = false
  if section.settings.show_competitors
    if section.settings.heading != blank or section.settings.show_eyebrow and section.settings.eyebrow != blank or section.settings.show_description and section.settings.description != blank
      assign show_comp_header = true
    endif
  endif

  assign show_banner = false
  if section.settings.show_cta_banner
    if section.settings.banner_heading != blank or section.settings.banner_text != blank or section.settings.cta_text != blank
      assign show_banner = true
    endif
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-compare {
    --stc-bg: {{ section.settings.background_color }};
    --stc-heading: {{ section.settings.heading_color }};
    --stc-text: {{ section.settings.text_color }};
    --stc-accent: {{ section.settings.accent_color }};
    --stc-accent-hover: {{ section.settings.accent_hover_color }};
    --stc-card-bg: {{ section.settings.card_background }};
    --stc-card-border: {{ section.settings.card_border_color }};
    --stc-matrix-bg: {{ section.settings.matrix_background }};
    --stc-highlight: {{ highlight_color }};
    --stc-highlight-bg: {{ highlight_bg }};
    --stc-radius: {{ section.settings.card_radius }}px;
    --stc-cols: {{ tech_count }};
    --stc-comp-cols: {{ competitor_count }};
    --stc-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --stc-heading-size: {{ section.settings.heading_size_mobile }}px;
    --stc-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --stc-desc-size: {{ section.settings.description_size }}px;
    --stc-pad-x: {{ section.settings.padding_x }}px;
    --stc-header-gap: {{ section.settings.header_gap }}px;
    --stc-header-align: {{ header_align }};
    --stc-max-width: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --stc-image-ratio: {{ section.settings.image_aspect_ratio }};
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: var(--stc-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-compare {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<div
  class="scale-o-compare"
  data-section-id="{{ section.id }}"
  data-animate="{% if section.settings.enable_animations %}true{% else %}false{% endif %}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Scale-O comparison' | escape }}"
>
  <div class="scale-o-compare__container">
    {%- if section.settings.show_tech and tech_count > 0 -%}
      {%- if show_tech_header -%}
        <header class="scale-o-compare__header scale-o-compare__header--{{ header_align }}" data-stc-animate>
          {%- if section.settings.show_tech_eyebrow and section.settings.tech_eyebrow != blank -%}
            <p class="scale-o-compare__eyebrow">{{ section.settings.tech_eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.tech_heading != blank -%}
            <h2 class="scale-o-compare__heading">{{ section.settings.tech_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.show_tech_description and section.settings.tech_description != blank -%}
            <p class="scale-o-compare__description">{{ section.settings.tech_description | escape }}</p>
          {%- endif -%}
        </header>
      {%- endif -%}

      <div class="scale-o-compare__board scale-o-compare__board--desktop" data-stc-animate>
        <div class="scale-o-compare__board-wrap" tabindex="0" role="region" aria-label="{{ section.settings.tech_heading | default: 'Technology comparison' | escape }}">
          <table class="scale-o-compare__board-table">
            <caption class="scale-o-compare__sr-only">{{ section.settings.tech_heading | default: 'Technology comparison' | escape }}</caption>
            <colgroup>
              {%- if section.settings.show_features -%}
                <col class="scale-o-compare__col scale-o-compare__col--criteria">
              {%- endif -%}
              {%- assign visible = 0 -%}
              {%- for tech in tech_blocks -%}
                {%- if tech.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                {%- assign visible = visible | plus: 1 -%}
                {%- if visible > 4 -%}{%- break -%}{%- endif -%}
                <col class="scale-o-compare__col{% if tech.settings.highlight %} scale-o-compare__col--featured{% endif %}">
              {%- endfor -%}
            </colgroup>
            <thead>
              <tr>
                {%- if section.settings.show_features -%}
                  <th class="scale-o-compare__corner" scope="col">
                    <span>{{ section.settings.tech_criteria_heading | default: 'TECHNOLOGY' | escape }}</span>
                  </th>
                {%- endif -%}
                {%- assign visible = 0 -%}
                {%- for tech in tech_blocks -%}
                  {%- if tech.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                  {%- assign visible = visible | plus: 1 -%}
                  {%- if visible > 4 -%}{%- break -%}{%- endif -%}
                  {%- liquid
                    assign card_image = tech.settings.image
                    if card_image == blank and tech.settings.product != blank
                      assign card_image = tech.settings.product.featured_image
                    endif
                    assign card_mobile = tech.settings.image_mobile | default: card_image
                    assign card_alt = tech.settings.image_alt | default: tech.settings.title | default: 'Water treatment system'
                    assign is_highlight = tech.settings.highlight
                  -%}
                  <th
                    class="scale-o-compare__head{% if is_highlight %} scale-o-compare__head--featured{% endif %}"
                    scope="col"
                    {{ tech.shopify_attributes }}
                  >
                    <div class="scale-o-compare__card{% if is_highlight %} scale-o-compare__card--featured{% endif %}">
                      {%- if is_highlight and section.settings.show_recommended_badge -%}
                        <p class="scale-o-compare__recommend">
                          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                            <path d="M8 1.6 9.9 5.7l4.5.5-3.3 3 1 4.4L8 11.8 3.9 13.6l1-4.4-3.3-3 4.5-.5z"/>
                          </svg>
                          <span>{{ section.settings.recommended_label | default: 'Recommended' | escape }}</span>
                        </p>
                      {%- elsif tech.settings.show_badge and tech.settings.badge_text != blank -%}
                        <p class="scale-o-compare__badge">{{ tech.settings.badge_text | escape }}</p>
                      {%- endif -%}
                      <div class="scale-o-compare__photo">
                        {%- if card_image != blank -%}
                          <picture>
                            {%- if tech.settings.image_mobile != blank -%}
                              <source media="(max-width: 767px)" srcset="{{ card_mobile | image_url: width: 640 }}">
                            {%- endif -%}
                            {{
                              card_image
                              | image_url: width: 720
                              | image_tag:
                                loading: 'lazy',
                                widths: '240,360,480,720',
                                sizes: '(max-width: 767px) 46vw, 220px',
                                alt: card_alt
                            }}
                          </picture>
                        {%- elsif is_highlight -%}
                          <img src="{{ 'scale-o-solution-product.png' | asset_url }}" alt="{{ card_alt | escape }}" width="640" height="480" loading="lazy">
                        {%- else -%}
                          <div class="scale-o-compare__placeholder" aria-hidden="true">
                            {% render 'scale-o-compare-icon', icon: tech.settings.theme_icon, class: 'scale-o-compare__placeholder-svg' %}
                          </div>
                        {%- endif -%}
                      </div>
                      <div class="scale-o-compare__card-body">
                        <h3 class="scale-o-compare__card-title">{{ tech.settings.title | escape }}</h3>
                        {%- if section.settings.show_column_descriptions and tech.settings.description != blank -%}
                          <p class="scale-o-compare__card-text">{{ tech.settings.description | escape }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  </th>
                {%- endfor -%}
              </tr>
            </thead>
            {%- if section.settings.show_features and feature_blocks.size > 0 -%}
              <tbody>
                {%- if section.settings.show_tech_type_row -%}
                  <tr class="scale-o-compare__mini-row scale-o-compare__mini-row--type">
                    <th class="scale-o-compare__mini-feature" scope="row">{{ section.settings.tech_type_row_title | default: 'Technology' | escape }}</th>
                    {%- assign visible = 0 -%}
                    {%- for tech in tech_blocks -%}
                      {%- if tech.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                      {%- assign visible = visible | plus: 1 -%}
                      {%- if visible > 4 -%}{%- break -%}{%- endif -%}
                      <td class="scale-o-compare__mini-td{% if tech.settings.highlight %} scale-o-compare__mini-td--featured{% endif %}">
                        {%- case visible -%}
                          {%- when 1 -%}
                            {% render 'scale-o-compare-cell', value: section.settings.tech_type_value_1, status: 'neutral', featured: tech.settings.highlight, short_label: tech.settings.title %}
                          {%- when 2 -%}
                            {% render 'scale-o-compare-cell', value: section.settings.tech_type_value_2, status: 'neutral', featured: tech.settings.highlight, short_label: tech.settings.title %}
                          {%- when 3 -%}
                            {% render 'scale-o-compare-cell', value: section.settings.tech_type_value_3, status: 'neutral', featured: tech.settings.highlight, short_label: tech.settings.title %}
                          {%- when 4 -%}
                            {% render 'scale-o-compare-cell', value: section.settings.tech_type_value_4, status: 'neutral', featured: tech.settings.highlight, short_label: tech.settings.title %}
                        {%- endcase -%}
                      </td>
                    {%- endfor -%}
                  </tr>
                {%- endif -%}
                {%- for feature in feature_blocks -%}
                  {%- if feature.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                  <tr class="scale-o-compare__mini-row" {{ feature.shopify_attributes }}>
                    <th class="scale-o-compare__mini-feature" scope="row">{{ feature.settings.title | escape }}</th>
                    {%- assign visible = 0 -%}
                    {%- for tech in tech_blocks -%}
                      {%- if tech.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                      {%- assign visible = visible | plus: 1 -%}
                      {%- if visible > 4 -%}{%- break -%}{%- endif -%}
                      <td class="scale-o-compare__mini-td{% if tech.settings.highlight %} scale-o-compare__mini-td--featured{% endif %}">
                        {%- case visible -%}
                          {%- when 1 -%}
                            {% render 'scale-o-compare-cell', value: feature.settings.value_1, status: feature.settings.status_1, featured: tech.settings.highlight, short_label: tech.settings.title %}
                          {%- when 2 -%}
                            {% render 'scale-o-compare-cell', value: feature.settings.value_2, status: feature.settings.status_2, featured: tech.settings.highlight, short_label: tech.settings.title %}
                          {%- when 3 -%}
                            {% render 'scale-o-compare-cell', value: feature.settings.value_3, status: feature.settings.status_3, featured: tech.settings.highlight, short_label: tech.settings.title %}
                          {%- when 4 -%}
                            {% render 'scale-o-compare-cell', value: feature.settings.value_4, status: feature.settings.status_4, featured: tech.settings.highlight, short_label: tech.settings.title %}
                        {%- endcase -%}
                      </td>
                    {%- endfor -%}
                  </tr>
                {%- endfor -%}
              </tbody>
            {%- endif -%}
          </table>
        </div>
      </div>

      {%- comment -%} Mobile: 4 selectable cards + 2-column FEATURES / selected tech {%- endcomment -%}
      {%- liquid
        assign default_tech_index = 1
        assign visible = 0
        for tech in tech_blocks
          if tech.settings.enabled == false
            continue
          endif
          assign visible = visible | plus: 1
          if visible > 4
            break
          endif
          if tech.settings.highlight
            assign default_tech_index = visible
          endif
        endfor
      -%}
      <div
        class="scale-o-compare__mobile"
        data-stc-mobile
        data-stc-default="{{ default_tech_index }}"
        data-stc-animate
      >
        <div class="scale-o-compare__picker" role="radiogroup" aria-label="{{ section.settings.tech_heading | default: 'Select technology' | escape }}">
          {%- assign visible = 0 -%}
          {%- for tech in tech_blocks -%}
            {%- if tech.settings.enabled == false -%}{%- continue -%}{%- endif -%}
            {%- assign visible = visible | plus: 1 -%}
            {%- if visible > 4 -%}{%- break -%}{%- endif -%}
            {%- liquid
              assign card_image = tech.settings.image
              if card_image == blank and tech.settings.product != blank
                assign card_image = tech.settings.product.featured_image
              endif
              assign card_alt = tech.settings.image_alt | default: tech.settings.title
              assign is_highlight = tech.settings.highlight
              assign is_default = false
              if visible == default_tech_index
                assign is_default = true
              endif
              assign radio_id = 'stc-tech-' | append: section.id | append: '-' | append: visible
            -%}
            <label
              class="scale-o-compare__picker-card{% if is_default %} is-selected{% endif %}{% if is_highlight %} is-featured{% endif %}"
              for="{{ radio_id }}"
              {{ tech.shopify_attributes }}
            >
              <span class="scale-o-compare__picker-photo">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', widths: '80,120,160', sizes: '56px', alt: card_alt
                  }}
                {%- elsif is_highlight -%}
                  <img src="{{ 'scale-o-solution-product.png' | asset_url }}" alt="{{ card_alt | escape }}" width="56" height="56" loading="lazy">
                {%- else -%}
                  <span class="scale-o-compare__picker-fallback" aria-hidden="true">
                    {% render 'scale-o-compare-icon', icon: tech.settings.theme_icon, class: 'scale-o-compare__picker-fallback-svg' %}
                  </span>
                {%- endif -%}
              </span>
              <span class="scale-o-compare__picker-body">
                {%- if is_highlight and section.settings.show_recommended_badge -%}
                  <span class="scale-o-compare__picker-badge">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M8 1.6 9.9 5.7l4.5.5-3.3 3 1 4.4L8 11.8 3.9 13.6l1-4.4-3.3-3 4.5-.5z"/>
                    </svg>
                    {{ section.settings.recommended_label | default: 'Recommended' | escape }}
                  </span>
                {%- endif -%}
                <span class="scale-o-compare__picker-title">{{ tech.settings.title | escape }}</span>
              </span>
              <input
                class="scale-o-compare__picker-input"
                id="{{ radio_id }}"
                type="radio"
                name="stc-tech-{{ section.id }}"
                value="{{ visible }}"
                data-stc-tech-index="{{ visible }}"
                data-stc-tech-title="{{ tech.settings.title | escape }}"
                data-stc-tech-featured="{% if is_highlight %}true{% else %}false{% endif %}"
                {% if card_image != blank %}
                  data-stc-tech-image="{{ card_image | image_url: width: 120 }}"
                {% elsif is_highlight %}
                  data-stc-tech-image="{{ 'scale-o-solution-product.png' | asset_url }}"
                {% endif %}
                {% if is_default %}checked{% endif %}
              >
              <span class="scale-o-compare__picker-radio" aria-hidden="true"></span>
            </label>
          {%- endfor -%}
        </div>

        {%- if section.settings.show_features and feature_blocks.size > 0 -%}
          <div class="scale-o-compare__mobile-matrix">
            <div class="scale-o-compare__mobile-matrix-head">
              <div class="scale-o-compare__mobile-matrix-corner">
                Technology
              </div>
              <div class="scale-o-compare__mobile-matrix-tech" data-stc-mobile-head>
                {%- assign visible = 0 -%}
                {%- for tech in tech_blocks -%}
                  {%- if tech.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                  {%- assign visible = visible | plus: 1 -%}
                  {%- if visible > 4 -%}{%- break -%}{%- endif -%}
                  {%- if visible == default_tech_index -%}
                    {%- liquid
                      assign head_image = tech.settings.image
                      if head_image == blank and tech.settings.product != blank
                        assign head_image = tech.settings.product.featured_image
                      endif
                    -%}
                    {%- if head_image != blank -%}
                      {{
                        head_image
                        | image_url: width: 120
                        | image_tag: loading: 'lazy', class: 'scale-o-compare__mobile-matrix-logo', widths: '60,90,120', sizes: '44px', alt: tech.settings.title
                      }}
                    {%- else -%}
                      <span class="scale-o-compare__mobile-matrix-name">{{ tech.settings.title | escape }}</span>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

            <div class="scale-o-compare__mobile-matrix-body" data-stc-mobile-rows>
              {%- if section.settings.show_tech_type_row -%}
                <div
                  class="scale-o-compare__mobile-row scale-o-compare__mobile-row--type"
                  data-stc-mobile-row
                  data-v1="{{ section.settings.tech_type_value_1 | escape }}"
                  data-s1="neutral"
                  data-v2="{{ section.settings.tech_type_value_2 | escape }}"
                  data-s2="neutral"
                  data-v3="{{ section.settings.tech_type_value_3 | escape }}"
                  data-s3="neutral"
                  data-v4="{{ section.settings.tech_type_value_4 | escape }}"
                  data-s4="neutral"
                >
                  <div class="scale-o-compare__mobile-feature">
                    <span class="scale-o-compare__mobile-feature-icon" aria-hidden="true">
                      {% render 'scale-o-compare-icon', icon: 'layers', class: 'scale-o-compare__mobile-feature-svg' %}
                    </span>
                    <span class="scale-o-compare__mobile-feature-title">{{ section.settings.tech_type_row_title | default: 'Technology' | escape }}</span>
                  </div>
                  <div class="scale-o-compare__mobile-value" data-stc-mobile-value>
                    {%- case default_tech_index -%}
                      {%- when 1 -%}
                        {% render 'scale-o-compare-cell', value: section.settings.tech_type_value_1, status: 'neutral', featured: true %}
                      {%- when 2 -%}
                        {% render 'scale-o-compare-cell', value: section.settings.tech_type_value_2, status: 'neutral', featured: true %}
                      {%- when 3 -%}
                        {% render 'scale-o-compare-cell', value: section.settings.tech_type_value_3, status: 'neutral', featured: true %}
                      {%- else -%}
                        {% render 'scale-o-compare-cell', value: section.settings.tech_type_value_4, status: 'neutral', featured: true %}
                    {%- endcase -%}
                  </div>
                </div>
              {%- endif -%}
              {%- for feature in feature_blocks -%}
                {%- if feature.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                <div
                  class="scale-o-compare__mobile-row"
                  data-stc-mobile-row
                  data-v1="{{ feature.settings.value_1 | escape }}"
                  data-s1="{{ feature.settings.status_1 | escape }}"
                  data-v2="{{ feature.settings.value_2 | escape }}"
                  data-s2="{{ feature.settings.status_2 | escape }}"
                  data-v3="{{ feature.settings.value_3 | escape }}"
                  data-s3="{{ feature.settings.status_3 | escape }}"
                  data-v4="{{ feature.settings.value_4 | escape }}"
                  data-s4="{{ feature.settings.status_4 | escape }}"
                  {{ feature.shopify_attributes }}
                >
                  <div class="scale-o-compare__mobile-feature">
                    <span class="scale-o-compare__mobile-feature-icon" aria-hidden="true">
                      {%- if feature.settings.icon_image != blank -%}
                        {{
                          feature.settings.icon_image
                          | image_url: width: 64
                          | image_tag: loading: 'lazy', widths: '32,48,64', sizes: '20px', alt: ''
                        }}
                      {%- else -%}
                        {% render 'scale-o-compare-icon', icon: feature.settings.theme_icon, class: 'scale-o-compare__mobile-feature-svg' %}
                      {%- endif -%}
                    </span>
                    <span class="scale-o-compare__mobile-feature-title">{{ feature.settings.title | escape }}</span>
                  </div>
                  <div class="scale-o-compare__mobile-value" data-stc-mobile-value>
                    {%- case default_tech_index -%}
                      {%- when 1 -%}
                        {% render 'scale-o-compare-cell', value: feature.settings.value_1, status: feature.settings.status_1, featured: true %}
                      {%- when 2 -%}
                        {% render 'scale-o-compare-cell', value: feature.settings.value_2, status: feature.settings.status_2, featured: true %}
                      {%- when 3 -%}
                        {% render 'scale-o-compare-cell', value: feature.settings.value_3, status: feature.settings.status_3, featured: true %}
                      {%- else -%}
                        {% render 'scale-o-compare-cell', value: feature.settings.value_4, status: feature.settings.status_4, featured: true %}
                    {%- endcase -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

    {%- if section.settings.show_competitors and competitor_count > 0 -%}
      <div class="scale-o-versus-section" data-stc-animate>
        <div class="scale-o-compare__container">
          {%- if show_comp_header -%}
            <header class="scale-o-versus-section__header">
              {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
                <p class="scale-o-versus-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if section.settings.heading != blank -%}
                <h2 class="scale-o-versus-section__heading">{{ section.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if section.settings.show_description and section.settings.description != blank -%}
                <p class="scale-o-versus-section__description">{{ section.settings.description | escape }}</p>
              {%- endif -%}
              {%- if section.settings.show_comp_legend -%}
                <div class="scale-o-versus-rows__legend" aria-hidden="true">
                  <span class="scale-o-versus-rows__pill scale-o-versus-rows__pill--win">
                    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>{{ section.settings.win_legend | default: 'Scale-O advantage' | escape }}</span>
                  </span>
                  <span class="scale-o-versus-rows__pill scale-o-versus-rows__pill--lose">
                    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 4l8 8M12 4 4 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    <span>{{ section.settings.lose_legend | default: 'Competitor limitation' | escape }}</span>
                  </span>
                </div>
              {%- endif -%}
            </header>
          {%- endif -%}

          {%- if competitor_rows.size > 0 -%}
            {%- liquid
              assign win_brand_title = 'Scale-O'
              assign lose_brand_title = 'Core competitors'
              assign win_index = 1
              assign lose_index = 2
              assign win_brand_image = blank
              assign win_brand_image_mobile = blank
              assign win_brand_image_alt = 'Scale-O'
              assign lose_brand_image = blank
              assign lose_brand_image_mobile = blank
              assign lose_brand_image_alt = 'Core competitors'
              assign visible = 0
              assign found_win = false
              assign found_lose = false

              for brand in competitor_blocks
                if brand.settings.enabled == false
                  continue
                endif
                assign visible = visible | plus: 1
                if visible > 4
                  break
                endif
                if brand.settings.highlight and found_win == false
                  assign win_brand_title = brand.settings.title
                  assign win_index = visible
                  assign win_brand_image = brand.settings.image
                  assign win_brand_image_mobile = brand.settings.image_mobile
                  assign win_brand_image_alt = brand.settings.image_alt | default: brand.settings.title
                  assign found_win = true
                endif
                unless brand.settings.highlight
                  if found_lose == false
                    assign lose_brand_title = brand.settings.title
                    assign lose_index = visible
                    assign lose_brand_image = brand.settings.image
                    assign lose_brand_image_mobile = brand.settings.image_mobile
                    assign lose_brand_image_alt = brand.settings.image_alt | default: brand.settings.title
                    assign found_lose = true
                  endif
                endunless
              endfor

              if found_win == false
                assign visible = 0
                for brand in competitor_blocks
                  if brand.settings.enabled == false
                    continue
                  endif
                  assign visible = visible | plus: 1
                  if visible > 4
                    break
                  endif
                  assign win_brand_title = brand.settings.title
                  assign win_index = visible
                  assign win_brand_image = brand.settings.image
                  assign win_brand_image_mobile = brand.settings.image_mobile
                  assign win_brand_image_alt = brand.settings.image_alt | default: brand.settings.title
                  break
                endfor
              endif

              if found_lose == false
                assign visible = 0
                for brand in competitor_blocks
                  if brand.settings.enabled == false
                    continue
                  endif
                  assign visible = visible | plus: 1
                  if visible > 4
                    break
                  endif
                  if visible != win_index
                    assign lose_brand_title = brand.settings.title
                    assign lose_index = visible
                    assign lose_brand_image = brand.settings.image
                    assign lose_brand_image_mobile = brand.settings.image_mobile
                    assign lose_brand_image_alt = brand.settings.image_alt | default: brand.settings.title
                    break
                  endif
                endfor
              endif
            -%}

            <div class="scale-o-versus-table-wrap scale-o-versus-table-wrap--desktop" tabindex="0">
              <table class="scale-o-versus-table">
                <caption class="scale-o-compare__sr-only">{{ section.settings.heading | default: 'Competitor comparison' | escape }}</caption>
                <thead>
                  <tr>
                    <th scope="col" class="scale-o-versus-table__th scale-o-versus-table__th--feature">Feature</th>
                    <th scope="col" class="scale-o-versus-table__th scale-o-versus-table__th--win">
                      <div class="scale-o-versus-table__head-cell">
                        <div class="scale-o-versus-table__head-photo">
                          {%- if win_brand_image != blank -%}
                            <picture>
                              {%- if win_brand_image_mobile != blank -%}
                                <source media="(max-width: 767px)" srcset="{{ win_brand_image_mobile | image_url: width: 320 }}">
                              {%- endif -%}
                              {{
                                win_brand_image
                                | image_url: width: 480
                                | image_tag:
                                  loading: 'lazy',
                                  widths: '160,240,320,480',
                                  sizes: '(max-width: 767px) 28vw, 180px',
                                  alt: win_brand_image_alt | escape
                              }}
                            </picture>
                          {%- else -%}
                            <img src="{{ 'scale-o-solution-product.png' | asset_url }}" alt="{{ win_brand_image_alt | escape }}" width="480" height="360" loading="lazy">
                          {%- endif -%}
                        </div>
                        <p class="scale-o-versus-table__head-title">{{ win_brand_title | escape }}</p>
                      </div>
                    </th>
                    <th scope="col" class="scale-o-versus-table__th scale-o-versus-table__th--lose">
                      <div class="scale-o-versus-table__head-cell">
                        <div class="scale-o-versus-table__head-photo">
                          {%- if lose_brand_image != blank -%}
                            <picture>
                              {%- if lose_brand_image_mobile != blank -%}
                                <source media="(max-width: 767px)" srcset="{{ lose_brand_image_mobile | image_url: width: 320 }}">
                              {%- endif -%}
                              {{
                                lose_brand_image
                                | image_url: width: 480
                                | image_tag:
                                  loading: 'lazy',
                                  widths: '160,240,320,480',
                                  sizes: '(max-width: 767px) 28vw, 180px',
                                  alt: lose_brand_image_alt | escape
                              }}
                            </picture>
                          {%- else -%}
                            <div class="scale-o-versus-table__head-placeholder" aria-hidden="true">
                              {% render 'scale-o-compare-icon', icon: 'factory', class: 'scale-o-compare__icon-svg' %}
                            </div>
                          {%- endif -%}
                        </div>
                        <p class="scale-o-versus-table__head-title">{{ lose_brand_title | escape }}</p>
                      </div>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {%- for row in competitor_rows -%}
                    {%- if row.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                    {%- liquid
                      assign win_value = ''
                      assign lose_value = ''
                      assign win_status = 'neutral'
                      assign lose_status = 'neutral'
                      case win_index
                        when 1
                          assign win_value = row.settings.value_1
                          assign win_status = row.settings.status_1
                        when 2
                          assign win_value = row.settings.value_2
                          assign win_status = row.settings.status_2
                        when 3
                          assign win_value = row.settings.value_3
                          assign win_status = row.settings.status_3
                        when 4
                          assign win_value = row.settings.value_4
                          assign win_status = row.settings.status_4
                      endcase
                      case lose_index
                        when 1
                          assign lose_value = row.settings.value_1
                          assign lose_status = row.settings.status_1
                        when 2
                          assign lose_value = row.settings.value_2
                          assign lose_status = row.settings.status_2
                        when 3
                          assign lose_value = row.settings.value_3
                          assign lose_status = row.settings.status_3
                        when 4
                          assign lose_value = row.settings.value_4
                          assign lose_status = row.settings.status_4
                      endcase
                    -%}
                    <tr class="scale-o-versus-table__row" {{ row.shopify_attributes }}>
                      <th scope="row" class="scale-o-versus-table__feature">
                        <span class="scale-o-versus-table__feature-title">{{ row.settings.title | escape }}</span>
                      </th>
                      <td class="scale-o-versus-table__td scale-o-versus-table__td--win" data-col="{{ win_brand_title | escape }}">
                        {% render 'scale-o-compare-cell', value: win_value, status: win_status, featured: true, short_label: win_brand_title %}
                      </td>
                      <td class="scale-o-versus-table__td scale-o-versus-table__td--lose" data-col="{{ lose_brand_title | escape }}">
                        {% render 'scale-o-compare-cell', value: lose_value, status: lose_status, featured: false, short_label: lose_brand_title %}
                      </td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>

            {%- comment -%} Mobile: 3 brand cards + accordion points {%- endcomment -%}
            <div
              class="scale-o-versus-mobile"
              data-stc-versus-mobile
              data-stc-default="{{ win_index }}"
            >
              <div class="scale-o-versus-mobile__cards" role="radiogroup" aria-label="{{ section.settings.heading | default: 'Select brand' | escape }}">
                {%- assign visible = 0 -%}
                {%- for brand in competitor_blocks -%}
                  {%- if brand.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                  {%- assign visible = visible | plus: 1 -%}
                  {%- if visible > 3 -%}{%- break -%}{%- endif -%}
                  {%- liquid
                    assign brand_image = brand.settings.image | default: brand.settings.image_mobile
                    assign brand_alt = brand.settings.image_alt | default: brand.settings.title
                    assign is_win = brand.settings.highlight
                    assign is_default = false
                    if visible == win_index
                      assign is_default = true
                    endif
                    assign radio_id = 'stc-vs-' | append: section.id | append: '-' | append: visible
                  -%}
                  <label
                    class="scale-o-versus-mobile__card{% if is_default %} is-selected{% endif %}{% if is_win %} is-featured{% endif %}"
                    for="{{ radio_id }}"
                    {{ brand.shopify_attributes }}
                  >
                    <span class="scale-o-versus-mobile__card-photo">
                      {%- if brand_image != blank -%}
                        {{
                          brand_image
                          | image_url: width: 240
                          | image_tag: loading: 'lazy', widths: '120,180,240', sizes: '96px', alt: brand_alt
                        }}
                      {%- elsif is_win -%}
                        <img src="{{ 'scale-o-solution-product.png' | asset_url }}" alt="{{ brand_alt | escape }}" width="96" height="72" loading="lazy">
                      {%- else -%}
                        <span class="scale-o-versus-mobile__card-fallback" aria-hidden="true">
                          {% render 'scale-o-compare-icon', icon: 'factory', class: 'scale-o-compare__icon-svg' %}
                        </span>
                      {%- endif -%}
                    </span>
                    <span class="scale-o-versus-mobile__card-title">{{ brand.settings.title | escape }}</span>
                    {%- if is_win and section.settings.show_recommended_badge -%}
                      <span class="scale-o-versus-mobile__card-badge">
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1.6 9.9 5.7l4.5.5-3.3 3 1 4.4L8 11.8 3.9 13.6l1-4.4-3.3-3 4.5-.5z"/></svg>
                        {{ section.settings.recommended_label | default: 'Recommended' | escape }}
                      </span>
                    {%- endif -%}
                    <input
                      class="scale-o-versus-mobile__input"
                      id="{{ radio_id }}"
                      type="radio"
                      name="stc-vs-{{ section.id }}"
                      value="{{ visible }}"
                      data-stc-vs-index="{{ visible }}"
                      data-stc-vs-featured="{% if is_win %}true{% else %}false{% endif %}"
                      {% if is_default %}checked{% endif %}
                    >
                  </label>
                {%- endfor -%}
              </div>

              <div class="scale-o-versus-mobile__list" data-stc-versus-list>
                {%- for row in competitor_rows -%}
                  {%- if row.settings.enabled == false -%}{%- continue -%}{%- endif -%}
                  {%- liquid
                    assign row_value = ''
                    assign row_status = 'neutral'
                    case win_index
                      when 1
                        assign row_value = row.settings.value_1
                        assign row_status = row.settings.status_1
                      when 2
                        assign row_value = row.settings.value_2
                        assign row_status = row.settings.status_2
                      when 3
                        assign row_value = row.settings.value_3
                        assign row_status = row.settings.status_3
                      when 4
                        assign row_value = row.settings.value_4
                        assign row_status = row.settings.status_4
                    endcase
                  -%}
                  <details
                    class="scale-o-versus-mobile__item"
                    data-stc-versus-row
                    data-v1="{{ row.settings.value_1 | escape }}"
                    data-s1="{{ row.settings.status_1 | escape }}"
                    data-v2="{{ row.settings.value_2 | escape }}"
                    data-s2="{{ row.settings.status_2 | escape }}"
                    data-v3="{{ row.settings.value_3 | escape }}"
                    data-s3="{{ row.settings.status_3 | escape }}"
                    data-v4="{{ row.settings.value_4 | escape }}"
                    data-s4="{{ row.settings.status_4 | escape }}"
                    {{ row.shopify_attributes }}
                  >
                    <summary class="scale-o-versus-mobile__summary">
                      <span class="scale-o-versus-mobile__icon" aria-hidden="true">
                        {% render 'scale-o-compare-icon', icon: row.settings.theme_icon, class: 'scale-o-versus-mobile__icon-svg' %}
                      </span>
                      <span class="scale-o-versus-mobile__mark" data-stc-versus-mark aria-hidden="true">
                        {% render 'scale-o-compare-cell', value: '', status: row_status, featured: true %}
                      </span>
                      <span class="scale-o-versus-mobile__copy">
                        <span class="scale-o-versus-mobile__point">{{ row.settings.title | escape }}</span>
                        <span class="scale-o-versus-mobile__value" data-stc-versus-value>{{ row_value | escape }}</span>
                      </span>
                      <span class="scale-o-versus-mobile__chevron" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </span>
                    </summary>
                    {%- if row.settings.impact != blank -%}
                      <div class="scale-o-versus-mobile__impact">{{ row.settings.impact | escape }}</div>
                    {%- endif -%}
                  </details>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.competitor_note != blank -%}
            <p class="scale-o-compare__note">{{ section.settings.competitor_note | escape }}</p>
          {%- endif -%}

          {%- if show_banner -%}
            <div class="scale-o-compare__banner scale-o-compare__banner--versus">
              <span class="scale-o-compare__banner-icon" aria-hidden="true">
                {% render 'scale-o-compare-icon', icon: section.settings.banner_icon, class: 'scale-o-compare__icon-svg' %}
              </span>
              <div class="scale-o-compare__banner-copy">
                {%- if section.settings.banner_heading != blank -%}
                  <p class="scale-o-compare__banner-heading">{{ section.settings.banner_heading | escape }}</p>
                {%- endif -%}
                {%- if section.settings.banner_text != blank -%}
                  <p class="scale-o-compare__banner-text">{{ section.settings.banner_text | escape }}</p>
                {%- endif -%}
              </div>
              {%- if section.settings.cta_text != blank -%}
                <a class="scale-o-compare__cta" href="{{ section.settings.cta_url | default: '/collections/water-softeners' }}">
                  <span>{{ section.settings.cta_text | escape }}</span>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- elsif show_banner -%}
      <div class="scale-o-compare__container">
        <div class="scale-o-compare__banner" data-stc-animate>
          <span class="scale-o-compare__banner-icon" aria-hidden="true">
            {% render 'scale-o-compare-icon', icon: section.settings.banner_icon, class: 'scale-o-compare__icon-svg' %}
          </span>
          <div class="scale-o-compare__banner-copy">
            {%- if section.settings.banner_heading != blank -%}
              <p class="scale-o-compare__banner-heading">{{ section.settings.banner_heading | escape }}</p>
            {%- endif -%}
            {%- if section.settings.banner_text != blank -%}
              <p class="scale-o-compare__banner-text">{{ section.settings.banner_text | escape }}</p>
            {%- endif -%}
          </div>
          {%- if section.settings.cta_text != blank -%}
            <a class="scale-o-compare__cta" href="{{ section.settings.cta_url | default: '/collections/water-softeners' }}">
              <span>{{ section.settings.cta_text | escape }}</span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
</div>

<script src="{{ 'scale-o-tech-compare.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Scale-O Comparison",
  "tag": "section",
  "class": "scale-o-compare-section",
  "max_blocks": 36,
  "settings": [
    { "type": "paragraph", "content": "Technology table compares Scale-O with other water treatments. Competitor rows compare Scale-O with core competitors, one point per card." },

    { "type": "header", "content": "Technology cards" },
    { "type": "checkbox", "id": "show_tech", "label": "Show technology cards", "default": true },
    { "type": "checkbox", "id": "show_tech_eyebrow", "label": "Show technology eyebrow", "default": true },
    { "type": "text", "id": "tech_eyebrow", "label": "Technology eyebrow", "default": "TECHNOLOGY COMPARISON" },
    { "type": "text", "id": "tech_heading", "label": "Technology heading", "default": "Scale-O vs Other Water Treatment" },
    { "type": "checkbox", "id": "show_tech_description", "label": "Show technology description", "default": true },
    { "type": "textarea", "id": "tech_description", "label": "Technology description", "default": "See how Scale-O compares with salt-based, electromagnetic and multi-media systems for household scale protection." },
    { "type": "checkbox", "id": "show_features", "label": "Show comparison table", "default": true },
    { "type": "text", "id": "tech_criteria_heading", "label": "Table first column heading", "default": "TECHNOLOGY" },
    { "type": "checkbox", "id": "show_tech_type_row", "label": "Show technology type row", "default": true },
    { "type": "text", "id": "tech_type_row_title", "label": "Technology type row title", "default": "Technology" },
    { "type": "text", "id": "tech_type_value_1", "label": "Technology type column 1", "default": "Ion Exchange" },
    { "type": "text", "id": "tech_type_value_2", "label": "Technology type column 2", "default": "Electro-Magnetism" },
    { "type": "text", "id": "tech_type_value_3", "label": "Technology type column 3", "default": "Multi bed Filtration" },
    { "type": "text", "id": "tech_type_value_4", "label": "Technology type column 4", "default": "Advanced Chelation" },
    { "type": "checkbox", "id": "show_recommended_badge", "label": "Show Recommended badge on Scale-O", "default": true },
    { "type": "text", "id": "recommended_label", "label": "Recommended badge text", "default": "Recommended" },
    { "type": "checkbox", "id": "show_column_images", "label": "Show column images", "default": true },
    { "type": "checkbox", "id": "show_column_descriptions", "label": "Show column descriptions", "default": false },
    { "type": "checkbox", "id": "show_card_icons", "label": "Show card icons", "default": false },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile card layout",
      "default": "scroll",
      "options": [
        { "value": "scroll", "label": "Horizontal scroll" },
        { "value": "stack", "label": "Stacked cards" }
      ]
    },

    { "type": "header", "content": "Competitor comparison" },
    { "type": "checkbox", "id": "show_competitors", "label": "Show competitor comparison", "default": true },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show competitor eyebrow", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Competitor eyebrow", "default": "COMPETITOR COMPARISON" },
    { "type": "text", "id": "heading", "label": "Competitor heading", "default": "Scale-O vs Core Competitors" },
    { "type": "checkbox", "id": "show_description", "label": "Show competitor description", "default": true },
    { "type": "textarea", "id": "description", "label": "Competitor description", "default": "Ten points that change water quality, safety, and what you pay over time." },
    { "type": "checkbox", "id": "show_comp_legend", "label": "Show advantage legend", "default": true },
    { "type": "text", "id": "win_legend", "label": "Scale-O legend", "default": "Scale-O advantage" },
    { "type": "text", "id": "lose_legend", "label": "Competitor legend", "default": "Competitor limitation" },
    { "type": "text", "id": "competitor_hint", "label": "Table hint" },
    { "type": "text", "id": "impact_label", "label": "Impact label (screen reader)", "default": "Why it matters" },
    { "type": "text", "id": "criteria_heading", "label": "First column heading", "default": "Criteria" },
    { "type": "text", "id": "competitor_note", "label": "Comparison note", "default": "Typical of salt-free products sold online in India." },

    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },

    { "type": "header", "content": "Scale-O highlight" },
    { "type": "color", "id": "highlight_color", "label": "Highlight color", "default": "#0C7FDF" },
    { "type": "color", "id": "highlight_background", "label": "Highlight background", "default": "#E8F3FC" },

    { "type": "header", "content": "Conclusion banner" },
    { "type": "checkbox", "id": "show_cta_banner", "label": "Show conclusion banner", "default": true },
    {
      "type": "select",
      "id": "banner_icon",
      "label": "Banner icon",
      "default": "shield",
      "options": [
        { "value": "shield", "label": "Shield" },
        { "value": "droplet", "label": "Water" },
        { "value": "wrench", "label": "Install" },
        { "value": "none", "label": "None" }
      ]
    },
    { "type": "text", "id": "banner_heading", "label": "Banner heading", "default": "Better water. Better life." },
    { "type": "textarea", "id": "banner_text", "label": "Banner text", "default": "Scale-O delivers salt-free, maintenance-free protection that's simple, efficient and built for modern homes." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Explore Scale-O Products" },
    { "type": "url", "id": "cta_url", "label": "CTA URL", "info": "Leave blank to use /collections/water-softeners." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 0, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Card image ratio",
      "default": "4 / 3",
      "options": [
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "16 / 10", "label": "16:10" }
      ]
    },
    { "type": "range", "id": "card_radius", "label": "Corner radius", "min": 8, "max": 28, "step": 1, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "enable_animations", "label": "Enable reveal animations", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_x", "label": "Horizontal padding", "min": 12, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "margin_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "header_gap", "label": "Header bottom gap", "min": 16, "max": 64, "step": 4, "unit": "px", "default": 36 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Label size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 13 },
