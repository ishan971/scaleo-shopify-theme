{%- comment -%}
  Scale-O Technology Video — founder / UGC product demo
{%- endcomment -%}

{{ 'scale-o-tech-video.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign highlight_blocks = section.blocks | where: 'type', 'highlight'
  assign header_align = section.settings.header_alignment
  assign video_obj = section.settings.shopify_video
  assign video_link = section.settings.video_url
  assign poster = section.settings.thumbnail

  assign video_src = ''
  if video_obj != blank
    for source in video_obj.sources
      if source.format == 'mp4' or source.mime_type == 'video/mp4'
        assign video_src = source.url
      endif
    endfor
    if video_src == blank and video_obj.sources.size > 0
      assign video_src = video_obj.sources.first.url
    endif
  endif

  assign media_kind = 'none'
  assign media_src = ''
  if section.settings.video_type == 'shopify' and video_src != blank
    assign media_kind = 'shopify'
    assign media_src = video_src
  elsif video_link != blank and video_link.id != blank
    if video_link.type == 'youtube'
      assign media_kind = 'youtube'
      assign yt = 'https://www.youtube.com/embed/' | append: video_link.id | append: '?rel=0&modestbranding=1&playsinline=1&autoplay=1'
      if section.settings.muted or section.settings.autoplay
        assign yt = yt | append: '&mute=1'
      endif
      if section.settings.loop
        assign yt = yt | append: '&loop=1&playlist=' | append: video_link.id
      endif
      unless section.settings.show_controls
        assign yt = yt | append: '&controls=0'
      endunless
      assign media_src = yt
    elsif video_link.type == 'vimeo'
      assign media_kind = 'vimeo'
      assign vm = 'https://player.vimeo.com/video/' | append: video_link.id | append: '?title=0&byline=0&portrait=0&dnt=1&autoplay=1'
      if section.settings.muted or section.settings.autoplay
        assign vm = vm | append: '&muted=1'
      endif
      if section.settings.loop
        assign vm = vm | append: '&loop=1'
      endif
      assign media_src = vm
    endif
  elsif video_src != blank
    assign media_kind = 'shopify'
    assign media_src = video_src
  endif

  assign poster_url = ''
  if poster != blank
    assign poster_url = poster | image_url: width: 1600
  elsif video_obj != blank and video_obj.preview_image != blank
    assign poster_url = video_obj.preview_image | image_url: width: 1600
  endif

  assign play_size = 72
  if section.settings.play_button_size == 'small'
    assign play_size = 56
  elsif section.settings.play_button_size == 'large'
    assign play_size = 88
  endif

  assign show_header = false
  if section.settings.heading != blank
    assign show_header = true
  endif
  if section.settings.show_eyebrow and section.settings.eyebrow != blank
    assign show_header = true
  endif
  if section.settings.show_description and section.settings.description != blank
    assign show_header = true
  endif

  assign do_autoplay = false
  if section.settings.autoplay
    assign do_autoplay = true
  endif

  assign media_title = section.settings.video_label | default: section.settings.heading | default: 'Scale-O video'
  assign show_footer = false
  if section.settings.show_cta and section.settings.cta_text != blank
    assign show_footer = true
  endif
  if section.settings.show_trust and section.settings.trust_text != blank
    assign show_footer = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-tech-video {
    --stv-bg: {{ section.settings.background_color }};
    --stv-heading: {{ section.settings.heading_color }};
    --stv-text: {{ section.settings.text_color }};
    --stv-accent: {{ section.settings.accent_color }};
    --stv-accent-hover: {{ section.settings.accent_hover_color }};
    --stv-card-border: {{ section.settings.card_border_color }};
    --stv-radius: {{ section.settings.video_radius }}px;
    --stv-ratio: {{ section.settings.video_ratio }};
    --stv-play-size: {{ play_size }}px;
    --stv-shadow: 0 18px 40px rgba(26, 43, 74, 0.08);
    --stv-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --stv-heading-size: {{ section.settings.heading_size_mobile }}px;
    --stv-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --stv-desc-size: {{ section.settings.description_size }}px;
    --stv-pad-x: {{ section.settings.padding_x }}px;
    --stv-header-gap: {{ section.settings.header_gap }}px;
    --stv-header-align: {{ header_align }};
    --stv-max-width: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: var(--stv-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-tech-video {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<div
  class="scale-o-tech-video"
  data-section-id="{{ section.id }}"
  data-media-type="{{ media_kind }}"
  data-media-src="{{ media_src | escape }}"
  data-media-title="{{ media_title | escape }}"
  data-autoplay="{% if do_autoplay %}true{% else %}false{% endif %}"
  data-muted="{% if section.settings.muted or do_autoplay %}true{% else %}false{% endif %}"
  data-loop="{% if section.settings.loop %}true{% else %}false{% endif %}"
  data-controls="{% if section.settings.show_controls %}true{% else %}false{% endif %}"
  data-playsinline="{% if section.settings.playsinline %}true{% else %}false{% endif %}"
  data-open-modal="{% if section.settings.open_in_modal %}true{% else %}false{% endif %}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Scale-O video' | escape }}"
>
  <div class="scale-o-tech-video__container">
    {%- if show_header -%}
      <header class="scale-o-tech-video__header scale-o-tech-video__header--{{ header_align }}">
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
          <p class="scale-o-tech-video__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="scale-o-tech-video__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.show_description and section.settings.description != blank -%}
          <p class="scale-o-tech-video__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="scale-o-tech-video__player-wrap">
      <div class="scale-o-tech-video__player" data-stv-stage>
        {%- if poster_url != blank -%}
          <img
            class="scale-o-tech-video__poster"
            src="{{ poster_url }}"
            alt="{{ section.settings.thumbnail_alt | default: media_title | escape }}"
            width="1280"
            height="720"
            loading="lazy"
          >
        {%- else -%}
          <div class="scale-o-tech-video__placeholder" aria-hidden="true">
            {% render 'scale-o-video-icon', icon: 'play', class: 'scale-o-tech-video__icon-svg' %}
          </div>
        {%- endif -%}
      </div>

      {%- if media_kind != 'none' -%}
        <button
          type="button"
          class="scale-o-tech-video__poster-btn"
          data-stv-play
          aria-label="{{ section.settings.play_label | default: 'Play video' | escape }}"
        >
          {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
            <span class="scale-o-tech-video__badge">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              {{ section.settings.badge_text | escape }}
            </span>
          {%- endif -%}
          <span class="scale-o-tech-video__play" aria-hidden="true">
            <svg viewBox="0 0 18 18" fill="currentColor"><path d="M15.562 8.1L3.87.225c-.818-.562-1.87 0-1.87.9v15.75c0 .9 1.052 1.462 1.87.9L15.563 9.9c.584-.45.584-1.35 0-1.8z"></path></svg>
          </span>
        </button>
      {%- endif -%}
    </div>

    {%- if highlight_blocks.size > 0 -%}
      <ul class="scale-o-tech-video__highlights" role="list">
        {%- for block in highlight_blocks -%}
          <li class="scale-o-tech-video__highlight" {{ block.shopify_attributes }}>
            <span class="scale-o-tech-video__highlight-icon" aria-hidden="true">
              {%- if block.settings.icon_image != blank -%}
                {{
                  block.settings.icon_image
                  | image_url: width: 80
                  | image_tag: loading: 'lazy', widths: '40,80', alt: ''
                }}
              {%- else -%}
                {% render 'scale-o-video-icon', icon: block.settings.theme_icon, class: 'scale-o-tech-video__icon-svg' %}
              {%- endif -%}
            </span>
            <span>
              {%- if block.settings.title != blank -%}
                <p class="scale-o-tech-video__highlight-title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="scale-o-tech-video__highlight-text">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if show_footer -%}
      <div class="scale-o-tech-video__cta-wrap">
        {%- if section.settings.show_cta and section.settings.cta_text != blank -%}
          <a class="scale-o-tech-video__cta" href="{{ section.settings.cta_url | default: '#' }}">
            <span>{{ section.settings.cta_text | escape }}</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if section.settings.show_trust and section.settings.trust_text != blank -%}
          <p class="scale-o-tech-video__trust">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <span>{{ section.settings.trust_text | escape }}</span>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.open_in_modal -%}
    <div class="scale-o-tech-video__modal" data-stv-modal hidden>
      <button type="button" class="scale-o-tech-video__modal-close" data-stv-modal-close aria-label="Close video">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 3l8 8M11 3 3 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
      <div class="scale-o-tech-video__modal-dialog" role="dialog" aria-modal="true" aria-label="{{ media_title | escape }}">
        <div data-stv-modal-mount></div>
      </div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'scale-o-tech-video.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Scale-O Video",
  "tag": "section",
  "class": "scale-o-tech-video-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "TECHNOLOGY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See How Scale-O Works" },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Understand how Scale-O protects your home from hard-water scale with a simple, salt-free solution." },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },

    { "type": "header", "content": "Video" },
    {
      "type": "select",
      "id": "video_type",
      "label": "Video source",
      "default": "external",
      "options": [
        { "value": "shopify", "label": "Shopify hosted" },
        { "value": "external", "label": "YouTube or Vimeo" }
      ]
    },
    { "type": "video", "id": "shopify_video", "label": "Shopify hosted video" },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "info": "Used when video source is YouTube or Vimeo"
    },
    { "type": "image_picker", "id": "thumbnail", "label": "Video thumbnail" },
    { "type": "text", "id": "thumbnail_alt", "label": "Thumbnail alt text", "default": "Scale-O product demonstration video" },
    { "type": "text", "id": "video_label", "label": "Accessible video label", "default": "Scale-O product demonstration" },
    {
      "type": "select",
      "id": "video_ratio",
      "label": "Video aspect ratio",
      "default": "16 / 9",
      "options": [
        { "value": "16 / 9", "label": "16:9" },
        { "value": "21 / 9", "label": "21:9" },
        { "value": "4 / 3", "label": "4:3" }
      ]
    },
    { "type": "range", "id": "video_radius", "label": "Video corner radius", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 20 },
    {
      "type": "select",
      "id": "play_button_size",
      "label": "Play button size",
      "default": "large",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    { "type": "checkbox", "id": "show_badge", "label": "Show video badge", "default": true },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Real Product Demo" },
    { "type": "text", "id": "play_label", "label": "Play button label", "default": "Play video" },

    { "type": "header", "content": "Video behaviour" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false, "info": "If enabled, playback is muted for browser compatibility." },
    { "type": "checkbox", "id": "muted", "label": "Muted", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Loop", "default": false },
    { "type": "checkbox", "id": "show_controls", "label": "Show controls", "default": true },
    { "type": "checkbox", "id": "playsinline", "label": "Play inline", "default": true },
    { "type": "checkbox", "id": "open_in_modal", "label": "Open video in modal", "default": false },

    { "type": "header", "content": "CTA" },
    { "type": "checkbox", "id": "show_cta", "label": "Show CTA", "default": true },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Explore Scale-O Products" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust line", "default": true },
    { "type": "text", "id": "trust_text", "label": "Trust text", "default": "Trusted by thousands of happy homes across India." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 0, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_x", "label": "Horizontal padding", "min": 12, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "margin_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "header_gap", "label": "Header bottom gap", "min": 16, "max": 64, "step": 4, "unit": "px", "default": 28 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 24, "max": 56, "step": 1, "unit": "px", "default": 45 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 40, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 16 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7FBFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1A2B4A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5A6B85" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "accent_hover_color", "label": "Accent hover", "default": "#0A6BC4" },
    { "type": "color", "id": "card_border_color", "label": "Border", "default": "#E8EEF8" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Scale-O video" }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Video Highlight",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "theme_icon",
          "label": "Icon",
          "default": "install",
          "options": [
            { "value": "install", "label": "Installation" },
            { "value": "salt", "label": "Salt-free" },
            { "value": "electricity", "label": "Electricity" },
            { "value": "recycle", "label": "No water waste" },
            { "value": "droplet", "label": "Water" },
            { "value": "shield", "label": "Protection" },
            { "value": "home", "label": "Home" },
            { "value": "none", "label": "None" }
          ]
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image", "info": "Optional. Replaces the theme icon." },
        { "type": "text", "id": "title", "label": "Title", "default": "Easy Installation" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Designed for simple installation without complicated plumbing." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scale-O Video",
      "category": "Custom",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "theme_icon": "install",
            "title": "Easy Installation",
            "description": "Designed for simple installation without complicated plumbing."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "theme_icon": "salt",
            "title": "Salt-Free",
            "description": "No salt bags or traditional brine system."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "theme_icon": "electricity",
            "title": "Zero Electricity",
            "description": "Works without electricity."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "theme_icon": "recycle",
            "title": "Zero Water Waste",
            "description": "No regeneration water wastage."
          }
        }
      ]
    }
  ]
}
{% endschema %}
