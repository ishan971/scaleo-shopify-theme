{%- comment -%}
  SCALE-O USP — full-width banner image only (desktop + mobile, Shopify-editable)
{%- endcomment -%}
{{ 'scale-o-usp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign banner = section.settings.banner_image
  assign banner_mobile = section.settings.banner_image_mobile
  assign banner_alt = 'SCALE-O USP'

  if banner != blank
    assign banner_alt = banner.alt | default: banner_alt
    assign desktop_src = banner | image_url: width: 2880
  else
    assign desktop_src = 'scale-o-usp-banner.jpg' | asset_url
  endif

  if banner_mobile != blank
    if banner_mobile.alt != blank
      assign banner_alt = banner_mobile.alt
    endif
    assign mobile_src = banner_mobile | image_url: width: 1500
  else
    assign mobile_src = 'scale-o-usp-banner-mobile.jpg' | asset_url
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .so-usp {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .so-usp {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
  }
</style>

<div class="so-usp so-usp--banner" id="scale-o-usp">
  <div class="so-usp__banner">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset="{% if banner_mobile != blank %}{{ banner_mobile | image_url: width: 750 }} 750w, {{ banner_mobile | image_url: width: 1100 }} 1100w, {{ banner_mobile | image_url: width: 1500 }} 1500w{% else %}{{ mobile_src }}{% endif %}"
        {% if banner_mobile != blank %}sizes="100vw"{% endif %}
      >
      {% if banner != blank %}
        <source
          media="(min-width: 768px)"
          srcset="
            {{ banner | image_url: width: 1100 }} 1100w,
            {{ banner | image_url: width: 1500 }} 1500w,
            {{ banner | image_url: width: 2000 }} 2000w,
            {{ banner | image_url: width: 2400 }} 2400w,
            {{ banner | image_url: width: 2880 }} 2880w
          "
          sizes="100vw"
        >
      {% endif %}
      <img
        class="so-usp__banner-img"
        src="{{ desktop_src }}"
        alt="{{ banner_alt | escape }}"
        width="{% if banner != blank %}{{ banner.width | default: 2560 }}{% else %}2560{% endif %}"
        height="{% if banner != blank %}{{ banner.height | default: 1022 }}{% else %}1022{% endif %}"
        loading="lazy"
        decoding="async"
      >
    </picture>
  </div>
</div>

{% schema %}
{
  "name": "SCALE-O USP",
  "tag": "section",
  "class": "scale-o-usp-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Desktop banner",
      "info": "Wide landscape image. Best at 2000–2500px wide."
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Mobile banner",
      "info": "Tall portrait image for phones. Leave empty to use the default mobile banner."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "SCALE-O USP",
      "category": "Product"
    }
  ]
}
{% endschema %}
