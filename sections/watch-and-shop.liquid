            "badge": "INSTALLATION",
            "cta_text": "Shop Now",
            "show_product": true,
            "show_product_image": true,
            "show_product_price": true,
            "show_cta": true,
            "show_badge": true,
            "show_play_button": true,
            "autoplay": true,
            "muted": true,
            "loop": true
          }
        },
        {
          "type": "watch_shop_video",
          "settings": {
            "video_title": "How Scale-O Works",
            "custom_title": "Scale-O Centi Water Softener",
            "badge": "HOW IT WORKS",
            "cta_text": "Shop Now",
            "show_product": true,
            "show_product_image": true,
