{%- comment -%}
  Scale-O Watch & Shop — shoppable short-form video section
{%- endcomment -%}

{{ 'scale-o-watch-shop.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign video_blocks = section.blocks | where: 'type', 'watch_shop_video'
  assign header_align = section.settings.header_alignment
  assign enable_carousel = section.settings.enable_carousel
  assign show_arrows = false
  if enable_carousel and section.settings.show_arrows
    assign show_arrows = true
  endif
  assign overlay_radius = 999
  if section.settings.overlay_style == 'card'
    assign overlay_radius = 14
  endif
  assign show_header = false
  if section.settings.heading != blank
    assign show_header = true
  endif
  if section.settings.show_eyebrow and section.settings.eyebrow != blank
    assign show_header = true
  endif
  if section.settings.show_description and section.settings.description != blank
    assign show_header = true
  endif
  assign grid_desktop = section.settings.desktop_cards | plus: 0 | round
  assign grid_tablet = section.settings.tablet_cards | plus: 0 | round
-%}

<style>
  #shopify-section-{{ section.id }} .scale-o-watch-shop {
    --was-bg: {{ section.settings.background_color }};
    --was-heading-color: {{ section.settings.heading_color }};
    --was-text-color: {{ section.settings.text_color }};
    --was-eyebrow-color: {{ section.settings.eyebrow_color }};
    --was-accent: {{ section.settings.accent_color }};
    --was-arrow-bg: {{ section.settings.arrow_background }};
    --was-arrow-icon: {{ section.settings.arrow_icon_color }};
    --was-arrow-hover: {{ section.settings.arrow_hover_background }};
    --was-card-bg: {{ section.settings.card_background }};
    --was-card-border: {{ section.settings.card_border_color }};
    --was-product-bg: {{ section.settings.product_card_background }};
    --was-product-title: {{ section.settings.product_title_color }};
    --was-price-color: {{ section.settings.price_color }};
    --was-badge-bg: {{ section.settings.badge_background }};
    --was-badge-text: {{ section.settings.badge_text_color }};
    --was-radius: {{ section.settings.card_radius }}px;
    --was-overlay-radius: {{ overlay_radius }}px;
    --was-overlay-offset: {{ section.settings.product_overlay_offset }}px;
    --was-product-image: {{ section.settings.product_image_size }}px;
    --was-ratio: {{ section.settings.card_ratio }};
    --was-gap: {{ section.settings.card_gap }}px;
    --was-gap-mobile: {{ section.settings.card_gap_mobile }}px;
    --was-cols-desktop: {{ section.settings.desktop_cards }};
    --was-cols-tablet: {{ section.settings.tablet_cards }};
    --was-cols-mobile: {{ section.settings.mobile_cards }};
    --was-mobile-card-width: 90%;
    --was-grid-desktop: {{ grid_desktop }};
    --was-grid-tablet: {{ grid_tablet }};
    --was-pad-x: {{ section.settings.padding_x }}px;
    --was-header-gap: {{ section.settings.header_gap }}px;
    --was-header-align: {{ header_align }};
    --was-max-width: {% if section.settings.max_width == 0 %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --was-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --was-heading-size: {{ section.settings.heading_size_mobile }}px;
    --was-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --was-desc-size: {{ section.settings.description_size }}px;
    --was-shadow: 0 4px 16px rgba(26, 43, 74, 0.08);
    --was-shadow-hover: 0 10px 28px rgba(26, 43, 74, 0.14);
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: var(--was-bg);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .scale-o-watch-shop {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<div
  class="scale-o-watch-shop{% if enable_carousel %} scale-o-watch-shop--carousel{% else %} scale-o-watch-shop--grid{% endif %}{% if show_arrows %} scale-o-watch-shop--arrows{% endif %}{% if section.settings.show_dots %} scale-o-watch-shop--dots{% endif %}{% if enable_carousel and section.settings.enable_touch_swipe %} scale-o-watch-shop--swipe{% endif %}"
  data-section-id="{{ section.id }}"
  data-carousel="{% if enable_carousel %}true{% else %}false{% endif %}"
  data-autoplay="{% if section.settings.autoplay %}true{% else %}false{% endif %}"
  data-pause-outside="{% if section.settings.pause_outside_viewport %}true{% else %}false{% endif %}"
  data-cols-desktop="{{ section.settings.desktop_cards }}"
  data-cols-tablet="{{ section.settings.tablet_cards }}"
  data-cols-mobile="{{ section.settings.mobile_cards }}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Watch and shop' | escape }}"
>
  <div class="scale-o-watch-shop__container">
    {%- if show_header -%}
      <header class="scale-o-watch-shop__header scale-o-watch-shop__header--{{ header_align }}">
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
          <p class="scale-o-watch-shop__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="scale-o-watch-shop__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.show_description and section.settings.description != blank -%}
          <p class="scale-o-watch-shop__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if video_blocks.size > 0 -%}
      <div class="scale-o-watch-shop__carousel-wrap">
        {%- if show_arrows -%}
          <button type="button" class="scale-o-watch-shop__nav scale-o-watch-shop__nav--prev" data-was-prev aria-label="Previous videos">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}

        <div class="scale-o-watch-shop__viewport" data-was-viewport>
          <ul class="scale-o-watch-shop__track" data-was-track role="list">
            {%- for block in video_blocks -%}
              <li class="scale-o-watch-shop__slide" data-was-slide>
                {% render 'scale-o-watch-shop-card', block: block, section: section %}
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- if show_arrows -%}
          <button type="button" class="scale-o-watch-shop__nav scale-o-watch-shop__nav--next" data-was-next aria-label="Next videos">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}

        {%- if enable_carousel and section.settings.show_dots -%}
          <div class="scale-o-watch-shop__dots" data-was-dots role="tablist" aria-label="Watch and shop pages"></div>
        {%- endif -%}
      </div>
    {%- else -%}
      <p class="scale-o-watch-shop__empty">Add Watch & Shop videos in the theme editor.</p>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'scale-o-watch-shop.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Watch & Shop",
  "tag": "section",
  "class": "scale-o-watch-shop-section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WATCH & SHOP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See Scale-O in Action" },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Watch real product demonstrations, installation guides and customer experiences." },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
