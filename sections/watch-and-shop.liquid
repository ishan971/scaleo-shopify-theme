        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 0, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    {
      "type": "select",
      "id": "desktop_cards",
      "label": "Desktop cards visible",
      "default": "4",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ]
    },
    {
      "type": "select",
      "id": "tablet_cards",
      "label": "Tablet cards visible",
      "default": "2.5",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "2.5", "label": "2.5" },
        { "value": "3", "label": "3" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_cards",
      "label": "Mobile cards visible",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "1.25", "label": "1.25" },
        { "value": "1.5", "label": "1.5" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Card ratio",
      "default": "9 / 16",
      "options": [
        { "value": "9 / 16", "label": "9:16" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "3 / 4", "label": "3:4" }
      ]
    },
    { "type": "range", "id": "card_gap", "label": "Card gap (desktop)", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_gap_mobile", "label": "Card gap (mobile)", "min": 8, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_x", "label": "Horizontal padding", "min": 12, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "margin_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "header_gap", "label": "Header bottom gap", "min": 16, "max": 64, "step": 4, "unit": "px", "default": 32 },
    { "type": "header", "content": "Video" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay videos", "default": true, "info": "Autoplay is always muted for browser compatibility." },
    { "type": "checkbox", "id": "muted", "label": "Muted", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Loop video", "default": true },
    { "type": "checkbox", "id": "show_controls", "label": "Show video controls", "default": false },
    { "type": "checkbox", "id": "pause_outside_viewport", "label": "Pause videos outside the viewport", "default": true },
    { "type": "header", "content": "Carousel" },
    { "type": "checkbox", "id": "enable_carousel", "label": "Enable carousel", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show navigation dots", "default": true },
    { "type": "checkbox", "id": "enable_touch_swipe", "label": "Enable touch swipe", "default": true },
    { "type": "header", "content": "Product overlay" },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Product overlay style",
      "default": "pill",
      "options": [
        { "value": "pill", "label": "Pill" },
        { "value": "card", "label": "Rounded card" }
      ]
    },
    { "type": "range", "id": "product_image_size", "label": "Product image size", "min": 28, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "product_overlay_offset", "label": "Product overlay offset", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "use_rupee_symbol", "label": "Show Indian rupee symbol (₹)", "default": true },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size (desktop)", "min": 24, "max": 56, "step": 1, "unit": "px", "default": 45 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 40, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1A2B4A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5A6B85" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#0C7FDF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0C7FDF" },
    { "type": "color", "id": "arrow_background", "label": "Arrow background", "default": "#0C7FDF" },
    { "type": "color", "id": "arrow_icon_color", "label": "Arrow icon", "default": "#FFFFFF" },
    { "type": "color", "id": "arrow_hover_background", "label": "Arrow hover background", "default": "#0A6BC4" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#E8EEF8" },
    { "type": "color", "id": "product_card_background", "label": "Product card background", "default": "#FFFFFF" },
    { "type": "color", "id": "product_title_color", "label": "Product title", "default": "#1A2B4A" },
    { "type": "color", "id": "price_color", "label": "Price", "default": "#0C7FDF" },
    { "type": "color", "id": "badge_background", "label": "Badge background", "default": "#0C7FDF" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text", "default": "#FFFFFF" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Watch and shop" }
  ],
  "blocks": [
    {
      "type": "watch_shop_video",
      "name": "Watch & Shop Video",
      "settings": [
        { "type": "header", "content": "Video" },
        {
          "type": "select",
          "id": "video_type",
          "label": "Video source",
          "default": "shopify",
          "options": [
            { "value": "shopify", "label": "Shopify hosted" },
            { "value": "external", "label": "YouTube or Vimeo" }
          ]
        },
        { "type": "video", "id": "shopify_video", "label": "Shopify hosted video" },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "External video URL",
          "accept": ["youtube", "vimeo"],
          "info": "Used when video source is YouTube or Vimeo"
        },
        { "type": "image_picker", "id": "poster", "label": "Poster image" },
        { "type": "header", "content": "Product" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "custom_title", "label": "Custom display title", "info": "Leave empty to use the product title" },
        { "type": "text", "id": "custom_price", "label": "Custom display price", "info": "Display only. Leave empty to use the product price." },
        { "type": "text", "id": "video_title", "label": "Video title", "info": "Optional overlay title, for example How Scale-O Works" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "Leave empty to hide" },
        { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop Now" },
        { "type": "url", "id": "cta_url", "label": "CTA URL", "info": "Used when no product is selected" },
        { "type": "header", "content": "Display" },
        { "type": "checkbox", "id": "show_product", "label": "Show product information", "default": true },
        { "type": "checkbox", "id": "show_product_image", "label": "Show product image", "default": true },
        { "type": "checkbox", "id": "show_product_price", "label": "Show product price", "default": true },
        { "type": "checkbox", "id": "show_cta", "label": "Show CTA", "default": true },
        { "type": "checkbox", "id": "show_badge", "label": "Show badge", "default": true },
        { "type": "checkbox", "id": "show_video_title", "label": "Show video title", "default": false },
        { "type": "checkbox", "id": "show_play_button", "label": "Show play button", "default": true },
