{{ 'blog-sidebar.css' | asset_url | stylesheet_tag }}
{%- assign current_article_id = article.id -%}
{%- for block in section.blocks -%}
{%- case block.type -%}
  {%- when 'search' -%}
    <nav class="m-widget so-widget-toc" data-so-article-toc {{ block.shopify_attributes }} aria-label="{{ block.settings.title | default: 'In this article' | escape }}">
      <h3 class="m-widget__title so-widget-toc__title">{{ block.settings.title | default: 'In this article' }}</h3>
      <ol class="so-widget-toc__list" data-so-article-toc-list></ol>
    </nav>
  {%- when 'cta' -%}
    {%- if block.settings.title != blank or block.settings.button_label != blank -%}
      <div class="m-widget so-widget-cta" {{ block.shopify_attributes }}>
        {% if block.settings.title != blank %}
          <h3 class="m-widget__title">{{ block.settings.title }}</h3>
        {% endif %}
        {% if block.settings.text != blank %}
          <p>{{ block.settings.text }}</p>
        {% endif %}
        {% if block.settings.button_label != blank %}
          <a class="so-widget-cta__btn" href="{{ block.settings.button_link | default: '/collections/water-softeners' }}">
            {{ block.settings.button_label }}
          </a>
        {% endif %}
      </div>
    {%- endif -%}
  {%- when 'categories' -%}
    {%- assign blogs_name = block.settings.list_blog -%}
    {%- if blogs_name != blank -%}
    <div class="m-widget">
      <h3 class="m-widget__title">{{ block.settings.title }}</h3>
      <div class="m-widget__content">
        <ul class="m-link-lists">
          {% for link in linklists[blogs_name].links %}
            {% unless blog.handle == link.handle %}
              <li class="m-link-lists--item m:block">
                <a class="m-link" href="{{ link.url }}">
                  <span class="m-link__label">
                    {{ link.title }}
                    {%- if blogs[link.handle] != blank -%}
                      <span class="m-link__count">({{ blogs[link.handle].articles_count }})</span>
                    {%- endif -%}
                  </span>
                </a>
              </li>
            {% endunless %}
          {% endfor %}
        </ul>
      </div>
    </div>
    {%- endif -%}
  {%- when 'tags' -%}
    {%- if blog.all_tags != blank -%}
    <div class="m-widget">
      <h3 class="m-widget__title">{{ block.settings.title }}</h3>
      <div class="m-widget__content">
        <ul class="m-link-lists m-link-lists--inline">
          {%- for tag in blog.all_tags -%}
            <li class="m-link-lists--item m:block m:capitalize"><a class="m-link" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
    {%- endif -%}
  {%- when 'recent_post' -%}
    {% liquid
      assign name_collection = block.settings.sidebar_recent_blog_name
      assign length = block.settings.sidebar_recent_blog_count | plus: 1
      assign selected_blog = blogs[name_collection]
      if selected_blog == blank
        assign selected_blog = blog
      endif
    %}
    {%- if selected_blog != blank -%}
    <div class="m-widget">
      <h3 class="m-widget__title">{{ block.settings.title }}</h3>
      <div class="m-widget__content">
        <div class="m-recent-posts">
          {%- for article in selected_blog.articles limit: length -%}
            {%- if article.id == current_article_id -%}
              {%- continue -%}
            {%- endif -%}
            {% liquid
              if article.excerpt != blank
                assign article_excerpt = article.excerpt
              else
                assign article_excerpt = article.content
              endif

              assign truncate = block.settings.truncate | default: 10
            %}
            <div class="m-recent-post">
              <a class="m-recent-post__thumbnail" href="{{ article.url }}">{% render 'responsive-image', image: article.image %}</a>
              <div class="m-recent-post__summary">
                {%- if article.tags.size > 0 and block.settings.blog_show_tags -%}
                  <div class="m-recent-post__tag">
                    {%- for tag in article.tags limit: 1 -%}{{ tag | link_to_tag: tag }}{%- endfor -%}
                  </div>
                {%- endif -%}

                <div class="m-recent-post__title"><a href="{{ article.url }}">{{ article.title }}</a></div>
                {%- if block.settings.show_excerpt and article_excerpt != blank -%}
                  <div class="m-recent-post__description">
                    {%- if block.settings.truncate_excerpt -%}
                      {{ article_excerpt | strip_html | truncatewords: truncate, block.settings.truncate_last_symbols }}
                    {%- else -%}
                      {{ article_excerpt | strip_html }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
                
                {%- if block.settings.blog_show_author or block.settings.blog_show_date -%}
                  <div class="m-recent-post__meta">
                    {% if block.settings.blog_show_author %}{{ 'blogs.article.by_author' | t }} <span>{{ article.author }}</span> {% endif %}{% if block.settings.blog_show_date %}{{ 'blogs.article.posted_in' | t }} <span>{{ article.created_at | date: '%B' }} {{ article.created_at | date: '%d, %Y' }}</span>{% endif %}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
    {%- endif -%}
{%- endcase -%}
{%- endfor -%}
