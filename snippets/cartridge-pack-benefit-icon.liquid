{%- case icon -%}
  {%- when 'calendar' -%}
    <svg class="cpk__benefit-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <rect x="3" y="5" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="1.6"/>
      <path d="M3 9.5h18" stroke="currentColor" stroke-width="1.6"/>
      <path d="M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <rect x="7" y="12" width="3" height="3" rx="0.6" fill="currentColor"/>
      <rect x="14" y="12" width="3" height="3" rx="0.6" fill="currentColor"/>
    </svg>
  {%- when 'shield' -%}
    <svg class="cpk__benefit-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M12 3.5 18 6v5.8c0 4.1-2.7 7.2-6 8.7-3.3-1.5-6-4.6-6-8.7V6l6-2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="m9.2 12.2 1.8 1.8 3.8-3.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'box' -%}
    <svg class="cpk__benefit-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M4 8.5 12 4.5l8 4v8.5l-8 4-8-4V8.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M4 8.5 12 12.5l8-4M12 12.5V21" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>
  {%- when 'tag' -%}
    <svg class="cpk__benefit-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M4 12.5V5h7.5L20 13.5 12.5 21 4 12.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <circle cx="8" cy="9" r="1.2" fill="currentColor"/>
    </svg>
  {%- when 'clipboard' -%}
    <svg class="cpk__benefit-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <rect x="6" y="5" width="12" height="15" rx="2" stroke="currentColor" stroke-width="1.6"/>
      <path d="M9 3.5h6v3H9v-3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M9 11h4M9 14h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="m13.2 16.2 1.2 1.2 2.4-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- else -%}
    <svg class="cpk__benefit-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/>
      <path d="m8.5 12.2 2.4 2.4 4.8-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
{%- endcase -%}
