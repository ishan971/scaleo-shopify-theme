<svg class="{{ class | default: 'cpk__svg' }}" viewBox="0 0 64 88" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="{{ gradient_id }}" x1="12" y1="4" x2="52" y2="84" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#8adfff"/>
      <stop offset="42%" stop-color="#0C7FDF"/>
      <stop offset="100%" stop-color="#032047"/>
    </linearGradient>
    <linearGradient id="{{ gradient_id }}-shine" x1="18" y1="10" x2="28" y2="70" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#fff" stop-opacity="0.45"/>
      <stop offset="100%" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <rect x="18" y="4" width="28" height="8" rx="3" fill="url(#{{ gradient_id }})"/>
  <rect x="14" y="10" width="36" height="10" rx="4" fill="url(#{{ gradient_id }})"/>
  <rect x="16" y="18" width="32" height="58" rx="10" fill="url(#{{ gradient_id }})"/>
  <rect x="20" y="22" width="7" height="48" rx="3.5" fill="url(#{{ gradient_id }}-shine)"/>
  <rect x="22" y="72" width="20" height="8" rx="3" fill="url(#{{ gradient_id }})"/>
  <circle cx="32" cy="80" r="3.2" fill="#8adfff"/>
</svg>
