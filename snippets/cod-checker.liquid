<div class="location-delivery-checker pincode-widget">
  {% assign delivery_available_message = 'Delivery is available!' %}
  {% assign cod_available_message = 'COD is available!' %}
  {% assign cod_unavailable_message = 'Oops! COD is not currently available in your area.' %}
  {% assign delivery_unavailable_message = 'Oops! We are not currently servicing your area.' %}
  {% assign placeholder_message = 'Enter pincode' %}
  {% assign check_button_text = 'Check' %}
  {% assign success_color = '#468847' %}
  {% assign failure_color = '#FF0000' %}
  {% assign spacing_in_pixels = 10 %}

  <div class="pincode-widget__card">
    <div class="pincode-widget__top">
      <div class="pincode-widget__left">
        <input
          type="text"
          id="PostalCode"
          name="PostalCode"
          maxlength="6"
          inputmode="numeric"
          autocomplete="postal-code"
          placeholder="{{ placeholder_message | escape }}"
          onkeypress="return event.keyCode != 13;"
        >
        <button
          type="button"
          id="pincodeActionBtn"
          class="pincode-widget__btn"
          onclick="handlePincodeAction()"
        >
          {{ check_button_text | escape }}
        </button>
      </div>
      <span class="pincode-widget__truck" aria-hidden="true">
        <svg width="28" height="20" viewBox="0 0 28 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1.5 3.5h14.5v10H1.5V3.5Z" stroke="#222" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M16 7.5h6.2l3.3 3.6V13.5H16V7.5Z" stroke="#222" stroke-width="1.4" stroke-linejoin="round"/>
          <circle cx="7" cy="16.2" r="1.8" stroke="#222" stroke-width="1.4"/>
          <circle cx="21.5" cy="16.2" r="1.8" stroke="#222" stroke-width="1.4"/>
        </svg>
      </span>
    </div>
    <div class="pincode-widget__result" id="pincodeWidgetResult" hidden>
      <span class="pincode-widget__free">Free delivery</span>
      <span class="pincode-widget__sep">|</span>
      <span class="pincode-widget__by" id="pincodeDeliveryBy"></span>
    </div>
    <p id="PostalCodeCheckerAvailability" class="pincode-widget__msg" style="display: none;"></p>
  </div>
</div>

{% assign file_name = 'shipping-delivery-pincode.json' %}
{% assign file_url = file_name | asset_url %}
<script type="text/javascript">
    var availabilityData = [];

    function fetchAvailabilityData() {
      var jsonFileUrl = '{{ file_url }}';
      var request = new XMLHttpRequest();
      request.open('GET', jsonFileUrl, true);
      request.onload = function() {
        console.log('yest')
        if (request.status >= 200 && request.status < 400) {
          var jsonData = JSON.parse(request.responseText);
          jsonData.forEach(function(data) {
           
            availabilityData.push({
              pincode: data.Pincode,
              cod_available: data.Delivery,
              day_to_deliver: data.Day_to_deliver   
            });
          });
           // console.log('availabilityData ',availabilityData)
        } else {
          console.error('Error fetching JSON data');
        }
      };
      request.onerror = function() {
        console.error('Request failed');
      };
      request.send();
    }

    fetchAvailabilityData();

    function handlePincodeAction() {
      var widget = document.querySelector('.pincode-widget');
      var input = document.getElementById('PostalCode');
      var btn = document.getElementById('pincodeActionBtn');
      if (widget && widget.classList.contains('is-checked')) {
        widget.classList.remove('is-checked');
        if (input) {
          input.removeAttribute('readonly');
          input.focus();
          input.select();
        }
        if (btn) btn.textContent = 'Check';
        return;
      }
      checkCodAndDeliveryAvailability();
    }

    var checkCodAndDeliveryAvailability = function() {
      var box = document.getElementById('PostalCodeCheckerAvailability');
      var postalCode = document.getElementById('PostalCode').value;
      var widget = document.querySelector('.pincode-widget');
      var resultRow = document.getElementById('pincodeWidgetResult');
      var byEl = document.getElementById('pincodeDeliveryBy');
      var btn = document.getElementById('pincodeActionBtn');
      var input = document.getElementById('PostalCode');
        console.log(postalCode)
      box.style.display = 'block';
      box.style.visibility = 'hidden';

      var availability = getAvailability(postalCode);
       // console.log('availability ',availability)
      if (availability) {
        var availabilityText = ' ';

       if (availability.cod_available) {
        
          availabilityText += '  ' + {{ delivery_available_message | json }};
        } else {
          availabilityText += '  ' + {{ delivery_unavailable_message | json }};
        }

        
        // if (availability.cod_available) {
        //   availabilityText += '  ' + {{ cod_available_message | json }};
        // } else {
        //   availabilityText += '  ' + {{ cod_unavailable_message | json }};
        // }

        var longDate = new Date();
        longDate.setDate(longDate.getDate() + (availability.day_to_deliver || 0) + 2);
        var longLabel = longDate.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'short' });
        if (byEl) byEl.textContent = 'By ' + longLabel;
        if (resultRow) {
          resultRow.hidden = !availability.cod_available;
        }
        if (widget) {
          widget.classList.toggle('is-checked', !!availability.cod_available);
          widget.classList.toggle('is-error', !availability.cod_available);
        }
        if (availability.cod_available) {
          if (input) input.setAttribute('readonly', 'readonly');
          if (btn) btn.textContent = 'Change';
          box.style.display = 'none';
        } else {
          if (input) input.removeAttribute('readonly');
          if (btn) btn.textContent = 'Check';
        }

        
             
        box.textContent = availabilityText;       
        box.style.color = (availability.cod_available) ? {{ success_color | json }} : {{ failure_color | json }};
        // box.style.color = (availability.delivery_available && availability.cod_available) ? {{ success_color | json }} : {{ failure_color | json }};
      } else {
        box.textContent = "We currently do not service to this pincode.";
        box.style.color = {{ failure_color | json }};
        box.style.display = 'block';
        if (resultRow) resultRow.hidden = true;
        if (widget) {
          widget.classList.remove('is-checked');
          widget.classList.add('is-error');
        }
        if (input) input.removeAttribute('readonly');
        if (btn) btn.textContent = 'Check';
      }

      box.style.visibility = 'visible';
    };

    function getAvailability(postalCode) {
      for (var i = 0; i < availabilityData.length; i++) {
      
        if (availabilityData[i].pincode == postalCode) {
          console.log('matched')
          return {
            cod_available: availabilityData[i].cod_available,
            day_to_deliver: availabilityData[i].day_to_deliver
          };
        }
      }
      return null;
    }

