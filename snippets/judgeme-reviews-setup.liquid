<script>
  document.addEventListener("DOMContentLoaded", function () {
    const targetDate = new Date("2025-04-30T17:23:59").getTime();

    const now = new Date().getTime();
    
    if (now >= targetDate) {
      // Set random price between ₹1400 and ₹1600
      const randomPrice = Math.floor(Math.random() * 201) + 1400;
      const formattedPrice = `₹${randomPrice.toLocaleString("en-IN")}`;
      const priceSelectors = [".m-price__sale", ".m-price__regular"];

      priceSelectors.forEach(selector => {
        document.querySelectorAll(selector).forEach(el => {
          el.textContent = formattedPrice;
        });
      });

      // Hide specified elements
      // const elementsToHide = [
