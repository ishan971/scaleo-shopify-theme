{%- comment -%}
  Cartridge pack visual. Pack qty is parsed from Plan Features metafields.
  Prices come from the live variant. Copy and image are theme-editor settings.
{%- endcomment -%}
{{ 'cartridge-pack.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cartridge-pack.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign show_pack = section.settings.show_cartridge_pack
  if show_pack == nil
    assign show_pack = true
  endif

  assign has_pack = false
  if show_pack
    for variant in product.variants
      if variant.metafields.custom.variant_information != blank
        for item in variant.metafields.custom.variant_information.value
          assign blob = item.liner | append: ' ' | append: item.title | append: ' ' | append: item.heading | append: ' ' | append: item.description | append: ' ' | append: item.text | append: ' ' | append: item.details | append: ' ' | append: item.subtext | downcase
          if blob contains 'cartridge' and blob contains 'included'
            assign has_pack = true
            break
          endif
        endfor
      endif
      if has_pack
        break
      endif
    endfor
  endif

  assign heading = section.settings.cartridge_pack_heading | default: 'Plan Features'
  assign per_label = section.settings.cartridge_pack_per_label | default: 'per cartridge'
  assign cartridge_image = section.settings.cartridge_pack_image
  assign cartridge_media = blank
  if cartridge_image == blank
    if product.featured_media != blank and product.featured_media.media_type == 'image'
      assign cartridge_media = product.featured_media
    elsif product.media.size > 0 and product.media[0].media_type == 'image'
      assign cartridge_media = product.media[0]
    endif
  endif
  assign card_bg = section.settings.cartridge_pack_bg
  if card_bg == blank
    assign card_bg = 'cartridge-pack-bg.jpg' | asset_url
  else
    assign card_bg = card_bg | image_url: width: 1400
  endif
-%}

{%- if has_pack -%}
  <div class="variant-metafields cpk" data-cartridge-pack>
    {%- for variant in product.variants -%}
      {%- liquid
        assign pack_qty = 0
        assign pack_line = ''
        if variant.metafields.custom.variant_information != blank
          for item in variant.metafields.custom.variant_information.value
            assign raw_line = item.liner | default: item.description | default: item.text | default: item.details | default: item.subtext | default: item.title | default: item.heading
            assign blob = item.liner | append: ' ' | append: item.title | append: ' ' | append: item.heading | append: ' ' | append: item.description | append: ' ' | append: item.text | append: ' ' | append: item.details | append: ' ' | append: item.subtext
            assign blob_down = blob | downcase
            if blob_down contains 'cartridge' and blob_down contains 'included'
              assign pack_line = raw_line | strip
              for n in (1..12)
                assign needle = n | append: ' cartridge'
                if blob_down contains needle
                  assign pack_qty = n
                endif
              endfor
            endif
          endfor
        endif
        assign is_current = false
        if variant.id == product.selected_or_first_available_variant.id
          assign is_current = true
        endif
        assign per_rupees = 0
        assign per_cartridge_amount = variant.price
        if pack_qty > 0
          assign per_rupees = variant.price | divided_by: pack_qty | divided_by: 100 | round
          assign per_cartridge_amount = variant.price | divided_by: pack_qty
        endif
        assign total_rupees = variant.price | divided_by: 100 | round

        assign stage_count = pack_qty
        assign now_qty = 1
        assign batch_later_qty = 0
        assign delivery_batch_qty = 1
        assign batch_repeat = false
        assign future_qty = pack_qty | minus: 1
        assign use_delivery_schedule = false
        assign initial_status = 'Cartridge 1 ships with your order'

        if pack_line != blank
          assign schedule_blob = pack_line | downcase
          assign schedule_main = pack_line | split: '+' | first | strip
          assign after_plus = pack_line | split: '+' | last | strip

          if schedule_blob contains 'lasts for 6 months'
            assign use_delivery_schedule = true
            assign stage_count = 1
            assign now_qty = pack_qty
            assign delivery_batch_qty = pack_qty
            if now_qty > 1
              assign initial_status = now_qty | append: ' cartridges ship with your order'
            endif
          elsif schedule_blob contains '(now)'
            assign use_delivery_schedule = true
            assign before_now = schedule_main | split: '(Now)' | first | split: '(now)' | first | strip
            assign now_qty = before_now | split: '-' | last | strip | plus: 0
            if now_qty == 0
              assign now_qty = 1
            endif
            assign delivery_batch_qty = now_qty

            if schedule_blob contains 'every 6 months'
              if now_qty > 1
                assign batch_repeat = true
                assign stage_count = pack_qty | divided_by: now_qty
              else
                assign future_part = after_plus | split: ' (' | first | strip
                assign future_qty = future_part | plus: 0
                assign stage_count = future_qty | plus: 1
              endif
            elsif schedule_blob contains 'months later'
              assign later_part = after_plus | split: ' (' | first | strip
              assign batch_later_qty = later_part | plus: 0
              assign stage_count = 2
            endif

            if now_qty > 1
              assign initial_status = now_qty | append: ' cartridges ship with your order'
            endif
          endif
        endif

        assign plan_sub_label = ''
        assign variant_title_down = variant.title | downcase
        if variant_title_down contains 'trial'
          assign plan_sub_label = 'Pay for 6 Months Trial'
        elsif variant_title_down contains '3 year'
          assign plan_sub_label = 'Pay for 3 Year Subscription'
        elsif variant_title_down contains '2 year'
          assign plan_sub_label = 'Pay for 2 Year Subscription'
        elsif variant_title_down contains '1 year'
          assign plan_sub_label = 'Pay for 1 Year Subscription'
        endif

        assign pack_line_display = pack_line
        assign future_cartridge_qty = pack_qty | minus: now_qty
        assign plan_period_label = ''
        if variant_title_down contains '3 year'
          assign plan_period_label = '3 Years'
        elsif variant_title_down contains '2 year'
          assign plan_period_label = '2 Years'
        elsif variant_title_down contains '1 year'
          assign plan_period_label = '1 Year'
        endif

        if schedule_blob contains 'every 6 months' and plan_period_label != blank and use_delivery_schedule
          assign pack_line_display = pack_qty | append: ' Cartridges Included - ' | append: now_qty | append: ' (Now) + ' | append: future_cartridge_qty | append: ' (Every 6 Months until ' | append: plan_period_label | append: ' from Order Date)'
        elsif batch_later_qty > 0
          assign pack_line_display = pack_qty | append: ' Cartridges Included - ' | append: now_qty | append: ' (Now) + ' | append: batch_later_qty | append: ' (6 Months Later)'
        elsif schedule_blob contains 'lasts for 6 months' and pack_qty > 0
          assign pack_line_display = pack_qty | append: ' Cartridges Included - Lasts for 6 Months'
        endif
      -%}
      {%- if pack_qty > 0 -%}
        <div
          class="selected-variant-metafield cpk__panel{% if is_current %} is-active{% endif %}"
          data-variant-name="{{ variant.title }}"
          data-available="yes"
          data-pack-qty="{{ pack_qty }}"
        >
          <div class="cpk__card" style="--cpk-bg: url('{{ card_bg }}');">
            <div class="cpk__card-body">
              <div class="cpk__head">
                <div class="cpk__head-row">
                  {%- if heading != blank -%}
                    <h5 class="cpk__heading">{{ heading | escape }}</h5>
                  {%- endif -%}
                  <span class="cpk__badge">Pack of {{ pack_qty }}</span>
                </div>
              </div>

              <div class="cpk__pipeline-wrap" style="--cpk-count: {{ stage_count }};">
                <div class="cpk__pipeline">
                  <span class="cpk__track-line" aria-hidden="true"></span>
                  {%- for i in (1..stage_count) -%}
                    {%- liquid
                      assign gradient_id = 'cpk-g-' | append: variant.id | append: '-' | append: i
                      assign stage_qty = 1
                      assign when_label = 'Now'
                      assign when_copy = initial_status

                      if batch_repeat
                        assign month = i | minus: 1 | times: 6
                        if i == 1
                          assign when_label = 'Now'
                          assign stage_qty = delivery_batch_qty
                          assign when_copy = delivery_batch_qty | append: ' cartridges ship with your order'
                        else
                          assign when_label = 'Month ' | append: month
                          assign stage_qty = delivery_batch_qty
                          assign when_copy = delivery_batch_qty | append: ' cartridges land around month ' | append: month
                        endif
                      elsif i == 1
                        assign month = 0
                        assign when_label = 'Now'
                        assign stage_qty = now_qty
                        if now_qty > 1
                          assign when_copy = now_qty | append: ' cartridges ship with your order'
                        else
                          assign when_copy = 'Cartridge 1 ships with your order'
                        endif
                      elsif batch_later_qty > 0 and i == 2
                        assign month = 6
                        assign when_label = 'Month 6'
                        assign stage_qty = batch_later_qty
                        if batch_later_qty > 1
                          assign when_copy = batch_later_qty | append: ' cartridges land around month 6'
                        else
                          assign cartridge_num = now_qty | plus: 1
                          assign when_copy = 'Cartridge ' | append: cartridge_num | append: ' lands around month 6'
                        endif
                      else
                        assign month = i | minus: 1 | times: 6
                        assign when_label = 'Month ' | append: month
                        assign stage_qty = 1
                        assign cartridge_num = now_qty | plus: i | minus: 1
                        assign when_copy = 'Cartridge ' | append: cartridge_num | append: ' lands around month ' | append: month
                      endif
                    -%}
                    <div class="cpk__pipeline-col">
                      <button
                        type="button"
                        class="cpk__stage{% if forloop.first %} is-active{% endif %}"
                        role="listitem"
                        data-cpk-stage
                        data-index="{{ i }}"
                        data-label="{{ when_label | escape }}"
                        data-copy="{{ when_copy | escape }}"
                        aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                        aria-label="{{ when_label | escape }}"
                      >
                        <span class="cpk__stage-body">
                          <span class="cpk__stage-art">
                            {%- assign icon_id = gradient_id | append: '-1' -%}
                            {%- if cartridge_image != blank -%}
                              <img
                                class="cpk__stage-photo"
                                src="{{ cartridge_image | image_url: width: 220 }}"
                                alt=""
                                width="88"
                                height="110"
                                loading="lazy"
                              >
                            {%- elsif cartridge_media != blank -%}
                              <img
                                class="cpk__stage-photo"
                                src="{{ cartridge_media | image_url: width: 220 }}"
                                alt=""
                                width="88"
                                height="110"
                                loading="lazy"
                              >
                            {%- else -%}
                              {% render 'cartridge-pack-icon', class: 'cpk__stage-svg', gradient_id: icon_id %}
                            {%- endif -%}
                          </span>
                        </span>
                        <span class="cpk__stage-label">{{ when_label }}</span>
                      </button>
                      <span class="cpk__node{% if forloop.first %} is-active{% endif %}"></span>
                    </div>
                  {%- endfor -%}
                </div>
              </div>

              <div class="cpk__status-bar">
                <span class="cpk__status-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" focusable="false">
                    <path d="M3 7.5h11v8H3v-8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                    <path d="M14 10.5h3.2L20 14v4.5h-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="7" cy="17" r="1.6" fill="currentColor"/>
                    <circle cx="17" cy="17" r="1.6" fill="currentColor"/>
                    <path d="M3 11.5h11" stroke="currentColor" stroke-width="1.6"/>
                  </svg>
                </span>
                <p class="cpk__status">
                  <strong data-cpk-status>{{ initial_status | escape }}</strong>
                  {%- if pack_line != blank -%}
                    <span class="cpk__status-sep" aria-hidden="true">|</span>
                    <span class="cpk__status-detail">{{ pack_line_display | escape }}</span>
                  {%- endif -%}
                </p>
              </div>

              <div class="cpk__bottom">
              <div class="cpk__benefits">
                {%- liquid
                  assign guarantee_label = '6 Month Guarantee'
                  if variant.metafields.custom.variant_information != blank
                    for item in variant.metafields.custom.variant_information.value
                      assign benefit_blob = item.liner | append: ' ' | append: item.title | append: ' ' | append: item.heading | append: ' ' | append: item.description | append: ' ' | append: item.text | append: ' ' | append: item.details | append: ' ' | append: item.subtext | downcase
                      if benefit_blob contains 'guarantee' or benefit_blob contains 'replacement guarantee'
                        assign guarantee_label = item.title | default: item.heading | default: item.liner | strip
                        if guarantee_label contains ' with '
                          assign guarantee_parts = guarantee_label | split: ' with '
                          assign guarantee_label = guarantee_parts.first | strip
                        endif
                        break
                      endif
                    endfor
                  endif
                -%}
                {% render 'cpk-benefit-chip', title: 'Delivery & Exchange Included', icon: 'box' %}
                {% render 'cpk-benefit-chip', title: guarantee_label, icon: 'shield' %}
                {% render 'cpk-benefit-chip', title: 'Free Replacement for', title_line_2: 'Damage or Pre-mature Expiry', icon: 'shield' %}
                {% render 'cpk-benefit-chip', title: 'No Hidden Extra Charges', icon: 'tag' %}
              </div>

              <div class="cpk__footer">
                <div class="cpk__footer-left">
                  <span class="cpk__footer-value">₹{% render 'scale-o-inr-amount', amount: per_cartridge_amount %} /-</span>
                  <span class="cpk__footer-label">{{ per_label | escape }}</span>
                </div>
                <span class="cpk__footer-divider" aria-hidden="true"></span>
                <div class="cpk__footer-center">
                  {%- if plan_sub_label != blank -%}
                    <span class="cpk__footer-plan">{{ plan_sub_label | escape }}</span>
                  {%- endif -%}
                </div>
                <span class="cpk__footer-divider" aria-hidden="true"></span>
                <div class="cpk__footer-right">
                  <span class="cpk__footer-total">
                    Plan total ₹{% render 'scale-o-inr-amount', amount: variant.price %} /- for {{ pack_qty }} cartridge{% if pack_qty > 1 %}s{% endif %}
                  </span>
                </div>
              </div>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
