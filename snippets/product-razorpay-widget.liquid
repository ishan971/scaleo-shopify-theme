{%- comment -%}
  Renders the Razorpay app block only. No custom Secure Checkout markup.
{%- endcomment -%}
{%- for block in section.blocks -%}
  {%- if block.type == '@app' and block.id contains 'razorpay' -%}
    <div class="product-razorpay-widget" {{ block.shopify_attributes }}>
      {% render block %}
    </div>
  {%- endif -%}
{%- endfor -%}
