{% if product.metafields.custom.specification != blank %}
  {% assign ps = product.metafields.custom.specification.value %}
  {% if ps %}
    {%- liquid
      assign spec_filters = ps.additional_information.value | default: ps.additional_information
      assign has_filters = false
      if spec_filters != blank
        assign has_filters = true
      endif
    -%}
    <div class="specs-acc" id="product-specifications">
      <h5 class="specs-acc__heading">Specifications</h5>

      <div class="specs-acc__list-wrap">
        <div class="specs-acc__item">
          <button type="button" class="specs-acc__summary" aria-expanded="false">
            <span class="specs-acc__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="7" width="18" height="10" rx="1.5"></rect>
                <path d="M7 7v4M11 7v3M15 7v4M19 7v3"></path>
              </svg>
            </span>
            <span class="specs-acc__title">Product Dimensions</span>
            <span class="specs-acc__chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="specs-acc__panel">
            <div class="specs-acc__panel-inner">
              <div class="specs-acc__body">
                <div class="specs-acc__product-title">
                  <h4><b>{{ product.title }}</b></h4>
                  <div data-shop-id="{{ shop.id }}" product-id="{{ product.id }}" data-page="{{ request.page_type }}" class="ddreview-star"></div>
                </div>
                <div class="specs-acc__table" role="table">
                  <div class="specs-acc__row specs-acc__row--head" role="row">
                    <div role="columnheader"></div>
                    <div role="columnheader">Inch</div>
                    <div role="columnheader">C.M</div>
                  </div>
                  <div class="specs-acc__row" role="row">
                    <div role="cell">Length</div>
                    <div role="cell">{{ ps.product_dimension_length_inch }}</div>
                    <div role="cell">{{ ps.product_dimension_length_cm }}</div>
                  </div>
                  <div class="specs-acc__row" role="row">
                    <div role="cell">Width</div>
                    <div role="cell">{{ ps.product_dimension_width_inch }}</div>
                    <div role="cell">{{ ps.product_dimension_width_cm }}</div>
                  </div>
                  <div class="specs-acc__row" role="row">
                    <div role="cell">Height</div>
                    <div role="cell">{{ ps.product_dimension_height_inch }}</div>
                    <div role="cell">{{ ps.product_dimension_height_cm }}</div>
                  </div>
                </div>
                {% if ps.product_weight %}
                  <p class="specs-acc__weight"><b>Weight</b> : {{ ps.product_weight }}</p>
                {% endif %}
              </div>
            </div>
          </div>
        </div>

        <div class="specs-acc__item">
          <button type="button" class="specs-acc__summary" aria-expanded="false">
            <span class="specs-acc__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="8" width="16" height="13" rx="1"></rect>
                <path d="M4 13h16M12 8v13"></path>
                <path d="M8 8V5l4 2 4-2v3"></path>
              </svg>
            </span>
            <span class="specs-acc__title">Package Dimensions</span>
            <span class="specs-acc__chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="specs-acc__panel">
            <div class="specs-acc__panel-inner">
              <div class="specs-acc__body">
                <div class="specs-acc__table" role="table">
                  <div class="specs-acc__row specs-acc__row--head" role="row">
                    <div role="columnheader"></div>
                    <div role="columnheader">Inch</div>
                    <div role="columnheader">C.M</div>
                  </div>
                  <div class="specs-acc__row" role="row">
                    <div role="cell">Length</div>
                    <div role="cell">{{ ps.package_dimensions_length_inch }}</div>
                    <div role="cell">{{ ps.package_dimensions_length_cm }}</div>
                  </div>
                  <div class="specs-acc__row" role="row">
                    <div role="cell">Width</div>
                    <div role="cell">{{ ps.package_dimensions_width_inch }}</div>
                    <div role="cell">{{ ps.package_dimensions_width_cm }}</div>
                  </div>
                  <div class="specs-acc__row" role="row">
                    <div role="cell">Height</div>
                    <div role="cell">{{ ps.package_dimensions_height_inch }}</div>
                    <div role="cell">{{ ps.package_dimensions_height_cm }}</div>
                  </div>
                </div>
                {% if ps.package_weight %}
                  <p class="specs-acc__weight"><b>Weight</b> : {{ ps.package_weight }}</p>
                {% endif %}
              </div>
            </div>
          </div>
        </div>

        {% if has_filters %}
          <div class="specs-acc__item">
            <button type="button" class="specs-acc__summary" aria-expanded="false">
              <span class="specs-acc__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
              </span>
              <span class="specs-acc__title">Additional Information</span>
              <span class="specs-acc__chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </button>
            <div class="specs-acc__panel">
              <div class="specs-acc__panel-inner">
                <div class="specs-acc__body">
                  <div class="specs-acc__pairs">
                    {% for i in spec_filters %}
                      {% assign dfl = forloop.index0 | modulo: 2 %}
                      {% if dfl == 0 %}
                        <div class="specs-acc__pair">
                          <span class="specs-acc__pair-label">{{ i }}</span>
                      {% else %}
                          <span class="specs-acc__pair-value">{{ i }}</span>
                        </div>
                      {% endif %}
                      {% if dfl == 0 and forloop.last %}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endif %}

        {% if ps.specification_bottom_content %}
          <div class="specs-acc__item">
            <button type="button" class="specs-acc__summary" aria-expanded="false">
              <span class="specs-acc__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </span>
              <span class="specs-acc__title">More Details</span>
              <span class="specs-acc__chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </button>
            <div class="specs-acc__panel">
              <div class="specs-acc__panel-inner">
                <div class="specs-acc__body specs-acc__body--rte">
                  {{ ps.specification_bottom_content | metafield_tag }}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}
{% endif %}
