{%- comment -%}
  Scale-O article share pills: Facebook, X, LinkedIn, copy link.
{%- endcomment -%}
{%- liquid
  assign share_url = url
  if share_url == blank
    assign share_url = shop.url | append: article.url
  endif
  assign share_title = article.title | default: page_title
  assign encoded_url = share_url | url_encode
  assign encoded_title = share_title | url_encode
-%}
<nav class="so-article-share" aria-label="Share this article">
  <span class="so-article-share__label">Share</span>
  <div class="so-article-share__list">
    <a
      class="so-article-share__btn"
      href="https://www.facebook.com/sharer/sharer.php?u={{ encoded_url }}"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 8h3V4h-3c-2.8 0-5 2.2-5 5v2H7v4h2v8h4v-8h3l1-4h-4V9c0-.6.4-1 1-1z"/></svg>
      <span>Facebook</span>
    </a>
    <a
      class="so-article-share__btn"
      href="https://twitter.com/intent/tweet?url={{ encoded_url }}&text={{ encoded_title }}"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 16 15" aria-hidden="true"><path fill="currentColor" d="M0.04 0L6.14 8.16 0 14.79h1.38l5.37-5.81 4.34 5.81h4.7L9.35 6.17 15.07 0h-1.38L8.74 5.35 4.74 0H.04zM2.07 1.02h2.16l9.54 12.75H11.6L2.07 1.02z"/></svg>
      <span>Twitter</span>
    </a>
    <a
      class="so-article-share__btn"
      href="https://www.linkedin.com/sharing/share-offsite/?url={{ encoded_url }}"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.5 8.5H3.7V20h2.8V8.5zM5.1 4C4.1 4 3.3 4.8 3.3 5.8s.8 1.8 1.8 1.8 1.8-.8 1.8-1.8S6.1 4 5.1 4zM20.3 20h-2.8v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V20H10.8V8.5h2.7v1.6c.4-.7 1.3-1.8 3.2-1.8 3.4 0 4 2.2 4 5.1V20z"/></svg>
      <span>LinkedIn</span>
    </a>
    <button
      type="button"
      class="so-article-share__btn"
      data-so-copy-link
      data-copy-url="{{ share_url | escape }}"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M10 13a5 5 0 0 0 7.07 0l1.41-1.41a5 5 0 0 0-7.07-7.07L10 5.93"/>
        <path d="M14 11a5 5 0 0 0-7.07 0L5.52 12.4a5 5 0 0 0 7.07 7.07L14 18.07"/>
      </svg>
      <span data-so-copy-label>Copy link</span>
    </button>
  </div>
</nav>
