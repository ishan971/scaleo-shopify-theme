{%- comment -%}
  Scale-O cart promo — plan-based coupons + view all coupons.
{%- endcomment -%}
{%- liquid
  assign promo_on = settings.cart_drawer_promo_enable
  assign auto_apply = settings.cart_drawer_promo_auto_apply

  assign subtotal_cents = cart.original_total_price | default: cart.total_price
  if cart.original_total_price == blank or cart.original_total_price == 0
    assign subtotal_cents = cart.total_price | plus: cart.total_discount
  endif

  assign show_promo = false
  if promo_on
    assign show_promo = true
  endif
-%}

{%- if show_promo -%}
  <div
    class="scale-o-cart-promo{% if cart.item_count == 0 %} is-empty{% endif %}"
    data-scale-o-cart-promo
    data-auto-apply="{% if auto_apply %}true{% else %}false{% endif %}"
    data-currency-code="{% if settings.currency_code_enabled %}true{% else %}false{% endif %}"
    {% if cart.item_count == 0 %}hidden{% endif %}
  >
    <input
      type="hidden"
      name="discount"
      form="cart-drawer-form"
      value=""
      data-scale-o-promo-input
    >

    <div class="scale-o-cart-promo__coupons-zone">
      <div class="scale-o-cart-promo__collapsed" data-scale-o-promo-collapsed>
        <div class="scale-o-cart-promo__offer" data-scale-o-promo-active-card hidden>
          <span class="scale-o-cart-promo__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="11" fill="#0C7FDF"/>
              <text x="12" y="16" text-anchor="middle" fill="#fff" font-size="11" font-weight="700" font-family="system-ui,sans-serif">%</text>
            </svg>
          </span>
          <div class="scale-o-cart-promo__offer-copy">
            <p class="scale-o-cart-promo__offer-title" data-scale-o-promo-active-title>Plan discount applied</p>
            <p class="scale-o-cart-promo__offer-sub">
              Code: <strong data-scale-o-promo-active-code>—</strong>
            </p>
          </div>
          <span class="scale-o-cart-promo__applied" data-scale-o-promo-applied-badge>Applied</span>
        </div>

        <button
          type="button"
          class="scale-o-cart-promo__coupons-toggle"
          data-scale-o-promo-toggle
          aria-expanded="false"
          aria-controls="scale-o-cart-promo-list"
        >
          <span class="scale-o-cart-promo__coupons-toggle-label">View all coupons</span>
          <svg class="scale-o-cart-promo__coupons-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div
        id="scale-o-cart-promo-list"
        class="scale-o-cart-promo__coupons-panel scale-o-scroll-hidden"
        data-scale-o-promo-list
        hidden
      >
        <button
          type="button"
          class="scale-o-cart-promo__coupons-back"
          data-scale-o-promo-toggle
          aria-expanded="true"
          aria-controls="scale-o-cart-promo-list"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 4L6 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Hide coupons</span>
        </button>
        <ul class="scale-o-cart-promo__coupon-list" role="list">
          <li class="scale-o-cart-promo__coupon-item" data-coupon-code="SO-6M" data-coupon-amount="500">
            <div class="scale-o-cart-promo__coupon-main">
              <span class="scale-o-cart-promo__coupon-code">SO-6M</span>
              <span class="scale-o-cart-promo__coupon-desc">Get ₹500 OFF on 6 Month / Trial Plan</span>
            </div>
            <span class="scale-o-cart-promo__coupon-badge" data-coupon-badge hidden>Applied</span>
          </li>
          <li class="scale-o-cart-promo__coupon-item" data-coupon-code="SO-1Y" data-coupon-amount="1000">
            <div class="scale-o-cart-promo__coupon-main">
              <span class="scale-o-cart-promo__coupon-code">SO-1Y</span>
              <span class="scale-o-cart-promo__coupon-desc">Get ₹1,000 OFF on 1 Year Plan</span>
            </div>
            <span class="scale-o-cart-promo__coupon-badge" data-coupon-badge hidden>Applied</span>
          </li>
          <li class="scale-o-cart-promo__coupon-item" data-coupon-code="SO-2Y" data-coupon-amount="1000">
            <div class="scale-o-cart-promo__coupon-main">
              <span class="scale-o-cart-promo__coupon-code">SO-2Y</span>
              <span class="scale-o-cart-promo__coupon-desc">Get ₹1,000 OFF on 2 Year Plan</span>
            </div>
            <span class="scale-o-cart-promo__coupon-badge" data-coupon-badge hidden>Applied</span>
          </li>
          <li class="scale-o-cart-promo__coupon-item" data-coupon-code="SO-3Y" data-coupon-amount="2000">
            <div class="scale-o-cart-promo__coupon-main">
              <span class="scale-o-cart-promo__coupon-code">SO-3Y</span>
              <span class="scale-o-cart-promo__coupon-desc">Get ₹2,000 OFF on 3 Year Plan</span>
            </div>
            <span class="scale-o-cart-promo__coupon-badge" data-coupon-badge hidden>Applied</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="scale-o-cart-promo__summary">
      <div class="scale-o-cart-promo__rows">
        <div class="scale-o-cart-promo__row">
          <span>Cart Total</span>
          <span data-scale-o-promo-subtotal>
            {%- if settings.currency_code_enabled -%}
              {{ subtotal_cents | money_with_currency }}
            {%- else -%}
              {{ subtotal_cents | money }}
            {%- endif -%}
          </span>
        </div>
        <div class="scale-o-cart-promo__row scale-o-cart-promo__row--discount" data-scale-o-promo-plan-row hidden>
          <span data-scale-o-promo-plan-label>Plan Discount</span>
          <span data-scale-o-promo-plan-discount>- ₹0.00</span>
        </div>
        <div class="scale-o-cart-promo__row">
          <span>GST (18%)</span>
          <span class="scale-o-cart-promo__gst-included">Included</span>
        </div>
        <div class="scale-o-cart-promo__row scale-o-cart-promo__row--payable">
          <span>To Pay</span>
          <span data-scale-o-promo-payable>
            {%- if settings.currency_code_enabled -%}
              {{ cart.total_price | money_with_currency }}
            {%- else -%}
              {{ cart.total_price | money }}
            {%- endif -%}
          </span>
        </div>
      </div>
      <p class="scale-o-cart-promo__meta">
        <span class="scale-o-cart-promo__note">Free Shipping on All Orders</span>
      </p>
    </div>
  </div>
{%- endif -%}
