{%- comment -%}
  Comparison value cell.
  Accepts: value, status, featured, short_label
{%- endcomment -%}
{%- liquid
  assign cell_status = status | default: 'neutral'
  assign cell_value = value | default: ''
  assign is_featured = false
  if featured == true or featured == 'true'
    assign is_featured = true
  endif
-%}
  <span class="scale-o-compare__cell scale-o-compare__cell--{{ cell_status }}{% if is_featured %} scale-o-compare__cell--featured{% endif %}">
    <span class="scale-o-compare__mark" aria-hidden="true">
      {%- if cell_status == 'positive' or cell_status == 'not_required' -%}
        <svg viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.2 3.2L13 4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {%- elsif cell_status == 'negative' -%}
        <svg viewBox="0 0 16 16" fill="none"><path d="M4 4l8 8M12 4 4 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      {%- else -%}
        <span class="scale-o-compare__dot"></span>
      {%- endif -%}
    </span>
    {%- if short_label != blank -%}
      <span class="scale-o-compare__cell-label">{{ short_label | escape }}</span>
    {%- endif -%}
    {%- if cell_value != blank -%}
      <span class="scale-o-compare__value">{{ cell_value | escape }}</span>
    {%- endif -%}
  </span>
