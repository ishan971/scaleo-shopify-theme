{%- comment -%}
  Scale-O technology comparison icons. Accepts: icon, class
{%- endcomment -%}
{%- liquid
  assign icon_name = icon | default: 'none'
  assign svg_class = class | default: 'scale-o-compare__icon-svg'
-%}
{%- unless icon_name == 'none' or icon_name == blank -%}
  {%- case icon_name -%}
    {%- when 'bucket' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M6 8h12l-1.2 11.2A2 2 0 0 1 14.8 21H9.2a2 2 0 0 1-2-1.8L6 8z"/><path d="M4 8h16"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
      </svg>
    {%- when 'pipe' -%}
