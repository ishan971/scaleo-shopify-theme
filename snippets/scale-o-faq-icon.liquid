      <path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M21 16v2a3 3 0 0 1-3 3h-2"/>
    </svg>
  {%- when 'whatsapp' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M12.04 2.73A9.25 9.25 0 0 0 3.1 15.02L2 21.27l6.4-1.05a9.25 9.25 0 0 0 3.64.74h.01A9.25 9.25 0 0 0 12.04 2.73zm5.4 13.13c-.23.64-1.33 1.23-1.86 1.31-.48.07-1.08.1-1.74-.11-.4-.12-.91-.3-1.57-.58-2.76-1.19-4.56-3.97-4.7-4.16-.14-.19-1.15-1.53-1.15-2.92 0-1.39.73-2.07 1-2.35.23-.24.61-.35.98-.35.12 0 .22 0 .32.01.28.01.42.03.6.47.23.54.78 1.9.85 2.04.07.14.12.3.02.49-.09.19-.14.3-.27.46-.14.16-.29.35-.41.47-.14.14-.28.29-.12.56.16.27.72 1.19 1.55 1.93 1.07.95 1.97 1.25 2.28 1.4.28.12.45.1.62-.06.19-.19.8-.93 1.01-1.25.21-.32.42-.26.7-.16.28.1 1.78.84 2.09.99.3.15.5.23.58.35.07.13.07.74-.16 1.38z"/>
    </svg>
  {%- else -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="8.5"/><path d="M9.5 9.2a2.5 2.5 0 0 1 4.8.8c0 1.6-2.3 2-2.3 3.5"/><circle cx="12" cy="17" r="0.7" fill="currentColor" stroke="none"/>
    </svg>
{%- endcase -%}
