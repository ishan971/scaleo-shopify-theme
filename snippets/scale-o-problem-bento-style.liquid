{%- comment -%}
  Returns inline grid placement style for auto bento layouts.
  Accepts: index, total
{%- endcomment -%}
{%- liquid
  assign idx = index | plus: 0
  assign total = total | plus: 0
  assign style = ''

  if total == 8
    case idx
      when 1
        assign style = 'grid-column: 1 / span 2; grid-row: 1;'
      when 2
        assign style = 'grid-column: 3; grid-row: 1;'
      when 3
        assign style = 'grid-column: 4; grid-row: 1 / span 2;'
      when 4
        assign style = 'grid-column: 1; grid-row: 2;'
      when 5
        assign style = 'grid-column: 2; grid-row: 2;'
      when 6
        assign style = 'grid-column: 1; grid-row: 3;'
      when 7
        assign style = 'grid-column: 2; grid-row: 3;'
      when 8
        assign style = 'grid-column: 3 / span 2; grid-row: 3;'
    endcase
  elsif total == 7
    case idx
      when 1
        assign style = 'grid-column: 1 / span 2; grid-row: 1;'
      when 2
        assign style = 'grid-column: 3; grid-row: 1;'
      when 3
        assign style = 'grid-column: 4; grid-row: 1 / span 2;'
      when 4
        assign style = 'grid-column: 1; grid-row: 2;'
      when 5
        assign style = 'grid-column: 2; grid-row: 2;'
      when 6
        assign style = 'grid-column: 1 / span 2; grid-row: 3;'
      when 7
        assign style = 'grid-column: 3 / span 2; grid-row: 3;'
    endcase
  elsif total == 6
    case idx
      when 1
        assign style = 'grid-column: 1 / span 2; grid-row: 1;'
      when 2
        assign style = 'grid-column: 3; grid-row: 1;'
      when 3
        assign style = 'grid-column: 4; grid-row: 1 / span 2;'
      when 4
        assign style = 'grid-column: 1; grid-row: 2;'
      when 5
        assign style = 'grid-column: 2 / span 2; grid-row: 2;'
      when 6
        assign style = 'grid-column: 1 / span 2; grid-row: 3;'
    endcase
  elsif total == 5
    case idx
      when 1
        assign style = 'grid-column: 1 / span 2; grid-row: 1;'
      when 2
        assign style = 'grid-column: 3; grid-row: 1;'
      when 3
        assign style = 'grid-column: 4; grid-row: 1 / span 2;'
      when 4
        assign style = 'grid-column: 1; grid-row: 2;'
      when 5
        assign style = 'grid-column: 2 / span 2; grid-row: 2;'
    endcase
  elsif total == 4
    case idx
      when 1
        assign style = 'grid-column: 1 / span 2; grid-row: 1;'
      when 2
        assign style = 'grid-column: 3 / span 2; grid-row: 1;'
      when 3
        assign style = 'grid-column: 1 / span 2; grid-row: 2;'
      when 4
        assign style = 'grid-column: 3 / span 2; grid-row: 2;'
    endcase
  elsif total == 3
    case idx
      when 1
        assign style = 'grid-column: 1 / span 2; grid-row: 1;'
      when 2
        assign style = 'grid-column: 3; grid-row: 1;'
      when 3
        assign style = 'grid-column: 1 / span 3; grid-row: 2;'
    endcase
  elsif total == 2
    case idx
      when 1
        assign style = 'grid-column: 1 / span 2; grid-row: 1;'
      when 2
        assign style = 'grid-column: 3 / span 2; grid-row: 1;'
    endcase
  endif
-%}
{{- style -}}
