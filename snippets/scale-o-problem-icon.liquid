{%- comment -%}
  Scale-O hard-water problem icons. Accepts: icon, class
{%- endcomment -%}
{%- liquid
  assign icon_name = icon | default: 'none'
  assign svg_class = class | default: 'scale-o-problems__icon-svg'
-%}
{%- unless icon_name == 'none' or icon_name == blank -%}
  {%- case icon_name -%}
    {%- when 'faucet' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 2v6"/><path d="M8 8h8"/><path d="M7 8a5 5 0 0 0 10 0"/><path d="M12 13v3"/><path d="M10 18c0 1.1.9 2 2 2s2-.9 2-2"/><path d="M8 21h8"/>
      </svg>
    {%- when 'shower' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M4 4h9a4 4 0 0 1 4 4v1H8"/><path d="M8 9v2"/><path d="M8 14v.01"/><path d="M12 14v.01"/><path d="M16 14v.01"/><path d="M8 18v.01"/><path d="M12 18v.01"/><path d="M16 18v.01"/>
      </svg>
    {%- when 'heater' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="7" y="3" width="10" height="18" rx="2"/><path d="M10 7h4"/><path d="M10 11h4"/><circle cx="12" cy="16.5" r="1.2"/>
      </svg>
    {%- when 'pipe' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M4 10h8v8"/><path d="M12 18h8"/><path d="M4 7v6"/><path d="M20 15v6"/>
      </svg>
    {%- when 'floor' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18"/><path d="M12 3v18"/>
      </svg>
    {%- when 'hair' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="8" r="4"/><path d="M6 20c1.5-3 4-4.5 6-4.5S16.5 17 18 20"/><path d="M8 4c1-2 3-2.5 4-2.5S15 2 16 4"/>
      </svg>
    {%- when 'skin' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="8" r="4"/><path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
      </svg>
    {%- when 'appliance' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 8h16"/><circle cx="12" cy="14.5" r="3"/>
      </svg>
    {%- when 'droplet' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
      </svg>
    {%- when 'glass' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M8 3h8l-1.2 14.4A3 3 0 0 1 11.82 20h.36a3 3 0 0 1-2.98-2.6L8 3z"/><path d="M8.5 9h7"/>
      </svg>
  {%- endcase -%}
{%- endunless -%}
