{%- comment -%}
  Scale-O Solution icons. Accepts: icon, class
  Used when no custom image is uploaded.
{%- endcomment -%}
{%- liquid
  assign icon_name = icon | default: 'none'
  assign svg_class = class | default: 'scale-o-solution__icon-svg'
-%}
{%- unless icon_name == 'none' or icon_name == blank -%}
  {%- case icon_name -%}
    {%- when 'scale' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 3v4"/><path d="M8 7h8"/><path d="M6 11c0 4 2.5 7 6 9 3.5-2 6-5 6-9"/><path d="M9 14h6"/>
      </svg>
    {%- when 'appliance' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 8h16"/><circle cx="12" cy="14.5" r="3"/>
      </svg>
    {%- when 'faucet' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 2v6"/><path d="M8 8h8"/><path d="M7 8a5 5 0 0 0 10 0"/><path d="M12 13v3"/><path d="M10 18c0 1.1.9 2 2 2s2-.9 2-2"/><path d="M8 21h8"/>
      </svg>
    {%- when 'droplet' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
      </svg>
    {%- when 'electricity' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/>
      </svg>
    {%- when 'salt' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M8 4h8l2 6H6l2-6z"/><path d="M6 10v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-8"/><path d="M10 14h.01"/><path d="M14 14h.01"/><path d="M12 17h.01"/>
      </svg>
    {%- when 'water' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M3 15c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2"/><path d="M3 9c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2"/><path d="M12 3v2"/>
      </svg>
    {%- when 'maintenance' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 0 0 5.4-5.4z"/><path d="m15 7 2 2"/>
      </svg>
    {%- when 'shield' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3z"/><path d="m9 12 2 2 4-4"/>
      </svg>
    {%- when 'home' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/>
      </svg>
    {%- when 'floor' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18"/><path d="M12 3v18"/>
      </svg>
    {%- when 'heater' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="7" y="3" width="10" height="18" rx="2"/><path d="M10 7h4"/><path d="M10 11h4"/><circle cx="12" cy="16.5" r="1.2"/>
      </svg>
    {%- when 'glass' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M8 3h8l-1.2 14.4A3 3 0 0 1 11.82 20h.36a3 3 0 0 1-2.98-2.6L8 3z"/><path d="M8.5 9h7"/>
      </svg>
    {%- when 'hair' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="8" r="4"/><path d="M6 20c1.5-3 4-4.5 6-4.5S16.5 17 18 20"/><path d="M8 4c1-2 3-2.5 4-2.5S15 2 16 4"/>
      </svg>
    {%- when 'bathroom' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M4 12h16v2a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-2z"/><path d="M7 12V6a2 2 0 0 1 2-2h1"/><path d="M7 19v2M17 19v2"/><circle cx="16" cy="5" r="1"/><circle cx="19" cy="7" r="1"/>
      </svg>
    {%- when 'family' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="9" cy="8" r="3"/><path d="M3.5 19v-1.2A4.3 4.3 0 0 1 7.8 13.5h2.4A4.3 4.3 0 0 1 14.5 17.8V19"/><circle cx="16.5" cy="8.5" r="2.4"/><path d="M16 13.6h1.2a3.8 3.8 0 0 1 3.8 3.8V19"/>
      </svg>
    {%- when 'sparkle' -%}
      <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 3v3"/><path d="M12 18v3"/><path d="M3 12h3"/><path d="M18 12h3"/><path d="M5.6 5.6l2.1 2.1"/><path d="M16.3 16.3l2.1 2.1"/><path d="M18.4 5.6l-2.1 2.1"/><path d="M7.7 16.3l-2.1 2.1"/><path d="M12 8.5l1.1 2.3 2.4 1.1-2.4 1.1L12 15.3l-1.1-2.3-2.4-1.1 2.4-1.1z"/>
      </svg>
  {%- endcase -%}
{%- endunless -%}
