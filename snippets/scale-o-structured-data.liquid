{%- comment -%}
  Scale-O structured data: Organization (sitewide), WebSite (sitewide), WebPage (pages).
  Render from header with: {% render 'scale-o-structured-data', logo: section.settings.logo %}
{%- endcomment -%}

{%- liquid
  assign org_id = shop.url | append: '/#organization'
  assign website_id = shop.url | append: '/#website'
  assign page_id = canonical_url

  assign logo_url = blank
  if logo != blank
    assign logo_url = logo | image_url: width: logo.width
    unless logo_url contains 'https:'
      assign logo_url = logo_url | prepend: 'https:'
    endunless
  endif
-%}

{%- capture same_as_items -%}
  {%- if settings.social_facebook_link != blank -%}{{ settings.social_facebook_link | json }},{%- endif -%}
  {%- if settings.social_instagram_link != blank -%}{{ settings.social_instagram_link | json }},{%- endif -%}
  {%- if settings.social_youtube_link != blank -%}{{ settings.social_youtube_link | json }},{%- endif -%}
  {%- if settings.social_twitter_link != blank -%}{{ settings.social_twitter_link | json }},{%- endif -%}
  {%- if settings.social_linkedin_link != blank -%}{{ settings.social_linkedin_link | json }},{%- endif -%}
  {%- if settings.social_tiktok_link != blank -%}{{ settings.social_tiktok_link | json }},{%- endif -%}
  {%- if settings.social_pinterest_link != blank -%}{{ settings.social_pinterest_link | json }},{%- endif -%}
  {%- if settings.social_whatsapp_link != blank -%}{{ settings.social_whatsapp_link | json }},{%- endif -%}
  {%- if settings.social_snapchat_link != blank -%}{{ settings.social_snapchat_link | json }},{%- endif -%}
  {%- if settings.social_tumblr_link != blank -%}{{ settings.social_tumblr_link | json }},{%- endif -%}
  {%- if settings.social_vimeo_link != blank -%}{{ settings.social_vimeo_link | json }},{%- endif -%}
{%- endcapture -%}
{%- assign same_as_items = same_as_items | strip | replace: ',,', ',' | remove_last: ',' -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": {{ org_id | json }},
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }}
  {%- if logo_url != blank -%}
  ,"logo": {
    "@type": "ImageObject",
    "url": {{ logo_url | json }}
  }
  {%- endif -%}
  {%- if same_as_items != blank -%}
  ,"sameAs": [{{ same_as_items }}]
  {%- endif -%}
  {%- if settings.contact_phone_number != blank or settings.contact_email != blank -%}
  ,"contactPoint": [{
    "@type": "ContactPoint",
    "contactType": "customer service"
    {%- if settings.contact_phone_number != blank -%}
    ,"telephone": {{ settings.contact_phone_number | json }}
    {%- endif -%}
    {%- if settings.contact_email != blank -%}
    ,"email": {{ settings.contact_email | json }}
    {%- endif -%}
    ,"areaServed": "IN",
    "availableLanguage": ["en", "hi"]
  }]
  {%- endif -%}
}
</script>

{%- assign search_target = shop.url | append: routes.search_url | append: '?q={search_term_string}' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": {{ website_id | json }},
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "publisher": {
    "@id": {{ org_id | json }}
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": {{ search_target | json }}
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- if request.page_type == 'page' -%}
  {%- liquid
    assign webpage_name = page.title | default: page_title
    assign webpage_description = page_description | default: page.content | strip_html | truncate: 160
  -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": {{ page_id | json }},
  "url": {{ page_id | json }},
  "name": {{ webpage_name | json }},
  "description": {{ webpage_description | json }},
  "isPartOf": {
    "@id": {{ website_id | json }}
  },
  "about": {
    "@id": {{ org_id | json }}
  },
  "publisher": {
    "@id": {{ org_id | json }}
  },
  "inLanguage": {{ request.locale.iso_code | json }}
}
</script>
{%- endif -%}
