{%- comment -%}
  Checkbox filter group using product tags. Same UI as Shopify storefront filters.
  Accepts: title, options_text, group_id
{%- endcomment -%}
{%- liquid
  assign option_lines = options_text | newline_to_br | split: '<br />'
  assign group_handle = title | handleize
  assign has_any = false
  assign active_count = 0
-%}
{%- for raw_line in option_lines -%}
  {%- assign option_label = raw_line | strip | replace: '<br />', '' | replace: '<br>', '' -%}
  {%- if option_label == blank -%}{%- continue -%}{%- endif -%}
  {%- liquid
    assign option_handle = option_label | handleize
    assign option_down = option_label | downcase
    if current_tags contains option_label or current_tags contains option_handle or current_tags contains option_down
      assign active_count = active_count | plus: 1
      assign has_any = true
    endif
    for existing_tag in collection.all_tags
      assign existing_handle = existing_tag | handleize
      if existing_handle == option_handle or existing_tag == option_label
        assign has_any = true
        break
      endif
    endfor
  -%}
{%- endfor -%}
{%- if has_any -%}
  <div class="m-filter--widget m-accordion--item open{% if active_count > 0 %} has-active{% endif %}" data-scale-o-tag-filter="{{ group_id | escape }}">
    <div class="m-filter--widget-title h5 m-accordion--item-button">
      <span>{{ title | escape }}</span>
      {%- if active_count > 0 -%}
        <span class="scale-o-filter-pill-count">{{ active_count }}</span>
      {%- endif -%}
      <span class="m-accordion--item-icon">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M13.5306 6.53073L8.5306 11.5307C8.46092 11.6007 8.37813 11.6561 8.28696 11.694C8.1958 11.7318 8.09806 11.7513 7.99935 11.7513C7.90064 11.7513 7.8029 11.7318 7.71173 11.694C7.62057 11.6561 7.53778 11.6007 7.4681 11.5307L2.4681 6.53073C2.3272 6.38984 2.24805 6.19874 2.24805 5.99948C2.24805 5.80023 2.3272 5.60913 2.4681 5.46823C2.60899 5.32734 2.80009 5.24818 2.99935 5.24818C3.19861 5.24818 3.3897 5.32734 3.5306 5.46823L7.99997 9.93761L12.4693 5.46761C12.6102 5.32671 12.8013 5.24756 13.0006 5.24756C13.1999 5.24756 13.391 5.32671 13.5318 5.46761C13.6727 5.60851 13.7519 5.7996 13.7519 5.99886C13.7519 6.19812 13.6727 6.38921 13.5318 6.53011L13.5306 6.53073Z" fill="currentColor"/>
        </svg>
      </span>
    </div>
    <div class="m-filter--widget-content m-accordion--item-content" style="opacity: 1;">
      <ul class="m-facets{% if section.settings.limit_height_widget %} m-filter--scroll-content m-scrollbar--vertical{% endif %}" role="list" style="--max-height: {{ section.settings.limit_height }}px;">
        {%- for raw_line in option_lines -%}
          {%- assign option_label = raw_line | strip | replace: '<br />', '' | replace: '<br>', '' -%}
          {%- if option_label == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign option_handle = option_label | handleize
            assign option_down = option_label | downcase
            assign is_active = false
            if current_tags contains option_label or current_tags contains option_handle or current_tags contains option_down
              assign is_active = true
            endif

            assign tag_in_collection = false
            for existing_tag in collection.all_tags
              assign existing_handle = existing_tag | handleize
              if existing_handle == option_handle or existing_tag == option_label
                assign tag_in_collection = true
                break
              endif
            endfor
          -%}
          <li class="m-facet--item{% if is_active %} active remove-tag{% else %} add-tag{% endif %}" data-group="{{ group_handle }}" data-handle="{{ option_handle }}" data-tag-filter>
            <label class="m-facet--checkbox{% unless tag_in_collection or is_active %} m-facet--checkbox__disabled{% endunless %}">
              {%- if is_active -%}
                {{ option_label | link_to_remove_tag: option_down | replace: '<a', '<a class="m-facet--tag-link"' }}
              {%- elsif tag_in_collection -%}
                {{ option_label | link_to_add_tag: option_down | replace: '<a', '<a class="m-facet--tag-link"' }}
              {%- endif -%}
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="0.5" y="0.5" width="17" height="17" stroke="currentColor"></rect>
                <path d="M4.875 9.75L7.5 12.375L13.5 6.375" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span class="m-facet--label">{{ option_label | escape }}</span>
            </label>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}
