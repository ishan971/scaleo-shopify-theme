{% if settings.show_scroll_top_button %}
  {% style %}
    #scroll-to-top-button.m-button--scroll-top {
      position: fixed !important;
      top: auto !important;
      left: auto !important;
      right: max(16px, env(safe-area-inset-right, 0px)) !important;
      bottom: max(20px, env(safe-area-inset-bottom, 0px)) !important;
      z-index: 999;
      margin: 0;
      border-radius: 50%;
      padding: 0;
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      width: 46px;
      height: 46px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      box-shadow: 0 8px 20px rgba(12, 127, 223, 0.28);
      transition: opacity 0.2s ease, visibility 0.2s ease, bottom 0.2s ease;
    }

    #scroll-to-top-button.m-button--scroll-top.is-show {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .m-scroll-top-target {
      width: 0;
      height: 0;
      visibility: hidden;
      opacity: 0;
    }

    @media (max-width: 767px) {
      #scroll-to-top-button.m-button--scroll-top {
        width: 42px;
        height: 42px;
        right: max(12px, env(safe-area-inset-right, 0px)) !important;
        bottom: max(16px, env(safe-area-inset-bottom, 0px)) !important;
      }

      #scroll-to-top-button.m-button--scroll-top svg {
        width: 14px;
        height: 14px;
      }
    }

    /* Sit above mobile sticky ATC when it is visible */
    html.scale-o-sticky-atc-on #scroll-to-top-button.m-button--scroll-top {
      bottom: calc(96px + env(safe-area-inset-bottom, 0px)) !important;
      right: max(12px, env(safe-area-inset-right, 0px)) !important;
    }

    /* Sit above desktop sticky ATC when it is visible */
    @media (min-width: 990px) {
      html.scale-o-sticky-desk-on #scroll-to-top-button.m-button--scroll-top {
        bottom: calc(100px + env(safe-area-inset-bottom, 0px)) !important;
      }
    }
  {% endstyle %}
{% endif %}
<div id="scroll-to-top-target" class="m-scroll-top-target"></div>
{% if settings.show_scroll_top_button %}
<button
  id="scroll-to-top-button"
  class="m-button m-button--primary m-button--scroll-top"
  type="button"
  aria-label="Scroll to Top"
>
  <svg class="m-svg-icon m-svg-icon--medium" fill="currentColor" stroke="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-hidden="true" focusable="false"><path d="M4.465 263.536l7.07 7.071c4.686 4.686 12.284 4.686 16.971 0L207 92.113V468c0 6.627 5.373 12 12 12h10c6.627 0 12-5.373 12-12V92.113l178.494 178.493c4.686 4.686 12.284 4.686 16.971 0l7.07-7.071c4.686-4.686 4.686-12.284 0-16.97l-211.05-211.05c-4.686-4.686-12.284-4.686-16.971 0L4.465 246.566c-4.687 4.686-4.687 12.284 0 16.97z"/></svg>
</button>
{% endif %}
