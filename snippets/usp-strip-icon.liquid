{%- comment -%}
  Scale-O USP Strip icons — brand-matched inline SVGs.
  Accepts: icon (string), class (optional)
{%- endcomment -%}
{%- liquid
  assign icon_name = icon | default: 'electricity'
  assign svg_class = class | default: 'scale-o-usp-strip__svg'
-%}
{%- case icon_name -%}

  {%- comment -%} Indian Hard Water — clean droplet {%- endcomment -%}
  {%- when 'droplet' -%}
    <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3.2c2.8 3.6 6.2 7.2 6.2 11a6.2 6.2 0 1 1-12.4 0c0-3.8 3.4-7.4 6.2-11Z"/>
    </svg>

  {%- comment -%} Patented / Manufactured — badge check {%- endcomment -%}
  {%- when 'patent' -%}
    <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3.2 14.2 5l2.6.4-.4 2.6 1.8 2.2-1.8 2.2.4 2.6-2.6.4L12 17.6l-2.2-1.8-2.6-.4.4-2.6L5.8 10.6l1.8-2.2-.4-2.6 2.6-.4L12 3.2Z"/>
      <path d="m9.4 11.2 1.8 1.8 3.4-3.5"/>
    </svg>

  {%- comment -%} Zero Electricity — Lucide plug-zap {%- endcomment -%}
  {%- when 'electricity' -%}
    <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M6.3 20.3a2.4 2.4 0 0 0 3.4 0L12 18l-6-6-2.3 2.3a2.4 2.4 0 0 0 0 3.4Z"/>
      <path d="m2 22 3-3"/>
      <path d="M7.5 13.5 10 11"/>
      <path d="M10.5 16.5 13 14"/>
      <path d="m18 3-4 4h6l-4 4"/>
    </svg>

  {%- comment -%} Zero Salt — Lucide ban {%- endcomment -%}
  {%- when 'salt' -%}
    <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="10"/>
      <path d="M4.929 4.929 19.07 19.071"/>
    </svg>

  {%- comment -%} Zero Water Wastage — Lucide droplets + strike (like wrench-off) {%- endcomment -%}
  {%- when 'water' -%}
    <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/>
      <path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/>
      <path d="m2 2 20 20"/>
    </svg>

  {%- when 'water-saving' -%}
    <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/>
      <path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/>
      <path d="m2 2 20 20"/>
    </svg>

  {%- comment -%} Zero Maintenance — Lucide wrench-off {%- endcomment -%}
  {%- when 'maintenance' -%}
    <svg class="{{ svg_class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M10.747 5.093a6 6 0 0 1 6.841-2.882c.438.12.54.662.219.984L14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-2.882 6.842"/>
      <path d="m13.5 13.5-7.88 7.88a1 1 0 0 1-2.999-3l7.88-7.88"/>
      <path d="m2 2 20 20"/>
    </svg>

  {%- comment -%} Zero Operating Cost — note + ₹ + down arrow {%- endcomment -%}
  {%- when 'rupee' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <rect x="5.2" y="4.2" width="13.6" height="9.2" rx="1.4" stroke="currentColor" stroke-width="1.5"/>
      <path d="M9 6.8h6M9 9h6M14.4 6.8c-1.2 0-2 .8-2 2s.8 2 2 2H9l4.2 2.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M12 14.2v5.2M9.6 17.2 12 19.6l2.4-2.4" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'shield' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M12 3.5 19 6.2v5.2c0 4.4-2.9 7.5-7 8.8-4.1-1.3-7-4.4-7-8.8V6.2L12 3.5Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
      <path d="m9.2 12.1 1.9 1.9 3.8-3.9" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'house' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="m4.5 11 7.5-6.5L19.5 11" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M6.5 10.5V19h11v-8.5" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
      <path d="M10 19v-5h4v5" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
    </svg>

  {%- when 'star' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="m12 3.8 2.2 4.6 5 .7-3.6 3.6.9 5.1L12 15.4 7.5 17.8l.9-5.1L4.8 9.1l5-.7L12 3.8Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
    </svg>

  {%- when 'truck' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M3 7.5h10.5V15H3V7.5Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
      <path d="M13.5 10H18l2.5 3v2H13.5v-5Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
      <circle cx="7" cy="16.5" r="1.6" stroke="currentColor" stroke-width="1.45"/>
      <circle cx="17" cy="16.5" r="1.6" stroke="currentColor" stroke-width="1.45"/>
    </svg>

  {%- when 'warranty' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M12 3.5 19 6.2v5.2c0 4.4-2.9 7.5-7 8.8-4.1-1.3-7-4.4-7-8.8V6.2L12 3.5Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
      <path d="M12 8v5" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"/>
      <circle cx="12" cy="15.5" r=".9" fill="currentColor"/>
    </svg>

  {%- when 'calendar' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <rect x="4" y="5.5" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.55"/>
      <path d="M8 3.8v3.2M16 3.8v3.2M4 10h16" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"/>
      <path d="M10.2 13.2h1.2V17h1.4" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- comment -%} Zero Plumbing — L-pipe + valve + droplet {%- endcomment -%}
  {%- when 'plumbing' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M6.2 5.2v7.6c0 1.3 1 2.4 2.4 2.4h8.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M4.6 5.2h3.2M4.6 8h3.2M16.8 13.2v3.2M14.8 15.2h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M13.2 4.4c1 1.3 2.1 2.5 2.1 3.7a2.1 2.1 0 1 1-4.2 0c0-1.2 1.1-2.4 2.1-3.7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <circle cx="18.6" cy="15.2" r="1.5" stroke="currentColor" stroke-width="1.4"/>
    </svg>

  {%- comment -%} Zero Manpower — hard hat over gear {%- endcomment -%}
  {%- when 'manpower' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M7.2 9.4c0-2.6 2.1-4.6 4.8-4.6s4.8 2 4.8 4.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M5.6 9.4h12.8v1.6c0 .7-.6 1.3-1.3 1.3H6.9c-.7 0-1.3-.6-1.3-1.3V9.4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="12" cy="17.2" r="2.2" stroke="currentColor" stroke-width="1.45"/>
      <path d="M12 13.8v1.2M12 19.4v1.2M8.8 17.2h1.2M14 17.2h1.2M9.6 14.8l.9.9M14.5 18.7l.9.9M14.5 14.8l-.9.9M9.6 18.7l-.9.9" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
    </svg>

  {%- when 'none' -%}

  {%- else -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M8.2 5.2c1.5 1.9 3.2 3.8 3.2 5.6a3.2 3.2 0 1 1-6.4 0c0-1.8 1.7-3.7 3.2-5.6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M16.4 3.8c1.7 2.1 3.6 4.2 3.6 6.2a4 4 0 1 1-8 0c0-2 1.9-4.1 3.6-6.2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M11.6 14.2c1.1 1.4 2.4 2.8 2.4 4.1a2.4 2.4 0 1 1-4.8 0c0-1.3 1.3-2.7 2.4-4.1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
{%- endcase -%}
