    "rich_text_iB8afp": {
      "type": "rich-text",
      "blocks": {
        "text_pqW8nJ": {
          "type": "text",
          "settings": {
            "text": "<h3>Scale-O Benefits for Soft Water Living</h3><p>Scale-O helps improve your everyday water experience by reducing hard water scaling across your entire home.</p><h4>Benefits of Scale-O</h4><h5>Protects Appliances</h5><ul><li>Helps reduce scale buildup in geysers, washing machines, dishwashers, and pipelines.</li></ul><h5>Cleaner Bathrooms</h5><ul><li>Reduces white stains and scaling on taps, showers, and tiles.</li></ul><h5>Better Water Flow</h5><ul><li>Helps reduce mineral buildup inside plumbing systems.</li></ul><h5>Salt-Free Technology</h5><ul><li>No salt refilling, chemicals, or regeneration required.</li></ul><h5>DIY Installation</h5><ul><li>Simply placed inside the overhead tank without plumbing modifications.</li></ul><h5>Whole House Protection</h5><ul><li>Supports hard water treatment for the entire house through the overhead tank system.</li></ul><h5>Zero Maintenance</h5><ul><li>No complicated servicing or recurring maintenance needs.</li></ul><p></p>"
          }
        }
      },
