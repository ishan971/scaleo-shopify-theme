        "html_jcXBE8": {
          "type": "html",
          "settings": {
            "code": "<style>\n  .before-after-section {\n    margin-top: 40px;\n    background: #f9f9f9;\n    border-radius: 12px;\n    padding: 30px 20px;\n    border: 1px solid #ddd;\n  }\n\n  .before-after-wrapper {\n    display: flex;\n    justify-content: space-between;\n    align-items: stretch;\n    gap: 30px;\n    position: relative;\n  }\n\n  .before-after-wrapper::before {\n    content: \"\";\n    position: absolute;\n    left: 50%;\n    top: 0;\n    width: 1px;\n    height: 100%;\n    background: #ccc;\n    transform: translateX(-50%);\n  }\n\n  .before-box,\n  .after-box {\n    width: 50%;\n    padding: 10px 20px;\n  }\n\n  .before-box h2,\n  .after-box h2 {\n    font-size: 28px;\n    margin-bottom: 20px;\n    color: #1c7acc;\n  }\n\n  .before-box ul,\n  .after-box ul {\n    padding-left: 20px;\n    margin: 0;\n  }\n\n  .before-box li,\n  .after-box li {\n    margin-bottom: 0;\n    font-size: 18px;\n    color: #333;\n    line-height: 1.7;\n  }\n\n  @media (max-width: 768px) {\n    .before-after-wrapper {\n      flex-direction: column;\n      gap: 20px;\n    }\n\n    .before-after-wrapper::before {\n      display: none;\n    }\n\n    .before-box,\n    .after-box {\n      width: 100%;\n      padding: 0;\n    }\n  }\n</style>\n\n<div class=\"content\" style=\"text-align:center;\">\n\n\n\n  <h1>Before vs After Using Scale-O</h1>\n\n  <div class=\"before-after-section\">\n    <div class=\"before-after-wrapper\">\n\n      <!-- Before Scale-O -->\n      <div class=\"before-box\">\n        <h2>Before Scale-O</h2>\n\n        <ul style=\"text-align:center;\">\n          <li>White scaling on taps &amp; fittings</li>\n          <li>Frequent bathroom cleaning</li>\n          <li>Reduced geyser efficiency</li>\n          <li>Hard water stains on tiles</li>\n          <li>Mineral deposits in plumbing</li>\n          <li>Appliance scaling issues</li>\n        </ul>\n      </div>\n\n      <!-- After Scale-O -->\n      <div class=\"after-box\">\n        <h2>After Scale-O</h2>\n\n        <ul style=\"text-align:center;\">\n          <li>Reduced visible scaling</li>\n          <li>Cleaner bathroom fittings</li>\n          <li>Better appliance protection</li>\n          <li>Reduced hard water stains</li>\n          <li>Improved water usage experience</li>\n          <li>Lower maintenance concerns</li>\n        </ul>\n      </div>\n\n    </div>\n  </div>\n\n</div>",
            "width": "100%",
            "block_custom_class": "",
            "animations": "inherit"
          }
        }
