    "custom_liquid_etEAdK": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n\n\n  .st-container{\n      width: 100%;\n      max-width: 1440px;\n      margin: 0 auto;\n      padding: 0 80px;\n  }\n  .slick-track {\n      display: flex;\n      gap: 20px;\n  }\n  .slick-list {\n      display: flex!important;\n  }\n  .st-slider2{\n      padding-top: 40px;\n  }\n  .st-slide {\n      background: white;\n      padding: 20px;\n      border-radius: 20px;\n      display: flex!important;\n      flex-direction: column;\n      justify-content: space-between;\n      gap: 30px;\n  }\n  .slick-slide{\n      height: auto!important;\n  }\n  .st-author-info{\n      display: flex;\n      align-items: center;\n      gap: 10px;\n  }\n  .st-content {\n      display: grid;\n      gap: 20px;\n  }\n  \n  /* Texts */\n  .st-content p{\n      /* font-family: Neue Montreal; */\n      font-size: 15px;\n      line-height: 26.4px;\n      color: #333333;\n      margin: 0;\n  }\n  .st-author-info span{\n      /* font-family: Neue Montreal; */\n      font-size: 16px;\n      line-height: 19.2px;\n      font-weight: 500;\n      color: #333333;\n  }\n  /* Navigations */\n  .slick-next{\n      right: -60px!important;\n      padding: 23px;\n      border-radius: 50%;\n      background: white;\n      transition: .4s all ease;\n  }\n  .slick-prev{\n      left: -60px!important;\n      padding: 23px;\n      border-radius: 50%;\n      background: white;\n      transition: .4s all ease;\n  }\n  .slick-prev:hover,.slick-next:hover{\n      transition: .4s all ease;\n      background: black;\n  }\n  .slick-prev:hover::before,\n  .slick-next:hover::before{\n      filter: brightness(0) invert(1);\n      transition: .4s all ease;\n  }\n  .slick-prev::before{\n      content: url('https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Group_1.svg?v=1722327196')!important;\n      display: flex;\n      width: 24px;\n      height: 24px;\n      transform: translate(-11px,-11px);\n      transition: .4s all ease;\n  }\n  .slick-next::before{\n      content: url('https://cdn.shopify.com/s/files/1/0592/6508/9638/files/cfsafa.svg?v=1722327196')!important;\n      display: flex;\n      width: 24px;\n      height: 24px;\n      transform: translate(-11px,-11px);\n      transition: .4s all ease;\n  }\n  \n  /* Responsive */\n  @media (min-width: 768px) and (max-width: 1024px){\n      .st-container{\n          padding: 0 40px;\n      }\n  }\n  @media (max-width: 767px){\n      .st-container{\n          padding: 0 20px;\n      }\n  }\n  </style>\n  \n  <div class=\"st-container\">\n      <div class=\"st-slider\">\n          <div class=\"st-slide\">\n              <div class=\"st-content\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_40.svg?v=1722325727\" width=\"50px\" height=\"50px\">\n                  <p>\"Scale-O is a very innovative product. I'm very happy with the product, reason is it is very easy to install, no hassles. hard water is a big problem, we wanted a solution but not a salt based softener\"</p>\n              </div>\n              <div class=\"st-author-info\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/OBJECTS.svg?v=1722326122\" width=\"45px\" height=\"45px\">\n                  <span>Mrs. Pragati Choksi</span>\n              </div>\n          </div>\n          <div class=\"st-slide\">\n              <div class=\"st-content\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_40.svg?v=1722325727\" width=\"50px\" height=\"50px\">\n                  <p>\"We absolutely loved Scale-O. Very compact and easy to install design. We found it really effective and could avoid the hassle and cumbersome process of conventional plant installation.\"</p>\n              </div>\n              <div class=\"st-author-info\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/dvefgsdef.svg?v=1722326122\" width=\"45px\" height=\"45px\">\n                  <span>Dr. Gaurav Khurana</span>\n              </div>\n          </div>\n          <div class=\"st-slide\">\n              <div class=\"st-content\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_40.svg?v=1722325727\" width=\"50px\" height=\"50px\">\n                  <p>\"The product is really good, and just one day post installation we can see the change in quality of water. good work!\"</p>\n              </div>\n              <div class=\"st-author-info\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/ddsgege.svg?v=1722326122\" width=\"45px\" height=\"45px\">\n                  <span>Ms. Avani Nathwani</span>\n              </div>\n          </div>\n          <div class=\"st-slide\">\n              <div class=\"st-content\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_40.svg?v=1722325727\" width=\"50px\" height=\"50px\">\n                  <p>\"Good concept, as we are facing problems due to hard water. Easy installation and friendly customer service!\"</p>\n              </div>\n              <div class=\"st-author-info\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/sfawff.svg?v=1722326122\" width=\"45px\" height=\"45px\">\n                  <span>Mrs. Prabha Harwani</span>\n              </div>\n          </div>\n          <div class=\"st-slide\">\n              <div class=\"st-content\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_40.svg?v=1722325727\" width=\"50px\" height=\"50px\">\n                  <p>\"Scale-O is a very innovative product. I'm very happy with the product, reason is it is very easy to install, no hassles. hard water is a big problem, we wanted a solution but not a salt based softners\"</p>\n              </div>\n              <div class=\"st-author-info\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/OBJECTS.svg?v=1722326122\" width=\"45px\" height=\"45px\">\n                  <span>Mrs. Pragati Choksi</span>\n              </div>\n          </div>\n          <div class=\"st-slide\">\n              <div class=\"st-content\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_40.svg?v=1722325727\" width=\"50px\" height=\"50px\">\n                  <p>\"The product is really good, and just one day post installation we can see the change in quality of water. good work!\"</p>\n              </div>\n              <div class=\"st-author-info\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/ddsgege.svg?v=1722326122\" width=\"45px\" height=\"45px\">\n                  <span>Ms. Avani Nathwani</span>\n              </div>\n          </div>\n          <div class=\"st-slide\">\n              <div class=\"st-content\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_40.svg?v=1722325727\" width=\"50px\" height=\"50px\">\n                  <p>\"Good concept, as we are facing problems due to hard water. Easy installation and friendly customer service!\"</p>\n              </div>\n              <div class=\"st-author-info\">\n                  <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/sfawff.svg?v=1722326122\" width=\"45px\" height=\"45px\">\n                  <span>Mrs. Prabha Harwani</span>\n              </div>\n          </div>\n      </div>\n  </div>        \n  </div>\n  \n  \n  <script>\n  $(document).ready(function(){\n  var $slider1 = $('.st-slider');\n  $slider1.slick({\n      slidesToShow: 4,\n      slidesToScroll: 1,\n      arrows: true,\n      autoplay: true,\n      autoplaySpeed: 1500,\n      responsive: [\n          {\n              breakpoint: 680,\n              settings: {\n                  slidesToShow: 1,\n                  slidesToScroll: 1,\n                  arrows: false \n              }\n          },\n          {\n              breakpoint: 768,\n              settings: {\n                  slidesToShow: 2,\n                  slidesToScroll: 1,\n                  arrows: false \n              }\n          },\n          {\n              breakpoint: 1140,\n              settings: {\n                  slidesToShow: 3,\n                  slidesToScroll: 1,\n                  arrows: false\n              }\n          }\n      ]\n  });\n  });\n  </script>",
