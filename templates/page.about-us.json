        "liquid_CEgcGa": {
          "type": "liquid",
          "settings": {
            "custom_liquid": "<style>\n        \n        .mission-section {\n            text-align: left;\n            padding: 50px 20px;\n            background-color: #fff;\n        }\n        .mission-section h6 {\n            color: #007bff;\n            margin-bottom: 20px;\n        }\n        .mission-section p {\n            font-size: 18px;\n            margin-bottom: 40px;\n        }\n        .mission-item {\n            display: flex;\n            align-items: flex-start;\n            margin-bottom: 30px;\n        }\n        .mission-item img {\n            margin-right: 20px;\n        }\n        .mission-item h2 {\n            margin: 0;\n            font-size: 24px;\n            color: #333;\n        }\n        .mission-item p {\n            margin: 10px 0 0;\n            font-size: 16px;\n            color: #666;\n        }\n    </style>\n\n    <div class=\"mission-section\">\n        <h6>OUR MISSION</h6>\n        <p>Join Panthera in its mission to revolutionize water quality and experience the difference that innovations can create!</p>\n        \n        <div class=\"mission-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_41_1d782729-0edf-4f44-86a0-eed78b6e0dce.png?v=1721282040\" alt=\"Creativity Icon\" width=\"50\" height=\"50\">\n            <div>\n                <h2>Creativity</h2>\n                <p>Panthera has become synonymous with cutting-edge technology and forward-thinking solutions. We have spearheaded the development of revolutionary products that not only soften water but also protect the health of our consumers while retaining essential minerals in the water.</p>\n            </div>\n        </div>\n        \n        <div class=\"mission-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_42_ef8670d2-04da-4899-998d-e6700085a832.png?v=1721282040\" alt=\"Sustainability Icon\" width=\"50\" height=\"50\">\n            <div>\n                <h2>Sustainability</h2>\n                <p>Panthera's products are designed and manufactured with sustainability in mind, utilizing eco-friendly materials and processes to minimize carbon footprint and preserve natural resources.</p>\n            </div>\n        </div>\n        \n        <div class=\"mission-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_42-1_3e94c957-8684-4719-9253-8152ea7a70c0.png?v=1721282041\" alt=\"Affordability Icon\" width=\"50\" height=\"50\">\n            <div>\n                <h2>Affordability</h2>\n                <p>Panthera's focus area has guided every decision and initiative to be customer-centric and considering the affordability and mass adoption in our economic plans.</p>\n            </div>\n        </div>\n    </div>",
            "width": "50%",
