 .form-left-con,\n    .form-right-con {\n      width: 100%;\n      gap: 30px;\n    }\n    h2 {\n      font-size: 28px;\n    }\n  }\n</style>\n\n<div class=\"form-container\">\n  <form id=\"mainForm\" method=\"post\" class=\"form-main\">\n    <div class=\"form-inputs\">\n      <div class=\"form-left-con\">\n        <div class=\"form-group\">\n          <label for=\"name\">Name:<span class=\"required\">*</span></label>\n          <input type=\"text\" id=\"name\" name=\"name\" />\n          <span id=\"error_name\" class=\"error\"></span>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"location\">Location:<span class=\"required\">*</span></label>\n          <input type=\"text\" id=\"location\" name=\"location\" />\n          <span id=\"error_location\" class=\"error\"></span>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"email\">E-mail:<span class=\"required\">*</span></label>\n          <input type=\"email\" id=\"email\" name=\"_replyto\" />\n          <span id=\"error_email\" class=\"error\"></span>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"contact\"\n            >Contact No:<span class=\"required\">*</span></label\n          >\n          <input type=\"number\" id=\"contact\" name=\"contact\" />\n          <span id=\"error_contact\" class=\"error\"></span>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"query\"\n            >Type your Query:<span class=\"required\">*</span></label\n          >\n          <textarea\n            style=\"border-width: 0\"\n            class=\"ta\"\n            id=\"query\"\n            name=\"query\"\n            rows=\"5\"\n            cols=\"63\"\n          ></textarea>\n        </div>\n        <button type=\"submit\" class=\"submit-btn\">Submit</button>\n      </div>\n    </div>\n  </form>\n</div>\n\n<script>\n  document\n    .getElementById(\"mainForm\")\n    .addEventListener(\"submit\", function (event) {\n      event.preventDefault();\n\n      var name = document.getElementById(\"name\").value;\n      var location = document.getElementById(\"location\").value;\n      var email = document.getElementById(\"email\").value;\n      var contact = document.getElementById(\"contact\").value;\n\n      if (!name) {\n        document.getElementById(\"error_name\").innerHTML =\n          \"Name field is required\";\n      } else {\n        document.getElementById(\"error_name\").innerHTML = \"\";\n      }\n      if (!location) {\n        document.getElementById(\"error_location\").innerHTML =\n          \"Location field is required\";\n      } else {\n        document.getElementById(\"error_location\").innerHTML = \"\";\n      }\n      if (!email) {\n        document.getElementById(\"error_email\").innerHTML =\n          \"Email field is required\";\n      } else {\n        document.getElementById(\"error_email\").innerHTML = \"\";\n      }\n      if (!contact) {\n        document.getElementById(\"error_contact\").innerHTML =\n          \"Contact field is required\";\n      } else {\n        document.getElementById(\"error_contact\").innerHTML = \"\";\n      }\n      if (name && location && email && contact) {\n        this.submit();\n      }\n    });\n</script>",
