        "liquid_f6JU4j": {
          "type": "liquid",
          "settings": {
            "custom_liquid": "<style>\n  .required {\n    color: red;\n    margin-left: 5px;\n  }\n\n  .error {\n    color: red;\n    font-size: 14px;\n  }\n\n  p {\n    color: #0c7fdf;\n    font-size: 15px;\n    font-weight: 500;\n    text-transform: uppercase;\n  }\n\n  .form-container {\n    margin-top: 50px;\n    max-width: 1500px;\n    width: 100%;\n    justify-content: center;\n  }\n\n  .form-inputs {\n    display: flex;\n    width: 100%;\n    flex-direction: row;\n    gap: 45px;\n  }\n\n  .form-left-con,\n  .form-right-con {\n    display: flex;\n    flex-direction: column;\n    gap: 30px;\n    width: 50%;\n  }\n\n  .form-group {\n    display: flex;\n    flex-wrap: wrap;\n    width: 100%;\n    position: relative;\n  }\n\n  .form-group label {\n    font-size: 16px;\n    flex: 1 1 100%;\n    margin-bottom: 5px;\n    font-weight: bold;\n  }\n\n  .form-group2 {\n    display: flex;\n    justify-content: space-between;\n    gap: 15px;\n  }\n\n  .form-group input,\n  .form-group select {\n    padding: 15px;\n    border: none;\n    font-size: 18px;\n    width: 100%;\n    font-weight: 500;\n    border-radius: 10px;\n    background: #eeeeee;\n    color: gray;\n  }\n\n  .form-group select {\n    width: 100%;\n    -webkit-appearance: none; /* Remove default arrow in WebKit browsers */\n    -moz-appearance: none; /* Remove default arrow in Firefox */\n    appearance: none; /* Remove default arrow in other browsers */\n    background: #eeeeee; /* Background color of the select box */\n    background-image: url(\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Group.svg?v=1722926013\"); /* Custom arrow */\n    background-repeat: no-repeat;\n    background-position: right 10px center; /* Position of the arrow */\n    background-size: 24px; /* Size of the arrow */\n  }\n\n  .form-group input::placeholder {\n    color: #858585;\n  }\n\n  .submit-btn {\n    width: 195px;\n    padding: 15px 20px;\n    margin-top: 40px;\n    background-color: #007bff;\n    border: none;\n    color: white;\n    font-size: 16px;\n    cursor: pointer;\n    border-radius: 100px;\n  }\n\n  .submit-btn:hover {\n    background-color: #4d4d4d;\n  }\n\n  @media (max-width: 767px) {\n    .form-group2 {\n      flex-direction: column;\n      gap: 30px;\n    }\n\n    .form-inputs {\n      width: 100%;\n      flex-direction: column;\n      gap: 30px;\n    }\n\n    .form-left-con,\n    .form-right-con {\n      width: 100%;\n      gap: 30px;\n    }\n\n    h2 {\n      font-size: 28px;\n    }\n  }\n</style>\n\n<div class=\"form-container\">\n  <form\n    class=\"form-main\"\n    action=\"https://formspree.io/f/mldrbvyg\"\n    method=\"post\"\n    id=\"waterForm\"\n  >\n    <div class=\"form-inputs\">\n      <div class=\"form-left-con\">\n        <div class=\"form-group\">\n          <label for=\"name\">Name:<span class=\"required\">*</span></label>\n          <input type=\"text\" name=\"Name\" id=\"name\" placeholder=\"Enter your name\" />\n          <span id=\"error_name\" class=\"error\"></span>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"email\">E-mail:<span class=\"required\">*</span></label>\n          <input\n            type=\"email\"\n            name=\"Email\"\n            id=\"email\"\n            placeholder=\"Enter your email\"\n          />\n          <span id=\"error_email\" class=\"error\"></span>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"contact\"\n            >Contact No.:<span class=\"required\">*</span></label\n          >\n          <input\n            type=\"number\"\n            name=\"Contact No\"\n            id=\"contact\"\n            placeholder=\"+91 | XXXXXX XXXXX\"\n          />\n          <span id=\"error_contact\" class=\"error\"></span>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"address\">Address:<span class=\"required\">*</span></label>\n          <input\n            type=\"text\"\n            name=\"Address\"\n            id=\"address\"\n            placeholder=\"Address\"\n          />\n          <span id=\"error_address\" class=\"error\"></span>\n        </div>\n        <div class=\"form-group2\">\n          <div class=\"form-group\">\n            <label for=\"state\">State:<span class=\"required\">*</span></label>\n            <select id=\"state\" name=\"State\" onchange=\"fetchCities()\">\n              <option value=\"default\">Select State</option>\n            </select>\n            <span id=\"error_state\" class=\"error\"></span>\n          </div>\n          <div class=\"form-group\">\n            <label for=\"city\">City/town:<span class=\"required\">*</span></label>\n            <select name=\"City\" id=\"city\">\n              <option value=\"default\">Select City</option>\n            </select>\n            <span id=\"error_city\" class=\"error\"></span>\n          </div>\n          <div class=\"form-group\">\n            <label for=\"pincode\"\n              >Pin code:<span class=\"required\">*</span></label\n            >\n            <input\n              type=\"number\"\n              name=\"Pincode\"\n              id=\"pincode\"\n              placeholder=\"123456\"\n            />\n            <span id=\"error_pincode\" class=\"error\"></span>\n          </div>\n        </div>\n      </div>\n      <div class=\"form-right-con\">\n        <div class=\"form-group\">\n          <label for=\"property-type\"\n            >Type of Property:<span class=\"required\">*</span></label\n          >\n          <select id=\"property-type\" name=\"Type of Property\">\n            <option value=\"default\">Select Property Type</option>\n            <option value=\"For School/College/University\">\n              For School/College/University\n            </option>\n            <option value=\"For Government Offices\">\n              For Government Offices\n            </option>\n            <option value=\"For Public Facilities\">For Public Facilities</option>\n          </select>\n          <span id=\"error_property_type\" class=\"error\"></span>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"overhead-tank\"\n            >Overhead Water Storage Tank Capacity:<span class=\"required\"\n              >*</span\n            ></label\n          >\n          <select\n            id=\"overhead-tank\"\n            name=\"Overhead Water Storage Tank Capacity\"\n          >\n            <option value=\"default\">Select Capacity</option>\n            <option value=\"10,000 L\">10,000 L</option>\n            <option value=\"15,000 L\">15,000 L</option>\n            <option value=\"20,000 L\">20,000 L</option>\n            <option value=\"25,000 L\">25,000 L</option>\n            <option value=\"30,000 L\">30,000 L</option>\n            <option value=\"50,000 L\">50,000 L</option>\n          </select>\n          <span id=\"error_overhead_tank\" class=\"error\"></span>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"underground-tank\"\n            >Underground Water Storage Tank Capacity: (Common Society Tank)<span\n              class=\"required\"\n              >*</span\n            ></label\n          >\n          <select\n            id=\"underground-tank\"\n            name=\"Underground Water Storage Tank Capacity\"\n          >\n            <option value=\"default\">Select Capacity</option>\n            <option value=\"50,000 L\">50,000 L</option>\n            <option value=\"1,00,000 L\">1,00,000 L</option>\n            <option value=\"1,50,000 L\">1,50,000 L</option>\n            <option value=\"2,00,000 L\">2,00,000 L</option>\n            <option value=\"3,00,000 L & Above\">3,00,000 L & Above</option>\n          </select>\n          <span id=\"error_underground_tank\" class=\"error\"></span>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"water-usage\"\n            >Average Daily Water Usage:<span class=\"required\">*</span></label\n          >\n          <select id=\"water-usage\" name=\"Average Daily Water Usage\">\n            <option value=\"default\">Select Usage</option>\n            <option value=\"5000 L/d to 10,000 L/d\">\n              5000 L/d to 10,000 L/d\n            </option>\n            <option value=\"10,000 L/d to 20,000 L/d\">\n              10,000 L/d to 20,000 L/d\n            </option>\n            <option value=\"15,000 L/d to 30,000 L/d\">\n              15,000 L/d to 30,000 L/d\n            </option>\n            <option value=\"25,000 L/d to 50,000 L/d\">\n              25,000 L/d to 50,000 L/d\n            </option>\n            <option value=\"50,000 L/d to 1,00,000 L/d\">\n              50,000 L/d to 1,00,000 L/d\n            </option>\n            <option value=\"1,00,000 L/d to 1,50,000 L/d\">\n              1,00,000 L/d to 1,50,000 L/d\n            </option>\n            <option value=\"1,50,000 L/d to 2,00,000 L/d\">\n              1,50,000 L/d to 2,00,000 L/d\n            </option>\n            <option value=\"3,00,000 L/d & Above\">3,00,000 L/d & Above</option>\n          </select>\n          <span id=\"error_water_usage\" class=\"error\"></span>\n        </div>\n      </div>\n    </div>\n    <button type=\"submit\" class=\"submit-btn\">Submit</button>\n  </form>\n</div>\n\n<script>\n  let token;\n  const url = \"https://www.universal-tutorial.com/api/getaccesstoken\";\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      Accept: \"application/json\",\n      \"api-token\":\n        \"EWxxAo1zZSIBtaBaOskfGxuYwwrW7jQnfosSNVe54KvKbVLQnb3m47vqk79Ow163ZO8\",\n      \"user-email\": \"ketan.tupple@gmail.com\",\n    },\n  })\n    .then((response) => response.json())\n    .then((data) => {\n      token = data.auth_token;\n\n      fetch(\"https://www.universal-tutorial.com/api/states/India\", {\n        method: \"GET\",\n        headers: {\n          Authorization: \"Bearer \" + data.auth_token,\n          Accept: \"application/json\",\n        },\n      })\n        .then((response) => response.json())\n        .then((data) => {\n          const stateSelect = document.getElementById(\"state\");\n\n          // Populate states dropdown\n          data.forEach((state) => {\n            let option = document.createElement(\"option\");\n            option.textContent = state.state_name;\n            option.value = state.state_name; // You can use state ID or any unique identifier here\n            stateSelect.appendChild(option);\n          });\n        })\n        .catch((error) => {\n          console.error(\"Error fetching data:\", error);\n        });\n    })\n    .catch((error) => {\n      console.error(\"Error fetching data:\", error);\n    });\n\n  async function fetchCities() {\n    const selectedState = document.getElementById(\"state\").value;\n\n    if (selectedState === \"default\") {\n      return; // No state selected, do nothing\n    }\n    // Clear existing cities in the dropdown\n    const citySelect = document.getElementById(\"city\");\n    citySelect.innerHTML = \"\"; // Clear existing options\n\n    // Add default \"Select City\" option\n    let defaultOption = document.createElement(\"option\");\n    defaultOption.textContent = \"Select City\";\n    defaultOption.value = \"default\";\n    citySelect.appendChild(defaultOption);\n\n    fetch(\"https://www.universal-tutorial.com/api/cities/\" + selectedState, {\n      method: \"GET\",\n      headers: {\n        Authorization: \"Bearer \" + token,\n        Accept: \"application/json\",\n      },\n    })\n      .then((response) => response.json())\n      .then((data) => {\n        const citySelect = document.getElementById(\"city\");\n\n        // Populate states dropdown\n        data.forEach((city) => {\n          let option = document.createElement(\"option\");\n          option.textContent = city.city_name;\n          option.value = city.city_name;\n          citySelect.appendChild(option);\n        });\n      })\n      .catch((error) => {\n        console.error(\"Error fetching data:\", error);\n      });\n  }\n\n  document\n    .getElementById(\"waterForm\")\n    .addEventListener(\"submit\", function (event) {\n      event.preventDefault();\n\n      let isValid = true;\n\n      const fields = [\n        { id: \"name\", errorId: \"error_name\", message: \"Name is required\" },\n        { id: \"email\", errorId: \"error_email\", message: \"Email is required\" },\n        {\n          id: \"contact\",\n          errorId: \"error_contact\",\n          message: \"Contact number is required\",\n          validate: (value) =>\n            /^\\d{10}$/.test(value) || \"Contact number must be 10 digits\",\n        },\n        {\n          id: \"address\",\n          errorId: \"error_address\",\n          message: \"Address is required\",\n        },\n        {\n          id: \"state\",\n          errorId: \"error_state\",\n          message: \"State is required\",\n          isSelect: true,\n        },\n        {\n          id: \"city\",\n          errorId: \"error_city\",\n          message: \"City is required\",\n          isSelect: true,\n        },\n        {\n          id: \"pincode\",\n          errorId: \"error_pincode\",\n          message: \"Pincode is required\",\n          validate: (value) =>\n            /^\\d{6}$/.test(value) || \"Pincode must be 6 digits\",\n        },\n        {\n          id: \"property-type\",\n          errorId: \"error_property_type\",\n          message: \"Property type is required\",\n          isSelect: true,\n        },\n        {\n          id: \"overhead-tank\",\n          errorId: \"error_overhead_tank\",\n          message: \"Overhead tank capacity is required\",\n          isSelect: true,\n        },\n        {\n          id: \"underground-tank\",\n          errorId: \"error_underground_tank\",\n          message: \"Underground tank capacity is required\",\n          isSelect: true,\n        },\n        {\n          id: \"water-usage\",\n          errorId: \"error_water_usage\",\n          message: \"Water usage is required\",\n          isSelect: true,\n        },\n      ];\n\n      fields.forEach((field) => {\n        const input = document.getElementById(field.id);\n        const error = document.getElementById(field.errorId);\n        let errorMessage = \"\";\n\n        if (field.isSelect) {\n          if (input.value === \"default\") {\n            errorMessage = field.message;\n          }\n        } else {\n          if (!input.value.trim()) {\n            errorMessage = field.message;\n          } else if (field.validate) {\n            const validationResult = field.validate(input.value.trim());\n            if (typeof validationResult === \"string\") {\n              errorMessage = validationResult;\n            }\n          }\n        }\n\n        if (errorMessage) {\n          error.textContent = errorMessage;\n          isValid = false;\n        } else {\n          error.textContent = \"\";\n        }\n      });\n\n      if (isValid) {\n        // Form is valid, proceed with submission\n        document.getElementById(\"waterForm\").submit();\n        // You can also use AJAX or fetch API to submit the form data\n        // For example:\n        // fetch('your-server-endpoint', {\n        //     method: 'POST',\n        //     body: new FormData(document.getElementById('waterForm'))\n        // }).then(response => response.json())\n        // .then(data => console.log(data));\n      }\n    });\n</script>",
