        "custom_liquid": "<style>\n    p {\n        color: #0C7FDF;\n        font-size: 15px;\n        font-weight: 500;\n        text-transform: uppercase;\n    }\n    .form-container {\n        margin-top: 50px;\n        max-width: 1500px;\n        width: 100%;\n        justify-content: center;\n    }\n    .form-inputs {\n        display: flex;\n        width: 100%;\n        flex-direction: row;\n        gap: 45px;\n    }\n    .form-left-con,\n    .form-right-con {\n        display: flex;\n        flex-direction: column;\n        gap: 30px;\n    }\n    .form-left-con,\n    .form-right-con {\n        width: 50%;\n    }\n    .form-group {\n        display: flex;\n        flex-wrap: wrap;\n        flex: 1;\n    }\n    .form-group label {\n        font-size: 16px;\n        flex: 1 1 100%;\n        margin-bottom: 5px;\n        font-weight: bold;\n    }\n    .form-group2 {\n        display: flex;\n        justify-content: space-between;\n        gap: 15px;\n    }\n    .form-group input,\n    .form-group select {\n        padding: 15px;\n        border: none;\n        font-size: 18px;\n        width: 100%;\n        font-weight: 500;\n        border-radius: 10px;\n        background: #EEEEEE;\n        color: gray;\n    }\n    .form-group select {\n        width: 100%;\n    }\n    .form-group input::placeholder {\n        color: #858585;\n    }\n    .submit-btn {\n        width: 195px;\n        padding: 15px 20px;\n        margin-top: 40px;\n        background-color: #007bff;\n        border: none;\n        color: white;\n        font-size: 16px;\n        cursor: pointer;\n        border-radius: 100px;\n    }\n    .submit-btn:hover {\n        background-color: #4d4d4d;\n    }\n    .error {\n        color: red;\n        font-size: 14px;\n    }\n    @media (max-width: 767px) {\n        .form-group2 {\n            flex-direction: column;\n            gap: 30px;\n        }\n        .form-inputs {\n            width: 100%;\n            flex-direction: column;\n            gap: 30px;\n        }\n        .form-left-con,\n        .form-right-con {\n            width: 100%;\n            gap: 30px;\n        }\n        h2 {\n            font-size: 28px;\n        }\n    }\n</style>\n\n<div class=\"form-container\">\n    <form class=\"form-main\" id=\"waterForm\">\n        <div class=\"form-inputs\">\n            <div class=\"form-left-con\">\n                <div class=\"form-group\">\n                    <label for=\"name\">Name:</label>\n                    <input type=\"text\" id=\"name\" placeholder=\"Prashant\">\n                    <span id=\"error_name\" class=\"error\"></span>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"email\">E-mail:</label>\n                    <input type=\"email\" id=\"email\" placeholder=\"E.g. sem@leo.com\">\n                    <span id=\"error_email\" class=\"error\"></span>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"contact\">Contact No.:</label>\n                    <input type=\"number\" id=\"contact\" placeholder=\"+91 | XXXXXX XXXXX\">\n                    <span id=\"error_contact\" class=\"error\"></span>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"address\">Address:</label>\n                    <input type=\"text\" id=\"address\" placeholder=\"Address\">\n                    <span id=\"error_address\" class=\"error\"></span>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"pincode\">Pin code:</label>\n                    <input type=\"text\" id=\"pincode\" placeholder=\"123456\">\n                    <span id=\"error_pincode\" class=\"error\"></span>\n                </div>\n                <div class=\"form-group2\">\n                    <div class=\"form-group\">\n                        <label for=\"state\">State:</label>\n                        <select id=\"state\" onchange=\"fetchCities()\">\n                            <option value=\"default\">Select State</option>\n                        </select>\n                        <span id=\"error_state\" class=\"error\"></span>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"city\">City/town:</label>\n                        <select id=\"city\" name=\"city\">\n                            <option value=\"default\">Select City</option>\n                        </select>\n                        <span id=\"error_city\" class=\"error\"></span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"form-right-con\">\n                <div class=\"form-group\">\n                    <label for=\"bungalows-flats\">No. of Bungalows/Flats/Units in the Society:</label>\n                    <input type=\"text\" id=\"bungalows-flats\" placeholder=\"e.g. 10 Bungalows or 20 Flats\">\n                    <span id=\"error_bungalows_flats\" class=\"error\"></span>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"blocks-wings\">No. of Blocks/Wings/Towers:</label>\n                    <input type=\"text\" id=\"blocks-wings\" placeholder=\"e.g. 3 Blocks\">\n                    <span id=\"error_blocks_wings\" class=\"error\"></span>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"house-type\">Type of House:</label>\n                    <select id=\"house-type\">\n                        <option value=\"default\">Select Type</option>\n                        <option>2 BHK</option>\n                        <option>3 BHK</option>\n                        <option>4 BHK</option>\n                        <option>5 BHK</option>\n                    </select>\n                    <span id=\"error_house_type\" class=\"error\"></span>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"overhead-tank\">Overhead Water Storage Tank Capacity:</label>\n                    <select id=\"overhead-tank\">\n                        <option value=\"default\">Select Capacity</option>\n                        <option>10,000 L</option>\n                        <option>15,000 L</option>\n                        <option>20,000 L</option>\n                        <option>25,000 L</option>\n                        <option>30,000 L</option>\n                        <option>50,000 L</option>\n                    </select>\n                    <span id=\"error_overhead_tank\" class=\"error\"></span>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"underground-tank\">Underground Water Storage Tank Capacity: (Common Society Tank)</label>\n                    <select id=\"underground-tank\">\n                        <option value=\"default\">Select Capacity</option>\n                        <option>50,000 L</option>\n                        <option>1,00,000 L</option>\n                        <option>1,50,000 L</option>\n                        <option>2,00,000 L</option>\n                        <option>3,00,000 L & Above</option>\n                    </select>\n                    <span id=\"error_underground_tank\" class=\"error\"></span>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"water-usage\">Average Daily Water Usage:</label>\n                    <select id=\"water-usage\">\n                        <option value=\"default\">Select Usage</option>\n                        <option>5000 L/d to 10,000 L/d</option>\n                        <option>10,000 L/d to 20,000 L/d</option>\n                        <option>15,000 L/d to 30,000 L/d</option>\n                        <option>25,000 L/d to 50,000 L/d</option>\n                        <option>50,000 L/d to 1,00,000 L/d</option>\n                        <option>1,00,000 L/d to 1,50,000 L/d</option>\n                        <option>1,50,000 L/d to 2,00,000 L/d</option>\n                        <option>3,00,000 L/d & Above</option>\n                    </select>\n                    <span id=\"error_water_usage\" class=\"error\"></span>\n                </div>\n            </div>\n        </div>\n        <button type=\"submit\" class=\"submit-btn\">Submit Now</button>\n    </form>\n</div>\n\n\n\n<script>\n    \n\n\n\n    let token;\n    const url = \"https://www.universal-tutorial.com/api/getaccesstoken\";\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"Accept\": \"application/json\",\n        \"api-token\": \"EWxxAo1zZSIBtaBaOskfGxuYwwrW7jQnfosSNVe54KvKbVLQnb3m47vqk79Ow163ZO8\",\n        \"user-email\": \"ketan.tupple@gmail.com\"\n      }\n    })\n    .then(response => response.json())\n    .then(data => {\n        token = data.auth_token;\n      \n        fetch(\"https://www.universal-tutorial.com/api/states/India\", {\n            method: \"GET\",\n            headers: {\n            \"Authorization\": \"Bearer \"+data.auth_token,\n            \"Accept\": \"application/json\"\n            }\n        })\n        .then(response => response.json())\n        .then(data => {\n            \n            const stateSelect = document.getElementById('state');\n        \n            // Populate states dropdown\n            data.forEach(state => {\n                let option = document.createElement('option');\n                option.textContent = state.state_name;\n                option.value = state.state_name; // You can use state ID or any unique identifier here\n                stateSelect.appendChild(option);\n            });\n        })\n        .catch(error => {\n            console.error('Error fetching data:', error);\n        });\n    })\n    .catch(error => {\n      console.error('Error fetching data:', error);\n    });\n    \n    async function fetchCities() {\n        const selectedState = document.getElementById('state').value;\n        \n        if (selectedState === 'default') {\n            return; // No state selected, do nothing\n        }\n        // Clear existing cities in the dropdown\n        const citySelect = document.getElementById('city');\n        citySelect.innerHTML = ''; // Clear existing options\n\n        // Add default \"Select City\" option\n        let defaultOption = document.createElement('option');\n        defaultOption.textContent = 'Select City';\n        defaultOption.value = 'default';\n        citySelect.appendChild(defaultOption);\n\n        fetch(\"https://www.universal-tutorial.com/api/cities/\"+selectedState, {\n            method: \"GET\",\n            headers: {\n            \"Authorization\": \"Bearer \"+token,\n            \"Accept\": \"application/json\"\n            }\n        })\n        .then(response => response.json())\n        .then(data => {\n            \n            const citySelect = document.getElementById('city');\n        \n            // Populate states dropdown\n            data.forEach(city => {\n                let option = document.createElement('option');\n                option.textContent = city.city_name;\n                option.value = city.city_name;\n                citySelect.appendChild(option);\n            });\n        })\n        .catch(error => {\n            console.error('Error fetching data:', error);\n        });\n    }\n   \n    \n\n    document.getElementById('waterForm').addEventListener('submit', function(event) {\n        event.preventDefault();\n    \n        let isValid = true;\n    \n        const fields = [\n            { id: 'name', errorId: 'error_name', message: 'Name is required' },\n            { id: 'contact', errorId: 'error_contact', message: 'Contact is required' },\n            { id: 'state', errorId: 'error_state', message: 'State is required', isSelect: true },\n            { id: 'city', errorId: 'error_city', message: 'City is required', isSelect: true },\n            { id: 'email', errorId: 'error_email', message: 'Email is required' },\n            { id: 'address', errorId: 'error_address', message: 'Address is required' },\n            { id: 'pincode', errorId: 'error_pincode', message: 'Pincode is required' },\n            { id: 'bungalows-flats', errorId: 'error_bungalows_flats', message: 'Bungalows/Flats/Units is required' },\n            { id: 'blocks-wings', errorId: 'error_blocks_wings', message: 'Blocks/Wings is required' },\n            { id: 'house-type', errorId: 'error_house_type', message: 'House Type is required', isSelect: true },\n            { id: 'overhead-tank', errorId: 'error_overhead_tank', message: 'Overhead Tank Capacity is required', isSelect: true },\n            { id: 'underground-tank', errorId: 'error_underground_tank', message: 'Underground Tank Capacity is required', isSelect: true },\n            { id: 'water-usage', errorId: 'error_water_usage', message: 'Water Usage is required', isSelect: true }\n        ];\n    \n        fields.forEach(field => {\n            const input = document.getElementById(field.id);\n            const error = document.getElementById(field.errorId);\n    \n            if (field.isSelect) {\n                if (input.value === 'default') {\n                    error.textContent = field.message;\n                    isValid = false;\n                } else {\n                    error.textContent = '';\n                }\n            } else {\n                if (!input.value.trim()) {\n                    error.textContent = field.message;\n                    isValid = false;\n                } else {\n                    error.textContent = '';\n                }\n            }\n        });\n    \n        if (isValid) {\n            // Form is valid, proceed with submission\n            alert('Form submitted successfully!');\n            // You can also use AJAX or fetch API to submit the form data\n            // For example:\n            // fetch('your-server-endpoint', {\n            //     method: 'POST',\n            //     body: new FormData(document.getElementById('waterForm'))\n            // }).then(response => response.json())\n            // .then(data => console.log(data));\n        }\n    });\n    \n    \n\n\n\n    \n</script>",
        "custom_class": "container"
      }
