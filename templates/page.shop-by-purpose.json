      "settings": {
        "custom_liquid": "<style>\n  .fnote {\n    margin-top: 22px;\n  }\n\n  .required {\n    color: red;\n    margin-left: 5px;\n  }\n\n  .form-container {\n    margin-top: 50px;\n    max-width: 1500px;\n    width: 100%;\n    justify-content: center;\n  }\n\n  .form-inputs {\n    display: flex;\n    width: 100%;\n    flex-direction: row;\n    gap: 45px;\n  }\n\n  .form-left-con,\n  .form-right-con {\n    display: flex;\n    flex-direction: column;\n    gap: 30px;\n    width: 50%;\n  }\n\n  .form-group {\n    display: flex;\n    flex-wrap: wrap;\n    flex: 1;\n    position: relative;\n  }\n\n  .form-group label {\n    font-size: 16px;\n    flex: 1 1 100%;\n    margin-bottom: 5px;\n    font-weight: bold;\n  }\n\n  .form-group2 {\n    display: flex;\n    justify-content: space-between;\n    gap: 15px;\n  }\n\n  .form-group input,\n  .form-group select {\n    padding: 15px;\n    border: none;\n    font-size: 18px;\n    width: 100%;\n    font-weight: 500;\n    border-radius: 10px;\n    background: #eeeeee;\n    color: gray;\n  }\n\n  .form-group select {\n    -webkit-appearance: none;\n    -moz-appearance: none;\n    appearance: none;\n    background: #eeeeee;\n    background-image: url(\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Group.svg?v=1722926013\");\n    background-repeat: no-repeat;\n    background-position: right 10px center;\n    background-size: 24px;\n  }\n\n  .form-group select::-ms-expand {\n    display: none;\n  }\n\n  .form-group input::placeholder {\n    color: #858585;\n  }\n\n  .submit-btn {\n    width: 195px;\n    padding: 15px 20px;\n    margin-top: 40px;\n    background-color: #007bff;\n    border: none;\n    color: white;\n    font-size: 16px;\n    cursor: pointer;\n    border-radius: 100px;\n  }\n\n  .submit-btn:hover {\n    background-color: #4d4d4d;\n  }\n\n  .error-message {\n    color: red;\n    font-size: 14px;\n    position: absolute;\n    bottom: -20px;\n    left: 0;\n  }\n\n  @media (max-width: 767px) {\n    .form-group2 {\n      flex-direction: column;\n      gap: 30px;\n    }\n\n    .form-inputs {\n      width: 100%;\n      flex-direction: column;\n      gap: 30px;\n    }\n\n    .form-left-con,\n    .form-right-con {\n      width: 100%;\n      gap: 30px;\n    }\n\n    h2 {\n      font-size: 28px;\n    }\n  }\n\n  /* Full-screen loader styles */\n  #pagepreloader {\n    display: none;\n    background-color: rgba(0, 0, 0, 0.3);\n    padding: 0;\n    margin: 0;\n    height: 100%;\n    position: fixed;\n    z-index: 99999;\n    left: 0;\n    top: 0;\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n</style>\n\n<div id=\"pagepreloader\" style=\"display: none\">\n  <div class=\"text-center\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Spin-1s-200px.gif?v=1723182703\"\n      style=\"max-width: 50%\"\n      alt=\"Loading...\"\n    />\n  </div>\n</div>\n\n<div class=\"form-container\">\n  <form class=\"form-main\" id=\"waterForm\">\n    <!-- Your form content here -->\n    <div class=\"form-inputs\">\n      <div class=\"form-left-con\">\n        <div class=\"form-group\">\n          <label for=\"name\">Name:<span class=\"required\">*</span></label>\n          <input type=\"text\" id=\"name\" placeholder=\"Enter your name\" tabindex=\"1\" />\n          <span class=\"error-message\" id=\"error_name\"></span>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"contact\"\n            >Contact No.:<span class=\"required\">*</span></label\n          >\n          <input\n            type=\"number\"\n            id=\"contact\"\n            minlength=\"10\"\n            placeholder=\"+91 | XXXXXX XXXXX\"\n            tabindex=\"3\"\n          />\n          <span class=\"error-message\" id=\"error_contact\"></span>\n        </div>\n        <div class=\"form-group2\">\n          <div class=\"form-group\">\n            <label for=\"state\">State:<span class=\"required\">*</span></label>\n            <select id=\"state\" onchange=\"fetchCities()\" tabindex=\"5\">\n              <option value=\"default\">Select State</option>\n            </select>\n            <span class=\"error-message\" id=\"error_state\"></span>\n          </div>\n          <div class=\"form-group\">\n            <label for=\"city\">City/town:<span class=\"required\">*</span></label>\n            <select id=\"city\" name=\"city\" tabindex=\"6\">\n              <option value=\"default\">Select City</option>\n            </select>\n            <span class=\"error-message\" id=\"error_city\"></span>\n          </div>\n          <div class=\"form-group\">\n            <label for=\"pincode\"\n              >Pin code:<span class=\"required\">*</span></label\n            >\n            <input\n              type=\"number\"\n              id=\"pincode\"\n              minlength=\"6\"\n              placeholder=\"123456\"\n              tabindex=\"7\"\n            />\n            <span class=\"error-message\" id=\"error_pincode\"></span>\n          </div>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"underground-tank\"\n            >Underground Water Storage Tank Capacity: (Optional)</label\n          >\n          <select id=\"underground-tank\" tabindex=\"10\">\n            <option>select</option>\n            <option value=\"1000 L- 1500 L\">1000 L- 1500 L</option>\n            <option value=\"3000 L - 5000 L\">3000 L - 5000 L</option>\n            <option value=\"2000 L- 2500 L\">2000 L- 2500 L</option>\n            <option value=\"10,000 L\">10,000 L</option>\n            <option value=\"15,000 L\">15,000 L</option>\n            <option value=\"20,000 L\">20,000 L</option>\n            <option value=\"25,000 L\">25,000 L</option>\n            <option value=\"30,000 L\">30,000 L</option>\n            <option value=\"50,000 L\">50,000 L</option>\n          </select>\n        </div>\n      </div>\n      <div class=\"form-right-con\">\n        <div class=\"form-group\">\n          <label for=\"email\">E-mail:<span class=\"required\">*</span></label>\n          <input\n            type=\"email\"\n            id=\"email\"\n            placeholder=\"Enter your email\"\n            tabindex=\"2\"\n          />\n          <span class=\"error-message\" id=\"error_email\"></span>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"address\">Address:<span class=\"required\">*</span></label>\n          <input\n            type=\"text\"\n            id=\"address\"\n            placeholder=\"Address\"\n            class=\"full-width\"\n            tabindex=\"4\"\n          />\n          <span class=\"error-message\" id=\"error_address\"></span>\n        </div>\n        <div class=\"form-group2\">\n          <div class=\"form-group\">\n            <label for=\"members\"\n              >No. of Members in the house:<span class=\"required\"\n                >*</span\n              ></label\n            >\n            <select id=\"members\" tabindex=\"8\">\n              <option>select</option>\n              <option value=\"Upto 3\">Upto 3</option>\n              <option value=\"4-6\">4-6</option>\n              <option value=\"7-10\">7-10</option>\n              <option value=\"11-15\">11-15</option>\n            </select>\n            <span class=\"error-message\" id=\"error_members\"></span>\n          </div>\n          <div class=\"form-group\">\n            <label for=\"overhead-tank\"\n              >Overhead Water Storage Tank Capacity:<span class=\"required\"\n                >*</span\n              ></label\n            >\n            <select\n              id=\"overhead-tank\"\n              tabindex=\"9\"\n              onchange=\"updateWaterUsageOptions()\"\n            >\n              <option>select</option>\n              <option value=\"500l\">500 L</option>\n              <option value=\"2t500l\">Two Tanks of 500 L</option>\n              <option value=\"1000-1500l\">1000 L- 1500 L</option>\n              <option value=\"2t1000-1500l\">Two Tanks of 1000 L-1500 L</option>\n              <option value=\"2000-2500l\">2000 L-2500 L</option>\n              <option value=\"2t2000-2500l\">Two Tanks of 2000 L-2500 L</option>\n              <option value=\"5000l\">5000 L</option>\n              <option value=\"2t5000l\">Two tanks of 5000 L</option>\n            </select>\n            <span class=\"error-message\" id=\"error_overhead_tank\"></span>\n          </div>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"water-usage\">\n            Average Daily Water Usage:<span class=\"required\">*</span>\n          </label>\n          <select id=\"water-usage\" tabindex=\"11\">\n            <!-- Options will be populated by JavaScript -->\n          </select>\n          <span class=\"error-message\" id=\"error_water_usage\"></span>\n        </div>\n      </div>\n    </div>\n    <p class=\"fnote\">\n      Note: Based on your form inputs and on clicking submit, you will be\n      redirected to the Suggested Product or Combo Pack Page for purchase!\n    </p>\n    <button type=\"submit\" class=\"submit-btn\" tabindex=\"12\">Submit</button>\n  </form>\n</div>\n\n<script>\n  function updateWaterUsageOptions() {\n    const overheadTank = document.getElementById(\"overhead-tank\");\n    const waterUsage = document.getElementById(\"water-usage\");\n    const selectedValue = overheadTank.value;\n\n    let options = [];\n\n    switch (selectedValue) {\n      case \"500l\":\n        options = [\"500 L/d\", \"1000 L/d\", \"1500 L/d\"];\n        break;\n      case \"2t500l\":\n        options = [\"500 L/d\", \"1000 L/d\", \"1500 L/d\", \"2000 L/d\"];\n        break;\n      case \"1000-1500l\":\n        options = [\"500 L/d\", \"1000 L/d\", \"1500 L/d\", \"2000 L/d\"];\n        break;\n      case \"2t1000-1500l\":\n        options = [\"500 L/d\", \"1000 L/d\", \"1500 L/d\", \"2000 L/d\", \"3000 L/d\"];\n        break;\n      case \"2000-2500l\":\n        options = [\"500 L/d\", \"1000 L/d\", \"1500 L/d\", \"2000 L/d\"];\n        break;\n      case \"2t2000-2500l\":\n        options = [\"500 L/d\", \"1000 L/d\", \"1500 L/d\", \"2000 L/d\", \"3000 L/d\"];\n        break;\n      case \"5000l\":\n        options = [\n          \"500 L/d\",\n          \"1000 L/d\",\n          \"1500 L/d\",\n          \"2000 L/d\",\n          \"3000 L/d\",\n          \"5000 L/d\",\n        ];\n        break;\n      case \"2t5000l\":\n        options = [\n          \"500 L/d\",\n          \"1000 L/d\",\n          \"1500 L/d\",\n          \"2000 L/d\",\n          \"3000 L/d\",\n          \"5000 L/d\",\n        ];\n        break;\n      default:\n        options = [];\n    }\n\n    // Clear existing options\n    waterUsage.innerHTML = \"<option>select</option>\";\n\n    // Add new options\n    options.forEach((option) => {\n      const opt = document.createElement(\"option\");\n      opt.value = option;\n      opt.textContent = option;\n      waterUsage.appendChild(opt);\n    });\n  }\n</script>\n\n<script>\n  document\n    .getElementById(\"waterForm\")\n    .addEventListener(\"submit\", function (event) {\n      event.preventDefault(); // Prevent the form from submitting the default way\n\n      // Clear all error messages\n      document.querySelectorAll(\".error-message\").forEach(function (span) {\n        span.textContent = \"\";\n      });\n\n      // Get form field values\n      var name = document.getElementById(\"name\").value.trim();\n      var contact = document.getElementById(\"contact\").value.trim();\n      var state = document.getElementById(\"state\").value;\n      var city = document.getElementById(\"city\").value;\n      var pincode = document.getElementById(\"pincode\").value.trim();\n      var email = document.getElementById(\"email\").value.trim();\n      var address = document.getElementById(\"address\").value.trim();\n      var members = document.getElementById(\"members\").value;\n      var overheadTank = document.getElementById(\"overhead-tank\").value;\n      var waterUsage = document.getElementById(\"water-usage\").value;\n\n      let isValid = true;\n\n      // Validation checks\n      if (!name) {\n        document.getElementById(\"error_name\").textContent = \"Name is required.\";\n        isValid = false;\n      }\n      if (!contact) {\n        document.getElementById(\"error_contact\").textContent =\n          \"Contact number is required.\";\n        isValid = false;\n      } else if (!/^\\d{10}$/.test(contact)) {\n        document.getElementById(\"error_contact\").textContent =\n          \"Contact number must be 10 digits.\";\n        isValid = false;\n      }\n\n      if (state === \"default\") {\n        document.getElementById(\"error_state\").textContent =\n          \"State is required.\";\n        isValid = false;\n      }\n      if (city === \"default\") {\n        document.getElementById(\"error_city\").textContent = \"City is required.\";\n        isValid = false;\n      }\n      if (!pincode) {\n        document.getElementById(\"error_pincode\").textContent =\n          \"Pincode is required.\";\n        isValid = false;\n      } else if (!/^\\d{6}$/.test(pincode)) {\n        document.getElementById(\"error_pincode\").textContent =\n          \"Pincode must be 6 digits.\";\n        isValid = false;\n      }\n\n      if (!email) {\n        document.getElementById(\"error_email\").textContent =\n          \"Email is required.\";\n        isValid = false;\n      }\n      if (!address) {\n        document.getElementById(\"error_address\").textContent =\n          \"Address is required.\";\n        isValid = false;\n      }\n      if (members === \"select\") {\n        document.getElementById(\"error_members\").textContent =\n          \"Number of members is required.\";\n        isValid = false;\n      }\n      if (overheadTank === \"select\") {\n        document.getElementById(\"error_overhead_tank\").textContent =\n          \"Overhead tank capacity is required.\";\n        isValid = false;\n      }\n      if (waterUsage === \"select\") {\n        document.getElementById(\"error_water_usage\").textContent =\n          \"Average daily water usage is required.\";\n        isValid = false;\n      }\n\n      if (isValid) {\n        // Hide the form\n        document.getElementById(\"pagepreloader\").style.display = \"flex\";\n\n        // Logic for redirection based on the form values\n        const productMap = {\n          // Your product mapping logic here\n          \"500l|500 L/d\": \"https://scale-o.com/products/scale-o-mini\",\n          \"500l|1000 L/d\": \"https://scale-o.com/products/scale-o-semi\",\n          \"500l|1500 L/d\": \"https://scale-o.com/products/scale-o-centi\",\n          \"1000-1500l|500 L/d\": \"https://scale-o.com/products/scale-o-mini\",\n          \"1000-1500l|1000 L/d\": \"https://scale-o.com/products/scale-o-semi\",\n          \"1000-1500l|1500 L/d\": \"https://scale-o.com/products/scale-o-centi\",\n          \"1000-1500l|2000 L/d\": \"https://scale-o.com/products/scale-o-centi\",\n          \"2000-2500l|500 L/d\": \"https://scale-o.com/products/scale-o-semi\",\n          \"2000-2500l|1000 L/d\": \"https://scale-o.com/products/scale-o-semi\",\n          \"2000-2500l|1500 L/d\": \"https://scale-o.com/products/scale-o-centi\",\n          \"2000-2500l|2000 L/d\": \"https://scale-o.com/products/scale-o-centi\",\n          \"5000l|500 L/d\": \"https://scale-o.com/products/scale-o-semi\",\n          \"5000l|1000 L/d\": \"https://scale-o.com/products/scale-o-centi\",\n          \"5000l|1500 L/d\": \"https://scale-o.com/products/scale-o-semi-x2\",\n          \"5000l|2000 L/d\":\n            \"https://scale-o.com/products/scale-o-semi-centi-combo\",\n          \"5000l|3000 L/d\": \"https://scale-o.com/products/scale-o-centi-x2\",\n          \"5000l|5000 L/d\": \"https://scale-o.com/products/scale-o-centi-x2\",\n          \"2t500l|500 L/d\":\n            \"https://scale-o.com/products/2-scale-o-mini-combo-pack\",\n          \"2t500l|1000 L/d\":\n            \"https://scale-o.com/products/2-scale-o-mini-combo-pack\",\n          \"2t500l|1500 L/d\":\n            \"https://scale-o.com/products/scale-o-mini-semi-combo\",\n          \"2t500l|2000 L/d\":\n            \"https://scale-o.com/products/scale-o-mini-centi-combo\",\n          \"2t1000-1500l|500 L/d\":\n            \"https://scale-o.com/products/2-scale-o-mini-combo-pack\",\n          \"2t1000-1500l|1000 L/d\":\n            \"https://scale-o.com/products/scale-o-mini-semi-combo\",\n          \"2t1000-1500l|1500 L/d\":\n            \"https://scale-o.com/products/scale-o-semi-x2\",\n          \"2t1000-1500l|2000 L/d\":\n            \"https://scale-o.com/products/scale-o-semi-centi-combo\",\n          \"2t1000-1500l|3000 L/d\":\n            \"https://scale-o.com/products/scale-o-centi-x2\",\n          \"2t2000-2500l|500 L/d\":\n            \"https://scale-o.com/products/scale-o-semi-x2\",\n          \"2t2000-2500l|1000 L/d\":\n            \"https://scale-o.com/products/scale-o-semi-x2\",\n          \"2t2000-2500l|1500 L/d\":\n            \"https://scale-o.com/products/scale-o-semi-centi-combo\",\n          \"2t2000-2500l|2000 L/d\":\n            \"https://scale-o.com/products/scale-o-centi-x2\",\n          \"2t2000-2500l|3000 L/d\":\n            \"https://scale-o.com/products/scale-o-centi-x2\",\n          \"2t5000l|500 L/d\": \"https://scale-o.com/products/scale-o-semi-x2\",\n          \"2t5000l|1000 L/d\":\n            \"https://scale-o.com/products/scale-o-semi-centi-combo\",\n          \"2t5000l|1500 L/d\":\n            \"https://scale-o.com/products/scale-o-semi-centi-combo\",\n          \"2t5000l|2000 L/d\":\n            \"https://scale-o.com/products/scale-o-semi-centi-combo\",\n          \"2t5000l|3000 L/d\": \"https://scale-o.com/products/scale-o-centi-x2\",\n          \"2t5000l|5000 L/d\": \"https://scale-o.com/products/scale-o-centi-x2\",\n        };\n        const key = `${overheadTank}|${waterUsage}`;\n        const redirectUrl = productMap[key];\n\n        setTimeout(function () {\n          document.getElementById(\"pagepreloader\").style.display = \"none\";\n          window.location.href = redirectUrl;\n        }, 3000);\n      }\n    });\n</script>\n\n<!-- State city API -->\n\n<script>\n  let token;\n  const url = \"https://www.universal-tutorial.com/api/getaccesstoken\";\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      Accept: \"application/json\",\n      \"api-token\":\n        \"EWxxAo1zZSIBtaBaOskfGxuYwwrW7jQnfosSNVe54KvKbVLQnb3m47vqk79Ow163ZO8\",\n      \"user-email\": \"ketan.tupple@gmail.com\",\n    },\n  })\n    .then((response) => response.json())\n    .then((data) => {\n      token = data.auth_token;\n\n      fetch(\"https://www.universal-tutorial.com/api/states/India\", {\n        method: \"GET\",\n        headers: {\n          Authorization: \"Bearer \" + data.auth_token,\n          Accept: \"application/json\",\n        },\n      })\n        .then((response) => response.json())\n        .then((data) => {\n          const stateSelect = document.getElementById(\"state\");\n\n          // Populate states dropdown\n          data.forEach((state) => {\n            let option = document.createElement(\"option\");\n            option.textContent = state.state_name;\n            option.value = state.state_name; // You can use state ID or any unique identifier here\n            stateSelect.appendChild(option);\n          });\n        })\n        .catch((error) => {\n          console.error(\"Error fetching data:\", error);\n        });\n    })\n    .catch((error) => {\n      console.error(\"Error fetching data:\", error);\n    });\n\n  async function fetchCities() {\n    const selectedState = document.getElementById(\"state\").value;\n\n    if (selectedState === \"default\") {\n      return; // No state selected, do nothing\n    }\n    // Clear existing cities in the dropdown\n    const citySelect = document.getElementById(\"city\");\n    citySelect.innerHTML = \"\"; // Clear existing options\n\n    // Add default \"Select City\" option\n    let defaultOption = document.createElement(\"option\");\n    defaultOption.textContent = \"Select City\";\n    defaultOption.value = \"default\";\n    citySelect.appendChild(defaultOption);\n\n    fetch(\"https://www.universal-tutorial.com/api/cities/\" + selectedState, {\n      method: \"GET\",\n      headers: {\n        Authorization: \"Bearer \" + token,\n        Accept: \"application/json\",\n      },\n    })\n      .then((response) => response.json())\n      .then((data) => {\n        const citySelect = document.getElementById(\"city\");\n\n        // Populate states dropdown\n        data.forEach((city) => {\n          let option = document.createElement(\"option\");\n          option.textContent = city.city_name;\n          option.value = city.city_name;\n          citySelect.appendChild(option);\n        });\n      })\n      .catch((error) => {\n        console.error(\"Error fetching data:\", error);\n      });\n  }\n</script>",
