        "html_L9zc4W": {
          "type": "html",
          "settings": {
            "code": "<div class=\"content\" style=\"text-align:center; max-width:1100px; margin:auto;\">\n\n  <h5>WHY CHOOSE SCALE-O?</h5>\n\n  <h1>Trusted Water Softener Solutions for Indian Homes</h1>\n\n  <br>\n\n  <p style=\"line-height:1.9;\">\n    Scale-O water softeners are designed to help homeowners deal with hard\n    water problems commonly found across Indian cities. As modern soft water\n    conditioners, Scale-O products help reduce scaling without the need for\n    salt, electricity, or complicated installation systems. From reducing\n    scaling on taps and showers to helping protect appliances and plumbing\n    systems, Scale-O provides practical water softening solutions for modern homes.\n  </p>\n\n  <div style=\"display:inline-block; text-align:left; margin-top:20px;\">\n\n    <ul style=\"list-style-type: disc; padding-left: 20px; line-height:1.9;\">\n      <li>Helps reduce hard water scaling</li>\n      <li>Supports better appliance efficiency</li>\n      <li>Suitable for overhead water tanks</li>\n      <li>Multiple sizes for different family needs</li>\n      <li>DIY installation &amp; zero maintenance</li>\n      <li>Reliable water softener plans for every home size</li>\n      <li>No regular servicing required since it’s zero maintenance</li>\n      <li>No salt refill or salt regeneration needed since it uses Zero Salt Technology</li>\n      <li>Zero Power Consumption, works without electricity or power connection</li>\n      <li>Zero Water Wastage, no backwash or drainage water loss</li>\n    </ul>\n\n  </div>\n\n</div>",
            "width": "100%",
            "block_custom_class": "",
            "animations": "inherit"
          }
        }
