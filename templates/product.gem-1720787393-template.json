        "custom_liquid": "<style>\n    .image-container {\n        display: none;\n        margin-top: 10px;\n    }\n    #section1 {\n        display: block; /* Display the first image by default */\n    }\n    .button1 {\n        padding: 10px 20px;\n        background-color: #333333;\n        color: white;\n        border: 2px solid #333333;\n        cursor: pointer;\n        margin-right: 10px;\n        border-radius: 5px;\n    }\n    .button1:hover {\n        background-color: transparent;\n        color: #333333;\n        border: 2px solid #333333;\n    }\n\n    .button2 {\n            padding: 10px 20px;\n            background-color: transparent;\n            color: #333333;\n            border: 2px solid #333333;\n            cursor: pointer;\n            border-radius: 5px;\n        }\n        .button2:hover {\n            background-color: #333333;\n            color: white;\n        }\n\n\n\n    .button-container {\n        margin-bottom: 20px;\n        text-align: center;\n    }\n</style>\n\n\n<div class=\"button-container\">\n    <button class=\"button1\" onclick=\"showImage('section1')\">FOR PEOPLE</button>\n    <button class=\"button2\" onclick=\"showImage('section2')\">FOR PROPERTY</button>\n</div>\n\n<div id=\"section1\" class=\"image-container\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_1247.png?v=1720604164\" alt=\"Image 1\" >\n</div>\n\n<div id=\"section2\" class=\"image-container\">\n    <img src=\"image2.jpg\" alt=\"Image 2\">\n</div>\n    \n<script>\n    function showImage(sectionId) {\n        var sections = document.querySelectorAll('.image-container');\n        sections.forEach(section => {\n            section.style.display = 'none';\n        });\n        document.getElementById(sectionId).style.display = 'block';\n    }\n</script>",
