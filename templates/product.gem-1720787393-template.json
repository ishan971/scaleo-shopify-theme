        "liquid_xyW9Kg": {
          "type": "liquid",
          "settings": {
            "custom_liquid": "<style>\n        @media (min-width:768px) {\n            .faq-container {\n                padding: 20px;\n                display: flex;\n                justify-content: space-between;\n            }\n\n            .faqdiv {\n                width: 49%;\n            }\n        }\n        \n        .faq-item {\n            margin-bottom: 20px;\n        }\n        \n        .faq-question {\n            width: 100%;\n            background-color: #F5F7FF;\n            border: none;\n            padding: 15px;\n            font-size: 16px;\n            text-align: left;\n            cursor: pointer;\n            border-radius: 4px;\n            transition: background-color 0.3s;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-right: 15px;\n        }\n        \n        .faq-question:hover {\n            background-color: #e1e1e1;\n        }\n        \n        .faq-answer {\n            max-height: 0;\n            opacity: 0;\n            overflow: hidden;\n            padding: 0 15px;\n            background-color: #F5F7FF;\n            border-radius: 0px 0px 4px 4px;\n            margin-top: 0px;\n            font-size: 14px;\n            line-height: 1.6;\n            transition: max-height 0.5s ease, opacity 0.5s ease, padding 0.5s ease;\n        }\n        \n        .faq-answer.open {\n            max-height: 500px; /* Adjust this value based on your content */\n            opacity: 1;\n            padding: 15px;\n        }\n        \n        .faq-icon {\n            width: 20px;\n            height: 20px;\n            margin-left: 5px;\n        }\n    </style>\n\n\n\n\n<div>\n        <div class=\"faq-container\">\n            <!-- col 1 -->\n            <div class=\"faqdiv\">\n                <div class=\"faq-item\">\n                    <button class=\"faq-question\">\n                        What is the life of the Scale-O water softener?\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                    </button>\n                    <div class=\"faq-answer\">Life of Scale-O water softener is 6 months once the product is inside the water but can extend to 8 months depending on daily usage. However shelf life of an unused product is 2 years.</div>\n                </div>\n                <div class=\"faq-item\">\n                    <button class=\"faq-question\">\n                        What is the guarantee on Scale-O softeners?\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                    </button>\n                    <div class=\"faq-answer\">Scale-O water softeners come with a one-year warranty from the date of purchase against any manufacturing defects.</div>\n                </div>\n                <div class=\"faq-item\">\n                    <button class=\"faq-question\">\n                        When should I exchange the Scale-O water softener?\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                    </button>\n                    <div class=\"faq-answer\">You should exchange the Scale-O water softener every 6 to 8 months, depending on your daily usage and water quality.</div>\n                </div>\n                <div class=\"faq-item\">\n                    <button class=\"faq-question\">\n                        Can Scale-O be used with existing water softeners?\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                    </button>\n                    <div class=\"faq-answer\">Yes, Scale-O can be used in conjunction with existing water softeners to enhance their effectiveness.</div>\n                </div>\n                <div class=\"faq-item\">\n                    <button class=\"faq-question\">\n                        Does Scale-O require installation services by a professional?\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                    </button>\n                    <div class=\"faq-answer\">No, Scale-O is designed for easy DIY installation and does not require professional services.</div>\n                </div>\n            </div>\n\n            <!-- col 2 -->\n            <div class=\"faqdiv\">\n                <div class=\"faq-item\">\n                    <button class=\"faq-question\">\n                        Why is Scale-O better than other water softeners?\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                    </button>\n                    <div class=\"faq-answer\">Scale-O offers superior performance, longer life, and easier maintenance compared to other water softeners on the market.</div>\n                </div>\n                <div class=\"faq-item\">\n                    <button class=\"faq-question\">\n                        What’s the maximum level of hardness at which Scale-O can work?\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                    </button>\n                    <div class=\"faq-answer\">Scale-O can effectively work in water hardness levels up to 300 ppm (parts per million).</div>\n                </div>\n                <div class=\"faq-item\">\n                    <button class=\"faq-question\">\n                        What is the health risk associated with using Scale-O water softeners?\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                    </button>\n                    <div class=\"faq-answer\">There are no health risks associated with using Scale-O water softeners as they do not add any chemicals to the water.</div>\n                </div>\n                <div class=\"faq-item\">\n                    <button class=\"faq-question\">\n                        How to choose the right Scale-O configuration for my application?\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                    </button>\n                    <div class=\"faq-answer\">Choosing the right Scale-O configuration depends on the size of your household and your daily water usage. Our customer support can help you make the right choice.</div>\n                </div>\n                <div class=\"faq-item\">\n                    <button class=\"faq-question\">\n                        Can Scale-O be used for commercial purposes?\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                    </button>\n                    <div class=\"faq-answer\">Yes, Scale-O is suitable for both residential and commercial purposes, depending on the configuration.</div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', function() {\n            const questions = document.querySelectorAll('.faq-question');\n\n            questions.forEach(question => {\n                question.addEventListener('click', function() {\n                    const answer = this.nextElementSibling;\n                    const isVisible = answer.classList.contains('open');\n\n                    document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open'));\n                    document.querySelectorAll('.close-icon').forEach(icon => icon.style.display = 'none');\n                    document.querySelectorAll('.open-icon').forEach(icon => icon.style.display = 'block');\n\n                    if (!isVisible) {\n                        answer.classList.add('open');\n                        this.querySelector('.open-icon').style.display = 'none';\n                        this.querySelector('.close-icon').style.display = 'block';\n                    } else {\n                        answer.classList.remove('open');\n                        this.querySelector('.open-icon').style.display = 'block';\n                        this.querySelector('.close-icon').style.display = 'none';\n                    }\n                });\n            });\n        });\n    </script>",
            "width": "100%",
            "block_custom_class": "container",
            "animations": "inherit"
          }
        }
