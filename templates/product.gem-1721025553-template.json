        "eyebrow": "FAQ",
        "heading": "Frequently Asked Questions",
        "description": "Everything you need to know about Scale-O, installation, maintenance and protecting your home from hard-water scale.",
        "show_cta": true,
        "show_cta_icon": true,
        "cta_heading": "Still have questions?",
        "cta_text": "Our experts are here to help you choose the right solution.",
