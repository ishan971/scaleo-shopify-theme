        "custom_liquid_ARV8Ey": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<style>\n  .mainbox {\n    background-color: white;\n    border-radius: 20px;\n    justify-content: space-between;\n  }\n\n  .features {\n    display: flex;\n    justify-content: space-around;\n\n    padding: 20px 0;\n  }\n\n  .feature {\n    text-align: center;\n    color: #333333;\n    font-size: 12px;\n    font-weight: 600;\n  }\n\n  .feature img {\n    display: block;\n    margin: 0 auto 10px;\n  }\n\n  .ratings {\n    padding: 20px;\n    display: flex;\n  }\n\n  .ratings h2 {\n    font-size: 19px;\n    margin-bottom: 10px;\n  }\n\n  .overall-rating {\n    display: flex;\n    align-items: center;\n    font-size: 18px;\n    margin-bottom: 20px;\n  }\n\n  .stars {\n    color: #ffba00;\n    margin-right: 10px;\n  }\n\n  .rating {\n    color: #666;\n    display: flex;\n    font-size: 12px;\n  }\n\n  .feature-ratings {\n    display: flex;\n    flex-direction: column;\n    width: 50%;\n  }\n\n  .rating-item {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    background-color: #f5f7ff;\n    padding-right: 10px;\n    padding-left: 10px;\n    margin-bottom: 10px;\n    border-radius: 20px;\n  }\n\n  .feature-name {\n    font-weight: bold;\n    font-size: 11px;\n  }\n</style>\n\n<div class=\"features\">\n  <div class=\"feature\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_48.svg?v=1722428686\"\n      alt=\"Quick Delivery\"\n    />\n    <p>QUICK DELIVERY</p>\n  </div>\n  <div class=\"feature\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_48-1.svg?v=1722428687\"\n      alt=\"Simple Installation\"\n    />\n    <p>SIMPLE INSTALLATION</p>\n  </div>\n  <div class=\"feature\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_48-2.svg?v=1722428686\"\n      alt=\"Full Guarantee\"\n    />\n    <p>FULL GUARANTEE</p>\n  </div>\n  <div class=\"feature\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_48-3.svg?v=1722428685\"\n      alt=\"Easy Exchange\"\n    />\n    <p>EASY EXCHANGE</p>\n  </div>\n</div>\n<div class=\"ratings mainbox\">\n  <div>\n    <h2>Ratings by Criteria</h2>\n    {% assign rounded_rating = product.metafields.custom.total_rating.value |\n    round %}\n\n    <div class=\"overall-rating\">\n      <span class=\"stars\">\n        {% case rounded_rating %} {% when 5 %} ★★★★★ {% when 4 %} ★★★★☆ {% when\n        3 %} ★★★☆☆ {% when 2 %} ★★☆☆☆ {% when 1 %} ★☆☆☆☆ {% else %} ☆☆☆☆☆ {%\n        endcase %}\n      </span>\n      <span class=\"rating\">\n        {{ product.metafields.custom.total_rating.value }}/5.0 ({{\n        product.metafields.custom.reviews.value }} Reviews)\n      </span>\n    </div>\n  </div>\n\n  <div class=\"feature-ratings\">\n    <div class=\"rating-item\">\n      <span class=\"feature-name\">CONCEPT</span>\n      <div style=\"display: flex; align-items: baseline\">\n        <span class=\"stars\">★</span>\n        <span class=\"rating\"\n          >{{product.metafields.custom.concept.value }} | 5.0</span\n        >\n      </div>\n    </div>\n    <div class=\"rating-item\">\n      <span class=\"feature-name\">CONVENIENCE</span>\n      <div style=\"display: flex; align-items: baseline\">\n        <span class=\"stars\">★</span>\n        <span class=\"rating\"\n          >{{product.metafields.custom.convenience.value }} | 5.0</span\n        >\n      </div>\n    </div>\n    <div class=\"rating-item\">\n      <span class=\"feature-name\">QUALITY</span>\n      <div style=\"display: flex; align-items: baseline\">\n        <span class=\"stars\">★</span>\n        <span class=\"rating\"\n          >{{product.metafields.custom.quality.value }} | 5.0</span\n        >\n      </div>\n    </div>\n    <div class=\"rating-item\">\n      <span class=\"feature-name\">PRICING</span>\n      <div style=\"display: flex; align-items: baseline\">\n        <span class=\"stars\">★</span>\n        <span class=\"rating\"\n          >{{product.metafields.custom.pricing.value }} | 5.0</span\n        >\n      </div>\n    </div>\n  </div>\n</div>"
          }
        }
      },
