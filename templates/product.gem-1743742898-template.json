        "free_shipping_return_NBb4gk": {
          "type": "free_shipping_return",
          "settings": {
            "shipping_icon": "shopify://shop_images/money-back.png",
            "shippng_title": "15 Day Refund Guarantee ",
            "shipping_tooltip": "<p>Customers may place a refund request within 7 days of the original purchase date, if item is undelivered or missing. In case the product delivered and is partially or completely damaged and the buyer is not willing to get a replacement for the same, they will be requested to ship the product back, post which they will be provided with a full refund.</p>",
            "return_replacement_icon": "shopify://shop_images/replacement.png",
            "return_title": "180 Day Replacement Guarantee",
            "return_tooltip": "<p>Customers may request a replacement within 24 hours of delivery, if item is partially or completely damaged. We provide an extra replacement product in case the life of Scale-O Water Softener is exhausted earlier than 6 months subject to clear evidence displayed as photos and videos indicating that the product is consumed and floating on the surface of water inside the tank.</p>"
          }
        },
        "custom_liquid_TVAThA": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    var variantNodes = document.querySelectorAll('.m-product-option--node');\n    var stockStatus = document.getElementById('stock-status');\n\n    variantNodes.forEach(function(node) {\n      var radioInput = node.querySelector('input[type=\"radio\"]');\n      \n      if (radioInput) {\n        radioInput.addEventListener('change', function() {\n          if (this.checked) {\n            var inventoryQuantity = node.getAttribute('data-inventory-quantity');\n            var inventoryManagement = node.getAttribute('data-inventory-management');\n\n            if (inventoryManagement === \"shopify\") {\n              if (inventoryQuantity > 0) {\n                stockStatus.innerHTML = 'Stock: ' + inventoryQuantity;\n              } else {\n                stockStatus.innerHTML = 'Out of stock';\n              }\n            } else {\n              stockStatus.innerHTML = 'Inventory not tracked';\n            }\n          }\n        });\n      }\n    });\n  });\n</script>"
          }
        },
