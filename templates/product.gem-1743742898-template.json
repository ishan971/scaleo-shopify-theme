    "custom_liquid_qR7BgT": {
      "type": "custom-liquid",
      "custom_css": [
        ".sec {background-color: #f5f7ff;}"
      ],
      "settings": {
        "custom_liquid": "<style>\n  .image-container {\n    display: none;\n    margin-top: 30px;\n  }\n  #section1 {\n    display: block; /* Display the first image by default */\n  }\n  .button {\n    padding: 10px 10px;\n    cursor: pointer;\n    margin-right: 10px;\n    border-radius: 5px;\n    border: 2px solid #333333;\n  }\n  .button1 {\n    background-color: #333333;\n    color: white;\n  }\n  .button1:hover {\n    background-color: transparent;\n    color: #333333;\n  }\n  .button2 {\n    background-color: transparent;\n    color: #333333;\n  }\n  .button2:hover {\n    background-color: #333333;\n    color: white;\n  }\n  .button.active {\n    background-color: #333333;\n    color: white;\n  }\n  .button-container {\n    margin-bottom: 0px;\n    text-align: center;\n  }\n</style>\n\n<div class=\"button-container\">\n  <button class=\"button button1 active\" onclick=\"showImage('section1', this)\">\n    For People\n  </button>\n  <button class=\"button button2\" onclick=\"showImage('section2', this)\">\n    For Property\n  </button>\n</div>\n\n<div id=\"section1\" class=\"image-container\">\n  <a\n    data-fancybox=\"gallery\"\n    href=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/for-people.png?v=1726896899\"\n  >\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/for-people.png?v=1726896899\"\n      alt=\"Thumbnail\"\n    />\n  </a>\n</div>\n\n<div id=\"section2\" class=\"image-container\">\n  <a\n    data-fancybox=\"gallery\"\n    href=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/for_property.png?v=1724149776\"\n  >\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/for_property.png?v=1724149776\"\n      alt=\"Thumbnail\"\n    />\n  </a>\n</div>\n\n<script>\n  function showImage(sectionId, button) {\n    var sections = document.querySelectorAll(\".image-container\");\n    sections.forEach((section) => {\n      section.style.display = \"none\";\n    });\n    document.getElementById(sectionId).style.display = \"block\";\n\n    var buttons = document.querySelectorAll(\".button\");\n    buttons.forEach((btn) => {\n      btn.classList.remove(\"active\");\n      if (btn !== button) {\n        btn.classList.add(\"button2\"); // Make inactive button white\n        btn.classList.remove(\"button1\");\n      } else {\n        btn.classList.add(\"button1\"); // Make active button colored\n        btn.classList.remove(\"button2\");\n      }\n    });\n    button.classList.add(\"active\");\n  }\n</script>",
        "custom_class": "container m-section-my m-section-py sec"
      }
    },
    "custom_content_3kjdhd": {
      "type": "custom-content",
      "blocks": {
        "text_zNQQic": {
          "type": "text",
          "settings": {
            "title": "Frequently Asked Questions",
            "subheading": "FAQ",
            "text": "",
            "width": "100%",
            "alignment": "center",
            "align_text": "center",
            "text_size": "medium",
            "text_color": "inherit",
            "button_label": "",
            "button_link": "",
            "button_style": "m-button--primary",
            "button_size": "",
            "block_custom_class": "",
            "animations": "inherit"
          }
        },
        "liquid_xyW9Kg": {
          "type": "liquid",
          "settings": {
            "custom_liquid": "<style>\n    @media (min-width:768px) {\n        .faq-container {\n            padding: 20px;\n            display: flex;\n            justify-content: space-between;\n        }\n\n        .faqdiv {\n            width: 49%;\n        }\n    }\n    \n    .faq-item {\n        margin-bottom: 20px;\n    }\n    \n    .faq-question {\n        width: 100%;\n        background-color: #F5F7FF;\n        border: none;\n        padding: 15px;\n        font-size: 16px;\n        text-align: left;\n        cursor: pointer;\n        border-radius: 4px;\n        transition: background-color 0.3s;\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        margin-right: 15px;\n        color: black; /* Default text color */\n    }\n    \n    .faq-question:hover {\n        background-color: #e1e1e1;\n    }\n\n    .faq-question.active {\n        background-color: #2a6ab2;\n        color: white;\n    }\n    \n    .faq-answer {\n        max-height: 0;\n        opacity: 0;\n        overflow: hidden;\n        padding: 0 15px;\n        background-color: #2a6ab2;\n        border-radius: 0px 0px 4px 4px;\n        margin-top: 0px;\n        font-size: 14px;\n        line-height: 1.6;\n        transition: max-height 0.5s ease, opacity 0.5s ease, padding 0.5s ease;\n    }\n\n    .faq-answer.active {\n        background-color: #2a6ab2;\n        color: white;\n        border-top: 1.5px solid #DBE2FF;\n    }\n    \n    .faq-answer.open {\n        max-height: 500px; /* Adjust this value based on your content */\n        opacity: 1;\n        padding: 15px;\n    }\n    \n    .faq-icon {\n        width: 20px;\n        height: 20px;\n        margin-left: 5px;\n    }\n</style>\n\n<div>\n    <div class=\"faq-container\">\n        <!-- col 1 -->\n        <div class=\"faqdiv\">\n            <div class=\"faq-item\">\n                <button class=\"faq-question\">\n                    What is the life of Scale-O water softeners?\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                </button>\n                <div class=\"faq-answer\">Life of Scale-O water softener is 6 months once the product is inside the water but can extend to 8 months depending on daily usage. However shelf life of an unused product is 2 years.</div>\n            </div>\n            <div class=\"faq-item\">\n                <button class=\"faq-question\">\n                    What is the guarantee on Scale-O softeners?\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                </button>\n                <div class=\"faq-answer\">Scale-O water softeners come with a 6 month Guarantee from the date of purchase against any manufacturing defects.</div>\n            </div>\n            <div class=\"faq-item\">\n                <button class=\"faq-question\">\n                    When should I exchange the Scale-O water softener?\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                </button>\n                <div class=\"faq-answer\">You should exchange the Scale-O water softener every 6 months, depending on your daily usage and water quality.</div>\n            </div>\n            <div class=\"faq-item\">\n                <button class=\"faq-question\">\n                    Can Scale-O be used with existing water softeners?\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                </button>\n                <div class=\"faq-answer\">Yes, Scale-O can be used in conjunction with existing water softeners to enhance their effectiveness.</div>\n            </div>\n            <div class=\"faq-item\">\n                <button class=\"faq-question\">\n                    Does Scale-O require installation services by a professional?\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                </button>\n                <div class=\"faq-answer\">No, Scale-O is designed for easy DIY installation and does not require professional installation.</div>\n            </div>\n        </div>\n\n        <!-- col 2 -->\n        <div class=\"faqdiv\">\n            <div class=\"faq-item\">\n                <button class=\"faq-question\">\n                    Why is Scale-O better than other water softeners?\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                </button>\n                <div class=\"faq-answer\">Scale-O offers superior performance, longer life, and easier maintenance compared to other water softeners on the market.</div>\n            </div>\n            <div class=\"faq-item\">\n                <button class=\"faq-question\">\n                    What’s the maximum level of hardness at which Scale-O can work?\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                </button>\n                <div class=\"faq-answer\">Scale-O can effectively work in water hardness levels up to 2000 ppm (parts per million).</div>\n            </div>\n            <div class=\"faq-item\">\n                <button class=\"faq-question\">\n                    What is the health risk associated with using Scale-O water softeners?\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                </button>\n                <div class=\"faq-answer\">There are no health risks associated with using Scale-O water softeners as they do not add any chemicals to the water.</div>\n            </div>\n            <div class=\"faq-item\">\n                <button class=\"faq-question\">\n                    How to choose the right Scale-O configuration for my application?\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                </button>\n                <div class=\"faq-answer\">Choosing the right Scale-O configuration depends on the size of the water tank and members in your household or daily water usage. Our sales team can help you make the right choice.</div>\n            </div>\n            <div class=\"faq-item\">\n                <button class=\"faq-question\">\n                    Can Scale-O be used for commercial purposes?\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/Frame_49.png?v=1720679877\" class=\"faq-icon open-icon\" alt=\"Open Icon\">\n                    <img src=\"https://cdn.shopify.com/s/files/1/0592/6508/9638/files/4444.png?v=1720679877\" class=\"faq-icon close-icon\" style=\"display:none;\" alt=\"Close Icon\">\n                </button>\n                <div class=\"faq-answer\">Yes, Scale-O is suitable for both residential and commercial purposes, depending on the configuration.</div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\n    document.addEventListener('DOMContentLoaded', function() {\n        const questions = document.querySelectorAll('.faq-question');\n\n        questions.forEach(question => {\n            question.addEventListener('click', function() {\n                const answer = this.nextElementSibling;\n                const isVisible = answer.classList.contains('open');\n\n                document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open', 'active'));\n                document.querySelectorAll('.faq-question').forEach(q => q.classList.remove('active'));\n                document.querySelectorAll('.close-icon').forEach(icon => icon.style.display = 'none');\n                document.querySelectorAll('.open-icon').forEach(icon => icon.style.display = 'block');\n\n                if (!isVisible) {\n                    answer.classList.add('open', 'active');\n                    this.classList.add('active');\n                    this.querySelector('.open-icon').style.display = 'none';\n                    this.querySelector('.close-icon').style.display = 'block';\n                } else {\n                    answer.classList.remove('open', 'active');\n                    this.classList.remove('active');\n                    this.querySelector('.open-icon').style.display = 'block';\n                    this.querySelector('.close-icon').style.display = 'none';\n                }\n            });\n        });\n    });\n</script>",
            "width": "100%",
            "block_custom_class": "container",
            "animations": "inherit"
          }
        }
      },
