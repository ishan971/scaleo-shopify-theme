          "settings": {
            "custom_liquid": "{% if product.metafields.custom.product_detail_usp != blank %}      \n<div class=\"product-detail-section\" style=\"display: flex; flex-wrap: wrap; column-gap: 5px; row-gap: 5px;\">\n{% for pro_details in product.metafields.custom.product_detail_usp.value %}\n  <span \n    style=\"border-radius: 5px;\n    color: {{ pro_details.text_color}};\n    background-color: {{ pro_details.background_color }}; \n    border:1px solid {{ pro_details.text_color}};\n    padding: 5px 8px;\n        font-size: 18px;\">\n    {{ pro_details.detail_name.value }}\n  </span>\n{% endfor %}\n</div>\n{% endif %}"
