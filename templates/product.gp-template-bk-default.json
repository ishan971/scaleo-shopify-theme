            "custom_liquid": "<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    var variantNodes = document.querySelectorAll('.m-product-option--node');\n    var stockStatus = document.getElementById('stock-status');\n\n    variantNodes.forEach(function(node) {\n      var radioInput = node.querySelector('input[type=\"radio\"]');\n      \n      if (radioInput) {\n        radioInput.addEventListener('change', function() {\n          if (this.checked) {\n            var inventoryQuantity = node.getAttribute('data-inventory-quantity');\n            var inventoryManagement = node.getAttribute('data-inventory-management');\n\n            if (inventoryManagement === \"shopify\") {\n              if (inventoryQuantity > 0) {\n                stockStatus.innerHTML = 'Stock: ' + inventoryQuantity;\n              } else {\n                stockStatus.innerHTML = 'Out of stock';\n              }\n            } else {\n              stockStatus.innerHTML = 'Inventory not tracked';\n            }\n          }\n        });\n      }\n    });\n  });\n</script>"
