    "custom_content_3kjdhd": {
      "type": "scale-o-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "What is Scale-O and how does it work?",
            "answer": "<p>Scale-O is a salt-free water conditioner designed for homes with overhead tanks. Place the compact unit inside your tank. As water flows through the home, Scale-O helps reduce hard-water scale on pipes, fittings and household appliances, without salt, electricity or plumbing changes.</p>",
            "category": "",
            "icon": "droplet"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "Does Scale-O require electricity?",
            "answer": "<p>No. Scale-O does not need electricity, wiring or a power connection. Once placed in the tank, it works as water flows through your home.</p>",
            "category": "",
            "icon": "bolt"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "Does Scale-O use salt?",
            "answer": "<p>No. Scale-O is a salt-free water conditioner. There are no salt bags to buy, store or refill.</p>",
            "category": "",
            "icon": "salt"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "Does Scale-O waste water?",
            "answer": "<p>No. Scale-O does not require backwashing, regeneration or water discharge. You get conditioned water without the water wastage typical of many salt-based softeners.</p>",
            "category": "",
            "icon": "droplet"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "How is Scale-O installed?",
            "answer": "<p>Installation is designed to be simple: choose the right model for your tank, open the overhead tank, place Scale-O inside, close the tank and use water as usual. No plumber or wiring is typically needed.</p>",
            "category": "",
            "icon": "wrench"
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "Where should Scale-O be installed?",
            "answer": "<p>Scale-O is designed for overhead and storage water tanks used in Indian homes, so conditioned water can reach bathrooms, kitchen, laundry and appliances.</p>",
            "category": "",
            "icon": "home"
          }
        },
        "faq_7": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "Can Scale-O be installed in an existing water tank?",
            "answer": "<p>Yes. Scale-O is placed inside an existing overhead tank. You do not need to replace the tank or install a separate treatment plant.</p>",
            "category": "",
            "icon": "tank"
          }
        },
        "faq_8": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "How does Scale-O help prevent hard-water scale?",
            "answer": "<p>Scale-O is a salt-free conditioner that helps reduce visible hard-water scale buildup on pipes, taps, geysers and other household fittings as water flows through the home.</p>",
            "category": "",
            "icon": "shield"
          }
        },
        "faq_9": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "Does Scale-O require regular maintenance?",
            "answer": "<p>Day-to-day use does not require salt refills, electricity or regular servicing. When it is time, the unit is replaced through a straightforward exchange process.</p>",
            "category": "",
            "icon": "wrench"
          }
        },
        "faq_10": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "How long does a Scale-O unit last?",
            "answer": "<p>Household units are typically exchanged on a regular cycle so protection stays consistent, often around every 6 months, depending on the product and usage. Check your product details and exchange policy for the recommended interval.</p>",
            "category": "",
            "icon": "clock"
          }
        },
        "faq_11": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "Which Scale-O model is right for my home?",
            "answer": "<p>Choose a Scale-O size that matches your tank capacity and household water usage. If you are unsure, talk to a Scale-O expert. They can help you pick the right model.</p>",
            "category": "",
            "icon": "home"
          }
        },
        "faq_12": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "Can Scale-O be used with geysers, washing machines and other appliances?",
            "answer": "<p>Yes. Once installed in the overhead tank, Scale-O conditions the water that flows to bathrooms, kitchen, laundry and household appliances such as geysers and washing machines.</p>",
            "category": "",
            "icon": "gear"
          }
        },
        "faq_13": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "How do I choose the correct Scale-O size?",
            "answer": "<p>Match the unit to your overhead tank capacity and how much water your household uses. Larger tanks or higher usage generally need a larger model. Use the product size guide or speak with our team if you need help choosing.</p>",
            "category": "",
            "icon": "size"
          }
        },
        "faq_14": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "What is included with my Scale-O purchase?",
            "answer": "<p>Your Scale-O unit is ready to place in the tank. Specific inclusions can vary by model. Check the product page for what ships with your chosen size.</p>",
            "category": "",
            "icon": "box"
          }
        },
        "faq_15": {
          "type": "faq",
          "settings": {
            "enabled": true,
            "question": "How does the trial / guarantee work?",
            "answer": "<p>Scale-O offers a 7-day risk-free trial so you can try it in your home with confidence. Guarantee activation is confirmed with your invoice as part of the purchase process. See the product page or talk to our team for current trial terms.</p>",
            "category": "",
            "icon": "shield"
          }
        }
      },
