les/1/0592/6508/9638/files/Frame_48-3.svg?v=1722428685\"\n      alt=\"Easy Exchange\"\n    />\n    <p>EASY EXCHANGE</p>\n  </div>\n</div>\n<div class=\"ratings mainbox\">\n  <div>\n    <h2>Ratings by Criteria</h2>\n    {% assign rounded_rating = product.metafields.custom.total_rating.value |\n    round %}\n\n    <div class=\"overall-rating\">\n      <span class=\"stars\">\n        {% case rounded_rating %} {% when 5 %} ★★★★★ {% when 4 %} ★★★★☆ {% when\n        3 %} ★★★☆☆ {% when 2 %} ★★☆☆☆ {% when 1 %} ★☆☆☆☆ {% else %} ☆☆☆☆☆ {%\n        endcase %}\n      </span>\n      <span class=\"rating\">\n        {{ product.metafields.custom.total_rating.value }}/5.0 ({{\n        product.metafields.custom.reviews.value }} Reviews)\n      </span>\n    </div>\n  </div>\n\n  <div class=\"feature-ratings\">\n    <div class=\"rating-item\">\n      <span class=\"feature-name\">CONCEPT</span>\n      <div style=\"display: flex; align-items: baseline\">\n        <span class=\"stars\">★</span>\n        <span class=\"rating\"\n          >{{product.metafields.custom.concept.value }} | 5.0</span\n        >\n      </div>\n    </div>\n    <div class=\"rating-item\">\n      <span class=\"feature-name\">CONVENIENCE</span>\n      <div style=\"display: flex; align-items: baseline\">\n        <span class=\"stars\">★</span>\n        <span class=\"rating\"\n          >{{product.metafields.custom.convenience.value }} | 5.0</span\n        >\n      </div>\n    </div>\n    <div class=\"rating-item\">\n      <span class=\"feature-name\">QUALITY</span>\n      <div style=\"display: flex; align-items: baseline\">\n        <span class=\"stars\">★</span>\n        <span class=\"rating\"\n          >{{product.metafields.custom.quality.value }} | 5.0</span\n        >\n      </div>\n    </div>\n    <div class=\"rating-item\">\n      <span class=\"feature-name\">PRICING</span>\n      <div style=\"display: flex; align-items: baseline\">\n        <span class=\"stars\">★</span>\n        <span class=\"rating\"\n          >{{product.metafields.custom.pricing.value }} | 5.0</span\n        >\n      </div>\n    </div>\n  </div>\n</div>"
